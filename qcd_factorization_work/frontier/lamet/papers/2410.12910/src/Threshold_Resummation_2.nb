        SuperscriptBox["\[Delta]", "ab"]}], 
       RowBox[{
        SuperscriptBox["k", "2"], "+", 
        RowBox[{"I", "*", "\[Epsilon]"}]}]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", 
        RowBox[{"(", 
