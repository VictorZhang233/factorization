Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Calculation", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"PDFls", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PDFls2", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", 
        RowBox[{"Length", "[", "\[Mu]hls", "]"}]}], ",", 
       RowBox[{"i", "\[GreaterEqual]", "1"}], ",", 
       RowBox[{"i", "--"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ChM", "=", 
         RowBox[{"MfixGen", "[", 
          RowBox[{"\[Mu]hls", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"PDFlist", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"xlist", ",", 
            RowBox[{"ChM", ".", "qV"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"PDFint", "=", 
         RowBox[{"Interpolation", "[", "PDFlist", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PDFintsys", "[", "x_", "]"}], ":=", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"PDFint", "[", "x", "]"}], "+", 
            RowBox[{"PDFint", "[", 
             RowBox[{"-", "x"}], "]"}]}], ")"}], "2"]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
