Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Consistency", " ", "check", " ", "of", " ", "the", " ", "two", " ", 
    "methods"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xlist", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{"x", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "2"}], ",", 
           RowBox[{"-", "0.02"}], ",", "0.02"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{"x", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0.02", ",", "2", ",", "0.02"}], "}"}]}], "]"}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Pz", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zs", "=", 
     RowBox[{"0.12", "/", "0.197"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nf", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CzM", "=", 
     RowBox[{"SubMGen", "[", 
      RowBox[{"Cz", ",", "xlist", ",", "Pz", ",", "zs"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CzMExp", "=", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{
       RowBox[{"-", "CzM"}], "*", "frsum"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"frsum", "=", 
     RowBox[{"dPVasym", "[", 
      RowBox[{"1", ",", "\[Mu]", ",", "nf", ",", 
       RowBox[{
        RowBox[{"\[Alpha]sNLO", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", "\[Mu]", "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MCzsum", "=", 
     RowBox[{"SubMGenLRR", "[", 
      RowBox[{"xlist", ",", "Pz", ",", "zs", ",", "frsum"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fvls", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], 
         SuperscriptBox["x", "2"]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xlist"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListPlot", "[", "fvls", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"MCzsum", ".", "fvls"}], ",", 
       RowBox[{"Joined", "\[Rule]", "True"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"CzMExp", ".", "fvls"}], ",", 
       RowBox[{"Joined", "\[Rule]", "True"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", "Black"}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "xlist", ",", "Pz", ",", "zs", ",", "\[Mu]", ",", "nf", ",", "CzM", ",", 
     "CzMExp", ",", "frsum", ",", "MCzsum"}], "]"}]}]}]], "Text",
