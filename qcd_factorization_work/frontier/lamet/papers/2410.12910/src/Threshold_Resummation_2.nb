        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"PDFint", "=", 
         RowBox[{"Interpolation", "[", "PDFlist", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PDFintsys", "[", "x_", "]"}], ":=", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"PDFint", "[", "x", "]"}], "+", 
            RowBox[{"PDFint", "[", 
             RowBox[{"-", "x"}], "]"}]}], ")"}], "2"]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PDFCombine", "[", "x_", "]"}], ":=", 
