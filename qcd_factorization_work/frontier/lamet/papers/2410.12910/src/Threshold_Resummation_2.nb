Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Consistency", " ", "check", " ", "of", " ", "the", " ", "two", " ", 
    "methods"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xlist", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{"x", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "2"}], ",", 
           RowBox[{"-", "0.02"}], ",", "0.02"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{"x", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0.02", ",", "2", ",", "0.02"}], "}"}]}], "]"}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Pz", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zs", "=", 
     RowBox[{"0.12", "/", "0.197"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]i", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nf", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"J2\[Eta]pls", "=", 
     RowBox[{"J\[Eta]pgen", "[", 
      RowBox[{"J2\[Eta]p", ",", "xlist"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"J2dnls", "=", 
     RowBox[{"Jdngen", "[", 
      RowBox[{"J2dn", ",", "xlist"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PJm", "=", 
     RowBox[{"PJgen", "[", 
      RowBox[{
      "J2\[Eta]pls", ",", "J2dnls", ",", "SNLO", ",", "a\[CapitalGamma]NLO", 
       ",", "aJNLO", ",", "xlist", ",", "\[Mu]", ",", "\[Mu]i", ",", "Pz", 
       ",", "zs"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PJm1", "=", 
     RowBox[{"PJgenold", "[", 
      RowBox[{
      "SNLO", ",", "a\[CapitalGamma]NLO", ",", "aJNLO", ",", "xlist", ",", 
       "\[Mu]", ",", "\[Mu]i", ",", "Pz", ",", "zs"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fvls", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], 
         SuperscriptBox["x", "2"]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xlist"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListPlot", "[", "fvls", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"PJm", ".", "fvls"}], ",", 
       RowBox[{"Joined", "\[Rule]", "True"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
