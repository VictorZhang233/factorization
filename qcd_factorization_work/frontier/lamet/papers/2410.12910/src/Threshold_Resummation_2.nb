                RowBox[{"[", "i", "]"}], "]"}], "+", 
               FractionBox["\[CapitalDelta]x", "4"]}], "<", 
              RowBox[{"Abs", "[", "x", "]"}], "\[LessEqual]", " ", 
              RowBox[{
               RowBox[{"xlsf", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               FractionBox[
                RowBox[{"3", "\[CapitalDelta]x"}], "4"]}]}], ",", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{
