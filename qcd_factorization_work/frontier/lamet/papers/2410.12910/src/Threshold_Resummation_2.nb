     RowBox[{
     "S_", ",", "a\[CapitalGamma]_", ",", "aJ_", ",", "xlist_", ",", "\[Mu]_",
       ",", "\[Mu]i_", ",", "Pz_", ",", "zs_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
