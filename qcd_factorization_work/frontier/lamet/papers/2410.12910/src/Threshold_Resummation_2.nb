                   RowBox[{"xlsf", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", 
                   FractionBox[
                    RowBox[{"3", "\[CapitalDelta]x"}], "4"]}], ")"}], "-", 
                 RowBox[{"Abs", "[", "x", "]"}]}], 
                RowBox[{"\[CapitalDelta]x", "/", "2"}]], 
               RowBox[{"PDFintsys", "[", "x", "]"}]}], "+", 
              RowBox[{
               FractionBox[
                RowBox[{
                 RowBox[{"Abs", "[", "x", "]"}], "-", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"xlsf", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", 
                   FractionBox["\[CapitalDelta]x", "4"]}], ")"}]}], 
                RowBox[{"\[CapitalDelta]x", "/", "2"}]], 
               RowBox[{
                RowBox[{"PDFls2", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"Length", "[", "\[Mu]hls", "]"}], "-", "i"}], 
                  "]"}], "]"}], "[", "x", "]"}]}]}], ",", 
             RowBox[{
              RowBox[{"PDFls2", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"Length", "[", "\[Mu]hls", "]"}], "-", "i"}], "]"}], 
               "]"}], "[", "x", "]"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"PDFCombine", "[", "x_", "]"}], ":=", 
           RowBox[{"PDFintsys", "[", "x", "]"}]}], ";"}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"PertAcc", "\[Equal]", "\"\<NNLO+LRR\>\""}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"PDFls", ",", 
             RowBox[{"DGLAPNNLOx", "[", 
