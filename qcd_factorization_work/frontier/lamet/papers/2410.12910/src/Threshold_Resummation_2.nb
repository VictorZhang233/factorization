 FontColor->RGBColor[0, 0, 1]]], "Subsection",
 CellChangeTimes->{{3.8940129407118998`*^9, 3.894012999503386*^9}, {
   3.894013043997801*^9, 3.894013057639818*^9}, 3.8940151309751434`*^9, 
