          FractionBox["\[CapitalDelta]x", 
           RowBox[{"Abs", "[", 
            RowBox[{"xlist", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "]"}]]}], ",", "0"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"\[Delta]Cmf", "[", 
         RowBox[{"i", ",", "j"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "xlist", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"Length", "[", "xlist", "]"}]}], "}"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "PJgen", "]"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"C\[Eta]pm", ":", " ", "J2\[Eta]p"}], ";", " ", 
    "\[IndentingNewLine]", 
    RowBox[{"Cdnm", ":", " ", "J2dn"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PJgen", "[", 
   RowBox[{
   "C\[Eta]pm_", ",", "Cdnm_", ",", "S_", ",", "a\[CapitalGamma]_", ",", 
    "aJ_", ",", "xlist_", ",", "\[Mu]_", ",", "\[Mu]i_", ",", "Pz_", ",", 
    "zs_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[CapitalDelta]x", ",", "L", ",", "nf", ",", "\[Eta]", ",", "fam", ",", 
      "Moffdiag", ",", "Mdiag"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[CapitalDelta]x", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"xlist", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"xlist", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"L", "=", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"xlist", "[", 
          RowBox[{"[", 
           RowBox[{"Length", "[", "xlist", "]"}], "]"}], "]"}], "-", 
         RowBox[{"xlist", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "2"]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nf", "=", "3"}], ";", 
     RowBox[{"(*", 
      RowBox[{"Fermion", " ", "flavors"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       SubscriptBox["y", "i"], ",", 
       SubscriptBox["x", "j"]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Eta]", "=", 
      RowBox[{"2", 
       RowBox[{"a\[CapitalGamma]", "[", 
        RowBox[{"\[Mu]i", ",", "\[Mu]", ",", "nf"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fam", "=", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         RowBox[{"S", "[", 
          RowBox[{"\[Mu]i", ",", "\[Mu]", ",", "nf"}], "]"}]}], "+", 
        RowBox[{"aJ", "[", 
         RowBox[{"\[Mu]i", ",", "\[Mu]", ",", "nf"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Moffdiag", "=", 
      RowBox[{"fam", "*", "Cdnm", "*", 
       FractionBox[
        RowBox[{
         RowBox[{"Sin", "[", 
          FractionBox[
           RowBox[{"\[Eta]", " ", "\[Pi]"}], "2"], "]"}], 
         RowBox[{"Gamma", "[", 
          RowBox[{"1", "-", "\[Eta]"}], "]"}], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "EulerGamma"}], " ", "\[Eta]"}]]}], "Pi"], 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"2", "Pz"}], "\[Mu]i"], ")"}], "\[Eta]"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"C\[Eta]pm", "+", 
            RowBox[{"IdentityMatrix", "[", 
             RowBox[{"Length", "[", "xlist", "]"}], "]"}]}], ")"}], "\[Eta]"],
          "-", 
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{"Length", "[", "xlist", "]"}], "]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Mdiag", "=", 
      RowBox[{"-", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Moffdiag", ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], "+", 
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"P\[ScriptCapitalJ]LT", "[", 
            RowBox[{
            "S", ",", "a\[CapitalGamma]", ",", "aJ", ",", "x", ",", "\[Mu]", 
             ",", "\[Mu]i", ",", "Pz", ",", "zs", ",", 
             RowBox[{"L", "+", 
              FractionBox["\[CapitalDelta]x", "2"]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "xlist"}], "}"}]}], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Moffdiag", "+", "Mdiag"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
