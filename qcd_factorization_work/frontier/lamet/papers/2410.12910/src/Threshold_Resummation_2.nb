           FractionBox[
            RowBox[{"\[Eta]", " ", "\[Pi]"}], "2"], "]"}], 
          RowBox[{"Gamma", "[", 
           RowBox[{"1", "-", "\[Eta]"}], "]"}], 
          SuperscriptBox["\[ExponentialE]", 
