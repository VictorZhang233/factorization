           RowBox[{"[", "1", "]"}], "]"}], "[", "\[Mu]", "]"}], "*", "CF"}], 
        RowBox[{"2", "Pi"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", 
            RowBox[{"Log", "[", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["\[Mu]", "Pz"], ")"}], "2"], "]"}]}], ")"}], 
          RowBox[{"Cratio1plusw\[Mu]", "[", 
           RowBox[{
            FractionBox["y", "x"], ",", "x", ",", "Pz", ",", "zs"}], "]"}]}], 
         "+", 
         RowBox[{"Cratio1pluswo\[Mu]", "[", 
          RowBox[{
           FractionBox["y", "x"], ",", "x", ",", "Pz", ",", "zs"}], "]"}], 
         "+", 
         RowBox[{"Chybrid1plus", "[", 
          RowBox[{
           FractionBox["y", "x"], ",", "x", ",", "Pz", ",", "zs"}], "]"}]}], 
        ")"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
