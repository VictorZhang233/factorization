       RowBox[{
        RowBox[{"\[Delta]Cmf", "[", 
         RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[NotEqual]", "j"}], ",", 
          RowBox[{
           FractionBox[
            RowBox[{"P\[ScriptCapitalJ]", "[", 
             RowBox[{"S", ",", "a\[CapitalGamma]", ",", "aJ", ",", 
              RowBox[{"xlist", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"xlist", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", "\[Mu]", ",", "\[Mu]i", 
              ",", "Pz", ",", "zs"}], "]"}], 
            RowBox[{"Abs", "[", 
             RowBox[{"xlist", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "]"}]], "\[CapitalDelta]x"}], 
          ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{"P\[ScriptCapitalJ]", "[", 
                 RowBox[{"S", ",", "a\[CapitalGamma]", ",", "aJ", ",", 
                  RowBox[{"xlist", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ",", 
                  RowBox[{"xlist", "[", 
