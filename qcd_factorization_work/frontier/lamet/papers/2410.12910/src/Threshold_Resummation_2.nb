 RowBox[{
  RowBox[{
   RowBox[{"ChNLOc", "[", 
    RowBox[{"y_", ",", "x_", ",", "\[Mu]_", ",", "Pz_", ",", "zs_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Xi]", ",", "nf", ",", "fr"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Xi]", "=", 
       FractionBox["y", "x"]}], ";", 
