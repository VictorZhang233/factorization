         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", "xlist", "]"}]}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Jdngen", "[", 
     RowBox[{"C_", ",", "xlist_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[CapitalDelta]x", ",", "\[Delta]Cmf"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[CapitalDelta]x", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"xlist", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"xlist", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         SubscriptBox["y", "i"], ",", 
