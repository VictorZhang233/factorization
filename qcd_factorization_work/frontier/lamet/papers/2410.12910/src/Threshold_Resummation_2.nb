       RowBox[{
        RowBox[{"\[Delta]Cmf", "[", 
         RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[NotEqual]", "j"}], ",", 
          RowBox[{
           RowBox[{"C", "[", 
