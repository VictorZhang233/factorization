   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"C\[Eta]pm", ":", " ", "J2\[Eta]p"}], ";", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"Cdnm", ":", " ", 
       RowBox[{
       "J2dn", "\[IndentingNewLine]", "\[Eta]m", " ", "must", " ", "be", " ", 
        "the", " ", "same", " ", "between", " ", "Jls0gen"}]}]}], ",", " ", 
     RowBox[{
     "JLTls0gen", " ", "and", " ", "Jgen", "\[IndentingNewLine]", "So", " ", 
