    " ", "J", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Remove", "[", "c", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RGgen", "[", "M_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", "sol", ",", "ls"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SubscriptBox["c", 
         RowBox[{"0", ",", "0"}]], "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"n", "=", "0"}], ",", 
         RowBox[{"n", "\[LessEqual]", 
          RowBox[{"M", "-", "1"}]}], ",", 
         RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"sol", "=", 
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"CoefficientList", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"UnitStep", "[", "n", "]"}], 
                 RowBox[{
                  SubsuperscriptBox["\[Sum]", 
                   RowBox[{"m", "=", "0"}], 
                   RowBox[{
                    RowBox[{"2", "n"}], "+", "2"}]], 
                  RowBox[{
                   SubscriptBox["c", 
                    RowBox[{
                    RowBox[{"n", "+", "1"}], ",", "m"}]], "2", "m", " ", 
                   SuperscriptBox["L", 
                    RowBox[{"m", "-", "1"}]]}]}]}], ",", "L"}], "]"}], 
              "\[Equal]", 
              RowBox[{"CoefficientList", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  SubsuperscriptBox["\[Sum]", 
                   RowBox[{"p", "=", "0"}], 
                   RowBox[{"n", "-", "1"}]], 
                  RowBox[{
                   RowBox[{"UnitStep", "[", 
                    RowBox[{"n", "-", "1", "-", "p"}], "]"}], 
                   RowBox[{
                    SubsuperscriptBox["\[Sum]", 
                    RowBox[{"m", "=", "0"}], 
                    RowBox[{
                    RowBox[{"2", "n"}], "-", 
                    RowBox[{"2", "p"}]}]], 
                    RowBox[{
                    SubscriptBox["\[Beta]", "p"], " ", 
                    RowBox[{"(", 
                    RowBox[{"n", "-", "p"}], ")"}], " ", 
                    SubscriptBox["c", 
                    RowBox[{
                    RowBox[{"n", "-", "p"}], ",", "m"}]], 
                    SuperscriptBox["L", "m"]}]}]}]}], "+", 
                 RowBox[{
                  SubsuperscriptBox["\[Sum]", 
                   RowBox[{"p", "=", "0"}], "n"], 
                  RowBox[{
                   RowBox[{"UnitStep", "[", 
                    RowBox[{"n", "-", "p"}], "]"}], 
                   RowBox[{
                    SubsuperscriptBox["\[Sum]", 
                    RowBox[{"m", "=", "0"}], 
                    RowBox[{"2", 
                    RowBox[{"(", 
                    RowBox[{"n", "-", "p"}], ")"}]}]], 
                    RowBox[{
                    SubscriptBox["\[CapitalGamma]", 
                    RowBox[{"p", "+", "1"}]], " ", 
                    SubscriptBox["c", 
                    RowBox[{
                    RowBox[{"n", "-", "p"}], ",", "m"}]], 
                    SuperscriptBox["L", 
                    RowBox[{"m", "+", "1"}]]}]}]}]}], "-", 
                 RowBox[{
                  SubsuperscriptBox["\[Sum]", 
                   RowBox[{"p", "=", "0"}], "n"], 
                  RowBox[{
                   RowBox[{"UnitStep", "[", 
                    RowBox[{"n", "-", "p"}], "]"}], 
                   RowBox[{
                    SubsuperscriptBox["\[Sum]", 
                    RowBox[{"m", "=", "0"}], 
                    RowBox[{"2", 
                    RowBox[{"(", 
                    RowBox[{"n", "-", "p"}], ")"}]}]], 
                    RowBox[{
                    SubscriptBox["\[Gamma]J", 
                    RowBox[{"p", "+", "1"}]], " ", 
                    SubscriptBox["c", 
                    RowBox[{
                    RowBox[{"n", "-", "p"}], ",", "m"}]], 
                    SuperscriptBox["L", "m"]}]}]}]}]}], ",", "L"}], "]"}]}], 
             ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               SubscriptBox["c", 
                RowBox[{
                 RowBox[{"n", "+", "1"}], ",", "i"}]], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{
                  RowBox[{"2", "n"}], "+", "2"}]}], "}"}]}], "]"}]}], "]"}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", 
            RowBox[{"i", "\[LessEqual]", 
             RowBox[{
              RowBox[{"2", "n"}], "+", "2"}]}], ",", 
            RowBox[{"i", "++"}], ",", 
            RowBox[{
             SubscriptBox["c", 
              RowBox[{
               RowBox[{"n", "+", "1"}], ",", "i"}]], "=", 
             RowBox[{
              RowBox[{"sol", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", ";;", ",", "2"}], "]"}], "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], " ", "]"}]}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        SubsuperscriptBox["\[Sum]", 
         RowBox[{"n", "=", "0"}], "M"], 
        RowBox[{
         SubsuperscriptBox["\[Sum]", 
          RowBox[{"m", "=", "0"}], 
          RowBox[{"2", "n"}]], 
         RowBox[{
          SuperscriptBox["\[Alpha]", "n"], 
          SubscriptBox["c", 
           RowBox[{"n", ",", "m"}]], 
          SuperscriptBox["L", "m"]}]}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
