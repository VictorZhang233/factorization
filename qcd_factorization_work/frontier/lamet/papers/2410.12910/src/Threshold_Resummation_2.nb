            RowBox[{"-", "EulerGamma"}], " ", "\[Eta]"}]]}], "Pi"], 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"2", " ", 
              RowBox[{"Abs", "[", "x", "]"}], "Pz"}], "\[Mu]i"], "*", 
            RowBox[{"Abs", "[", 
             RowBox[{"1", "-", "\[Xi]"}], "]"}]}], ")"}], "\[Eta]"], 
