       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[CapitalDelta]x", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"xlist", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"xlist", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"L", "=", 
        RowBox[{
         RowBox[{"Abs", "[", 
