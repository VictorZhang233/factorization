      RowBox[{"qinttest", "[", "2", "]"}], 
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Abs", "[", "x", "]"}], "-", "2"}], ")"}]}], "]"}]}]}], 
