Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Calculation", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"PDFls", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PDFls2", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", 
        RowBox[{"Length", "[", "\[Mu]hls", "]"}]}], ",", 
       RowBox[{"i", "\[GreaterEqual]", "1"}], ",", 
       RowBox[{"i", "--"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ChM", "=", 
         RowBox[{"MfixGen", "[", 
          RowBox[{"\[Mu]hls", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"PDFlist", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"xlist", ",", 
            RowBox[{"ChM", ".", "qV"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"PDFint", "=", 
         RowBox[{"Interpolation", "[", "PDFlist", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PDFintsys", "[", "x_", "]"}], ":=", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"PDFint", "[", "x", "]"}], "+", 
            RowBox[{"PDFint", "[", 
             RowBox[{"-", "x"}], "]"}]}], ")"}], "2"]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PDFCombine", "[", "x_", "]"}], ":=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", "x", "]"}], "\[LessEqual]", " ", 
            RowBox[{
             RowBox[{"xlsf", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "+", 
             FractionBox["\[CapitalDelta]x", "4"]}]}], ",", 
           RowBox[{"PDFintsys", "[", "x", "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"xlsf", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               FractionBox["\[CapitalDelta]x", "4"]}], "<", 
              RowBox[{"Abs", "[", "x", "]"}], "\[LessEqual]", " ", 
              RowBox[{
               RowBox[{"xlsf", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               FractionBox[
                RowBox[{"3", "\[CapitalDelta]x"}], "4"]}]}], ",", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"xlsf", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", 
                   FractionBox[
                    RowBox[{"3", "\[CapitalDelta]x"}], "4"]}], ")"}], "-", 
                 RowBox[{"Abs", "[", "x", "]"}]}], 
                RowBox[{"\[CapitalDelta]x", "/", "2"}]], 
               RowBox[{"PDFintsys", "[", "x", "]"}]}], "+", 
              RowBox[{
               FractionBox[
                RowBox[{
                 RowBox[{"Abs", "[", "x", "]"}], "-", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"xlsf", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", 
                   FractionBox["\[CapitalDelta]x", "4"]}], ")"}]}], 
                RowBox[{"\[CapitalDelta]x", "/", "2"}]], 
               RowBox[{
                RowBox[{"PDFls2", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"Length", "[", "\[Mu]hls", "]"}], "-", "i"}], 
                  "]"}], "]"}], "[", "x", "]"}]}]}], ",", 
             RowBox[{
              RowBox[{"PDFls2", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"Length", "[", "\[Mu]hls", "]"}], "-", "i"}], "]"}], 
               "]"}], "[", "x", "]"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"PDFCombine", "[", "x_", "]"}], ":=", 
           RowBox[{"PDFintsys", "[", "x", "]"}]}], ";"}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"PertAcc", "\[Equal]", "\"\<NLO+LRR\>\""}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"PDFls", ",", 
             RowBox[{"DGLAPNLOx", "[", 
              RowBox[{"PDFCombine", ",", 
               RowBox[{"\[Mu]hls", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "\[Mu]", ",", 
               "Mdglapns0", ",", "Mdglapns1", ",", "xDGLAP"}], "]"}]}], "]"}],
            ";", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"PDFls2", ",", 
             RowBox[{"DGLAPNLOx", "[", 
              RowBox[{"PDFCombine", ",", 
               RowBox[{"\[Mu]hls", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"\[Mu]hls", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "-", "1"}], "]"}], "]"}], ",", "Mdglapns0", ",",
                "Mdglapns1", ",", "xDGLAP"}], "]"}]}], "]"}], ";"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Nothing", "[", "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
