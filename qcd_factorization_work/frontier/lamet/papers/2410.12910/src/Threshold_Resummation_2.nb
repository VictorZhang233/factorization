 RowBox[{
  RowBox[{
   RowBox[{
    SubsuperscriptBox["D", "\[Mu]\[Nu]", "ab"], "[", 
    RowBox[{"x", ",", "y"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"\[CapitalOmega]", "|", 
      RowBox[{
       SubsuperscriptBox["A", "\[Mu]", "a"], 
       RowBox[{"(", "x", ")"}], 
       SubsuperscriptBox["A", "\[Nu]", "b"], 
       RowBox[{"(", "y", ")"}]}], "|", "\[CapitalOmega]"}], 
     "\[RightAngleBracket]"}], "=", 
    RowBox[{"\[Integral]", 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["\[DifferentialD]", "d"], "k"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "Pi"}], ")"}], "d"]], 
      FractionBox[
       RowBox[{
        RowBox[{"-", "I"}], " ", 
