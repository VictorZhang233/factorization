Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Generate", " ", "the", " ", "fixed", " ", "order", " ", "matching", " ", 
    "kernel"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SubMGen", "[", 
     RowBox[{"\[Delta]C_", ",", "xlist_", ",", "Pz_", ",", "zs_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Delta]Ctmp", ",", "\[CapitalDelta]x", ",", "\[Delta]Cmf"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Delta]Ctmp", "[", 
         RowBox[{"y_", ",", "x_"}], "]"}], ":=", 
        RowBox[{"\[Delta]C", "[", 
         RowBox[{
          FractionBox["y", "x"], ",", "x", ",", "Pz", ",", "zs"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"\[CapitalDelta]x", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"xlist", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"xlist", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         SubscriptBox["y", "i"], ",", 
         SubscriptBox["x", "j"]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Delta]Cmf", "[", 
         RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[NotEqual]", "j"}], ",", 
          RowBox[{
           FractionBox[
            RowBox[{"\[Delta]Ctmp", "[", 
             RowBox[{
              RowBox[{"xlist", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"xlist", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], 
            RowBox[{"Abs", "[", 
             RowBox[{"xlist", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "]"}]], "\[CapitalDelta]x"}], 
          ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{"\[Delta]Ctmp", "[", 
                 RowBox[{
                  RowBox[{"xlist", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ",", 
                  RowBox[{"xlist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], "]"}], 
                RowBox[{"Abs", "[", 
                 RowBox[{"xlist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}]], 
               "\[CapitalDelta]x"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", 
                RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}]}], "-", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{"\[Delta]Ctmp", "[", 
                RowBox[{
                 RowBox[{"xlist", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", 
                 RowBox[{"xlist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "]"}], 
               RowBox[{"Abs", "[", 
                RowBox[{"xlist", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}]], "\[CapitalDelta]x"}],
              ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"j", "+", "1"}], ",", 
               RowBox[{"Length", "[", "xlist", "]"}]}], "}"}]}], "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"\[Delta]Cmf", "[", 
          RowBox[{"i", ",", "j"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "xlist", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", "xlist", "]"}]}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.8973171664085927`*^9, 3.8973172235406327`*^9}, 
   3.8973172686388445`*^9, {3.89733247971019*^9, 3.8973324806006193`*^9}, {
   3.8973329220286303`*^9, 3.8973329234469633`*^9}, {3.8973339273130627`*^9, 
