Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Consistency", " ", "check", " ", "of", " ", "the", " ", "two", " ", 
    "methods"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xlist", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{"x", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "2"}], ",", 
           RowBox[{"-", "0.02"}], ",", "0.02"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{"x", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0.02", ",", "2", ",", "0.02"}], "}"}]}], "]"}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Pz", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zs", "=", 
     RowBox[{"0.12", "/", "0.197"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nf", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"J2\[Eta]pls", "=", 
     RowBox[{"J\[Eta]pgen", "[", 
      RowBox[{"J2\[Eta]p", ",", "xlist"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"J2dnls", "=", 
     RowBox[{"Jdngen", "[", 
      RowBox[{"J2dn", ",", "xlist"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Jls0", "=", 
     RowBox[{"Jls0gen", "[", 
      RowBox[{"J2\[Eta]pls", ",", "J2dnls"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JLTls0", "=", 
     RowBox[{"JLTls0gen", "[", "xlist", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Jm", "=", 
     RowBox[{"Jgen", "[", 
      RowBox[{
      "Jls0", ",", "JLTls0", ",", "JcoeNNLO", ",", "xlist", ",", "\[Mu]", ",",
        "Pz", ",", "zs"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Jm1", "=", 
     RowBox[{"Jgenold", "[", 
      RowBox[{
      "xlist", ",", "\[Mu]", ",", "Pz", ",", "zs", ",", "JcoeNNLO", ",", 
       SuperscriptBox["10", 
        RowBox[{"-", "2"}]]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fvls", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], 
         SuperscriptBox["x", "2"]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xlist"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListPlot", "[", "fvls", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Jm", ".", "fvls"}], ",", 
       RowBox[{"Joined", "\[Rule]", "True"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Jm1", ".", "fvls"}], ",", 
       RowBox[{"Joined", "\[Rule]", "True"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", "Blue"}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "xlist", ",", "Pz", ",", "zs", ",", "\[Mu]", ",", "nf", ",", 
     "J2\[Eta]pls", ",", "J2dnls", ",", "Jls0", ",", "JLTls0", ",", "Jm", ",",
      "Jm1", ",", "fvls"}], "]"}], "\[IndentingNewLine]"}]}]], "Text",
