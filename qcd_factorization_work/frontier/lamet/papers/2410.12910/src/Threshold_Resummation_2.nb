Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"On", " ", "the", " ", "other", " ", "hand"}], ",", " ", 
    RowBox[{
    "the", " ", "exponentiated", " ", "renormalon", " ", "series", " ", "can",
      " ", "be", " ", "obtained", " ", "from", " ", "the", " ", "direct", " ",
      "FT", " ", "of", " ", "the", " ", "exponential", " ", "decaying", " ", 
     "factor", "\[IndentingNewLine]", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "\[Infinity]"}], 
       RowBox[{"+", "\[Infinity]"}]], 
      RowBox[{
       FractionBox[
        RowBox[{"\[DifferentialD]", "\[Nu]"}], 
        RowBox[{"2", "\[Pi]"}]], 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "\[Nu]", 
         RowBox[{"(", 
          RowBox[{"\[Xi]", "-", "1"}], ")"}]}], "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"zs", "|", 
           RowBox[{"x", " ", "Pz"}], "|", 
           RowBox[{"-", 
            RowBox[{"|", "\[Nu]", "|"}]}]}], "]"}], "+", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"|", "\[Nu]", "|", 
               RowBox[{"-", "zs"}], "|", 
               RowBox[{"x", " ", "Pz"}], "|"}], ")"}]}], 
            FractionBox["\[Mu]", 
             RowBox[{"|", 
              RowBox[{"x", " ", "Pz"}], "|"}]], 
            RowBox[{
             SubscriptBox["\[Sum]", 
              RowBox[{"n", "=", 
               SuperscriptBox["n", "*"]}]], 
             RowBox[{
              SubscriptBox["r", "n"], 
              SuperscriptBox["\[Alpha]", 
               RowBox[{"n", "+", "1"}]]}]}]}], "]"}], 
          RowBox[{"\[Theta]", "[", 
           RowBox[{"|", 
            FractionBox["\[Nu]", 
             RowBox[{"x", " ", "Pz"}]], "|", 
            RowBox[{"-", "zs"}]}], "]"}]}]}], ")"}]}]}]}]}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"LRRcorr", "[", 
     RowBox[{"\[Xi]_", ",", "x_", ",", "Pz_", ",", "zs_", ",", "frsum_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Mr", ",", "Msub", ",", "\[Nu]0"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Mr", "=", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"Abs", "[", 
           RowBox[{"x", " ", "Pz"}], "]"}]], "frsum"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Nu]0", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"Pz", " ", "x", " ", "zs"}], "]"}]}], " ", ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        FractionBox[
         RowBox[{"Sin", "[", 
          RowBox[{"\[Nu]0", " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Xi]"}], ")"}]}], "]"}], 
         RowBox[{"\[Pi]", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Xi]"}], ")"}]}]], "+", 
        FractionBox[
         RowBox[{
          RowBox[{"Mr", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"\[Nu]0", "-", 
             RowBox[{"\[Nu]0", " ", "\[Xi]"}]}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "\[Xi]"}], ")"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Nu]0", "-", 
             RowBox[{"\[Nu]0", " ", "\[Xi]"}]}], "]"}]}]}], 
         RowBox[{"\[Pi]", " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["Mr", "2"], "+", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "\[Xi]"}], ")"}], "2"]}], 
           ")"}]}]]}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "the", " ", "LRR", " ", "correction"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SubMGenLRR", "[", 
     RowBox[{"xlist_", ",", "Pz_", ",", "zs_", ",", "frsum_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Delta]Ctmp", ",", "\[CapitalDelta]x", ",", "\[Delta]Cmf"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Delta]Ctmp", "[", 
         RowBox[{"y_", ",", "x_"}], "]"}], ":=", 
        RowBox[{"LRRcorr", "[", 
         RowBox[{
          FractionBox["y", "x"], ",", "x", ",", "Pz", ",", "zs", ",", 
          "frsum"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[CapitalDelta]x", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"xlist", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"xlist", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         SubscriptBox["y", "i"], ",", 
         SubscriptBox["x", "j"]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Delta]Cmf", "[", 
         RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[NotEqual]", "j"}], ",", 
          RowBox[{
           FractionBox[
            RowBox[{"\[Delta]Ctmp", "[", 
             RowBox[{
              RowBox[{"xlist", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"xlist", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], 
            RowBox[{"Abs", "[", 
             RowBox[{"xlist", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "]"}]], "\[CapitalDelta]x"}], 
          ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{"\[Delta]Ctmp", "[", 
                 RowBox[{
                  RowBox[{"xlist", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ",", 
                  RowBox[{"xlist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], "]"}], 
                RowBox[{"Abs", "[", 
                 RowBox[{"xlist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}]], 
               "\[CapitalDelta]x"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", 
                RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}]}], "-", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{"\[Delta]Ctmp", "[", 
                RowBox[{
                 RowBox[{"xlist", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", 
                 RowBox[{"xlist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "]"}], 
               RowBox[{"Abs", "[", 
                RowBox[{"xlist", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}]], "\[CapitalDelta]x"}],
              ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"j", "+", "1"}], ",", 
               RowBox[{"Length", "[", "xlist", "]"}]}], "}"}]}], "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"Length", "[", "xlist", "]"}], "]"}], "+", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"\[Delta]Cmf", "[", 
           RowBox[{"i", ",", "j"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "xlist", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"Length", "[", "xlist", "]"}]}], "}"}]}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9317768325393515`*^9, 3.931776872243449*^9}, {
   3.931776904973796*^9, 3.931776912445362*^9}, {3.9317769529966846`*^9, 
