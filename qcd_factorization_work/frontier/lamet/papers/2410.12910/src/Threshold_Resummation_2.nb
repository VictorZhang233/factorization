Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "old", " ", "method", " ", "to", " ", "generate", " ", "Jet"}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Jgenold", "[", 
     RowBox[{
     "xlist_", ",", "\[Mu]i_", ",", "Pz_", ",", "zs_", ",", "Jcoe_", ",", 
      "\[Delta]\[Eta]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[CapitalDelta]x", ",", "L", ",", "\[Delta]Cmf"}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[CapitalDelta]x", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"xlist", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"xlist", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"L", "=", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"xlist", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "+", 
         FractionBox["\[CapitalDelta]x", "2"]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         SubscriptBox["y", "i"], ",", 
         SubscriptBox["x", "j"]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Delta]Cmf", "[", 
         RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[NotEqual]", "j"}], ",", 
          RowBox[{
           FractionBox[
            RowBox[{"\[ScriptCapitalJ]", "[", 
             RowBox[{
              RowBox[{"xlist", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"xlist", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", "\[Mu]i", ",", "Pz", ",", 
              "zs", ",", "Jcoe", ",", "\[Delta]\[Eta]"}], "]"}], 
            RowBox[{"Abs", "[", 
             RowBox[{"xlist", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "]"}]], "\[CapitalDelta]x"}], 
          ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{"\[ScriptCapitalJ]", "[", 
                 RowBox[{
                  RowBox[{"xlist", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ",", 
                  RowBox[{"xlist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", "\[Mu]i", ",", "Pz", 
                  ",", "zs", ",", "Jcoe", ",", "\[Delta]\[Eta]"}], "]"}], 
                RowBox[{"Abs", "[", 
                 RowBox[{"xlist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}]], 
               "\[CapitalDelta]x"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", 
                RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}]}], "-", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{"\[ScriptCapitalJ]", "[", 
                RowBox[{
                 RowBox[{"xlist", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", 
                 RowBox[{"xlist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "\[Mu]i", ",", "Pz", 
                 ",", "zs", ",", "Jcoe", ",", "\[Delta]\[Eta]"}], "]"}], 
               RowBox[{"Abs", "[", 
                RowBox[{"xlist", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}]], "\[CapitalDelta]x"}],
              ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"j", "+", "1"}], ",", 
               RowBox[{"Length", "[", "xlist", "]"}]}], "}"}]}], "]"}], "-", 
           RowBox[{"\[ScriptCapitalJ]LT", "[", 
            RowBox[{
             RowBox[{"xlist", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "\[Mu]i", ",", "Pz", ",", 
             "zs", ",", "L", ",", "Jcoe", ",", "\[Delta]\[Eta]"}], "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"\[Delta]Cmf", "[", 
          RowBox[{"i", ",", "j"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "xlist", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", "xlist", "]"}]}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
