                 RowBox[{"-", "1"}], "+", 
                 FractionBox["L", 
                  RowBox[{"Abs", "[", "x", "]"}]]}], ")"}], "\[Eta]"]}], "-", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "+", 
                FractionBox["L", 
                 RowBox[{"Abs", "[", "x", "]"}]]}], ")"}], "\[Eta]"]}], 
            "\[Eta]"], 
           SuperscriptBox[
            RowBox[{"Abs", "[", "x", "]"}], "\[Eta]"]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xlist"}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Jgen", "[", 
     RowBox[{
     "Jls0_", ",", "JLTls0_", ",", "Jcoe_", ",", "xlist_", ",", "\[Mu]i_", 
      ",", "Pz_", ",", "zs_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[CapitalDelta]x", ",", "L", ",", "nf", ",", "\[Eta]m", ",", "Jls", 
        ",", "\[Delta]\[Eta]", ",", "\[Eta]", ",", "Jlsshift", ",", 
        "Moffdiag", ",", "JLTls", ",", "MLTdiag", ",", "Mdiag"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nf", "=", "3"}], ";", 
       RowBox[{"(*", 
        RowBox[{"Fermion", " ", "flavors"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         SubscriptBox["y", "i"], ",", 
         SubscriptBox["x", "j"]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Jls", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Jcoe", "[", 
             RowBox[{"\[Mu]i", ",", "nf"}], "]"}], "[", 
            RowBox[{"[", "n", "]"}], "]"}], ")"}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", 
            RowBox[{"Length", "[", 
