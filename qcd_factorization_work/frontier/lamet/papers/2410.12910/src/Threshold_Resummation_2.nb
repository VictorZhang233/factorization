Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "The", " ", "matching", " ", "kernel", " ", "to", " ", "calculate", " ", 
     "quasi"}], "-", 
    RowBox[{"PDF", " ", "from", " ", "the", " ", "light"}], "-", 
    RowBox[{"cone", " ", "PDF", "\[IndentingNewLine]", 
     RowBox[{
      OverscriptBox["f", "~"], "[", 
      RowBox[{"y", ",", "Pz"}], "]"}]}]}], "=", 
   RowBox[{"\[Integral]", 
    RowBox[{
     FractionBox[
      RowBox[{"\[DifferentialD]", "x"}], 
      RowBox[{"|", "x", "|"}]], 
     RowBox[{"C", "[", 
      RowBox[{
       FractionBox["y", "x"], ",", 
       FractionBox["\[Mu]", 
        RowBox[{"x", " ", "Pz"}]]}], "]"}], 
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "\[Mu]"}], "]"}]}]}]}], "\[IndentingNewLine]", 
  "*)"}]], "Input",
 CellChangeTimes->{{3.931778682089321*^9, 3.93177874591634*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"86f10e23-c405-4288-8eeb-e1b60caa67de"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Cratio1plusw\[Mu]", "[", 
    RowBox[{"\[Xi]_", ",", "x_", ",", "Pz_", ",", "zs_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"\[Xi]", ">", "1"}], ",", "0", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Xi]", "<", "1"}], "&&", 
        RowBox[{"\[Xi]", ">", "0"}]}], ",", 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"1", "+", 
          SuperscriptBox["\[Xi]", "2"]}], 
         RowBox[{"1", "-", "\[Xi]"}]], ")"}], ",", "0"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cratio1pluswo\[Mu]", "[", 
    RowBox[{"\[Xi]_", ",", "x_", ",", "Pz_", ",", "zs_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"\[Xi]", ">", "1"}], ",", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"1", "+", 
          SuperscriptBox["\[Xi]", "2"], " "}], 
         RowBox[{"1", "-", "\[Xi]"}]], 
        RowBox[{"Log", "[", 
         FractionBox["\[Xi]", 
          RowBox[{"\[Xi]", "-", "1"}]], "]"}]}], "+", "1", "-", 
       FractionBox["3", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Xi]"}], ")"}]}]]}], ")"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Xi]", "<", "1"}], "&&", 
        RowBox[{"\[Xi]", ">", "0"}]}], ",", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"1", "+", 
            SuperscriptBox["\[Xi]", "2"]}], 
           RowBox[{"1", "-", "\[Xi]"}]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Log", "[", 
              SuperscriptBox[
               RowBox[{"(", 
                FractionBox["1", "x"], ")"}], "2"], "]"}]}], "+", 
            RowBox[{"Log", "[", 
             RowBox[{"4", " ", "\[Xi]", 
              RowBox[{"(", 
               RowBox[{"1", "-", "\[Xi]"}], ")"}]}], "]"}], "-", "1"}], 
           ")"}]}], "+", "1", "+", 
         FractionBox["3", 
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Xi]"}], ")"}]}]]}], ")"}], ",", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", 
               SuperscriptBox["\[Xi]", "2"]}], ")"}], " "}], 
            RowBox[{"1", "-", "\[Xi]"}]]}], 
          RowBox[{"Log", "[", 
           FractionBox["\[Xi]", 
            RowBox[{"\[Xi]", "-", "1"}]], "]"}]}], "-", "1", "+", 
         FractionBox["3", 
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Xi]"}], ")"}]}]]}], ")"}]}], "]"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Chybrid1plus", "[", 
    RowBox[{"\[Xi]_", ",", "x_", ",", "Pz_", ",", "zs_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     FractionBox["3", "2"], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"Abs", "[", 
         RowBox[{"1", "-", "\[Xi]"}], "]"}]]}], "+", 
      FractionBox[
       RowBox[{"2", 
        RowBox[{"SinIntegral", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Xi]"}], ")"}], "*", 
          RowBox[{"Abs", "[", 
           RowBox[{"x", "*", "zs", "*", "Pz"}], "]"}]}], "]"}]}], 
       RowBox[{"Pi", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", "\[Xi]"}], ")"}]}]]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.897333167915127*^9, 3.8973332048272686`*^9}, {
  3.897333241676133*^9, 3.8973332609794526`*^9}, {3.897333560046735*^9, 
  3.8973335678443365`*^9}, {3.902927044059568*^9, 3.9029270447116327`*^9}, {
  3.9288568244597626`*^9, 3.928856825083312*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"dee409e8-e4e9-444a-b99f-decfa5669427"],

