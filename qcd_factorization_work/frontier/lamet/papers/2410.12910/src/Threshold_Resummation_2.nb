Cell[BoxData[{
 RowBox[{
  RowBox[{
   SuperscriptBox["H", "h"], "=", 
   RowBox[{
    SubscriptBox["\[Sum]", 
     RowBox[{"n", "=", "0"}]], 
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"m", "=", 
       RowBox[{"2", "n"}]}], "0"], 
     RowBox[{
      SuperscriptBox["\[Alpha]", "n"], 
      SubscriptBox["c", 
       RowBox[{"n", ",", "m"}]], 
      SuperscriptBox["L", "m"]}]}]}]}], ",", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"where", " ", "L"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Log", "[", 
       FractionBox[
        SuperscriptBox["\[Mu]", "2"], 
        RowBox[{"4", 
         SuperscriptBox["pz", "2"]}]], "]"}], " ", "and", " ", 
      SubscriptBox["c", 
       RowBox[{"0", ",", "0"}]]}], "=", "1"}]}], 
   ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    SuperscriptBox["H", "h"], "[", 
    RowBox[{"\[Mu]", ",", "pz"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"H", "[", 
      RowBox[{"\[Mu]", ",", "pz"}], "]"}], 
     RowBox[{"h", "[", 
      RowBox[{"\[Mu]", ",", "zs"}], "]"}]], "=", 
    RowBox[{"1", "+", 
     RowBox[{
      FractionBox[
       RowBox[{"\[Alpha]s", " ", "CF"}], 
       RowBox[{"2", "Pi"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox["L", "2"], "2"]}], "-", "L", "-", "2", "+", 
        FractionBox[
         SuperscriptBox["\[Pi]", "2"], "12"]}], ")"}]}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"\[Alpha]s", " ", "CF"}], 
       RowBox[{"2", "Pi"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["3", "2"], 
         RowBox[{"Log", "[", 
