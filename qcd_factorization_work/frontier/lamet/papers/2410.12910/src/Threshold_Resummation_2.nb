           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{"P\[ScriptCapitalJ]", "[", 
                RowBox[{"S", ",", "a\[CapitalGamma]", ",", "aJ", ",", 
                 RowBox[{"xlist", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", 
                 RowBox[{"xlist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "\[Mu]", ",", "\[Mu]i",
                  ",", "Pz", ",", "zs"}], "]"}], 
               RowBox[{"Abs", "[", 
                RowBox[{"xlist", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}]], "\[CapitalDelta]x"}],
              ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"j", "+", "1"}], ",", 
               RowBox[{"Length", "[", "xlist", "]"}]}], "}"}]}], "]"}], "-", 
           RowBox[{"P\[ScriptCapitalJ]LT", "[", 
            RowBox[{"S", ",", "a\[CapitalGamma]", ",", "aJ", ",", 
             RowBox[{"xlist", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "\[Mu]", ",", "\[Mu]i", 
             ",", "Pz", ",", "zs", ",", "L"}], "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
