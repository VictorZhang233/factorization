Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"DGLAPNLOMGen", ",", "DGLAPNLOx"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9317761346123734`*^9, 3.9317761399993024`*^9}},
 CellLabel->
  "In[103]:=",ExpressionUUID->"f5f7829e-3b90-4ade-97a6-886c6a79f9e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DGLAPNLOMGen", "[", "xlistf_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "pqq", ",", "zz", ",", "nf", ",", "H0", ",", "H2", ",", "H00", ",", 
       "Hm10", ",", "H10", ",", "Pns0", ",", "Pns1", ",", "\[CapitalDelta]x", 
       ",", "ymax", ",", "Mdglapns0", ",", "Mdglapns1"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"arXiv", ":", 
       RowBox[{"hep", "-", 
        RowBox[{"ph", "/", "0403192"}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"pqq", "[", "zz_", "]"}], ":=", 
       FractionBox[
        RowBox[{"1", "+", 
         SuperscriptBox["zz", "2"]}], 
        RowBox[{"1", "-", "zz"}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nf", "=", "3"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"H0", "[", "z_", "]"}], ":=", 
       RowBox[{"Log", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"H2", "[", "z_", "]"}], ":=", 
       RowBox[{"PolyLog", "[", 
        RowBox[{"2", ",", "z"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"H00", "[", "z_", "]"}], ":=", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", "!"}]], 
        SuperscriptBox[
         RowBox[{"Log", "[", "z", "]"}], "2"]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Hm10", "[", "z_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"Log", "[", "z", "]"}], 
         RowBox[{"Log", "[", 
          RowBox[{"1", "+", "z"}], "]"}]}], "+", 
        RowBox[{"PolyLog", "[", 
         RowBox[{"2", ",", 
          RowBox[{"-", "z"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"H10", "[", "z_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Log", "[", "z", "]"}]}], 
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}]}], "-", 
        RowBox[{"PolyLog", "[", 
         RowBox[{"2", ",", "z"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Pns0", "[", "z_", "]"}], ":=", 
       RowBox[{"CF", "*", "2", 
        RowBox[{"pqq", "[", "z", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Pns1", "[", "z_", "]"}], ":=", 
       RowBox[{
        RowBox[{"4", "CA", "*", "CF", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"pqq", "[", "z", "]"}], "*", 
            RowBox[{"(", 
             RowBox[{
              FractionBox["67", "18"], "+", 
              RowBox[{
               FractionBox["11", "6"], 
               RowBox[{"H0", "[", "z", "]"}]}], "-", 
              RowBox[{"Zeta", "[", "2", "]"}], "+", 
              RowBox[{"H00", "[", "z", "]"}]}], ")"}]}], "+", 
           RowBox[{
            RowBox[{"pqq", "[", 
             RowBox[{"-", "z"}], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Zeta", "[", "2", "]"}], "+", 
              RowBox[{"2", "*", 
               RowBox[{"Hm10", "[", "z", "]"}]}], "-", 
              RowBox[{"H00", "[", "z", "]"}]}], ")"}]}], "+", 
           RowBox[{
            FractionBox["14", "3"], 
            RowBox[{"(", 
             RowBox[{"1", "-", "z"}], ")"}]}]}], ")"}]}], "-", 
        RowBox[{"4", "CF", "*", "nf", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"pqq", "[", "z", "]"}], 
            RowBox[{"(", 
             RowBox[{
              FractionBox[
               RowBox[{"H0", "[", "z", "]"}], "3"], "+", 
              FractionBox["5", "9"]}], ")"}]}], "+", 
           FractionBox[
            RowBox[{"2", 
             RowBox[{"(", 
              RowBox[{"1", "-", "z"}], ")"}]}], "3"]}], ")"}]}], "+", 
        RowBox[{"4", 
         SuperscriptBox["CF", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], 
            RowBox[{"pqq", "[", 
             RowBox[{"-", "z"}], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "*", 
               RowBox[{"Hm10", "[", "z", "]"}]}], "-", 
              RowBox[{"H00", "[", "z", "]"}], "+", 
              RowBox[{"Zeta", "[", "2", "]"}]}], ")"}]}], "+", 
           RowBox[{"2", "*", 
            RowBox[{"pqq", "[", "z", "]"}], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"H10", "[", "z", "]"}], "-", 
              FractionBox[
               RowBox[{"3", " ", 
                RowBox[{"H0", "[", "z", "]"}]}], "4"], "+", 
              RowBox[{"H2", "[", "z", "]"}]}], ")"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"z", "+", "1"}], ")"}], "*", 
            RowBox[{"H00", "[", "z", "]"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "z"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"3", 
               FractionBox[
                RowBox[{"H0", "[", "z", "]"}], "2"]}]}], ")"}]}], "-", 
           RowBox[{"H0", "[", "z", "]"}]}], ")"}]}], "+", 
        RowBox[{"16", "CF", 
         RowBox[{"(", 
          RowBox[{"CF", "\[Minus]", 
           FractionBox["CA", "2"]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"pqq", "[", 
             RowBox[{"\[Minus]", "z"}], "]"}], 
            RowBox[{
             StyleBox["(",
              SpanMinSize->1.,
              SpanMaxSize->1.], 
             RowBox[{
              RowBox[{"Zeta", "[", "2", "]"}], "+", 
              RowBox[{"2", 
               RowBox[{"Hm10", "[", "z", "]"}]}], "\[Minus]", 
              RowBox[{"H00", "[", "z", "]"}]}], ")"}]}], "\[Minus]", 
           RowBox[{"2", 
            RowBox[{
             StyleBox["(",
              SpanMinSize->1.,
              SpanMaxSize->1.], 
             RowBox[{"1", "\[Minus]", "z"}], 
             StyleBox[")",
              SpanMinSize->1.,
              SpanMaxSize->1.]}]}], "\[Minus]", 
           RowBox[{
            RowBox[{
             StyleBox["(",
              SpanMinSize->1.,
              SpanMaxSize->1.], 
             RowBox[{"1", "+", "z"}], 
             StyleBox[")",
              SpanMinSize->1.,
              SpanMaxSize->1.]}], 
            RowBox[{
             StyleBox["H0",
              SpanMinSize->1.,
              SpanMaxSize->1.], "[", "z", "]"}]}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"The", " ", "full", " ", "kernel", " ", "is", " ", "2", 
         RowBox[{"(", 
          FractionBox["\[Alpha]s", 
           RowBox[{"4", "Pi"}]], ")"}], "Pns0"}], "+", 
        RowBox[{"2", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["\[Alpha]s", 
            RowBox[{"4", "Pi"}]], ")"}], "2"], "Pns1"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalDelta]x", "=", 
       RowBox[{
        RowBox[{"xlistf", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"xlistf", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ymax", "=", "50"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Mdglapns0", "[", 
        RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "<", "j"}], ",", 
         RowBox[{
          RowBox[{"Pns0", "[", 
           FractionBox[
            RowBox[{"xlistf", "[", 
             RowBox[{"[", "i", "]"}], "]"}], 
            RowBox[{"xlistf", "[", 
             RowBox[{"[", "j", "]"}], "]"}]], "]"}], 
          FractionBox[
           RowBox[{"xlistf", "[", 
            RowBox[{"[", "i", "]"}], "]"}], 
           RowBox[{"xlistf", "[", 
            RowBox[{"[", "j", "]"}], "]"}]], 
          RowBox[{"(", 
           FractionBox["\[CapitalDelta]x", 
            RowBox[{"Abs", "[", 
             RowBox[{"xlistf", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}]], ")"}]}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", ">", "j"}], ",", "0", ",", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Pns0", "[", 
                FractionBox[
                 RowBox[{"xlistf", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], 
                 RowBox[{"xlistf", "[", 
                  RowBox[{"[", "k", "]"}], "]"}]], "]"}], 
               FractionBox[
                RowBox[{"xlistf", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], 
                RowBox[{"xlistf", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]], 
               RowBox[{"(", 
                RowBox[{"-", 
                 FractionBox["\[CapitalDelta]x", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"xlistf", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "]"}]]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"i", "+", "1"}], ",", 
                RowBox[{"Length", "[", "xlistf", "]"}]}], "}"}]}], "]"}], "+", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Pns0", "[", 
                FractionBox[
                 RowBox[{"xlistf", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "y"], "]"}], 
               FractionBox[
                RowBox[{"xlistf", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "y"], 
               RowBox[{"(", 
                RowBox[{"-", 
                 FractionBox["\[CapitalDelta]x", 
                  RowBox[{"Abs", "[", "y", "]"}]]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"y", ",", 
