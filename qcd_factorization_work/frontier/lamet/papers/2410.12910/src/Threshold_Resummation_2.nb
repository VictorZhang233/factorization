        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"\[Eta]m", "=", 
        SuperscriptBox["10", 
         RowBox[{"-", "2"}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Delta]\[Eta]", "=", 
        SuperscriptBox["10", 
         RowBox[{"-", "3"}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Jlsshift", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Eta]", "=", 
            RowBox[{"\[Eta]m", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"n", "-", "2"}], ")"}], "*", "\[Delta]\[Eta]"}]}]}], 
           ";", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox[
               RowBox[{"2", "Pz"}], "\[Mu]i"], ")"}], "\[Eta]"], 
            RowBox[{"Jls0", "[", 
             RowBox[{"[", 
              RowBox[{"n", "+", "1"}], "]"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Moffdiag", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["\[Delta]\[Eta]", "n"]], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], 
            RowBox[{"n", "+", "k"}]], 
           RowBox[{"Binomial", "[", 
            RowBox[{"n", ",", "k"}], "]"}], 
           RowBox[{"Jlsshift", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1", "+", 
              RowBox[{"IntegerPart", "[", 
               FractionBox[
                RowBox[{"4", "-", "n"}], "2"], "]"}]}], "]"}], "]"}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "2"}], ")"}], "n"], 
           RowBox[{"Jls", "[", 
            RowBox[{"[", 
             RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "0", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"JLTls", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Eta]", "=", 
            RowBox[{"\[Eta]m", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"n", "-", "2"}], ")"}], "*", "\[Delta]\[Eta]"}]}]}], 
           ";", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox[
               RowBox[{"2", "Pz"}], "\[Mu]i"], ")"}], "\[Eta]"], 
            RowBox[{"JLTls0", "[", 
             RowBox[{"[", 
              RowBox[{"n", "+", "1"}], "]"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"MLTdiag", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["\[Delta]\[Eta]", "n"]], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], 
            RowBox[{"n", "+", "k"}]], 
           RowBox[{"Binomial", "[", 
            RowBox[{"n", ",", "k"}], "]"}], 
           RowBox[{"JLTls", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1", "+", 
              RowBox[{"IntegerPart", "[", 
               FractionBox[
                RowBox[{"4", "-", "n"}], "2"], "]"}]}], "]"}], "]"}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "2"}], ")"}], "n"], 
           RowBox[{"Jls", "[", 
            RowBox[{"[", 
             RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "0", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Mdiag", "=", 
        RowBox[{"-", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{"Moffdiag", ",", 
             RowBox[{"{", "1", "}"}]}], "]"}], "+", "MLTdiag"}], "]"}]}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Moffdiag", "+", "Mdiag"}]}]}], "\[IndentingNewLine]", "]"}]}],
    "\[IndentingNewLine]"}]}]], "Input",
