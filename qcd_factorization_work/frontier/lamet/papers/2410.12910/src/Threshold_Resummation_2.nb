             RowBox[{"-", "x"}], "]"}]}], ")"}], "2"]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Mu]hls", "[", 
