     RowBox[{"C\[Eta]pm_", ",", "Cdnm_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Eta]m", ",", "\[Delta]\[Eta]", ",", "\[Eta]"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Eta]m", "=", 
        SuperscriptBox["10", 
         RowBox[{"-", "2"}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Delta]\[Eta]", "=", 
        SuperscriptBox["10", 
         RowBox[{"-", "3"}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Eta]", "=", 
           RowBox[{"\[Eta]m", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", "2"}], ")"}], "*", "\[Delta]\[Eta]"}]}]}], 
          ";", 
          RowBox[{"Cdnm", "*", 
           FractionBox[
            RowBox[{
             RowBox[{"Sin", "[", 
              FractionBox[
               RowBox[{"\[Eta]", " ", "\[Pi]"}], "2"], "]"}], 
             RowBox[{"Gamma", "[", 
              RowBox[{"1", "-", "\[Eta]"}], "]"}], 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "EulerGamma"}], " ", "\[Eta]"}]]}], "Pi"], 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"C\[Eta]pm", "+", 
                RowBox[{"IdentityMatrix", "[", 
                 RowBox[{"Length", "[", "xlist", "]"}], "]"}]}], ")"}], 
              "\[Eta]"], "-", 
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"Length", "[", "xlist", "]"}], "]"}]}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "4"}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JLTls0gen", "[", "xlist_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[CapitalDelta]x", ",", "L", ",", "\[Eta]m", ",", "\[Delta]\[Eta]", 
        ",", "\[Eta]"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[CapitalDelta]x", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"xlist", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"xlist", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"L", "=", 
        RowBox[{
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"xlist", "[", 
             RowBox[{"[", 
              RowBox[{"Length", "[", "xlist", "]"}], "]"}], "]"}], "-", 
            RowBox[{"xlist", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "2"], "+", 
         FractionBox["\[CapitalDelta]x", "2"]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Eta]", "=", "\[Delta]\[Eta]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Eta]m", "=", 
        SuperscriptBox["10", 
         RowBox[{"-", "2"}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Delta]\[Eta]", "=", 
        SuperscriptBox["10", 
         RowBox[{"-", "3"}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Eta]", "=", 
           RowBox[{"\[Eta]m", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", "2"}], ")"}], "*", "\[Delta]\[Eta]"}]}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"Sin", "[", 
              FractionBox[
               RowBox[{"\[Eta]", " ", "\[Pi]"}], "2"], "]"}], 
