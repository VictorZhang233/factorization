          RowBox[{"i", "\[NotEqual]", "j"}], ",", 
          RowBox[{"C", "[", 
           RowBox[{
            RowBox[{"xlist", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"xlist", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", "0"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"ParallelTable", "[", 
