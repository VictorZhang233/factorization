     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"nf", "=", "3"}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Fermion", " ", "flavors"}], ",", " ", "GeV"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"\[Xi]", "=", 
       FractionBox["y", "x"]}], ";", 
      RowBox[{"(*", 
       RowBox[{"Momentum", " ", "fraction"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"\[Eta]", "=", 
       RowBox[{"2", 
        RowBox[{"a\[CapitalGamma]", "[", 
         RowBox[{"\[Mu]i", ",", "\[Mu]", ",", "nf"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Re", "[", 
