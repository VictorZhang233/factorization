       RowBox[{"(", "y", ")"}]}], "|", "\[CapitalOmega]"}], 
     "\[RightAngleBracket]"}], "=", 
    RowBox[{"\[Integral]", 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["\[DifferentialD]", "d"], "k"}], 
