PART B: covariant values from the whole-integrand parametric representation
   C_S : Delta = 2*P*Pp*lambda1*lambda2 + lambda1*m2 + lambda2*m2
   C_S : int = 2**(epsilon - 1)*pi*P**(epsilon - 1)*Pp**(epsilon - 1)*gamma(epsilon)/(m2**(2*epsilon)*sin(pi*epsilon))
   C_C1: Delta = -(lambda2 + x_F)*(-2*P*Pp*lambda1 + m2*x_F - m2)
   C_C1: even part of numerator = l^2 + ( -(lambda2 + x_F)*(-2*P*Pp*lambda1 + m2*x_F - m2) ),  equals l^2 + Delta: True
   C_C1: 6*int d^dl (l^2+D)/(-l^2+D)^4 = D^{-1-eps} * (2*epsilon - 1)*gamma(epsilon + 1)
   C_C1: int = -2**(2*epsilon - 1)*pi**(3/2)/(P*Pp*epsilon*m2**epsilon*sin(pi*epsilon)*gamma(1/2 - epsilon))
   C_H : Delta = V^2 = 2*P*Pp*(lambda1 + x_F)*(lambda2 - x_F + 1)
   C_H : 6*int d^dl (-l^2-D)/(-l^2+D)^4 = D^{-1-eps} * -(2*epsilon - 1)*gamma(epsilon + 1)
   C_H : int = 2**(epsilon - 1)*pi**(3/2)*P**(-epsilon - 1)*Pp**(-epsilon - 1)/(epsilon*sin(pi*epsilon)*gamma(1/2 - epsilon))

