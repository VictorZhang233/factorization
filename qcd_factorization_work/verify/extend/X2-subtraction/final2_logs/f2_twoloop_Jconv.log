HH    rays in -1..1: divergent for eps >= 0 (ray (-1, 0, -1, -1, 0, -1)) and for eps <= -1 (ray (-1, 0, 0, -1, 0, -1))  =>  possible convergence for eps in (-1, 0) [candidate rays only]
HH    rays in -2..2: divergent for eps >= 0 (ray (-2, -1, -2, -2, -1, -2)) and for eps <= -1 (ray (-2, -1, -1, -2, -1, -2))  =>  possible convergence for eps in (-1, 0) [candidate rays only]
HC1   rays in -1..1: divergent for ALL eps (ray (1, -1, -1, 1, 0, 0): B = 0, A >= 0)  =>  NO eps with absolute convergence (certificate)
C1C1  rays in -1..1: divergent for ALL eps (ray (0, 0, -1, -1, 1, 1): B = 0, A >= 0)  =>  NO eps with absolute convergence (certificate)
HS    rays in -1..1: divergent for ALL eps (ray (1, -1, 0, 1, -1, 0): B = 0, A >= 0)  =>  NO eps with absolute convergence (certificate)
C1S   rays in -1..1: divergent for ALL eps (ray (1, -1, 0, 0, -1, 1): B = 0, A >= 0)  =>  NO eps with absolute convergence (certificate)
SS    rays in -1..1: divergent for eps >= 1 (ray (-1, 0, -1, -1, -1, -1)) and for eps <= 0 (ray (-1, -1, -1, -1, 0, 0))  =>  possible convergence for eps in (0, 1) [candidate rays only]
SS    rays in -2..2: divergent for eps >= 1 (ray (-2, -1, -2, -2, -2, -2)) and for eps <= 0 (ray (-2, -2, -2, -2, -1, -1))  =>  possible convergence for eps in (0, 1) [candidate rays only]
HC2   rays in -1..1: divergent for ALL eps (ray (1, -1, 0, 0, -1, 1): B = 0, A >= 0)  =>  NO eps with absolute convergence (certificate)
C2C2  rays in -1..1: divergent for ALL eps (ray (0, 0, 1, 1, -1, -1): B = 0, A >= 0)  =>  NO eps with absolute convergence (certificate)
C2S   rays in -1..1: divergent for ALL eps (ray (1, -1, -1, 1, 0, 0): B = 0, A >= 0)  =>  NO eps with absolute convergence (certificate)
