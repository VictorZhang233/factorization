\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces 复 $k^-$ 平面中积分围道（蓝色）的形变与 Landau 奇异性。灰色虚箭头表示外部参数趋近奇异点（或 $\mathrm  {i}0\to 0$）时极点的移动方向。 (a)\nobreakspace  {}两个极点位于实轴同侧（此处都在下半平面）：即使它们趋近实轴，围道也可以向另一侧（上半平面）形变而远离极点，积分保持解析； (b)\nobreakspace  {}两个极点从实轴两侧相向趋近同一点：围道被夹在两者之间，无论向哪一侧形变都要越过一个极点，这就是 Landau 方程所刻画的钳夹（pinch）奇异性； (c)\nobreakspace  {}极点趋近积分区间的端点 $a$：端点不能移动，围道在端点附近无法避开极点，产生端点奇异性。 只有 (b)、(c) 两种情形可能使积分作为外部参数的函数出现奇异性。多维积分中，奇异性要求积分围道（超曲面）在所有方向上都无法形变避开奇点，由此导出 Landau 方程。\relax }}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:landau-pinch}{{1.1}{1}{复 $k^-$ 平面中积分围道（蓝色）的形变与 Landau 奇异性。灰色虚箭头表示外部参数趋近奇异点（或 $\ii 0\to 0$）时极点的移动方向。 (a)~两个极点位于实轴同侧（此处都在下半平面）：即使它们趋近实轴，围道也可以向另一侧（上半平面）形变而远离极点，积分保持解析； (b)~两个极点从实轴两侧相向趋近同一点：围道被夹在两者之间，无论向哪一侧形变都要越过一个极点，这就是 Landau 方程所刻画的钳夹（pinch）奇异性； (c)~极点趋近积分区间的端点 $a$：端点不能移动，围道在端点附近无法避开极点，产生端点奇异性。 只有 (b)、(c) 两种情形可能使积分作为外部参数的函数出现奇异性。多维积分中，奇异性要求积分围道（超曲面）在所有方向上都无法形变避开奇点，由此导出 Landau 方程。\relax }{figure.caption.1}{}}
\newlabel{fig:landau-pinch@cref}{{[figure][1][1]1.1}{[1][1][]1}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces 单圈无质量顶点 $\gamma ^*(q)\to q(p_1)\,\bar  q(p_2)$ 的三个钳夹面（领头区域）。胶子动量 $k$ 由反夸克线流向夸克线， 内夸克线携带 $p_1-k$，内反夸克线携带 $p_2+k$。 (a)\nobreakspace  {}软区 $k\to 0$：两条内费米子线在壳并分别平行于 $p_1$、$p_2$（蓝、橙色区域为两个喷注），零动量胶子（绿色）构成软子图 $S$，硬部分只剩光子顶点； (b)\nobreakspace  {}$k=\alpha p_1$（$0<\alpha <1$）：胶子与内夸克线都在壳且平行于 $p_1$，同属喷注 $J_1$，而内反夸克线的虚度 $(p_2+\alpha p_1)^2=\alpha q^2$ 不小，收缩进硬部分 $H$； (c)\nobreakspace  {}$k=-\beta p_2$（$0<\beta <1$）：与 (b) 镜像对称，胶子携带物理动量 $-k=\beta p_2$ 沿 $p_2$ 方向运动并属于 $J_2$，内夸克线的虚度 $(p_1+\beta p_2)^2=\beta q^2$ 不小。 费米子线上的箭头表示费米子数流向，动量箭头单独画出。\relax }}{2}{figure.caption.2}\protected@file@percent }
\newlabel{fig:vertex-regions}{{1.2}{2}{单圈无质量顶点 $\gamma ^*(q)\to q(p_1)\,\bar q(p_2)$ 的三个钳夹面（领头区域）。胶子动量 $k$ 由反夸克线流向夸克线， 内夸克线携带 $p_1-k$，内反夸克线携带 $p_2+k$。 (a)~软区 $k\to 0$：两条内费米子线在壳并分别平行于 $p_1$、$p_2$（蓝、橙色区域为两个喷注），零动量胶子（绿色）构成软子图 $S$，硬部分只剩光子顶点； (b)~$k=\alpha p_1$（$0<\alpha <1$）：胶子与内夸克线都在壳且平行于 $p_1$，同属喷注 $J_1$，而内反夸克线的虚度 $(p_2+\alpha p_1)^2=\alpha q^2$ 不小，收缩进硬部分 $H$； (c)~$k=-\beta p_2$（$0<\beta <1$）：与 (b) 镜像对称，胶子携带物理动量 $-k=\beta p_2$ 沿 $p_2$ 方向运动并属于 $J_2$，内夸克线的虚度 $(p_1+\beta p_2)^2=\beta q^2$ 不小。 费米子线上的箭头表示费米子数流向，动量箭头单独画出。\relax }{figure.caption.2}{}}
\newlabel{fig:vertex-regions@cref}{{[figure][2][1]1.2}{[1][1][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Coleman--Norton 定理的时空图像（$e^+e^-$ 湮灭，$\gamma ^*$ 静止系，$z$ 轴取为喷注轴，$x^\pm =(t\pm z)/\sqrt  2$）。钳夹面上每条在壳内线 $i$ 对应一段经典自由传播 $\Delta x_i^\mu =\alpha _i l_i^\mu $（$\alpha _i\ge 0$，与该线的 Feynman 参数成正比）；由 Landau 方程，各顶点的时空位置彼此相容。离壳（硬）线的 $\alpha _i=0$，全部收缩为原点处的硬顶点 $H$； 有限动量的无质量共线粒子沿光锥 $x^-=0$（$q$ 喷注）或 $x^+=0$（$\bar  q$ 喷注）以光速运动，并可在同一光线上任意处分裂或重新结合（图中共线胶子与夸克线的夹角是为了看清而夸大的）。 动量为零的软线（绿色长波长线）不受此约束：它在 Landau 方程中的贡献 $\alpha _i l_i^\mu $ 恒为零，与 $\alpha _i$ 无关；物理上它是波长无限长、不能局域化的量子，可以在两个喷注的任意位置被发射或吸收。 绿线只是示意：它连接的两点一般是类空间隔的。\relax }}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:coleman-norton}{{1.3}{2}{Coleman--Norton 定理的时空图像（$e^+e^-$ 湮灭，$\gamma ^*$ 静止系，$z$ 轴取为喷注轴，$x^\pm =(t\pm z)/\sqrt 2$）。钳夹面上每条在壳内线 $i$ 对应一段经典自由传播 $\Delta x_i^\mu =\alpha _i l_i^\mu $（$\alpha _i\ge 0$，与该线的 Feynman 参数成正比）；由 Landau 方程，各顶点的时空位置彼此相容。离壳（硬）线的 $\alpha _i=0$，全部收缩为原点处的硬顶点 $H$； 有限动量的无质量共线粒子沿光锥 $x^-=0$（$q$ 喷注）或 $x^+=0$（$\bar q$ 喷注）以光速运动，并可在同一光线上任意处分裂或重新结合（图中共线胶子与夸克线的夹角是为了看清而夸大的）。 动量为零的软线（绿色长波长线）不受此约束：它在 Landau 方程中的贡献 $\alpha _i l_i^\mu $ 恒为零，与 $\alpha _i$ 无关；物理上它是波长无限长、不能局域化的量子，可以在两个喷注的任意位置被发射或吸收。 绿线只是示意：它连接的两点一般是类空间隔的。\relax }{figure.caption.3}{}}
\newlabel{fig:coleman-norton@cref}{{[figure][3][1]1.3}{[1][1][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces $e^+e^-\to $ 两喷注的约化割图（领头钳夹面）。$H$（振幅）与 $H^\dagger $（共轭振幅）是全部离壳线收缩成的硬点；$J_1$、$J_2$ 是分别沿类光方向 $p_1$、$p_2$ 运动的共线子图（喷注），各以一条物理极化的夸克线与 $H$、$H^\dagger $ 相连，并穿过末态切割（红色虚线）； 软子图 $S$ 只通过胶子与两个喷注相连，不与硬部分相连，其末态粒子同样穿过切割。在 Feynman 规范下喷注与硬部分之间还可以有任意多条标量（纵向）极化的共线胶子， 图中未画出（参见\cref {fig:reduced-dis}）。\relax }}{3}{figure.caption.4}\protected@file@percent }
\newlabel{fig:reduced-ee}{{1.4}{3}{$e^+e^-\to $ 两喷注的约化割图（领头钳夹面）。$H$（振幅）与 $H^\dagger $（共轭振幅）是全部离壳线收缩成的硬点；$J_1$、$J_2$ 是分别沿类光方向 $p_1$、$p_2$ 运动的共线子图（喷注），各以一条物理极化的夸克线与 $H$、$H^\dagger $ 相连，并穿过末态切割（红色虚线）； 软子图 $S$ 只通过胶子与两个喷注相连，不与硬部分相连，其末态粒子同样穿过切割。在 Feynman 规范下喷注与硬部分之间还可以有任意多条标量（纵向）极化的共线胶子， 图中未画出（参见\cref {fig:reduced-dis}）。\relax }{figure.caption.4}{}}
\newlabel{fig:reduced-ee@cref}{{[figure][4][1]1.4}{[1][1][]3}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces 深度非弹散射（DIS）的约化割图。靶强子 $P$ 的共线子图 $A$（蓝色）跨越末态切割，其中的旁观者（靶残余）穿过切割； $H$、$H^\dagger $ 分别是振幅与共轭振幅中的硬子图，与虚光子 $q$ 相连；被击出的夸克形成末态喷注 $J$（沿 $n_B$ 方向）并穿过切割； 软子图 $S$ 以胶子与 $A$、$J$ 相连。$A$ 与 $H$（以及 $H^\dagger $）之间除一条物理极化的夸克线外，还可以有任意多条标量（纵向）极化、 即 $\epsilon ^\mu \propto k^\mu $ 的共线胶子（蓝色，以圆点标记），它们在幂次计数中不受压低，经 Ward 恒等式后成为 PDF 定义中的 Wilson 线（\cref {fig:ward-identity}）。\relax }}{3}{figure.caption.5}\protected@file@percent }
\newlabel{fig:reduced-dis}{{1.5}{3}{深度非弹散射（DIS）的约化割图。靶强子 $P$ 的共线子图 $A$（蓝色）跨越末态切割，其中的旁观者（靶残余）穿过切割； $H$、$H^\dagger $ 分别是振幅与共轭振幅中的硬子图，与虚光子 $q$ 相连；被击出的夸克形成末态喷注 $J$（沿 $n_B$ 方向）并穿过切割； 软子图 $S$ 以胶子与 $A$、$J$ 相连。$A$ 与 $H$（以及 $H^\dagger $）之间除一条物理极化的夸克线外，还可以有任意多条标量（纵向）极化、 即 $\epsilon ^\mu \propto k^\mu $ 的共线胶子（蓝色，以圆点标记），它们在幂次计数中不受压低，经 Ward 恒等式后成为 PDF 定义中的 Wilson 线（\cref {fig:ward-identity}）。\relax }{figure.caption.5}{}}
\newlabel{fig:reduced-dis@cref}{{[figure][5][1]1.5}{[1][1][]3}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.6}{\ignorespaces Drell--Yan 过程 $A+B\to \gamma ^*+X$ 的约化割图（强子张量）。为使两个强子分列左右，切割（红色虚线）画成水平的：下半部为振幅，上半部为共轭振幅。 强子 $A$、$B$ 的共线子图（蓝、橙色）各分为振幅与共轭振幅两部分，二者之间的旁观者（强子残余）线穿过切割；硬子图 $H$、$H^\dagger $ 各由一条来自 $A$ 的夸克线与一条来自 $B$ 的反夸克线相连， 并通过电流插入与 $\gamma ^*$ 相连；软子图 $S$ 以胶子与 $A$、$B$ 相连，在切割两侧均可附着。共线子图与 $H$ 之间的纵向极化胶子未画出（参见\cref {fig:reduced-dis}）； 旁观者之间的 Glauber 交换见\cref {fig:glauber-exchange}。\relax }}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:reduced-dy}{{1.6}{4}{Drell--Yan 过程 $A+B\to \gamma ^*+X$ 的约化割图（强子张量）。为使两个强子分列左右，切割（红色虚线）画成水平的：下半部为振幅，上半部为共轭振幅。 强子 $A$、$B$ 的共线子图（蓝、橙色）各分为振幅与共轭振幅两部分，二者之间的旁观者（强子残余）线穿过切割；硬子图 $H$、$H^\dagger $ 各由一条来自 $A$ 的夸克线与一条来自 $B$ 的反夸克线相连， 并通过电流插入与 $\gamma ^*$ 相连；软子图 $S$ 以胶子与 $A$、$B$ 相连，在切割两侧均可附着。共线子图与 $H$ 之间的纵向极化胶子未画出（参见\cref {fig:reduced-dis}）； 旁观者之间的 Glauber 交换见\cref {fig:glauber-exchange}。\relax }{figure.caption.6}{}}
\newlabel{fig:reduced-dy@cref}{{[figure][6][1]1.6}{[1][1][]4}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.7}{\ignorespaces $(\qopname  \relax o{ln}k^+,\qopname  \relax o{ln}k^-)$ 平面上的动量区域（括号内为 $(k^+,k^-,k_T)/Q$ 的标度，$\lambda \ll 1$；坐标轴以 $\qopname  \relax o{ln}(1/\lambda )$ 为单位）。$A$（$n$）共线区的大分量为 $k^+$，$B$（$\bar  n$）共线区的大分量为 $k^-$。 等虚度双曲线 $k^+k^-=$ 常数在对数坐标中是斜率为 $-1$ 的直线：共线区与软区位于同一条双曲线 $k^+k^-\sim \lambda ^2Q^2$ 上，彼此只差快度 $y=\frac  12\qopname  \relax o{ln}(k^+/k^-)$； 超软区位于 $k^+k^-\sim \lambda ^4Q^2$。Glauber 区由 $|k^+k^-|\ll k_T^2$ 定义：阴影为 $k_T\sim \lambda Q$ 时满足此条件的区域（通常所说的 Glauber 区是其中 $k^\pm \ll Q$ 的软部分）， 其典型标度 $(\lambda ^2,\lambda ^2,\lambda )$ 在本图中的投影与超软区重合（红框），二者只在 $k_T$ 上不同：Glauber 动量以横动量为主，$k^2\approx -k_T^2$。\relax }}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:momentum-regions}{{1.7}{4}{$(\ln k^+,\ln k^-)$ 平面上的动量区域（括号内为 $(k^+,k^-,k_T)/Q$ 的标度，$\lambda \ll 1$；坐标轴以 $\ln (1/\lambda )$ 为单位）。$A$（$n$）共线区的大分量为 $k^+$，$B$（$\bar n$）共线区的大分量为 $k^-$。 等虚度双曲线 $k^+k^-=$ 常数在对数坐标中是斜率为 $-1$ 的直线：共线区与软区位于同一条双曲线 $k^+k^-\sim \lambda ^2Q^2$ 上，彼此只差快度 $y=\frac 12\ln (k^+/k^-)$； 超软区位于 $k^+k^-\sim \lambda ^4Q^2$。Glauber 区由 $|k^+k^-|\ll k_T^2$ 定义：阴影为 $k_T\sim \lambda Q$ 时满足此条件的区域（通常所说的 Glauber 区是其中 $k^\pm \ll Q$ 的软部分）， 其典型标度 $(\lambda ^2,\lambda ^2,\lambda )$ 在本图中的投影与超软区重合（红框），二者只在 $k_T$ 上不同：Glauber 动量以横动量为主，$k^2\approx -k_T^2$。\relax }{figure.caption.7}{}}
\newlabel{fig:momentum-regions@cref}{{[figure][7][1]1.7}{[1][1][]4}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.8}{\ignorespaces 图示 Ward 恒等式。蓝色螺旋线是标量（纵向）极化的共线胶子（K 胶子，极化 $\propto k^\mu $，以圆点标记），来自 $A$ 共线子图（未画出）； $H$ 的其余外线（入射夸克、出射夸克、光子）都取为在壳的物理粒子（共线近似之后）。 (a)\nobreakspace  {}对 K 胶子在 $H$ 内一切可能附着位置（包括非阿贝尔情形中 $H$ 内的胶子线与鬼场线）求和，等于把它附着到一条沿 $n_B$ 方向的 Wilson 线（双线）上、 再乘以不含该胶子的硬部分 $H_0$（其入射动量为 $p+k$）；Wilson 线是未来指向还是过去指向，取决于 K 胶子附着在 $H$ 的末态线还是初态线上。 阿贝尔理论中这一等式对任意多个 K 光子成立；非阿贝尔理论中对单个 K 胶子成立（BRST 对称性）。 (b)\nobreakspace  {}非阿贝尔理论中有两个及以上 K 胶子时，求和给出按路径次序附着在 Wilson 线上的各项（色矩阵 $t^{a_1}$、$t^{a_2}$ 的次序由附着次序决定，两种次序都出现）， 一般还伴随含鬼场线（带箭头的点线）的附加项；此处只示意其存在，其精确形式与处理见附录 F。\relax }}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:ward-identity}{{1.8}{5}{图示 Ward 恒等式。蓝色螺旋线是标量（纵向）极化的共线胶子（K 胶子，极化 $\propto k^\mu $，以圆点标记），来自 $A$ 共线子图（未画出）； $H$ 的其余外线（入射夸克、出射夸克、光子）都取为在壳的物理粒子（共线近似之后）。 (a)~对 K 胶子在 $H$ 内一切可能附着位置（包括非阿贝尔情形中 $H$ 内的胶子线与鬼场线）求和，等于把它附着到一条沿 $n_B$ 方向的 Wilson 线（双线）上、 再乘以不含该胶子的硬部分 $H_0$（其入射动量为 $p+k$）；Wilson 线是未来指向还是过去指向，取决于 K 胶子附着在 $H$ 的末态线还是初态线上。 阿贝尔理论中这一等式对任意多个 K 光子成立；非阿贝尔理论中对单个 K 胶子成立（BRST 对称性）。 (b)~非阿贝尔理论中有两个及以上 K 胶子时，求和给出按路径次序附着在 Wilson 线上的各项（色矩阵 $t^{a_1}$、$t^{a_2}$ 的次序由附着次序决定，两种次序都出现）， 一般还伴随含鬼场线（带箭头的点线）的附加项；此处只示意其存在，其精确形式与处理见附录 F。\relax }{figure.caption.8}{}}
\newlabel{fig:ward-identity@cref}{{[figure][8][1]1.8}{[1][1][]5}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.9}{\ignorespaces 软胶子的程函（eikonal）近似。软胶子（绿色，动量 $k$ 流入夸克线，色指标 $a$、Lorentz 指标 $\mu $）附着在高能无质量夸克线（动量 $p$）上。 当 $k$ 的各分量都远小于 $p$ 的大分量、且不在 Glauber 区时，分子 $\bar  u(p)\gamma ^\mu ({\mathchoice {{\setbox \z@ \hbox {$\mathsurround \z@ \displaystyle p$}\setbox \tw@ \hbox {$\mathsurround \z@ \displaystyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ -0\ht \tw@ \advance \dimen@ -0\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \textstyle p$}\setbox \tw@ \hbox {$\mathsurround \z@ \textstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ -0\ht \tw@ \advance \dimen@ -0\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \scriptstyle p$}\setbox \tw@ \hbox {$\mathsurround \z@ \scriptstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ -0\ht \tw@ \advance \dimen@ -0\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \scriptscriptstyle p$}\setbox \tw@ \hbox {$\mathsurround \z@ \scriptscriptstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ -0\ht \tw@ \advance \dimen@ -0\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}}-{\mathchoice {{\setbox \z@ \hbox {$\mathsurround \z@ \displaystyle k$}\setbox \tw@ \hbox {$\mathsurround \z@ \displaystyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ --.05\ht \tw@ \advance \dimen@ --.05\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \textstyle k$}\setbox \tw@ \hbox {$\mathsurround \z@ \textstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ --.05\ht \tw@ \advance \dimen@ --.05\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \scriptstyle k$}\setbox \tw@ \hbox {$\mathsurround \z@ \scriptstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ --.05\ht \tw@ \advance \dimen@ --.05\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \scriptscriptstyle k$}\setbox \tw@ \hbox {$\mathsurround \z@ \scriptscriptstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ --.05\ht \tw@ \advance \dimen@ --.05\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}})\to 2p^\mu \bar  u(p)$、分母 $(p-k)^2+\mathrm  {i}0\to -2p\cdot k+\mathrm  {i}0$， 结果只依赖于 $p$ 的方向 $n$（对 $n$ 的标度不变），正是沿 $n$ 方向的 Wilson 线的单胶子 Feynman 规则： (a)\nobreakspace  {}出射夸克对应未来指向的 $W_n[\infty ,0]$，传播子为 $-\mathrm  {i}/(n\cdot k-\mathrm  {i}0)$；(b)\nobreakspace  {}入射夸克对应过去指向的 $W_n[0,-\infty ]$，传播子为 $\mathrm  {i}/(n\cdot k+\mathrm  {i}0)$ （顶点因子均为 $\mathrm  {i}g\,t^a n^\mu $）。Wilson 线上的箭头与被替代的夸克线的费米子数流向一致。\relax }}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:soft-eikonal}{{1.9}{6}{软胶子的程函（eikonal）近似。软胶子（绿色，动量 $k$ 流入夸克线，色指标 $a$、Lorentz 指标 $\mu $）附着在高能无质量夸克线（动量 $p$）上。 当 $k$ 的各分量都远小于 $p$ 的大分量、且不在 Glauber 区时，分子 $\bar u(p)\gamma ^\mu (\sla p-\sla k)\to 2p^\mu \bar u(p)$、分母 $(p-k)^2+\ii 0\to -2p\cdot k+\ii 0$， 结果只依赖于 $p$ 的方向 $n$（对 $n$ 的标度不变），正是沿 $n$ 方向的 Wilson 线的单胶子 Feynman 规则： (a)~出射夸克对应未来指向的 $W_n[\infty ,0]$，传播子为 $-\ii /(n\cdot k-\ii 0)$；(b)~入射夸克对应过去指向的 $W_n[0,-\infty ]$，传播子为 $\ii /(n\cdot k+\ii 0)$ （顶点因子均为 $\ii g\,t^a n^\mu $）。Wilson 线上的箭头与被替代的夸克线的费米子数流向一致。\relax }{figure.caption.9}{}}
\newlabel{fig:soft-eikonal@cref}{{[figure][9][1]1.9}{[1][1][]6}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.10}{\ignorespaces $e^+e^-\to $ 强子总截面的 $\mathcal  {O}\!\left (\alpha _s\right )$ 修正。上排：振幅层次的图——(a)\nobreakspace  {}单圈顶点修正 $\mathcal  M_V$，(b)、(c)\nobreakspace  {}夸克或反夸克辐射一个实胶子 $\mathcal  M_q$、$\mathcal  M_{\bar  q}$ （无质量外线的自能修正在维数正规化中是无标度积分，为零，故未画出）。下排：电磁流关联函数 $\Pi $ 的三个两圈图及其全部切割（虚线上方的数字为被切粒子数）。 (d)\nobreakspace  {}两粒子切割给出 $2\Real  (\mathcal  M_0^*\mathcal  M_V)$（$\mathcal  M_0$ 为 Born 振幅），三粒子切割给出干涉项 $2\Real  (\mathcal  M_q\mathcal  M_{\bar  q}^*)$； (e)、(f)\nobreakspace  {}三粒子切割给出 $|\mathcal  M_q|^2$、$|\mathcal  M_{\bar  q}|^2$，两粒子切割（浅色）对应在壳无质量外线上的自能，在维数正规化中为零。 由切割规则，所有切割之和等于 $2\Imag  \Pi $ 在 $\mathcal  {O}\!\left (\alpha _s\right )$ 的贡献：虚、实两部分各含 $1/\varepsilon ^2$ 极点，其和有限，给出 $R=R_0\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left (\vcenter to\@ne \big@size {}\right .$}\box \z@ }1+\genfrac  {}{}{}134C_F\,\alpha _s/\pi \leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left )\vcenter to\@ne \big@size {}\right .$}\box \z@ }$。\relax }}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:ee-oneloop}{{1.10}{7}{$e^+e^-\to $ 强子总截面的 $\order {\as }$ 修正。上排：振幅层次的图——(a)~单圈顶点修正 $\mathcal M_V$，(b)、(c)~夸克或反夸克辐射一个实胶子 $\mathcal M_q$、$\mathcal M_{\bar q}$ （无质量外线的自能修正在维数正规化中是无标度积分，为零，故未画出）。下排：电磁流关联函数 $\Pi $ 的三个两圈图及其全部切割（虚线上方的数字为被切粒子数）。 (d)~两粒子切割给出 $2\Real (\mathcal M_0^*\mathcal M_V)$（$\mathcal M_0$ 为 Born 振幅），三粒子切割给出干涉项 $2\Real (\mathcal M_q\mathcal M_{\bar q}^*)$； (e)、(f)~三粒子切割给出 $|\mathcal M_q|^2$、$|\mathcal M_{\bar q}|^2$，两粒子切割（浅色）对应在壳无质量外线上的自能，在维数正规化中为零。 由切割规则，所有切割之和等于 $2\Imag \Pi $ 在 $\order {\as }$ 的贡献：虚、实两部分各含 $1/\varepsilon ^2$ 极点，其和有限，给出 $R=R_0\big (1+\tfrac 34C_F\,\as /\pi \big )$。\relax }{figure.caption.10}{}}
\newlabel{fig:ee-oneloop@cref}{{[figure][10][1]1.10}{[1][1][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.11}{\ignorespaces Drell--Yan 过程 $\mathcal  {O}\!\left (\alpha _s\right )$ 修正的部分子图（振幅层次，时间自左向右）。上排为 $q\bar  q$ 道：(a)、(b)\nobreakspace  {}$q(p_1)\,\bar  q(p_2)\to \gamma ^*(q)\,g(k)$ 的两个实辐射图， (c)\nobreakspace  {}单圈顶点修正（与 Born 振幅干涉；无质量外线自能在维数正规化中为零）。下排为 $qg$ 道 $q(p_1)\,g(p_2)\to \gamma ^*(q)\,q(k)$ 的两个图：(d)\nobreakspace  {}$s$ 道（内夸克线动量 $p_1+p_2$），(e)\nobreakspace  {}$t$ 道（内夸克线动量 $p_1-q$） （$\bar  q g$ 道的图由电荷共轭得到）。入射反夸克线上的费米子数箭头背离顶点，动量箭头另行标出。\relax }}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:dy-oneloop}{{1.11}{7}{Drell--Yan 过程 $\order {\as }$ 修正的部分子图（振幅层次，时间自左向右）。上排为 $q\bar q$ 道：(a)、(b)~$q(p_1)\,\bar q(p_2)\to \gamma ^*(q)\,g(k)$ 的两个实辐射图， (c)~单圈顶点修正（与 Born 振幅干涉；无质量外线自能在维数正规化中为零）。下排为 $qg$ 道 $q(p_1)\,g(p_2)\to \gamma ^*(q)\,q(k)$ 的两个图：(d)~$s$ 道（内夸克线动量 $p_1+p_2$），(e)~$t$ 道（内夸克线动量 $p_1-q$） （$\bar q g$ 道的图由电荷共轭得到）。入射反夸克线上的费米子数箭头背离顶点，动量箭头另行标出。\relax }{figure.caption.11}{}}
\newlabel{fig:dy-oneloop@cref}{{[figure][11][1]1.11}{[1][1][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.12}{\ignorespaces Glauber 胶子交换（暗红色）。时间自左向右，硬碰撞 $H$ 之前的交换为初态相互作用，之后为末态相互作用。 (a)\nobreakspace  {}Drell--Yan：强子 $A$、$B$ 的旁观者（强子残余，进入末态 $X_A$、$X_B$）在硬碰撞之前交换 Glauber 胶子（$|k^+k^-|\ll k_T^2$）；来自 $B$ 的入射反夸克线与 $A$ 的旁观者线的交叉不是顶点。 在单个割图中，$A$ 一侧（旁观者线与活动部分子线）的 $k^-$ 极点与 $B$ 一侧的 $k^+$ 极点都分居实轴两侧，围道被钳在 Glauber 区（\cref {fig:glauber-contour}），只有对旁观者的末态切割求和（幺正性）之后才能把围道变形出 Glauber 区； (b)\nobreakspace  {}DIS：被击出的夸克与靶残余在硬碰撞之后交换 Glauber 胶子；对单举 DIS 它们由幺正性相消，而在 SIDIS 的 TMD 中它们组合成未来指向的 Wilson 线， 与 Drell--Yan 中由初态相互作用产生的过去指向 Wilson 线相对照（Sivers 函数因而在两过程间变号）。\relax }}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig:glauber-exchange}{{1.12}{8}{Glauber 胶子交换（暗红色）。时间自左向右，硬碰撞 $H$ 之前的交换为初态相互作用，之后为末态相互作用。 (a)~Drell--Yan：强子 $A$、$B$ 的旁观者（强子残余，进入末态 $X_A$、$X_B$）在硬碰撞之前交换 Glauber 胶子（$|k^+k^-|\ll k_T^2$）；来自 $B$ 的入射反夸克线与 $A$ 的旁观者线的交叉不是顶点。 在单个割图中，$A$ 一侧（旁观者线与活动部分子线）的 $k^-$ 极点与 $B$ 一侧的 $k^+$ 极点都分居实轴两侧，围道被钳在 Glauber 区（\cref {fig:glauber-contour}），只有对旁观者的末态切割求和（幺正性）之后才能把围道变形出 Glauber 区； (b)~DIS：被击出的夸克与靶残余在硬碰撞之后交换 Glauber 胶子；对单举 DIS 它们由幺正性相消，而在 SIDIS 的 TMD 中它们组合成未来指向的 Wilson 线， 与 Drell--Yan 中由初态相互作用产生的过去指向 Wilson 线相对照（Sivers 函数因而在两过程间变号）。\relax }{figure.caption.12}{}}
\newlabel{fig:glauber-exchange@cref}{{[figure][12][1]1.12}{[1][1][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.13}{\ignorespaces 软胶子动量 $k$（固定 $k^+$、$k_T$，$k_T\sim \lambda Q$）在复 $k^-$ 平面上的 Glauber 区分析。阴影带为 Glauber 区 $|k^-|\lesssim k_T^2/Q$； 图中极点来自 $k$ 流经的 $A$ 共线传播子，位于 $|k^-|\sim k_T^2/Q$。约定 $k$ 在附着顶点从 $A$ 子图流出，并取末态旁观者动量 $p_X$ 固定： Glauber 顶点之前的旁观者线 $l_s=p_X+k$ 中 $k$ 与大分量 $l_s^+$ 同向，极点在下半平面；进入 $H$ 的活动部分子线 $l_a=P_A-p_X-k$ 中 $k$ 与 $l_a^+$ 反向，极点在上半平面（$k$ 流入时上下互换）。 $B$ 共线线与胶子传播子本身给出的 $k^-$ 极点位于 $|k^-|\sim Q$，在图外。 (a)\nobreakspace  {}所有 $A$ 共线极点在同一侧：围道可向另一侧变形到 $|k^-|\sim |k_T|$，在那里软近似成立； (b)\nobreakspace  {}旁观者线与活动部分子线的极点分居两侧：围道被钳在 Glauber 区内（Glauber 钳夹）。 仅有 $k^-$ 钳夹并不致命：若胶子另一端的线（如 DIS 中出射的被击出夸克）给出的 $k^+$ 极点都在同一侧，仍可把 $k^+$ 围道变形到 $|k^+|\sim |k_T|$，使该端的程函近似成立； Drell--Yan 中 $B$ 一侧的 $k^+$ 围道同样被钳住，这一钳夹只有在对末态切割求和之后才被消除（\cref {fig:glauber-exchange}）。\relax }}{8}{figure.caption.13}\protected@file@percent }
\newlabel{fig:glauber-contour}{{1.13}{8}{软胶子动量 $k$（固定 $k^+$、$k_T$，$k_T\sim \lambda Q$）在复 $k^-$ 平面上的 Glauber 区分析。阴影带为 Glauber 区 $|k^-|\lesssim k_T^2/Q$； 图中极点来自 $k$ 流经的 $A$ 共线传播子，位于 $|k^-|\sim k_T^2/Q$。约定 $k$ 在附着顶点从 $A$ 子图流出，并取末态旁观者动量 $p_X$ 固定： Glauber 顶点之前的旁观者线 $l_s=p_X+k$ 中 $k$ 与大分量 $l_s^+$ 同向，极点在下半平面；进入 $H$ 的活动部分子线 $l_a=P_A-p_X-k$ 中 $k$ 与 $l_a^+$ 反向，极点在上半平面（$k$ 流入时上下互换）。 $B$ 共线线与胶子传播子本身给出的 $k^-$ 极点位于 $|k^-|\sim Q$，在图外。 (a)~所有 $A$ 共线极点在同一侧：围道可向另一侧变形到 $|k^-|\sim |k_T|$，在那里软近似成立； (b)~旁观者线与活动部分子线的极点分居两侧：围道被钳在 Glauber 区内（Glauber 钳夹）。 仅有 $k^-$ 钳夹并不致命：若胶子另一端的线（如 DIS 中出射的被击出夸克）给出的 $k^+$ 极点都在同一侧，仍可把 $k^+$ 围道变形到 $|k^+|\sim |k_T|$，使该端的程函近似成立； Drell--Yan 中 $B$ 一侧的 $k^+$ 围道同样被钳住，这一钳夹只有在对末态切割求和之后才被消除（\cref {fig:glauber-exchange}）。\relax }{figure.caption.13}{}}
\newlabel{fig:glauber-contour@cref}{{[figure][13][1]1.13}{[1][1][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.14}{\ignorespaces 单圈离壳 Sudakov 形状因子的按区域展开（此处画成类时情形 $\gamma ^*(q)\to q(p_1)\,\bar  q(p_2)$；$p_1$ 沿 $n$（$+$ 方向），$p_2$ 沿 $\bar  n$）。 左：动量走向，外线离壳 $p_1\sim Q(1,\lambda ^2,\lambda )$、$p_2\sim Q(\lambda ^2,1,\lambda )$，标度均按 $(k^+,k^-,k_T)$ 书写。 右：圈动量 $k$ 的四个贡献区域，内线旁标出其虚度的量级：硬区（三条内线均离壳 $\sim Q^2$，整个圈收缩为一点，灰色）、 $1$ 共线区（$k$ 与 $p_1-k$ 构成沿 $p_1$ 的喷注，蓝色；$p_2+k$ 为硬线）、$2$ 共线区（橙色，镜像）、超软区（胶子虚度 $\sim \lambda ^4Q^2$，绿色；两条夸克线虚度 $\sim \lambda ^2Q^2$）。 软区 $k\sim Q(\lambda ,\lambda ,\lambda )$ 给出无标度积分，在维数正规化中为零。各区域单独含有 $1/\varepsilon ^2$、$1/\varepsilon $ 极点：对标量三角形积分，这些极点在求和中完全相消，给出有限的原积分； 对完整的 QCD 顶点，求和后只剩原积分本身的紫外发散，由重整化消去。\relax }}{9}{figure.caption.14}\protected@file@percent }
\newlabel{fig:sudakov-ff}{{1.14}{9}{单圈离壳 Sudakov 形状因子的按区域展开（此处画成类时情形 $\gamma ^*(q)\to q(p_1)\,\bar q(p_2)$；$p_1$ 沿 $n$（$+$ 方向），$p_2$ 沿 $\bar n$）。 左：动量走向，外线离壳 $p_1\sim Q(1,\lambda ^2,\lambda )$、$p_2\sim Q(\lambda ^2,1,\lambda )$，标度均按 $(k^+,k^-,k_T)$ 书写。 右：圈动量 $k$ 的四个贡献区域，内线旁标出其虚度的量级：硬区（三条内线均离壳 $\sim Q^2$，整个圈收缩为一点，灰色）、 $1$ 共线区（$k$ 与 $p_1-k$ 构成沿 $p_1$ 的喷注，蓝色；$p_2+k$ 为硬线）、$2$ 共线区（橙色，镜像）、超软区（胶子虚度 $\sim \lambda ^4Q^2$，绿色；两条夸克线虚度 $\sim \lambda ^2Q^2$）。 软区 $k\sim Q(\lambda ,\lambda ,\lambda )$ 给出无标度积分，在维数正规化中为零。各区域单独含有 $1/\varepsilon ^2$、$1/\varepsilon $ 极点：对标量三角形积分，这些极点在求和中完全相消，给出有限的原积分； 对完整的 QCD 顶点，求和后只剩原积分本身的紫外发散，由重整化消去。\relax }{figure.caption.14}{}}
\newlabel{fig:sudakov-ff@cref}{{[figure][14][1]1.14}{[1][1][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.15}{\ignorespaces SCET 中的两类 Wilson 线。(a)\nobreakspace  {}$n$ 共线胶子（蓝色，领头分量 $\bar  n\cdot A_n\sim \lambda ^0$）附着在 $\bar  n$ 共线（或硬）线上时，使该线离壳 $p^2\sim Q^2$； 把这些离壳模式积掉后，它们附着到从流顶点 $\otimes $ 出发、沿 $\bar  n$ 方向（与 $\bar  n$ 共线反夸克平行）的共线 Wilson 线 $W_n$（由 $\bar  n\cdot A_n$ 构成）上， 流算符因而只通过规范不变组合 $\chi _n=W_n^\dagger \xi _n$ 出现（树图层次的匹配）。 (b)\nobreakspace  {}领头阶共线拉氏量中超软胶子（绿色）只通过 $n\cdot A_{us}$ 与 $n$ 共线夸克耦合；场重定义 $\xi _n=Y_n\xi _n^{(0)}$、$A_n=Y_nA_n^{(0)}Y_n^\dagger $ （$n\cdot D_{us}Y_n=0$）使新场 $\xi _n^{(0)}$、$A_n^{(0)}$ 与超软胶子退耦，超软胶子全部附着在沿 $n$ 方向（与 $n$ 共线夸克平行）的 Wilson 线 $Y_n$ 上。 $Y_n$ 的端点（$-\infty $ 或 $+\infty $）与 $\mathrm  {i}0$ 规定应依粒子是入射还是出射选取（此处为出射夸克）。Wilson 线上的箭头与被替代的费米子线的费米子数流向一致。\relax }}{10}{figure.caption.15}\protected@file@percent }
\newlabel{fig:scet-wilson}{{1.15}{10}{SCET 中的两类 Wilson 线。(a)~$n$ 共线胶子（蓝色，领头分量 $\bar n\cdot A_n\sim \lambda ^0$）附着在 $\bar n$ 共线（或硬）线上时，使该线离壳 $p^2\sim Q^2$； 把这些离壳模式积掉后，它们附着到从流顶点 $\otimes $ 出发、沿 $\bar n$ 方向（与 $\bar n$ 共线反夸克平行）的共线 Wilson 线 $W_n$（由 $\bar n\cdot A_n$ 构成）上， 流算符因而只通过规范不变组合 $\chi _n=W_n^\dagger \xi _n$ 出现（树图层次的匹配）。 (b)~领头阶共线拉氏量中超软胶子（绿色）只通过 $n\cdot A_{us}$ 与 $n$ 共线夸克耦合；场重定义 $\xi _n=Y_n\xi _n^{(0)}$、$A_n=Y_nA_n^{(0)}Y_n^\dagger $ （$n\cdot D_{us}Y_n=0$）使新场 $\xi _n^{(0)}$、$A_n^{(0)}$ 与超软胶子退耦，超软胶子全部附着在沿 $n$ 方向（与 $n$ 共线夸克平行）的 Wilson 线 $Y_n$ 上。 $Y_n$ 的端点（$-\infty $ 或 $+\infty $）与 $\ii 0$ 规定应依粒子是入射还是出射选取（此处为出射夸克）。Wilson 线上的箭头与被替代的费米子线的费米子数流向一致。\relax }{figure.caption.15}{}}
\newlabel{fig:scet-wilson@cref}{{[figure][15][1]1.15}{[1][1][]10}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.16}{\ignorespaces 推力（双喷注）分布在 $\tau =1-T\ll 1$ 时的因子化 $H\times J_n\otimes J_{\bar  n}\otimes S$ 的图示（每个因子都画成割图，红色虚线为末态切割）。 硬函数 $H=|C|^2$ 来自把 QCD 流匹配到 SCET 流的 Wilson 系数 $C(Q^2,\mu )$；喷注函数 $J_n$、$J_{\bar  n}$（对夸克与反夸克是同一个函数）描述虚度 $s_{n,\bar  n}\sim \tau Q^2$ 的共线辐射； 软函数 $S(k,\mu )$ 是沿 $n$、$\bar  n$ 方向的出射（未来指向）Wilson 线 $Y_n$、$Y_{\bar  n}$（后者取反基础表示）的真空矩阵元， 左、右两个顶点分别属于振幅与共轭振幅，软辐射对 $\tau $ 的贡献按半球测量：$k=n\cdot p_{s}^{(n)}+\bar  n\cdot p_{s}^{(\bar  n)}$（上标表示软粒子所在的半球）。 式中省略了相对 $\mathcal  {O}\!\left (\tau \right )$ 的幂次修正。\relax }}{10}{figure.caption.16}\protected@file@percent }
\newlabel{fig:dijet-factorization}{{1.16}{10}{推力（双喷注）分布在 $\tau =1-T\ll 1$ 时的因子化 $H\times J_n\otimes J_{\bar n}\otimes S$ 的图示（每个因子都画成割图，红色虚线为末态切割）。 硬函数 $H=|C|^2$ 来自把 QCD 流匹配到 SCET 流的 Wilson 系数 $C(Q^2,\mu )$；喷注函数 $J_n$、$J_{\bar n}$（对夸克与反夸克是同一个函数）描述虚度 $s_{n,\bar n}\sim \tau Q^2$ 的共线辐射； 软函数 $S(k,\mu )$ 是沿 $n$、$\bar n$ 方向的出射（未来指向）Wilson 线 $Y_n$、$Y_{\bar n}$（后者取反基础表示）的真空矩阵元， 左、右两个顶点分别属于振幅与共轭振幅，软辐射对 $\tau $ 的贡献按半球测量：$k=n\cdot p_{s}^{(n)}+\bar n\cdot p_{s}^{(\bar n)}$（上标表示软粒子所在的半球）。 式中省略了相对 $\order {\tau }$ 的幂次修正。\relax }{figure.caption.16}{}}
\newlabel{fig:dijet-factorization@cref}{{[figure][16][1]1.16}{[1][1][]10}}
