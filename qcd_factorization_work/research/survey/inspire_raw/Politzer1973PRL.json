{"hits": {"hits": [{"id": "81351", "metadata": {"authors": [{"full_name": "Politzer, H.David"}], "publication_info": [{"journal_volume": "30", "page_end": "1349", "year": 1973, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "page_start": "1346", "journal_title": "Phys.Rev.Lett."}, {"pubinfo_freetext": "Also in *Mohapatra, R. N. (Ed.), Lai, C. H. (Ed.): Gauge Theories Of Fundamental Interactions*, 333-336, and in *Rebbi, C. (Ed.): Lattice Gauge Theories and Monte Carlo Simulations*, 237-240"}, {"pubinfo_freetext": "In *Lichtenberg, D. B. (Ed.), Rosen, S. P. (Ed.): Developments In The Quark Theory Of Hadrons, Vol. 1*, 243-246"}], "texkeys": ["Politzer:1973fx"], "abstracts": [{"value": "An explicit calculation shows perturbation theory to be arbitrarily good for the deep Euclidean Green's functions of any Yang-Mills theory and of many Yang-Mills theories with fermions. Under the hypothesis that spontaneous symmetry breakdown is of dynamical origin, these symmetric Green's functions are the asymptotic forms of the physically significant spontaneously broken solution, whose coupling could be strong."}], "control_number": 81351, "dois": [{"value": "10.1103/PhysRevLett.30.1346"}], "titles": [{"title": "Reliable Perturbative Results for Strong Interactions?"}, {"title": "RELIABLE PERTURBATIVE RESULTS FOR STRONG INTERACTIONS?"}], "author_count": 1, "document_type": ["article"]}, "created": "1982-01-01T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/81351?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/81351?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/81351?format=latex-us", "json": "https://inspirehep.net/api/literature/81351?format=json", "json-expanded": "https://inspirehep.net/api/literature/81351?format=json-expanded", "cv": "https://inspirehep.net/api/literature/81351?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A81351"}, "updated":