{"hits": {"hits": [{"updated": "2023-03-06T13:43:20.044705+00:00", "metadata": {"authors": [{"full_name": "Collins, John"}], "texkeys": ["Collins:2007jp"], "abstracts": [{"value": "A previous counterexample to disprove k_T-factorization for H_1+H_2 --> H_3+H_4+X is extended calculationally to one higher order in gluon exchange. The result is that, by explicit calculation, standard k_T-factorization fails for the unpolarized cross-section for the production of hadrons of high transverse momentum in hadron-hadron collisions."}], "control_number": 759565, "titles": [{"title": "2-soft-gluon exchange and factorization breaking"}, {"title": "2-soft-gluon exchange and factorization breaking"}], "arxiv_eprints": [{"value": "0708.4410"}], "author_count": 1, "document_type": ["article"]}, "created": "2007-09-02T00:00:00+00:00", "id": "759565", "links": {"bibtex": "https://inspirehep.net/api/literature/759565?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/759565?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/759565?format=latex-us", "json": "https://inspirehep.net/api/literature/759565?format=json", "json-expanded": "https://inspirehep.net/api/literature/759565?format=json-expanded", "cv": "https://inspirehep.net/api/literature/759565?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A759565"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%200708.4410&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%200708.4410&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%200708.4410&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=