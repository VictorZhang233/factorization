{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Bodwin, Geoffrey T."}, {"full_name": "Brodsky, Stanley J."}, {"full_name": "Lepage, G.Peter"}], "publication_info": [{"journal_volume": "39", "artid": "3287", "year": 1989, "page_start": "3287", "journal_title": "Phys.Rev.D"}], "texkeys": ["Bodwin:1988fs"], "abstracts": [{"value": "We develop a simple, intuitive picture of the effects, in the Drell-Yan process, of initial-state interactions between the projectile and the target. For purposes of illustration, we present specific analyses in terms of a nonrelativistic QED model. However, our principal conclusions are valid in QCD as well. We show that initial-state interactions lead to an increase in the average of the square of the transverse momentum of the lepton pair that is proportional to the length of the target, and we also demonstrate that initial-state interactions can invalidate the parton-model (factorized) form of the cross section unless the beam energy is greater than a scale that grows with the length of the target."}], "control_number": 267085, "dois": [{"value": "10.1103/PhysRevD.39.3287"}], "titles": [{"title": "Effects of Initial State {QCD} Interactions in the {Drell-Yan} Process"}, {"title": "QUANTUM CHROMODYNAMICS"}, {"title": "EFFECTS OF INITIAL STATE QCD INTERACTIONS IN THE DRELL-YAN PROCESS"}], "author_count": 3, "document_type": ["article"]}, "id": "267085", "created": "1989-01-06T00:00:00+00:00", "updated": "2023-03-10T03:54:47.746092+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/267085?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/267085?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/267085?format=latex-us", "json": "https://inspirehep.net/api/literature/267085?format=json", "json-expanded": "https://inspirehep.net/api/literature/267085?format=json-expanded", "cv": "https://inspirehep.net/api/literature/267085?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A267085"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C39%2C3287&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C39%2C3287&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C39%2C3287&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C39%2C3287&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C39%2C3287&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C39%2C3287&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C39%2C3287&size=3&page=1&format=cv"}}