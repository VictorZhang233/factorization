{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Becher, Thomas"}, {"full_name": "Hager, Patrick"}, {"full_name": "Jaskiewicz, Sebastian"}, {"full_name": "Neubert, Matthias"}, {"full_name": "Schwienbacher, Dominik"}], "publication_info": [{"journal_volume": "134", "artid": "061901", "material": "publication", "year": 2025, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "journal_issue": "6", "journal_title": "Phys.Rev.Lett."}], "texkeys": ["Becher:2024kmk"], "abstracts": [{"value": "We analyze the low-energy dynamics of gap-between-jets cross sections at hadron colliders, for which phase factors in the hard amplitudes spoil collinear cancellations and lead to double (\u201csuper-leading\u201d) logarithmic behavior. Based on a method-of-regions analysis, we identify three-loop contributions from perturbative active-active Glauber-gluon exchanges with the right structure to render the cross section consistent with PDF factorization below the gap veto scale. The Glauber contributions we identify are unambiguously defined without regulators beyond dimensional regularization."}, {"value": "We analyze the low-energy dynamics of gap-between-jets cross sections at hadron colliders, for which phase factors in the hard amplitudes spoil collinear cancellations and lead to double (``super-leading'') logarithmic behavior. Based on a method-of-regions analysis, we identify three-loop contributions from perturbative active-active Glauber-gluon exchanges with the right structure to render the cross section consistent with PDF factorization below the gap veto scale. The Glauber contributions we identify are unambiguously defined without regulators beyond dimensional regularization."}], "titles": [{"title": "Factorization Restoration through Glauber Gluons"}, {"title": "Factorization restoration through Glauber gluons"}], "author_count": 5, "imprints": [{"date": "2025-02-10"}], "control_number": 2819755, "dois": [{"value": "10.1103/PhysRevLett.134.061901"}], "arxiv_eprints": [{"value": "2408.10308"}], "document_type": ["article"]}, "created": "2024-08-21T04:23:21.620642+00:00", "updated": "2025-11-20T19:21:17.433633+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/2819755?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/2819755?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/2819755?format=latex-us", "json": "https://inspirehep.net/api/literature/2819755?format=json", "json-expanded": "https://inspirehep.net/api/literature/2819755?format=json-expanded", "cv": "https://inspirehep.net/api/literature/2819755?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2819755"}, "id": "2819755"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22Factorization%20restoration%20through%20Glauber%20gluons%22&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22Factorization%20restoration%20through%20Glauber%20gluons%22&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22Factorization%20restoration%20through%20Glauber%20gluons%22&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22Factorization%20restoration%20through%20Glauber%20gluons%22&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22Factorization%20restoration%20through%20Glauber%20gluons%22&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api