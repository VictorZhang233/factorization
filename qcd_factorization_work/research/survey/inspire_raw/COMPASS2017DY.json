: "Sarkar, S."}, {"full_name": "Savin, I.A."}, {"full_name": "Sawada, T."}, {"full_name": "Sbrizzai, G."}, {"full_name": "Schiavon, P."}, {"full_name": "Schmidt, K."}, {"full_name": "Schmieden, H."}, {"full_name": "Sch\u00f6nning, K."}, {"full_name": "Seder, E."}, {"full_name": "Selyunin, A."}, {"full_name": "Silva, L."}, {"full_name": "Sinha, L."}, {"full_name": "Sirtl, S."}, {"full_name": "Slunecka, M."}, {"full_name": "Smolik, J."}, {"full_name": "Srnka, A."}, {"full_name": "Steffen, D."}, {"full_name": "Stolarski, M."}, {"full_name": "Subrt, O."}, {"full_name": "Sulc, M."}, {"full_name": "Suzuki, H."}, {"full_name": "Szabelski, A."}, {"full_name": "Szameitat, T."}, {"full_name": "Sznajder, P."}, {"full_name": "Tasevsky, M."}, {"full_name": "Tessaro, S."}, {"full_name": "Tessarotto, F."}, {"full_name": "Thiel, A."}, {"full_name": "Tomsa, J."}, {"full_name": "Tosello, F."}, {"full_name": "Tskhay, V."}, {"full_name": "Uhl, S."}, {"full_name": "Vauth, A."}, {"full_name": "Veloso, J."}, {"full_name": "Virius, M."}, {"full_name": "Vondra, J."}, {"full_name": "Wallner, S."}, {"full_name": "Weisrock, T."}, {"full_name": "Wilfert, M."}, {"full_name": "ter Wolbeek, J."}, {"full_name": "Zaremba, K."}, {"full_name": "Zavada, P."}, {"full_name": "Zavertyaev, M."}, {"full_name": "Zemlyanichkina, E."}, {"full_name": "Zhuravlev, N."}, {"full_name": "Ziembicki, M."}], "publication_info": [{"journal_volume": "119", "artid": "112002", "year": 2017, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "journal_issue": "11", "journal_title": "Phys.Rev.Lett."}], "texkeys": ["COMPASS:2017jbv", "Aghasyan:2017jop"], "collaborations": [{"value": "COMPASS"}], "abstracts": [{"value": "The first measurement of transverse-spin-dependent azimuthal asymmetries in the pion-induced Drell-Yan (DY) process is reported. We use the CERN SPS 190\u2009\u2009GeV/c \u03c0- beam and a transversely polarized ammonia target. Three azimuthal asymmetries giving access to different transverse-momentum-dependent (TMD) parton distribution functions (PDFs) are extracted using dimuon events with invariant mass between 4.3\u2009\u2009GeV/c2 and 8.5\u2009\u2009GeV/c2. Within the experimental uncertainties, the observed sign of the Sivers asymmetry is found to be consistent with the fundamental prediction of quantum chromodynamics (QCD) that the Sivers TMD PDFs extracted from DY have a sign opposite to the one extracted from semi-inclusive deep-inelastic scattering (SIDIS) data. We present two other asymmetries originating from the pion Boer-Mulders TMD PDFs convoluted with either the nucleon transversity or pretzelosity TMD PDFs. A recent COMPASS SIDIS measurement was obtained at a hard scale comparable to that of these DY results. This opens the way for possible tests of fundamental QCD universality predictions."}, {"value": "The first measurement of transverse-spin-dependent azimuthal asymmetries in the pion-induced Drell-Yan (DY) process is reported. We use the CERN SPS 190 GeV/$c$, $\\pi^{-}$ beam and a transversely polarized ammonia target. Three azimuthal asymmetries giving access to different transverse-momentum-dependent (TMD) parton distribution functions (PDFs) are extracted using dimuon events with invariant mass between 4.3 GeV/$c^2$ and 8.5 GeV/$c^2$. The observed sign of the Sivers asymmetry is found to be consistent with the fundamental prediction of Quantum Chromodynamics (QCD) that the Sivers TMD PDFs extracted from DY have a sign opposite to the one extracted from semi-inclusive deep-inelastic scattering (SIDIS) data. We present two other asymmetries originating from the pion Boer-Mulders TMD PDFs convoluted with either the nucleon transversity or pretzelosity TMD PDFs. These DY results are obtained at a hard scale comparable to that of a recent COMPASS SIDIS measurement and hence allow unique tests of fundamental QCD universality predictions."}], "titles": [{"title": "First measurement of transverse-spin-dependent azimuthal asymmetries in the Drell-Yan process"}], "author_count": 219, "imprints": [{"date": "2017-09-12"}], "control_number": 1589290, "dois": [{"value": "10.1103/PhysRevLett.119.112002"}], "arxiv_eprints": [{"value": "1704.00488"}], "document_type": ["article"]}, "updated": "2025-02-19T23:04:11.184491+00:00", "id": "1589290", "created": "2017-04-04T00:00:00+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201704.00488&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201704.00488&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201704.00488&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201704.00488&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201704.00488&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201704.00488&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201704.00488&size=3&page=1&format=cv"}}