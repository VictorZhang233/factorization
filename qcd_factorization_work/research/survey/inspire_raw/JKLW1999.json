{"hits": {"hits": [{"updated": "2023-03-09T20:23:06.117713+00:00", "metadata": {"authors": [{"full_name": "Jalilian-Marian, Jamal"}, {"full_name": "Kovner, Alex"}, {"full_name": "Leonidov, Andrei"}, {"full_name": "Weigert, Heribert"}], "publication_info": [{"journal_volume": "59", "artid": "014014", "year": 1998, "journal_title": "Phys.Rev.D"}], "texkeys": ["Jalilian-Marian:1997jhx", "JalilianMarian:1997gr"], "abstracts": [{"value": "We continue the study of the effective action for low $x$ physics based on a Wilson renormalization group approach. We express the full nonlinear renormalization group equation in terms of the average value and the average fluctuation of extra color charge density generated by integrating out gluons with intermediate values of $x$. This form clearly exhibits the nature of the phenomena driving the evolution and should serve as the basis of the analysis of saturation effects at high gluon density at small $x$."}], "control_number": 444380, "dois": [{"value": "10.1103/PhysRevD.59.014014"}], "arxiv_eprints": [{"value": "hep-ph/9706377"}], "titles": [{"title": "The Wilson renormalization group for low x physics: Towards the high density regime"}, {"title": "The Wilson renormalization group for low x physics: Towards the high density regime."}], "author_count": 4, "document_type": ["article"]}, "created": "1997-06-17T00:00:00+00:00", "id": "444380", "links": {"bibtex": "https://inspirehep.net/api/literature/444380?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/444380?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/444380?format=latex-us", "json": "https://inspirehep.net/api/literature/444380?format=json", "json-expanded": "https://inspirehep.net/api/literature/444380?format=json-expanded", "cv": "https://inspirehep.net/api/literature/444380?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A444380"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/litera