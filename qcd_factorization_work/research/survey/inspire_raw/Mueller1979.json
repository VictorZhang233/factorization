{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Mueller, Alfred H."}], "publication_info": [{"journal_volume": "20", "artid": "2037", "year": 1979, "page_start": "2037", "journal_title": "Phys.Rev.D"}], "texkeys": ["Mueller:1979ih"], "abstracts": [{"value": "The asymptotic behavior of the form factor in quantum electrodynamics is calculated in case the photon has a mass. The technique used takes into account all logarithms in q2 but neglects inverse powers of q2. The result is essentially that found by Sudakov. In order to obtain this result the large-n behavior of \u03b3n is obtained."}], "control_number": 7923, "dois": [{"value": "10.1103/PhysRevD.20.2037"}], "titles": [{"title": "On the Asymptotic Behavior of the Sudakov Form-factor"}, {"title": "ON THE ASYMPTOTIC BEHAVIOR OF THE SUDAKOV FORM-FACTOR"}], "author_count": 1, "document_type": ["article"]}, "created": "1979-06-01T00:00:00+00:00", "updated": "2023-03-10T01:18:43.029124+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/7923?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/7923?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/7923?format=latex-us", "json": "https://inspirehep.net/api/literature/7923?format=json", "json-expanded": "https://inspirehep.net/api/literature/7923?format=json-expanded", "cv": "https://inspirehep.net/api/literature/7923?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A7923"}, "id": "7923"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C20%2C2037&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C20%2C2037&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?