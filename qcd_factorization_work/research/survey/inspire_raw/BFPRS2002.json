{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Bauer, Christian W."}, {"full_name": "Fleming, Sean"}, {"full_name": "Pirjol, Dan"}, {"full_name": "Rothstein, Ira Z."}, {"full_name": "Stewart, Iain W."}], "publication_info": [{"journal_volume": "66", "artid": "014017", "year": 2002, "journal_title": "Phys.Rev.D"}], "texkeys": ["Bauer:2002nz"], "abstracts": [{"value": "In this paper we show how gauge symmetries in an effective theory can be used to simplify proofs of factorization formulae in highly energetic hadronic processes. We use the soft-collinear effective theory, generalized to deal with back-to-back jets of collinear particles. Our proofs do not depend on the choice of a particular gauge, and the formalism is applicable to both exclusive and inclusive factorization. As examples we treat the pi-gamma form factor (gamma gamma* -> pi^0), light meson form factors (gamma* M -> M), as well as deep inelastic scattering (e- p -> e- X), Drell-Yan (p pbar -> X l+ l-), and deeply virtual Compton scattering (gamma* p -> gamma(*) p)."}], "control_number": 582803, "dois": [{"value": "10.1103/PhysRevD.66.014017"}], "arxiv_eprints": [{"value": "hep-ph/0202088"}], "titles": [{"title": "Hard scattering factorization from effective field theory"}, {"title": "Hard scattering factorization from effective field theory."}], "author_count": 5, "document_type": ["article"]}, "updated": "2024-11-14T18:19:07.620771+00:00", "created": "2002-02-12T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/582803?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/582803?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/582803?format=latex-us", "json": "https://inspirehep.net/api/literature/582803?format=json", "json-expanded": "https://inspirehep.net/api/literature/582803?format=json-expanded", "cv": "https://inspirehep.net/api/literature/582803?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A582803"}, "id": "582803"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0202088&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0202088&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0202088&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0202088&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0202088&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0202088&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0202088&size=3&page=1&format=cv"}}