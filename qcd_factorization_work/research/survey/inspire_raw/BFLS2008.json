{"hits": {"hits": [{"updated": "2023-03-09T12:37:24.974339+00:00", "metadata": {"authors": [{"full_name": "Bauer, Christian W."}, {"full_name": "Fleming, Sean P."}, {"full_name": "Lee, Christopher"}, {"full_name": "Sterman, George F."}], "publication_info": [{"journal_volume": "78", "artid": "034027", "year": 2008, "journal_title": "Phys.Rev.D"}], "texkeys": ["Bauer:2008dt"], "abstracts": [{"value": "We present a new analysis of two-jet event shape distributions in soft collinear effective theory. Extending previous results, we observe that a large class of such distributions can be expressed in terms of vacuum matrix elements of operators in the effective theory. We match these matrix elements to the full theory in the two-jet limit without assuming factorization of the complete set of hadronic final states into independent sums over partonic collinear and soft states. We also briefly discuss the relationship of this approach to diagrammatic factorization in the full theory."}], "control_number": 778415, "dois": [{"value": "10.1103/PhysRevD.78.034027"}], "arxiv_eprints": [{"value": "0801.4569"}], "titles": [{"title": "Factorization of e+e- Event Shape Distributions with Hadronic Final States in Soft Collinear Effective Theory"}, {"title": "Factorization of e+e- Event Shape Distributions with Hadronic Final States in Soft Collinear Effective Theory"}], "author_count": 4, "document_type": ["article"]}, "created": "2008-01-30T00:00:00+00:00", "id": "778415", "links": {"bibtex": "https://inspirehep.net/api/literature/778415?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/778415?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/778415?format=latex-us", "json": "https://inspirehep.net/api/literature/778415?format=json", "json-expanded": "https://inspirehep.net/api/literature/778415?format=json-expanded", "cv": "https://inspirehep.net/api/literature/778415?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A778415"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%200801.4569&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%200801.4569&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%200801.4569&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%200801.4569&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%200801.4569&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%200801.4569&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%200801.4569&size=3&page=1&format=cv"}}