{"hits": {"hits": [{"created": "1981-01-01T00:00:00+00:00", "id": "10172", "links": {"bibtex": "https://inspirehep.net/api/literature/10172?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/10172?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/10172?format=latex-us", "json": "https://inspirehep.net/api/literature/10172?format=json", "json-expanded": "https://inspirehep.net/api/literature/10172?format=json-expanded", "cv": "https://inspirehep.net/api/literature/10172?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A10172"}, "updated": "2023-03-07T02:07:37.554840+00:00", "metadata": {"publication_info": [{"journal_volume": "185", "page_end": "188", "year": 1981, "page_start": "172", "journal_title": "Nucl.Phys.B"}], "authors": [{"full_name": "Collins, John C."}, {"full_name": "Sterman, George F."}], "texkeys": ["Collins:1981ta"], "imprints": [{"date": "1981"}], "abstracts": [{"value": "The role of partons with momenta much less than the c.m. energy is studied in general n -particle inclusive annihilation cross sections. The cancellation of non-factorizing logarithms associated with these partons is demonstrated in physical gauges. This is seen to be equivalent to cancellation of a set of infrared divergences in the massless limit. Connections with cut vertices and more complicated processes are discussed."}], "control_number": 10172, "dois": [{"value": "10.1016/0550-3213(81)90370-9"}], "titles": [{"title": "Soft Partons in {QCD}"}, {"title": "QUANTUM CHROMODYNAMICS"}, {"title": "SOFT PARTONS IN QCD"}], "author_count": 2, "document_type": ["article"]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C185%2C172&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspireh