{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Qiu, Jian-wei"}, {"full_name": "Sterman, George F."}], "publication_info": [{"journal_volume": "353", "page_end": "164", "year": 1991, "page_start": "137", "journal_title": "Nucl.Phys.B"}], "texkeys": ["Qiu:1990xy"], "imprints": [{"date": "1991"}], "abstracts": [{"value": "We analyze contributions to inclusive hadron-hadron scattering cross sections that decrease as 1/ Q 2 relative to leading behavior, with Q 2 a large momentum transfer. We show why this behavior may be treated in perturbative QCD, in terms of generalized factorization theorems. We suggest that this makes possible a unified of first nonleading power corrections in a large class of processes."}], "control_number": 28107, "dois": [{"value": "10.1016/0550-3213(91)90504-Q"}], "titles": [{"title": "Power corrections to hadronic scattering. 2. Factorization"}], "author_count": 2, "document_type": ["article"]}, "updated": "2023-11-08T12:37:21.569850+00:00", "created": "1990-07-12T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/28107?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/28107?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/28107?format=latex-us", "json": "https://inspirehep.net/api/literature/28107?format=json", "json-expanded": "https://inspirehep.net/api/literature/28107?format=json-expanded", "cv": "https://inspirehep.net/api/literature/28107?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A28107"}, "id": "28107"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C353%2C137&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C353%2C137&size=3&p