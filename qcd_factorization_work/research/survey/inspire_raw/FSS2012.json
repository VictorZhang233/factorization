{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Forshaw, Jeffrey R."}, {"full_name": "Seymour, Michael H."}, {"full_name": "Siodmok, Andrzej"}], "publication_info": [{"journal_volume": "11", "artid": "066", "year": 2012, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1213103"}, "page_start": "066", "journal_title": "JHEP"}], "texkeys": ["Forshaw:2012bi"], "abstracts": [{"value": "We investigate the breakdown of collinear factorization for non-inclusive observables in hadron-hadron collisions. For pure QCD processes, factorization is violated at the three-loop level and it has a structure identical to that encountered previously in the case of super-leading logarithms. In particular, it is driven by the non-commutation of Coulomb/Glauber gluon exchanges with other soft exchanges. Beyond QCD, factorization may be violated at the two-loop level provided that the hard subprocess contains matrix element contributions with phase differences between different colour topologies."}], "control_number": 1120161, "dois": [{"value": "10.1007/JHEP11(2012)066"}], "arxiv_eprints": [{"value": "1206.6363"}], "titles": [{"title": "On the Breaking of Collinear Factorization in QCD"}, {"title": "On the breaking of collinear factorization in QCD"}], "author_count": 3, "document_type": ["article"]}, "created": "2012-06-27T00:00:00+00:00", "updated": "2023-03-06T23:37:35.012231+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/1120161?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/1120161?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/1120161?format=latex-us", "json": "https://inspirehep.net/api/literature/1120161?format=json", "json-expanded": "https://inspirehep.net/api/literature/1120161?format=json-expanded", "cv": "https://inspirehep.net/api/literature/1120161?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1120161"}, "id": "1120161"}], "total": 1}, "links": {"