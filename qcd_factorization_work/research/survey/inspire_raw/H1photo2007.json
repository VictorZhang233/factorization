skov, V."}, {"full_name": "Specka, Arnd E."}, {"full_name": "Steder, M."}, {"full_name": "Stella, B."}, {"full_name": "Stiewe, J."}, {"full_name": "Stoilov, A."}, {"full_name": "Straumann, U."}, {"full_name": "Sunar, D."}, {"full_name": "Sykora, T."}, {"full_name": "Tchoulakov, V."}, {"full_name": "Thompson, G."}, {"full_name": "Thompson, P.D."}, {"full_name": "Toll, T."}, {"full_name": "Tomasz, F."}, {"full_name": "Traynor, D."}, {"full_name": "Trinh, T.N."}, {"full_name": "Truol, P."}, {"full_name": "Tsakov, I."}, {"full_name": "Tsipolitis, G."}, {"full_name": "Tsurin, I."}, {"full_name": "Turnau, J."}, {"full_name": "Tzamariudaki, E."}, {"full_name": "Urban, K."}, {"full_name": "Usik, A."}, {"full_name": "Utkin, D."}, {"full_name": "Valkarova, A."}, {"full_name": "Vallee, C."}, {"full_name": "Van Mechelen, P."}, {"full_name": "Vargas Trevino, A."}, {"full_name": "Vazdik, Y."}, {"full_name": "Vinokurova, S."}, {"full_name": "Volchinski, V."}, {"full_name": "Wacker, K."}, {"full_name": "Weber, G."}, {"full_name": "Weber, R."}, {"full_name": "Wegener, D."}, {"full_name": "Werner, C."}, {"full_name": "Wessels, M."}, {"full_name": "Wissing, Ch."}, {"full_name": "Wolf, R."}, {"full_name": "Wunsch, E."}, {"full_name": "Xella, S."}, {"full_name": "Yan, W."}, {"full_name": "Yeganov, V."}, {"full_name": "Zacek, J."}, {"full_name": "Zalesak, J."}, {"full_name": "Zhang, Z."}, {"full_name": "Zhelezov, A."}, {"full_name": "Zhokin, A."}, {"full_name": "Zhu, Y.C."}, {"full_name": "Zimmerman, J."}, {"full_name": "Zimmerman, T."}, {"full_name": "Zohrabyan, H."}, {"full_name": "Zomer, F."}], "publication_info": [{"journal_volume": "51", "page_end": "568", "year": 2007, "page_start": "549", "journal_title": "Eur.Phys.J.C"}], "texkeys": ["H1:2007jtx", "Aktas:2007hn"], "collaborations": [{"value": "H1"}], "abstracts": [{"value": "Measurements are presented of differential dijet cross sections in diffractive photoproduction (Q^2&lt;0.01 GeV^2) and deep-inelastic scattering processes (DIS, 4&lt;Q^2&lt;80 GeV^2). The event topology is given by ep-> e X Y, in which the system X, containing at least two jets, is separated from a leading low-mass proton remnant system Y by a large rapidity gap. The dijet cross sections are compared with NLO QCD predictions based on diffractive parton densities previously obtained from a QCD analysis of inclusive diffractive DIS cross sections by H1. In DIS, the dijet data are well described, supporting the validity of QCD factorisation. The diffractive DIS dijet data are more sensitive to the diffractive gluon density at high fractional parton momentum than the measurements of inclusive diffractive DIS. In photoproduction, the predicted dijet cross section has to be multiplied by a factor of approximately 0.5 for both direct and resolved photon interactions to describe the measurements. The ratio of measured dijet cross section to NLO prediction in photoproduction is a factor 0.5+-0.1 smaller than the same ratio in DIS. This suppression is the first clear observation of QCD hard scattering factorisation breaking at HERA. The measurements are also compared to the two soft colour neutralisation models SCI and GAL. The SCI model describes diffractive dijet production in DIS but not in photoproduction. The GAL model fails in both kinematic regions."}], "titles": [{"title": "Tests of QCD factorisation in the diffractive production of dijets in deep-inelastic scattering and photoproduction at HERA"}, {"title": "QUANTUM CHROMODYNAMICS"}, {"title": "FACTORIZATION"}, {"title": "DEEP INELASTIC"}, {"title": "Tests of QCD factorisation in the diffractive production of dijets in deep-inelastic scattering and photoproduction at HERA"}, {"title": "Tests of QCD Factorisation in the Diffractive Production of Dijets in Deep-Inelastic Scattering and Photoproduction at HERA"}], "author_count": 290, "control_number": 746380, "dois": [{"value": "10.1140/epjc/s10052-007-0325-4"}], "arxiv_eprints": [{"value": "hep-ex/0703022"}], "document_type": ["article"]}, "id": "746380"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ex%2F0703022&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ex%2F0703022&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ex%2F0703022&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ex%2F0703022&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ex%2F0703022&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ex%2F0703022&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ex%2F0703022&size=3&page=1&format=cv"}}