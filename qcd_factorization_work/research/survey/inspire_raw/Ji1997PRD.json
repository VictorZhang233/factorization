{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Ji, Xiang-Dong"}], "publication_info": [{"journal_volume": "55", "page_end": "7125", "year": 1997, "page_start": "7114", "journal_title": "Phys.Rev.D"}], "texkeys": ["Ji:1996nm"], "abstracts": [{"value": "We study in QCD the physics of deeply-virtual Compton scattering (DVCS)---the virtual Compton process in the large s and small t kinematic region. We show that DVCS can probe a new type of off-forward parton distributions. We derive an Altarelli-Parisi type of evolution equations for these distributions. We also derive their sum rules in terms of nucleon form-factors of the twist-two quark and gluon operators. In particular, we find that the second sum rule is related to fractions of the nucleon spin carried separately by quarks and gluons. We estimate the cross section for DVCS and compare it with the accompanying Bethe-Heitler process at CEBAF and HERMES kinematics."}], "control_number": 423438, "dois": [{"value": "10.1103/PhysRevD.55.7114"}], "arxiv_eprints": [{"value": "hep-ph/9609381"}], "titles": [{"title": "Deeply virtual Compton scattering"}, {"title": "Deeply-virtual Compton scattering."}, {"title": "Deeply Virtual Compton Scattering"}], "author_count": 1, "document_type": ["article"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/423438?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/423438?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/423438?format=latex-us", "json": "https://inspirehep.net/api/literature/423438?format=json", "json-expanded": "https://inspirehep.net/api/literature/423438?format=json-expanded", "cv": "https://inspirehep.net/api/literature/423438?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A423438"}, "updated": "2023-03-10T08:43:19.023288+00:00", "created": "1996-09-18T00:00:00+00:00", "id": "423438"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcit