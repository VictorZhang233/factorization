{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Bauer, Christian W."}, {"full_name": "Pirjol, Dan"}, {"full_name": "Stewart, Iain W."}], "publication_info": [{"journal_volume": "87", "artid": "201806", "year": 2001, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "journal_title": "Phys.Rev.Lett."}], "texkeys": ["Bauer:2001cu"], "abstracts": [{"value": "We prove that the matrix elements of four fermion operators mediating the decay B^0 -> D^+ \\pi^- and B^- -> D^0 \\pi^- factor into the product of a form factor describing the B -> D transition and a convolution of a short distance coefficient with the nonperturbative pion light-cone wave function. This is shown to all orders in alpha_s, up to corrections suppressed by factors of 1/mb, 1/mc, and 1/E_pi. It is not necessary to assume that the pion state is dominated by the q-qbar Fock state."}], "control_number": 559422, "dois": [{"value": "10.1103/PhysRevLett.87.201806"}], "arxiv_eprints": [{"value": "hep-ph/0107002"}], "titles": [{"title": "A Proof of factorization for B ---> D pi"}, {"title": "A proof of factorization for B --> D pi."}], "author_count": 3, "document_type": ["article"]}, "created": "2001-07-03T00:00:00+00:00", "updated": "2024-11-14T18:19:05.910148+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/559422?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/559422?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/559422?format=latex-us", "json": "https://inspirehep.net/api/literature/559422?format=json", "json-expanded": "https://inspirehep.net/api/literature/559422?format=json-expanded", "cv": "https://inspirehep.net/api/literature/559422?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A559422"}, "id": "559422"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0107002&size=3&page=1&fields=control_number,titles.title,au