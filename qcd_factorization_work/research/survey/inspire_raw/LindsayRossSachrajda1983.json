{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Lindsay, W.W."}, {"full_name": "Ross, D.A."}, {"full_name": "Sachrajda, Christopher T."}], "publication_info": [{"journal_volume": "214", "page_end": "89", "year": 1983, "page_start": "61", "journal_title": "Nucl.Phys.B"}], "texkeys": ["Lindsay:1982gd"], "imprints": [{"date": "1983"}], "abstracts": [{"value": "We present in detail, the QCD calculations of long-distance effects involving the interaction of gluons with a spectator quark. For individual diagrams there are such contributions for the Drell-Yan and deep inelastic processes which are not related by the renormalization group improved Drell-Yan formula. When the contributions from all diagrams are summed, these apparently non-factorizing terms cancel out."}], "control_number": 12706, "dois": [{"value": "10.1016/0550-3213(83)90166-9"}], "titles": [{"title": "On the Cancellation of Long Distance, Nonfactorizing Contributions to the {Drell-Yan} Cross-section"}, {"title": "ON THE CANCELLATION OF LONG DISTANCE, NONFACTORIZING CONTRIBUTIONS TO THE DRELL-YAN CROSS-SECTION"}], "author_count": 3, "document_type": ["article"]}, "id": "12706", "created": "1982-11-01T00:00:00+00:00", "updated": "2023-03-06T19:39:09.640605+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/12706?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/12706?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/12706?format=latex-us", "json": "https://inspirehep.net/api/literature/12706?format=json", "json-expanded": "https://inspirehep.net/api/literature/12706?format=json-expanded", "cv": "https://inspirehep.net/api/literature/12706?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A12706"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C214%2C61&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,ar