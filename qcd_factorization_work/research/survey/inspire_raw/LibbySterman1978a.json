{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Libby, Stephen B."}, {"full_name": "Sterman, George F."}], "publication_info": [{"journal_volume": "18", "artid": "3252", "year": 1978, "page_start": "3252", "journal_title": "Phys.Rev.D"}], "texkeys": ["Libby:1978qf"], "abstracts": [{"value": "Cross sections for jet and lepton-pair production at large transverse momenta are studied in a class of renormalizable field theories including quantum chromodynamics. To all orders in perturbation theory, appropriate moments are seen to factorize short-distance from long-distance dependence in leptoproduction. Scale breaking is governed by the anomalous dimensions of twist-two operators. These results are extended to hadron-hadron scattering for theories where infrared divergences cancel in the sum over soft particle emissions, even in the limit that all particle masses vanish. This cancellation is explicitly demonstrated for totally massless QED."}], "control_number": 130908, "dois": [{"value": "10.1103/PhysRevD.18.3252"}], "titles": [{"title": "Jet and Lepton Pair Production in High-Energy Lepton-Hadron and Hadron-Hadron Scattering"}, {"title": "HADRON HADRON"}], "author_count": 2, "document_type": ["article"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/130908?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/130908?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/130908?format=latex-us", "json": "https://inspirehep.net/api/literature/130908?format=json", "json-expanded": "https://inspirehep.net/api/literature/130908?format=json-expanded", "cv": "https://inspirehep.net/api/literature/130908?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A130908"}, "id": "130908", "created": "1978-07-01T00:00:00+00:00", "updated": "2023-03-07T02:06:34.991059+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C18%2C3252&size=3&pag