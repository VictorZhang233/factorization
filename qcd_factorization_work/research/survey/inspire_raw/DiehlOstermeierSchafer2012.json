{"hits": {"hits": [{"updated": "2023-03-07T02:28:17.605469+00:00", "metadata": {"authors": [{"full_name": "Diehl, Markus"}, {"full_name": "Ostermeier, Daniel"}, {"full_name": "Schafer, Andreas"}], "publication_info": [{"journal_volume": "03", "artid": "089", "year": 2012, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1213103"}, "page_start": "089", "journal_title": "JHEP"}, {"journal_volume": "03", "artid": "001", "material": "erratum", "year": 2016, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1213103"}, "page_start": "001", "journal_title": "JHEP"}], "texkeys": ["Diehl:2011yj"], "abstracts": [{"value": "We perform a detailed investigation of multiple hard interactions in hadron-hadron collisions. We discuss the space-time, spin and color structure of multiple interactions, classify different contributions according to their power behavior and provide several elements required for establishing all-order factorization. This also allows us to analyze the structure of Sudakov logarithms in double hard scattering. We show how multiparton distributions can be constrained by lattice calculations, by connecting them with generalized parton distributions, and by calculating their behavior at large transverse parton momenta."}], "control_number": 944460, "dois": [{"value": "10.1007/JHEP03(2012)089"}, {"value": "10.1007/JHEP03(2016)001"}], "arxiv_eprints": [{"value": "1111.0910"}], "titles": [{"title": "Elements of a theory for multiparton interactions in QCD"}, {"title": "Elements of a theory for multiparton interactions in QCD"}], "author_count": 3, "document_type": ["article"]}, "created": "2011-11-03T00:00:00+00:00", "id": "944460", "links": {"bibtex": "https://inspirehep.net/api/literature/944460?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/944460?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/944460?format=latex-us", "json": "https://inspirehep.net/api/literature/944460?format=json", "json-expanded": "https://inspirehep.net/api/literature/944460?format=json-expanded", "cv": "https://inspirehep.net/api/literature/944460?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A944460"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201111.0910&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201111.0910&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201111.0910&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201111.0910&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201111.0910&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201111.0910&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201111.0910&size=3&page=1&format=cv"}}