{"hits": {"hits": [{"created": "1978-01-01T00:00:00+00:00", "updated": "2023-03-06T23:37:52.164354+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/6171?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/6171?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/6171?format=latex-us", "json": "https://inspirehep.net/api/literature/6171?format=json", "json-expanded": "https://inspirehep.net/api/literature/6171?format=json-expanded", "cv": "https://inspirehep.net/api/literature/6171?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A6171"}, "id": "6171", "metadata": {"authors": [{"full_name": "Sterman, George F."}], "publication_info": [{"journal_volume": "17", "artid": "2789", "year": 1978, "page_start": "2789", "journal_title": "Phys.Rev.D"}], "texkeys": ["Sterman:1978bj"], "abstracts": [{"value": "The cancellation of mass divergences in cut vacuum polarization diagrams is investigated. Ensembles of states are identified, the summation over which produces transition probabilities which are free of mass divergences. States included in these ensembles can be characterized as having a \"jetlike\" structure. The reasoning is extended to a large class of renormalizable field theories, including non-Abelian gauge theories."}], "control_number": 6171, "dois": [{"value": "10.1103/PhysRevD.17.2789"}], "titles": [{"title": "Mass Divergences in Annihilation Processes. 2. Cancellation of Divergences in Cut Vacuum Polarization Diagrams"}, {"title": "MASS DIVERGENCES IN ANNIHILATION PROCESSES. 2. CANCELLATION OF DIVERGENCES IN CUT VACUUM POLARIZATION DIAGRAMS"}], "author_count": 1, "document_type": ["article"]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C17%2C2789&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprint