{"hits": {"hits": [{"updated": "2023-11-08T09:52:37.525754+00:00", "metadata": {"publication_info": [{"journal_volume": "264", "page_end": "620", "year": 1986, "page_start": "588", "journal_title": "Nucl.Phys.B"}, {"pubinfo_freetext": "Florence Univ. - DFF-85-15 (85,REC.AUG.) 56p"}, {"pubinfo_freetext": "Nucl. Phys. B264 ( 1986) 588-620 and Florence Univ. - DFF-85-15 (85,REC.AUG.) 56p"}], "authors": [{"full_name": "Catani, S."}, {"full_name": "Ciafaloni, M."}, {"full_name": "Marchesini, G."}], "texkeys": ["Catani:1985xt"], "imprints": [{"date": "1986"}], "abstracts": [{"value": "The Faddeev-Kulish approach of asymptotic dynamics is used to construct the QCD coherent states at the level of leading and first subleading infrared singularities. Gluon correlations are properly taken into account and an arbitrary number of initial and final partons are considered. The violation of the Bloch-Nordsieck theorem and the cancellation of the Coulomb phase in many-parton initiated processes are conformed. In particular, the non-cancelling terms are given in operator form and are shown to be in general of higher twist type. The physical interpretation and the gauge dependence of the results are also discussed."}], "control_number": 220930, "dois": [{"value": "10.1016/0550-3213(86)90500-6"}], "titles": [{"title": "NONCANCELLING INFRARED DIVERGENCES IN QCD COHERENT STATE"}], "author_count": 3, "document_type": ["article"]}, "created": "1985-01-01T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/220930?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/220930?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/220930?format=latex-us", "json": "https://inspirehep.net/api/literature/220930?format=json", "json-expanded": "https://inspirehep.net/api/literature/220930?format=json-expanded", "cv": "https://inspirehep.net/api/literature/220930?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A220930"}, "id": "220930"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C264%2C588&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C264%2C588&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C264%2C588&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C264%2C588&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C264%2C588&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C264%2C588&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C264%2C588&size=3&page=1&format=cv"}}