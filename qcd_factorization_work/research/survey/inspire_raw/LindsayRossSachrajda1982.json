{"hits": {"hits": [{"updated": "2023-03-10T15:22:26.971798+00:00", "metadata": {"authors": [{"full_name": "Lindsay, W.W."}, {"full_name": "Ross, D.A."}, {"full_name": "Sachrajda, Christopher T."}], "publication_info": [{"journal_volume": "117", "page_end": "108", "year": 1982, "page_start": "105", "journal_title": "Phys.Lett.B"}], "texkeys": ["Lindsay:1982pu"], "imprints": [{"date": "1982"}], "abstracts": [{"value": "We report on a calculation of all two-loop graphs in QCD involving the interactions of virtual gluons with the spectator quark in the process quark + hadron \u2192 lepton pair + anything. Because of the different ie's in the propagators there are contributions from individual diagrams which differ from the corresponding contributions in deep inelastic scattering. We find however that the sum of all these non-factorising terms is zero."}], "control_number": 12181, "dois": [{"value": "10.1016/0370-2693(82)90883-8"}], "titles": [{"title": "Interactions of Spectator Partons in the {Drell-Yan} Process"}, {"title": "INTERACTIONS OF SPECTATOR PARTONS IN THE DRELL-YAN PROCESS"}], "author_count": 3, "document_type": ["article"]}, "created": "1982-06-01T00:00:00+00:00", "id": "12181", "links": {"bibtex": "https://inspirehep.net/api/literature/12181?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/12181?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/12181?format=latex-us", "json": "https://inspirehep.net/api/literature/12181?format=json", "json-expanded": "https://inspirehep.net/api/literature/12181?format=json-expanded", "cv": "https://inspirehep.net/api/literature/12181?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A12181"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Lett.B%2C117%2C105&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.