{"hits": {"hits": [{"created": "1998-06-05T00:00:00+00:00", "metadata": {"authors": [{"full_name": "Collins, John C."}], "publication_info": [{"journal_volume": "58", "artid": "094002", "year": 1998, "journal_title": "Phys.Rev.D"}], "texkeys": ["Collins:1998rz"], "abstracts": [{"value": "A detailed proof of hard scattering factorization is given with the inclusion of heavy quark masses. Although the proof is explicitly given for deep-inelastic scattering, the methods apply more generally The power-suppressed corrections to the factorization formula are uniformly suppressed by a power of \\Lambda/Q, independently of the size of heavy quark masses, M, relative to Q."}], "control_number": 471389, "dois": [{"value": "10.1103/PhysRevD.58.094002"}], "arxiv_eprints": [{"value": "hep-ph/9806259"}], "titles": [{"title": "Hard scattering factorization with heavy quarks: A General treatment"}, {"title": "Hard-scattering factorization with heavy quarks: A general treatment."}, {"title": "Hard-scattering factorization with heavy quarks: A general treatment"}], "author_count": 1, "document_type": ["article"]}, "updated": "2023-03-09T20:13:42.609106+00:00", "id": "471389", "links": {"bibtex": "https://inspirehep.net/api/literature/471389?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/471389?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/471389?format=latex-us", "json": "https://inspirehep.net/api/literature/471389?format=json", "json-expanded": "https://inspirehep.net/api/literature/471389?format=json-expanded", "cv": "https://inspirehep.net/api/literature/471389?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A471389"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9806259&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,impri