{"hits": {"hits": [{"links": {"bibtex": "https://inspirehep.net/api/literature/442782?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/442782?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/442782?format=latex-us", "json": "https://inspirehep.net/api/literature/442782?format=json", "json-expanded": "https://inspirehep.net/api/literature/442782?format=json-expanded", "cv": "https://inspirehep.net/api/literature/442782?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A442782"}, "metadata": {"authors": [{"full_name": "Kidonakis, Nikolaos"}, {"full_name": "Sterman, George F."}], "publication_info": [{"journal_volume": "505", "page_end": "348", "year": 1997, "page_start": "321", "journal_title": "Nucl.Phys.B"}], "texkeys": ["Kidonakis:1997gm"], "abstracts": [{"value": "We resum distributions that are singular at partonic threshold (the elastic limit) in heavy quark production, in terms of logarithmic behavior in moment space. The method may be applied to a variety of cross sections sensitive to the edge of phase space, including transverse momentum distributions. Beyond leading logarithm, dependence on the moment variable is controlled by a matrix renormalization group equation, reflecting the evolution of composite operators that represent the color structure of the underlying hard scattering. At next-to-leading logarithmic accuracy, these evolution equations may be diagonalized, and moment dependence in the cross section is a sum of exponentials. Beyond next-to-leading logarithm, resummation involves matrix-ordering. We give a detailed analysis for the case of heavy quark production by light quark annihilation and gluon fusion."}], "control_number": 442782, "dois": [{"value": "10.1016/S0550-3213(97)00506-3"}], "arxiv_eprints": [{"value": "hep-ph/9705234"}], "titles": [{"title": "Resummation for QCD hard scattering"}, {"title": "QUANTUM CHROMODYNAMICS"}, {"title": "Resummation for QCD hard scattering."}, {"title": "Resummation for QCD Hard Scattering"}], "author_count": 2, "document_type": ["article"]}, "updated": "2023-03-09T18:43:52.317946+00:00", "id": "442782", "created": "1997-05-06T00:00:00+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9705234&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9705234&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9705234&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9705234&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9705234&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9705234&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9705234&size=3&page=1&format=cv"}}