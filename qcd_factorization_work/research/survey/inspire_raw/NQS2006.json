{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Nayak, Gouranga C."}, {"full_name": "Qiu, Jian-Wei"}, {"full_name": "Sterman, George F."}], "publication_info": [{"journal_volume": "74", "artid": "074007", "year": 2006, "journal_title": "Phys.Rev.D"}], "texkeys": ["Nayak:2006fm"], "abstracts": [{"value": "We study the transition of a heavy quark pair from octet to singlet color configurations at next-to-next-to-leading order (NNLO) in heavy quarkonium production. We show that the infrared singularities in this process are consistent with NRQCD factorization to all orders in the heavy quark relative velocity v. This factorization requires the gauge-completed matrix elements that we introduced previously to prove NNLO factorization to order v ^2."}], "control_number": 723335, "dois": [{"value": "10.1103/PhysRevD.74.074007"}], "arxiv_eprints": [{"value": "hep-ph/0608066"}], "titles": [{"title": "NRQCD Factorization and Velocity-dependence of NNLO Poles in Heavy Quarkonium Production"}, {"title": "NONRELATIVISTIC QCD"}, {"title": "NEXT-TO-NEXT-TO-LEADING-ORDER"}, {"title": "QUANTUM CHROMODYNAMICS"}, {"title": "NRQCD Factorization and Velocity-dependence of NNLO Poles in Heavy Quarkonium Production"}], "author_count": 3, "document_type": ["article"]}, "updated": "2023-03-07T01:43:01.227918+00:00", "created": "2006-08-07T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/723335?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/723335?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/723335?format=latex-us", "json": "https://inspirehep.net/api/literature/723335?format=json", "json-expanded": "https://inspirehep.net/api/literature/723335?format=json-expanded", "cv": "https://inspirehep.net/api/literature/723335?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A723335"}, "id": "723335"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostc