{"hits": {"hits": [{"links": {"bibtex": "https://inspirehep.net/api/literature/17408?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/17408?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/17408?format=latex-us", "json": "https://inspirehep.net/api/literature/17408?format=json", "json-expanded": "https://inspirehep.net/api/literature/17408?format=json-expanded", "cv": "https://inspirehep.net/api/literature/17408?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A17408"}, "metadata": {"authors": [{"full_name": "Mueller, Alfred H."}, {"full_name": "Qiu, Jian-wei"}], "publication_info": [{"journal_volume": "268", "page_end": "452", "year": 1986, "page_start": "427", "journal_title": "Nucl.Phys.B"}], "texkeys": ["Mueller:1985wy"], "imprints": [{"date": "1986"}], "abstracts": [{"value": "We determine the recombination probabilities for gluons to go into gluons or into quarks in a low-density limit. A modified Altarelli-Parisi equation expressing this recombination is given. We find recombination is very small compared to normal evolution in all interesting circumstances except that of nuclear shadowing. Thus, for evolution above Q 0 \u2248 2 GeV, the gluon density remains far below saturation except at unusually small values of x ."}], "control_number": 17408, "dois": [{"value": "10.1016/0550-3213(86)90164-1"}], "titles": [{"title": "Gluon Recombination and Shadowing at Small Values of x"}], "author_count": 2, "document_type": ["article"]}, "updated": "2023-03-07T05:41:26.287378+00:00", "id": "17408", "created": "1985-10-01T00:00:00+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C268%2C427&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/liter