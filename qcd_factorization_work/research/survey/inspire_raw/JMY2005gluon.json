{"hits": {"hits": [{"updated": "2023-03-06T16:28:39.388004+00:00", "metadata": {"authors": [{"full_name": "Ji, Xiang-dong"}, {"full_name": "Ma, Jian-Ping"}, {"full_name": "Yuan, Feng"}], "publication_info": [{"journal_volume": "07", "artid": "020", "year": 2005, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1213103"}, "page_start": "020", "journal_title": "JHEP"}], "texkeys": ["Ji:2005nu"], "abstracts": [{"value": "We study transverse-momentum-dependent (TMD) gluon distributions and factorization theorems for the gluon-initiated semi-inclusive processes at hadron colliders. Gauge-invariant TMD gluon distributions are defined, and their relations to the integrated (Feynman) parton distributions are explored when the transverse momentum is large. Through explicit calculations, soft-collinear factorization is verified at one-loop order for scalar particle production. Summation over large double logarithms is made through solving the Collins-Soper equation. We reproduce the known result in the limit that the transverse momentum of the scalar is large."}], "control_number": 677628, "dois": [{"value": "10.1088/1126-6708/2005/07/020"}], "arxiv_eprints": [{"value": "hep-ph/0503015"}], "titles": [{"title": "Transverse-momentum-dependent gluon distributions and semi-inclusive processes at hadron colliders"}, {"title": "SEMIINCLUSIVE"}, {"title": "TRANSVERSE MOMENTUM DEPENDENT"}, {"title": "Transverse-momentum-dependent gluon distributions and semi-inclusive processes at hadron colliders."}], "author_count": 3, "document_type": ["article"]}, "created": "2005-03-02T00:00:00+00:00", "id": "677628", "links": {"bibtex": "https://inspirehep.net/api/literature/677628?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/677628?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/677628?format=latex-us", "json": "https://inspirehep.net/api/literature/677628?format=json", "json-expanded": "https://inspirehep.net/api/literature/677628?form