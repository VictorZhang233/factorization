{"hits": {"hits": [{"created": "2006-02-28T00:00:00+00:00", "metadata": {"publication_info": [{"journal_volume": "97", "artid": "082002", "year": 2006, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "journal_title": "Phys.Rev.Lett."}], "authors": [{"full_name": "Ji, Xiangdong"}, {"full_name": "Qiu, Jian-Wei"}, {"full_name": "Vogelsang, Werner"}, {"full_name": "Yuan, Feng"}], "texkeys": ["Ji:2006ub"], "abstracts": [{"value": "Using Drell-Yan pair production as an example, we explore the relation between two well-known mechanisms for single transverse-spin asymmetries in hard processes: twist-three quark-gluon correlations when the pair's transverse momentum is large, $q_\\perp \\gg \\Lambda_{\\rm QCD}$, and time-reversal-odd and transverse-momentum-dependent parton distributions when $q_\\perp$ is much less than the pair's mass. We find that although the two mechanisms have their own domain of validity, they describe the same physics in the kinematic region where they overlap. This unifies the two mechanisms and imposes an important constraint on phenomenological studies of single spin asymmetries."}], "control_number": 711385, "dois": [{"value": "10.1103/PhysRevLett.97.082002"}], "arxiv_eprints": [{"value": "hep-ph/0602239"}], "titles": [{"title": "A Unified picture for single transverse-spin asymmetries in hard processes"}, {"title": "TRANSVERSE SPIN"}, {"title": "A unified picture for single transverse-spin asymmetries in hard processes."}], "author_count": 4, "document_type": ["article"]}, "id": "711385", "links": {"bibtex": "https://inspirehep.net/api/literature/711385?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/711385?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/711385?format=latex-us", "json": "https://inspirehep.net/api/literature/711385?format=json", "json-expanded": "https://inspirehep.net/api/literature/711385?format=json-expanded", "cv": "https://inspirehep.net/api/literature/711385?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A711385"}, "updated": "2024-05-07T10:31:07.838166+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0602239&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0602239&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0602239&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0602239&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0602239&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0602239&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0602239&size=3&page=1&format=cv"}}