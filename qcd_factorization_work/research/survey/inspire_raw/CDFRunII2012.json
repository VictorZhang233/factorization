Warburton, A."}, {"full_name": "Waters, D."}, {"full_name": "Wester, W.C., III"}, {"full_name": "Whiteson, D."}, {"full_name": "Wicklund, A.B."}, {"full_name": "Wicklund, E."}, {"full_name": "Wilbur, S."}, {"full_name": "Wick, F."}, {"full_name": "Williams, H.H."}, {"full_name": "Wilson, J.S."}, {"full_name": "Wilson, P."}, {"full_name": "Winer, B.L."}, {"full_name": "Wittich, P."}, {"full_name": "Wolbers, S."}, {"full_name": "Wolfe, H."}, {"full_name": "Wright, T."}, {"full_name": "Wu, X."}, {"full_name": "Wu, Z."}, {"full_name": "Yamamoto, K."}, {"full_name": "Yamato, D."}, {"full_name": "Yang, T."}, {"full_name": "Yang, U.K."}, {"full_name": "Yang, Y.C."}, {"full_name": "Yao, W.M."}, {"full_name": "Yeh, G.P."}, {"full_name": "Yi, K."}, {"full_name": "Yoh, J."}, {"full_name": "Yorita, K."}, {"full_name": "Yoshida, T."}, {"full_name": "Yu, G.B."}, {"full_name": "Yu, I."}, {"full_name": "Yu, S.S."}, {"full_name": "Yun, J.C."}, {"full_name": "Zanetti, A."}, {"full_name": "Zeng, Y."}, {"full_name": "Zhou, C."}, {"full_name": "Zucchelli, S."}], "texkeys": ["CDF:2012nhl", "Aaltonen:2012tha"], "collaborations": [{"value": "CDF"}], "abstracts": [{"value": "We report on a study of diffractive dijet production in $\\bar{p}p$ collisions at $\\sqrt{s}=1.96$ TeV using the CDF II detector at the Fermilab Tevatron $\\bar{p}p$ collider. A data sample from 310 pb$^{-1}$ of integrated luminosity collected by triggering on a high transverse energy jet, $E_T^{jet}$, in coincidence with a recoil antiproton detected in a Roman pot spectrometer is used to measure the ratio of single-diffractive to inclusive-dijet event rates as a function of $x^{\\bar p}$ of the interacting parton in the antiproton, the Bjorken-$x$, $x^{\\bar p}_{Bj}$, and a $Q^2\\approx (E_T^{jet})^2$ in the ranges $10^{-3}<x^{\\bar p}_{Bj}<10^{-1}$ and $10^2<Q^2 <10^4$ GeV$^2$, respectively. Results are presented for the region of $\\bar p$-momentum-loss fraction $0.03<\\xi_{\\bar p}<0.09$ and a four-momentum transfer squared $t_{\\bar p}>-4$ GeV$^2$. The $t_{\\bar p}$ dependence is measured as a function of $Q^2$ and $x_{Bj}^{\\bar p}$ and compared with that of inclusive single diffraction dissociation. We find weak $x^{\\bar p}_{Bj}$ and $Q^2$ dependencies in the ratio of single diffractive to inclusive event rates, and no significant $Q^2$ dependence in the diffractive $t_{\\bar p}$ distributions."}], "titles": [{"title": "Diffractive Dijet Production in $\\bar{p}p$ Collisions at $\\sqrt{s}=1.96$ TeV"}, {"title": "Diffractive Dijet Production in Antiproton-Proton Collisions at $\\sqrt{s}$=1.96 TeV"}], "author_count": 476, "control_number": 1118580, "dois": [{"value": "10.1103/PhysRevD.86.032009"}], "arxiv_eprints": [{"value": "1206.3955"}], "document_type": ["article"]}, "created": "2012-06-18T00:00:00+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201206.3955&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201206.3955&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201206.3955&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201206.3955&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201206.3955&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201206.3955&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201206.3955&size=3&