{"hits": {"hits": [{"links": {"bibtex": "https://inspirehep.net/api/literature/200601?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/200601?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/200601?format=latex-us", "json": "https://inspirehep.net/api/literature/200601?format=json", "json-expanded": "https://inspirehep.net/api/literature/200601?format=json-expanded", "cv": "https://inspirehep.net/api/literature/200601?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A200601"}, "metadata": {"authors": [{"full_name": "Gribov, L.V."}, {"full_name": "Levin, E.M."}, {"full_name": "Ryskin, M.G."}], "publication_info": [{"journal_volume": "100", "page_end": "150", "year": 1983, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214494"}, "page_start": "1", "journal_title": "Phys.Rept."}, {"pubinfo_freetext": "Phys. Rep. 100 ( 1983) 1-150"}], "texkeys": ["Gribov:1983ivg", "Gribov:1984tu"], "abstracts": [{"value": "Deep inelastic scattering, large p t particle production in hadron collisions and e + e \u2212 annihilation into hadrons are studied in perturbative QCD in the semihard region of very small x ( x \u2aa1 1) and large Q 2 ( p t 2 ). At small x the parton densities increase rapidly, so that the effects of parton-parton interactions (screenings), that stop the increase of the cross sections near their unitarity limit, and the coherent emission of soft gluons by the global colour charge of whole groups of harder particles, become essential. These effects are studied in detail."}], "control_number": 200601, "dois": [{"value": "10.1016/0370-1573(83)90022-4"}], "titles": [{"title": "Semihard Processes in QCD"}, {"title": "QUANTUM CHROMODYNAMICS"}], "author_count": 3, "document_type": ["article"]}, "updated": "2023-03-07T05:37:38.435521+00:00", "id": "200601", "created": "1984-01-01T00:00:00+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&