{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Banfi, A."}, {"full_name": "Marchesini, G."}, {"full_name": "Smye, G."}], "publication_info": [{"journal_volume": "08", "artid": "006", "year": 2002, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1213103"}, "page_start": "006", "journal_title": "JHEP"}], "texkeys": ["Banfi:2002hw"], "abstracts": [{"value": "We consider interjet observables in hard QCD processes given by the energy flow E_out in a region away from all hard jets. Here the QCD radiation is depleted (E_out << Q), and therefore these observables provide ideal means to study non-perturbative effects. We derive an evolution equation (in the large N_c limit) which resums, for large Q/E_out, all leading terms arising from large angle soft emission (double logarithms are absent). We discuss the analytical features of the result and identify universal and geometry-dependent contributions. Our analysis confirms features found using numerical methods by Dasgupta and Salam."}], "control_number": 588050, "dois": [{"value": "10.1088/1126-6708/2002/08/006"}], "arxiv_eprints": [{"value": "hep-ph/0206076"}], "titles": [{"title": "Away from jet energy flow"}, {"title": "Away-from-jet energy flow."}], "author_count": 3, "document_type": ["article"]}, "created": "2002-06-10T00:00:00+00:00", "updated": "2026-06-15T13:55:43.681742+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/588050?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/588050?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/588050?format=latex-us", "json": "https://inspirehep.net/api/literature/588050?format=json", "json-expanded": "https://inspirehep.net/api/literature/588050?format=json-expanded", "cv": "https://inspirehep.net/api/literature/588050?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A588050"}, "id": "588050"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/litera