{"hits": {"hits": [{"created": "2004-04-23T00:00:00+00:00", "metadata": {"authors": [{"full_name": "Ji, Xiang-dong"}, {"full_name": "Ma, Jian-ping"}, {"full_name": "Yuan, Feng"}], "publication_info": [{"journal_volume": "71", "artid": "034005", "year": 2005, "journal_title": "Phys.Rev.D"}], "texkeys": ["Ji:2004wu"], "abstracts": [{"value": "We demonstrate a factorization formula for semi-inclusive deep-inelastic scattering with hadrons in the current fragmentation region detected at low transverse momentum. To facilitate the factorization, we introduce the transverse-momentum dependent parton distributions and fragmentation functions with gauge links slightly off the light-cone, and with soft-gluon radiations subtracted. We verify the factorization to one-loop order in perturbative quantum chromodynamics and argue that it is valid to all orders in perturbation theory."}], "control_number": 648873, "dois": [{"value": "10.1103/PhysRevD.71.034005"}], "arxiv_eprints": [{"value": "hep-ph/0404183"}], "titles": [{"title": "QCD factorization for semi-inclusive deep-inelastic scattering at low transverse momentum"}, {"title": "QUANTUM CHROMODYNAMICS"}, {"title": "SEMIINCLUSIVE"}, {"title": "DEEP INELASTIC"}, {"title": "QCD factorization for semi-inclusive deep-inelastic scattering at low transverse momentum."}, {"title": "QCD Factorization for Semi-Inclusive Deep-Inelastic Scattering at Low Transverse Momentum"}], "author_count": 3, "document_type": ["article"]}, "updated": "2023-03-07T06:48:41.602730+00:00", "id": "648873", "links": {"bibtex": "https://inspirehep.net/api/literature/648873?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/648873?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/648873?format=latex-us", "json": "https://inspirehep.net/api/literature/648873?format=json", "json-expanded": "https://inspirehep.net/api/literature/648873?format=json-expanded", "cv": "https://inspirehep.net/api/literature/648873?format=cv", "citat