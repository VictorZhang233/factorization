{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Jaffe, R.L."}, {"full_name": "Soldate, M."}], "publication_info": [{"journal_volume": "26", "page_end": "68", "year": 1982, "page_start": "49", "journal_title": "Phys.Rev.D"}], "texkeys": ["Jaffe:1982pm"], "abstracts": [{"value": "The interpretation of observed scaling violations in leptoproduction is complicated by the possible presence of significant higher-twist effects. We refine the machinery of the operator-product expansion sufficiently for a study of twist-4 effects. In particular, we introduce and review the advantages of a special, \"canonical\" basis. We demonstrate that the canonical basis is adequate for the necessary twist-4 perturbative calculations, and calculate the operators' tree-level coefficient functions in electroproduction. Our results establish a framework within which careful analysis of more accurate data can provide information regarding correlations among the constituents of the proton."}], "control_number": 176462, "dois": [{"value": "10.1103/PhysRevD.26.49"}], "titles": [{"title": "Twist Four in Electroproduction: Canonical Operators and Coefficient Functions"}], "author_count": 2, "document_type": ["article"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/176462?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/176462?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/176462?format=latex-us", "json": "https://inspirehep.net/api/literature/176462?format=json", "json-expanded": "https://inspirehep.net/api/literature/176462?format=json-expanded", "cv": "https://inspirehep.net/api/literature/176462?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A176462"}, "id": "176462", "created": "1982-01-01T00:00:00+00:00", "updated": "2023-03-06T13:11:39.815200+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C26%2C49&size=3&page=1&fields=cont