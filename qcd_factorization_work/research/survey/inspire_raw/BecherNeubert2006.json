{"hits": {"hits": [{"updated": "2023-03-10T02:17:02.505564+00:00", "metadata": {"publication_info": [{"journal_volume": "97", "artid": "082001", "year": 2006, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "journal_title": "Phys.Rev.Lett."}], "authors": [{"full_name": "Becher, Thomas"}, {"full_name": "Neubert, Matthias"}], "texkeys": ["Becher:2006nr"], "abstracts": [{"value": "Methods from soft-collinear effective theory are used to perform the threshold resummation of Sudakov logarithms for the deep-inelastic structure function F_2(x,Q^2) in the endpoint region x->1 directly in momentum space. An explicit all-order formula is derived, which expresses the short-distance coefficient function C in the convolution F_2=C*phi_q in terms of Wilson coefficients and anomalous dimensions defined in the effective theory. Contributions associated with the physical scales Q^2 and Q^2(1-x) are separated from non-perturbative hadronic physics in a transparent way. A crucial ingredient to the momentum-space resummation is the exact solution to the integro-differential evolution equation of the jet function, which is derived. The methods developed in this Letter can be applied to many other hard QCD processes."}], "control_number": 715998, "dois": [{"value": "10.1103/PhysRevLett.97.082001"}], "arxiv_eprints": [{"value": "hep-ph/0605050"}], "titles": [{"title": "Threshold resummation in momentum space from effective field theory"}, {"title": "Threshold resummation in momentum space from effective field theory."}], "author_count": 2, "document_type": ["article"]}, "created": "2006-05-04T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/715998?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/715998?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/715998?format=latex-us", "json": "https://inspirehep.net/api/literature/715998?format=json", "json-expanded": "https://inspirehep.net/api/literature/715998?format=json-expanded", "cv": "https://inspirehep.net/api/literature/715998?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A715998"}, "id": "715998"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0605050&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0605050&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0605050&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0605050&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0605050&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0605050&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0605050&size=3&page=1&format=cv"}}