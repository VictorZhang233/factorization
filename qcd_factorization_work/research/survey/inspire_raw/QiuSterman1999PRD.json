{"hits": {"hits": [{"links": {"bibtex": "https://inspirehep.net/api/literature/471725?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/471725?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/471725?format=latex-us", "json": "https://inspirehep.net/api/literature/471725?format=json", "json-expanded": "https://inspirehep.net/api/literature/471725?format=json-expanded", "cv": "https://inspirehep.net/api/literature/471725?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A471725"}, "created": "1998-06-15T00:00:00+00:00", "updated": "2023-03-07T02:25:01.434906+00:00", "metadata": {"authors": [{"full_name": "Qiu, Jian-wei"}, {"full_name": "Sterman, George F."}], "publication_info": [{"journal_volume": "59", "artid": "014004", "year": 1999, "journal_title": "Phys.Rev.D"}], "texkeys": ["Qiu:1998ia"], "abstracts": [{"value": "We analyze single transverse-spin asymmetries for hadronic pion production at large transverse momenta using QCD factorization. In the large $x_F$ region, leading contributions to the asymmetries are naturally produced by twist-3 parton correlation functions that couple quark fields and gluon field strengths. With a simple model for these matrix elements, leading-order asymmetries calculated from QCD are consistent with data on pion production from Fermilab, and can be used to predict single-spin asymmetries at RHIC. We argue that our perturbative calculation for the asymmetries is relevant to pion transverse momenta as low as a few GeV."}], "control_number": 471725, "dois": [{"value": "10.1103/PhysRevD.59.014004"}], "arxiv_eprints": [{"value": "hep-ph/9806356"}], "titles": [{"title": "Single transverse spin asymmetries in hadronic pion production"}, {"title": "Single transverse-spin asymmetries in hadronic pion production."}, {"title": "Single Transverse-Spin Asymmetries in Hadronic Pion Production"}], "author_count": 2, "document_type": ["article"]}, "id": "471725"}], "total": 1}