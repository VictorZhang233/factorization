{"hits": {"hits": [{"links": {"bibtex": "https://inspirehep.net/api/literature/501340?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/501340?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/501340?format=latex-us", "json": "https://inspirehep.net/api/literature/501340?format=json", "json-expanded": "https://inspirehep.net/api/literature/501340?format=json-expanded", "cv": "https://inspirehep.net/api/literature/501340?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A501340"}, "updated": "2023-03-06T13:07:58.697225+00:00", "id": "501340", "created": "1999-06-08T00:00:00+00:00", "metadata": {"publication_info": [{"journal_volume": "61", "artid": "014003", "year": 2000, "journal_title": "Phys.Rev.D"}, {"journal_volume": "64", "artid": "059903", "material": "erratum", "year": 2001, "journal_title": "Phys.Rev.D"}], "authors": [{"full_name": "Nadolsky, Pavel M."}, {"full_name": "Stump, D.R."}, {"full_name": "Yuan, C.P."}], "texkeys": ["Nadolsky:1999kb"], "abstracts": [{"value": "We present a formalism that improves the applicability of perturbative QCD in the current region of semi-inclusive deep inelastic scattering. The formalism is based on all-order resummation of large logarithms arising in the perturbative treatment of hadron multiplicities and energy flows in this region. It is shown that the current region of semi-inclusive DIS is similar to the region of small transverse momenta in vector boson production at hadron colliders. We use this resummation formalism to describe transverse energy flows and charged particle multiplicity measured at the electron-proton collider HERA. We find good agreement between our theoretical results and experimental data for the transverse energy flows."}], "control_number": 501340, "dois": [{"value": "10.1103/PhysRevD.64.059903"}, {"value": "10.1103/PhysRevD.61.014003"}], "arxiv_eprints": [{"value": "hep-ph/9906280"}], "titles": [{"title": "Semiinclusive hadron production at HERA: The Effect of QCD gluon resummation"}, {"title": "QUANTUM CHROMODYNAMICS"}, {"title": "Semi-inclusive hadron production at HERA: The effect of {QCD} gluon resummation"}, {"title": "Semi-Inclusive Hadron Production at HERA: the Effect of QCD Gluon Resummation"}], "author_count": 3, "document_type": ["article"]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9906280&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9906280&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9906280&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9906280&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9906280&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9906280&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9906280&size=3&page=1&format=cv"}}