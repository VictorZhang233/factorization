{"hits": {"hits": [{"updated": "2023-03-09T17:57:41.890087+00:00", "metadata": {"publication_info": [{"journal_volume": "52", "artid": "55", "year": 1977, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214791"}, "page_start": "55", "journal_title": "Commun.Math.Phys."}], "authors": [{"full_name": "Breitenlohner, P."}, {"full_name": "Maison, D."}], "texkeys": ["Breitenlohner:1976te"], "abstracts": [{"value": "In the framework of dimensional renormalization the existence of Green's functions to all orders of perturbation theory is proved for theories with massless particles, provided all terms in the interaction Lagrangian have infrared degree \u03a9\u22674. If the vanishing of masses is enforced by some symmetry and this symmetry is respected by dimensional regularization, Schwinger's action principle holds for these Green's functions as in the massive case."}], "control_number": 3561, "dois": [{"value": "10.1007/BF01609071"}], "titles": [{"title": "Dimensionally Renormalized Green's Functions for Theories with Massless Particles. 2."}], "author_count": 2, "document_type": ["article"]}, "created": "1976-05-01T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/3561?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/3561?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/3561?format=latex-us", "json": "https://inspirehep.net/api/literature/3561?format=json", "json-expanded": "https://inspirehep.net/api/literature/3561?format=json-expanded", "cv": "https://inspirehep.net/api/literature/3561?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A3561"}, "id": "3561"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Commun.Math.Phys.%2C52%2C55&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,