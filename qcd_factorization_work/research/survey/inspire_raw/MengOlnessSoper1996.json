{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Meng, Ruibin"}, {"full_name": "Olness, Fredrick I."}, {"full_name": "Soper, Davison E."}], "publication_info": [{"journal_volume": "54", "page_end": "1935", "year": 1996, "page_start": "1919", "journal_title": "Phys.Rev.D"}], "texkeys": ["Meng:1995yn"], "abstracts": [{"value": "Measurement of the distribution of hadronic energy in the final state in deeply inelastic electron scattering at HERA can provide a good test of our understanding of perturbative QCD. For this purpose, we consider the energy distribution function, which can be computed without needing final state parton fragmentation functions. We compute this distribution function for finite transverse momentum q_T at order alpha_s, and use the results to sum the perturbation series to obtain a result valid for both large and small values of transverse momentum."}], "control_number": 402195, "dois": [{"value": "10.1103/PhysRevD.54.1919"}], "arxiv_eprints": [{"value": "hep-ph/9511311"}], "titles": [{"title": "Semiinclusive deeply inelastic scattering at small q(T)"}, {"title": "Semi-Inclusive Deeply Inelastic Scattering at Small q_T"}], "author_count": 3, "document_type": ["article"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/402195?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/402195?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/402195?format=latex-us", "json": "https://inspirehep.net/api/literature/402195?format=json", "json-expanded": "https://inspirehep.net/api/literature/402195?format=json-expanded", "cv": "https://inspirehep.net/api/literature/402195?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A402195"}, "updated": "2023-03-06T22:33:49.814305+00:00", "created": "1995-11-14T00:00:00+00:00", "id": "402195"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9511311&size=3&page=1&fields=con