{"hits": {"hits": [{"updated": "2023-03-07T01:34:34.592291+00:00", "metadata": {"publication_info": [{"journal_volume": "09", "artid": "128", "year": 2008, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1213103"}, "page_start": "128", "journal_title": "JHEP"}], "authors": [{"full_name": "Forshaw, J.R."}, {"full_name": "Kyrieleis, A."}, {"full_name": "Seymour, M.H."}], "texkeys": ["Forshaw:2008cq"], "abstracts": [{"value": "In a previous paper we reported the discovery of super-leading logarithmic terms in a non-global QCD observable. In this short update we recalculate the first super-leading logarithmic contribution to the 'gaps between jets' cross-section using a colour basis independent notation. This sheds light on the structure and origin of the super-leading terms and allows them to be calculated for gluon scattering processes for the first time."}], "control_number": 792787, "dois": [{"value": "10.1088/1126-6708/2008/09/128"}], "arxiv_eprints": [{"value": "0808.1269"}], "titles": [{"title": "Super-leading logarithms in non-global observables in QCD: Colour basis independent calculation"}, {"title": "color"}, {"title": "Super-leading logarithms in non-global observables in QCD: Colour basis independent calculation"}], "author_count": 3, "document_type": ["article"]}, "created": "2008-08-10T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/792787?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/792787?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/792787?format=latex-us", "json": "https://inspirehep.net/api/literature/792787?format=json", "json-expanded": "https://inspirehep.net/api/literature/792787?format=json-expanded", "cv": "https://inspirehep.net/api/literature/792787?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A792787"}, "id": "792787"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%