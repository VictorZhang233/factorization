{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Kang, Zhong-Bo"}, {"full_name": "Qiu, Jian-Wei"}, {"full_name": "Sterman, George"}], "publication_info": [{"journal_volume": "108", "artid": "102002", "year": 2012, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "journal_title": "Phys.Rev.Lett."}], "texkeys": ["Kang:2011mg"], "abstracts": [{"value": "We present a perturbative QCD factorization formalism for the production of heavy quarkonia of large transverse momentum $p_T$ at collider energies, which includes both the leading power (LP) and next-to-leading power (NLP) contributions to the cross section in the $m_Q^2/p_T^2$ expansion for heavy quark mass $m_Q$. We estimate fragmentation functions in the non-relativistic QCD formalism, and reproduce the bulk of the large enhancement found in explicit NLO calculations in the color singlet model. Heavy quarkonia produced from NLP channels prefer longitudinal polarization."}], "control_number": 926624, "dois": [{"value": "10.1103/PhysRevLett.108.102002"}], "arxiv_eprints": [{"value": "1109.1520"}], "titles": [{"title": "Heavy quarkonium production and polarization"}, {"title": "Heavy quarkonium production and polarization"}], "author_count": 3, "document_type": ["article"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/926624?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/926624?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/926624?format=latex-us", "json": "https://inspirehep.net/api/literature/926624?format=json", "json-expanded": "https://inspirehep.net/api/literature/926624?format=json-expanded", "cv": "https://inspirehep.net/api/literature/926624?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A926624"}, "updated": "2023-03-06T18:51:59.326505+00:00", "created": "2011-09-07T00:00:00+00:00", "id": "926624"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=most