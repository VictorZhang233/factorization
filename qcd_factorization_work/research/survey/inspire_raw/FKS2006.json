{"hits": {"hits": [{"updated": "2023-03-07T01:16:54.847562+00:00", "metadata": {"publication_info": [{"journal_volume": "08", "artid": "059", "year": 2006, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1213103"}, "page_start": "059", "journal_title": "JHEP"}], "authors": [{"full_name": "Forshaw, Jeffrey R."}, {"full_name": "Kyrieleis, A."}, {"full_name": "Seymour, M.H."}], "texkeys": ["Forshaw:2006fk"], "abstracts": [{"value": "We reconsider the calculation of a non-global QCD observable and find the possible breakdown of QCD coherence. This breakdown arises as a result of wide angle soft gluon emission developing a sensitivity to emission at small angles and it leads to the appearance of super-leading logarithms. We use the `gaps between jets' cross-section as a concrete example and illustrate that the new logarithms are intimately connected with the presence of Coulomb gluon contributions. We present some rough estimates of their potential phenomenological significance."}], "control_number": 714255, "dois": [{"value": "10.1088/1126-6708/2006/08/059"}], "arxiv_eprints": [{"value": "hep-ph/0604094"}], "titles": [{"title": "Super-leading logarithms in non-global observables in QCD"}, {"title": "QUANTUM CHROMODYNAMICS"}, {"title": "SUPERLEADING"}, {"title": "NONGLOBAL"}, {"title": "Super-leading logarithms in non-global observables in QCD"}], "author_count": 3, "document_type": ["article"]}, "created": "2006-04-11T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/714255?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/714255?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/714255?format=latex-us", "json": "https://inspirehep.net/api/literature/714255?format=json", "json-expanded": "https://inspirehep.net/api/literature/714255?format=json-expanded", "cv": "https://inspirehep.net/api/literature/714255?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A714255"}, "id": "714255"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0604094&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0604094&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0604094&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0604094&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0604094&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0604094&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F0604094&size=3&page=1&format=cv"}}