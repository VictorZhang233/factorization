{"hits": {"hits": [{"created": "2011-01-04T00:00:00+00:00", "metadata": {"publication_info": [{"journal_volume": "83", "artid": "105005", "year": 2011, "journal_title": "Phys.Rev.D"}], "authors": [{"full_name": "Dominguez, Fabio"}, {"full_name": "Marquet, Cyrille"}, {"full_name": "Xiao, Bo-Wen"}, {"full_name": "Yuan, Feng"}], "texkeys": ["Dominguez:2011wm"], "abstracts": [{"value": "We systematically study dijet production in various processes in the small-$x$ limit and establish an effective $k_t$-factorization for hard processes in a system with dilute probes scattering on a dense target. We find that the well-known Weizs\\'{a}cker-Williams gluon distribution can be directly probed in the quark-antiquark jet correlation in deep inelastic scattering and the dipole gluon distribution can be directly measured in the direct photon-jet correlation in $pA$ collisions. In the large-$N_c$ limit, the unintegrated gluon distributions involved in other different dijet channels in pA collisions are shown to be related to two widely proposed ones: the Weizs\\'{a}cker-Williams gluon distribution and the dipole gluon distribution."}], "control_number": 883101, "dois": [{"value": "10.1103/PhysRevD.83.105005"}], "arxiv_eprints": [{"value": "1101.0715"}], "titles": [{"title": "Universality of Unintegrated Gluon Distributions at small x"}, {"title": "Universality of Unintegrated Gluon Distributions at small x"}], "author_count": 4, "document_type": ["article"]}, "id": "883101", "links": {"bibtex": "https://inspirehep.net/api/literature/883101?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/883101?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/883101?format=latex-us", "json": "https://inspirehep.net/api/literature/883101?format=json", "json-expanded": "https://inspirehep.net/api/literature/883101?format=json-expanded", "cv": "https://inspirehep.net/api/literature/883101?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A883101"}, "updated": "2023-03-07T03:49:44.992859+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201101.0715&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201101.0715&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201101.0715&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201101.0715&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201101.0715&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201101.0715&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201101.0715&size=3&page=1&format=cv"}}