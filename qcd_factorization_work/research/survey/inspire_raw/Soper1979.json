{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Soper, Davison E."}], "publication_info": [{"journal_volume": "43", "artid": "1847", "year": 1979, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "page_start": "1847", "journal_title": "Phys.Rev.Lett."}], "texkeys": ["Soper:1979fq"], "abstracts": [{"value": "It is argued that the parton distribution function PaA(x,k\u2192T;\u03b6) is well defined and useful in quantum chromodynamics. Here \u03b6=(2PA\u00b7n)2(\u2212n2) arises as a variable because of the use of the axial gauge n\u00b7A=0. An approximation for PaA(x,kT;\u03b6) is given which is obtained from an approximate solution of the Bethe-Salpeter equation in the axial-gauge ladder model."}], "control_number": 8294, "dois": [{"value": "10.1103/PhysRevLett.43.1847"}], "titles": [{"title": "Partons and Their Transverse Momenta in {QCD}"}, {"title": "QUANTUM CHROMODYNAMICS"}, {"title": "PARTONS AND THEIR TRANSVERSE MOMENTA IN QCD"}], "author_count": 1, "document_type": ["article"]}, "created": "1979-09-01T00:00:00+00:00", "updated": "2023-03-06T13:43:21.464179+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/8294?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/8294?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/8294?format=latex-us", "json": "https://inspirehep.net/api/literature/8294?format=json", "json-expanded": "https://inspirehep.net/api/literature/8294?format=json-expanded", "cv": "https://inspirehep.net/api/literature/8294?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A8294"}, "id": "8294"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.Lett.%2C43%2C1847&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "http