{"hits": {"hits": [{"links": {"bibtex": "https://inspirehep.net/api/literature/416559?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/416559?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/416559?format=latex-us", "json": "https://inspirehep.net/api/literature/416559?format=json", "json-expanded": "https://inspirehep.net/api/literature/416559?format=json-expanded", "cv": "https://inspirehep.net/api/literature/416559?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A416559"}, "metadata": {"authors": [{"full_name": "Ji, Xiang-Dong"}], "publication_info": [{"journal_volume": "78", "page_end": "613", "year": 1997, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "page_start": "610", "journal_title": "Phys.Rev.Lett."}], "texkeys": ["Ji:1996ek"], "abstracts": [{"value": "I introduce a gauge invariant decomposition of the nucleon spin into quark helicity, quark orbital, and gluon contributions. The total quark (and hence the quark orbital) contribution is shown to be measurable through virtual Compton scattering in a special kinematic region where single quark scattering dominates. This deeply-virtual Compton scattering (DVCS) has much potential to unravel the quark and gluon structure of the nucleon."}], "control_number": 416559, "dois": [{"value": "10.1103/PhysRevLett.78.610"}], "arxiv_eprints": [{"value": "hep-ph/9603249"}], "titles": [{"title": "Gauge-Invariant Decomposition of Nucleon Spin"}, {"title": "Gauge-Invariant Decomposition of Nucleon Spin"}], "author_count": 1, "document_type": ["article"]}, "updated": "2024-05-07T11:09:12.920389+00:00", "id": "416559", "created": "1996-03-08T00:00:00+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9603249&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,do