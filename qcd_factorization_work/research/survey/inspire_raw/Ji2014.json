{"hits": {"hits": [{"links": {"bibtex": "https://inspirehep.net/api/literature/1292804?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/1292804?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/1292804?format=latex-us", "json": "https://inspirehep.net/api/literature/1292804?format=json", "json-expanded": "https://inspirehep.net/api/literature/1292804?format=json-expanded", "cv": "https://inspirehep.net/api/literature/1292804?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1292804"}, "updated": "2026-06-15T10:20:06.486311+00:00", "metadata": {"authors": [{"full_name": "Ji, Xiangdong"}], "publication_info": [{"journal_volume": "57", "page_end": "1412", "year": 2014, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1211797"}, "page_start": "1407", "journal_title": "Sci.China Phys.Mech.Astron."}], "texkeys": ["Ji:2014gla"], "abstracts": [{"value": "Parton physics, when formulated as light-front correlations, are difficult to study non-perturbatively, despite the promise of light-front quantization. Recently an alternative approach to partons have been proposed by re-visiting original Feynman picture of a hadron moving at asymptotically large momentum. Here I formulate the approach in the language of an effective field theory for a large hadron momentum $P$ in lattice QCD, LaMET for short. I show that using this new effective theory, parton properties, including light-front parton wave functions, can be extracted from lattice observables in a systematic expansion of $1/P$, much like that the parton distributions can be extracted from the hard scattering data at momentum scales of a few GeV."}], "titles": [{"title": "Parton Physics from Large-Momentum Effective Field Theory"}], "author_count": 1, "imprints": [{"date": "2014"}], "control_number": 1292804, "dois": [{"value": "10.1007/s11433-014-5492-3"}], "arxiv_eprints": [{"value": "1404.6680"}], "document_type": ["article"]}, "created": "2014-04-29T00:00:00+00:00", "id": "1292804"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201404.6680&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201404.6680&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201404.6680&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201404.6680&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201404.6680&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201404.6680&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%201404.6680&size=3&page=1&format=cv"}}