{"hits": {"hits": [{"created": "1999-02-18T00:00:00+00:00", "updated": "2023-03-09T23:22:33.230863+00:00", "id": "81187", "metadata": {"publication_info": [{"journal_volume": "8", "page_end": "4394", "year": 1973, "page_start": "4383", "journal_title": "Phys.Rev.D"}], "authors": [{"full_name": "Callan, Curtis G., Jr."}, {"full_name": "Gross, David J."}], "texkeys": ["Callan:1973pu"], "abstracts": [{"value": "We discuss the conditions under which renormalization-group methods can imply Bjorken scaling for deep-inelastic structure functions. We prove and refine a conjecture of Parisi's concerning the high-spin behavior of anomalous dimensions in order to show that in most theories Bjorken scaling is possible only if the renormalization group has a fixed point at the origin of coupling-constant space."}], "control_number": 81187, "dois": [{"value": "10.1103/PhysRevD.8.4383"}], "titles": [{"title": "Bjorken scaling in quantum field theory"}], "author_count": 2, "document_type": ["article"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/81187?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/81187?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/81187?format=latex-us", "json": "https://inspirehep.net/api/literature/81187?format=json", "json-expanded": "https://inspirehep.net/api/literature/81187?format=json-expanded", "cv": "https://inspirehep.net/api/literature/81187?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A81187"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C8%2C4383&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C8%2C4383&size=3&page=1&format=bibtex", "latex-eu": "https://insp