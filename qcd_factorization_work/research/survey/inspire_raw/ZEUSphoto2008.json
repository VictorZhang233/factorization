 {"full_name": "Catterall, C.D."}, {"full_name": "Cui, Y."}, {"full_name": "Hartner, Gerd F."}, {"full_name": "Menary, Scott R."}, {"full_name": "Noor, U."}, {"full_name": "Standage, J."}, {"full_name": "Whyte, J."}], "publication_info": [{"journal_volume": "55", "page_end": "191", "year": 2008, "page_start": "177", "journal_title": "Eur.Phys.J.C"}], "texkeys": ["ZEUS:2007uvk", "Chekanov:2007rh"], "collaborations": [{"value": "ZEUS"}], "abstracts": [{"value": "Diffractive photoproduction of dijets was measured with the ZEUS detector at the ep collider HERA using an integrated luminosity of 77.2 pb-1. The measurements were made in the kinematic range Q^2 < 1 GeV^2, 0.20 < y < 0.85 and x_pom < 0.025, where Q^2 is the photon virtuality, y is the inelasticity and x_pom is the fraction of the proton momentum taken by the diffractive exchange. The two jets with the highest transverse energy, E_T^jet, were required to satisfy E_T^jet > 7.5 and 6.5 GeV, respectively, and to lie in the pseudorapidity range -1.5 < eta^jet < 1.5. Differential cross sections were compared to perturbative QCD calculations using available parameterisations of diffractive parton distributions of the proton."}], "titles": [{"title": "Diffractive photoproduction of dijets in ep collisions at HERA"}, {"title": "Diffractive photoproduction of dijetsin $ep$ collisions at HERA"}], "author_count": 322, "control_number": 763404, "dois": [{"value": "10.1140/epjc/s10052-008-0598-2"}], "arxiv_eprints": [{"value": "0710.1498"}], "document_type": ["article"]}, "created": "2007-10-08T00:00:00+00:00", "id": "763404", "links": {"bibtex": "https://inspirehep.net/api/literature/763404?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/763404?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/763404?format=latex-us", "json": "https://inspirehep.net/api/literature/763404?format=json", "json-expanded": "https://inspirehep.net/api/literature/763404?format=json-expanded", "cv": "https:/