{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Sterman, George F."}], "publication_info": [{"journal_volume": "281", "page_end": "364", "year": 1987, "page_start": "310", "journal_title": "Nucl.Phys.B"}], "texkeys": ["Sterman:1986aj"], "imprints": [{"date": "1987"}], "abstracts": [{"value": "The large soft gluon corrections to short-distance hadronic cross sections are summed to all orders in perturbation theory. The arguments apply to any cross section whose Born contribution is initiated by quarks, including Drell-Yan and heavy vector boson cross sections. The exponentiation of leading and non-leading ln( n ) terms in moments of these cross sections is verified. In particular, the ln 3 ( n ) terms computed by van Neervan at two loops are rederived on the basis of one-loop calculations."}], "control_number": 230126, "dois": [{"value": "10.1016/0550-3213(87)90258-6"}], "titles": [{"title": "Summation of Large Corrections to Short Distance Hadronic Cross-Sections"}], "author_count": 1, "document_type": ["article"]}, "updated": "2023-03-07T01:43:57.238814+00:00", "created": "1986-06-27T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/230126?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/230126?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/230126?format=latex-us", "json": "https://inspirehep.net/api/literature/230126?format=json", "json-expanded": "https://inspirehep.net/api/literature/230126?format=json-expanded", "cv": "https://inspirehep.net/api/literature/230126?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A230126"}, "id": "230126"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C281%2C310&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.val