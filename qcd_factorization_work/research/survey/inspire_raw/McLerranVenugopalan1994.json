{"hits": {"hits": [{"id": "358358", "metadata": {"authors": [{"full_name": "McLerran, Larry D."}, {"full_name": "Venugopalan, Raju"}], "publication_info": [{"journal_volume": "49", "page_end": "2241", "year": 1994, "page_start": "2233", "journal_title": "Phys.Rev.D"}], "texkeys": ["McLerran:1993ni"], "abstracts": [{"value": "We argue that the distribution functions for quarks and gluons are computable at small x for sufficiently large nuclei, perhaps larger than can be physically realized. For such nuclei, we argue that weak coupling methods may be used. We show that the computation of the distribution functions can be recast as a many body problem with a modified propagator, a coupling constant which depends on the multiplicity of particles per unit rapidity per unit area, and for non-abelian gauge theories, some extra media dependent vertices. We explicitly compute the distribution function for gluons to lowest order, and argue how they may be computed in higher order."}], "control_number": 358358, "dois": [{"value": "10.1103/PhysRevD.49.2233"}], "arxiv_eprints": [{"value": "hep-ph/9309289"}], "titles": [{"title": "Computing quark and gluon distribution functions for very large nuclei"}, {"title": "Computing Quark and Gluon Distribution Functions for Very Large Nuclei"}], "author_count": 2, "document_type": ["article"]}, "created": "1993-09-24T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/358358?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/358358?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/358358?format=latex-us", "json": "https://inspirehep.net/api/literature/358358?format=json", "json-expanded": "https://inspirehep.net/api/literature/358358?format=json-expanded", "cv": "https://inspirehep.net/api/literature/358358?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A358358"}, "updated": "2023-03-07T05:40:46.813833+00:00"}], "total": 1}, "links": {"self":