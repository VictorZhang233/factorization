{"hits": {"hits": [{"created": "1984-02-01T00:00:00+00:00", "metadata": {"authors": [{"full_name": "Isgur, Nathan"}, {"full_name": "Llewellyn Smith, C.H."}], "publication_info": [{"journal_volume": "52", "artid": "1080", "year": 1984, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "page_start": "1080", "journal_title": "Phys.Rev.Lett."}], "texkeys": ["Isgur:1984jm"], "abstracts": [{"value": "It is found that at available Q2 the calculable perturbative contributions to the pion electric form factor F\u03c0(Q2) and the nucleon magnetic form factors GMN(Q2) are much smaller than the data, which can probably be explained by soft contributions. Both hard and soft effects are estimated from light-cone/infinite-momentum-frame wave functions suggested by quark models, but the main conclusions have a more general validity."}], "control_number": 14464, "dois": [{"value": "10.1103/PhysRevLett.52.1080"}], "titles": [{"title": "Asymptopia in High q**2 Exclusive Processes in QCD"}, {"title": "QUANTUM CHROMODYNAMICS"}], "author_count": 2, "document_type": ["article"]}, "updated": "2023-03-09T19:25:58.039996+00:00", "id": "14464", "links": {"bibtex": "https://inspirehep.net/api/literature/14464?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/14464?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/14464?format=latex-us", "json": "https://inspirehep.net/api/literature/14464?format=json", "json-expanded": "https://inspirehep.net/api/literature/14464?format=json-expanded", "cv": "https://inspirehep.net/api/literature/14464?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A14464"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.Lett.%2C52%2C1080&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collabor