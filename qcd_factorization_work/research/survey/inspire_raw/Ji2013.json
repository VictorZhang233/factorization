{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Ji, Xiangdong"}], "publication_info": [{"journal_volume": "110", "artid": "262002", "year": 2013, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "journal_title": "Phys.Rev.Lett."}], "texkeys": ["Ji:2013dva"], "abstracts": [{"value": "I show that the parton physics related to correlations of quarks and gluons on the light cone can be studied through the matrix elements of frame-dependent, equal-time correlators in the large momentum limit. This observation allows practical calculations of parton properties on a Euclidean lattice. As an example, I demonstrate how to recover the leading-twist quark distribution by boosting an equal-time correlator to a large momentum."}, {"value": "I show that the parton physics related to correlations of quarks and gluons on the light-cone can be studied through the matrix elements of frame-dependent, equal-time correlators in the large momentum limit. This observation allows practical calculations of parton properties on an Euclidean lattice. As an example, I demonstrate how to recover the leading-twist quark distribution by boosting an equal-time correlator to a large momentum."}], "titles": [{"title": "Parton Physics on a Euclidean Lattice"}, {"title": "Parton Physics on Euclidean Lattice"}], "author_count": 1, "imprints": [{"date": "2013-06-26"}], "control_number": 1232221, "dois": [{"value": "10.1103/PhysRevLett.110.262002"}], "arxiv_eprints": [{"value": "1305.1539"}], "document_type": ["article"]}, "updated": "2023-03-07T04:24:20.236405+00:00", "created": "2013-05-08T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/1232221?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/1232221?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/1232221?format=latex-us", "json": "https://inspirehep.net/api/literature/1232221?format=json", "json-expanded": "https://inspirehep.net/api/literature/123