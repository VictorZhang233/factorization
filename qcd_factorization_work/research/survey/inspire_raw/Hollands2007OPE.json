{"hits": {"hits": [{"created": "2006-05-11T00:00:00+00:00", "updated": "2023-03-06T16:16:13.876825+00:00", "id": "716588", "metadata": {"publication_info": [{"journal_volume": "273", "page_end": "36", "year": 2007, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214791"}, "page_start": "1", "journal_title": "Commun.Math.Phys."}], "authors": [{"full_name": "Hollands, Stefan"}], "texkeys": ["Hollands:2006ag"], "abstracts": [{"value": "We present an algorithm for constructing the Wilson operator product expansion (OPE) for perturbative interacting quantum field theory in general Lorentzian curved spacetimes, to arbitrary orders in perturbation theory. The remainder in this expansion is shown to go to zero at short distances in the sense of expectation values in arbitrary Hadamard states. We also establish a number of general properties of the OPE coefficients: (a) they only depend (locally and covariantly) upon the spacetime metric and coupling constants, (b) they satisfy an associativity property, (c) they satisfy a renormalization group equation, (d) they satisfy a certain microlocal wave front set condition, (e) they possess a ``scaling expansion''. The latter means that each OPE coefficient can be written as a sum of terms, each of which is the product of a curvature polynomial at a spacetime point, times a Lorentz invariant Minkowski distribution in the tangent space of that point. The algorithm is illustrated in an example."}], "control_number": 716588, "dois": [{"value": "10.1007/s00220-007-0230-6"}], "arxiv_eprints": [{"value": "gr-qc/0605072"}], "titles": [{"title": "The Operator product expansion for perturbative quantum field theory in curved spacetime"}, {"title": "SPACE-TIME"}, {"title": "The operator product expansion for perturbative quantum field theory in curved spacetime."}], "author_count": 1, "document_type": ["article"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/716588?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/716588?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/716588?format=latex-us", "json": "https://inspirehep.net/api/literature/716588?format=json", "json-expanded": "https://inspirehep.net/api/literature/716588?format=json-expanded", "cv": "https://inspirehep.net/api/literature/716588?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A716588"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22The%20operator%20product%20expansion%20for%20perturbative%20quantum%20field%20theory%20in%20curved%20spacetime%22&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22The%20operator%20product%20expansion%20for%20perturbative%20quantum%20field%20theory%20in%20curved%20spacetime%22&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22The%20operator%20product%20expansion%20for%20perturbative%20quantum%20field%20theory%20in%20curved%20spacetime%22&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22The%20operator%20product%20expansion%20for%20perturbative%20quantum%20field%20theory%20in%20curved%20spacetime%22&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22The%20operator%20product%20expansion%20for%20perturbative%20quantum%20field%20theory%20in%20curved%20spacetime%22&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22The%20ope