{"hits": {"hits": [{"created": "1984-03-01T00:00:00+00:00", "updated": "2023-03-09T19:26:42.728376+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/199766?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/199766?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/199766?format=latex-us", "json": "https://inspirehep.net/api/literature/199766?format=json", "json-expanded": "https://inspirehep.net/api/literature/199766?format=json-expanded", "cv": "https://inspirehep.net/api/literature/199766?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A199766"}, "id": "199766", "metadata": {"authors": [{"full_name": "Basu, Rahul"}, {"full_name": "Ramalho, Anibal J."}, {"full_name": "Sterman, George F."}], "publication_info": [{"journal_volume": "244", "page_end": "246", "year": 1984, "page_start": "221", "journal_title": "Nucl.Phys.B"}], "texkeys": ["Basu:1984ba"], "imprints": [{"date": "1984"}], "abstracts": [{"value": "We study one-loop soft gluon effects in a scalar quark QCD model of the Drell-Yan process. We find that factorization of the type suggested by Politzer holds at order m 2 / s , but fails at order m 4 / s 2 . We suggest that this pattern holds to higher orders, and that the non-factoring terms are not suppressed by form factors. We compute the non-factoring contributions, and give a classical interpretation of our results."}], "control_number": 199766, "dois": [{"value": "10.1016/0550-3213(84)90191-3"}], "titles": [{"title": "Factorization at Higher Twist in Hadron - Hadron Scattering"}, {"title": "FACTORIZATION AT HIGHER TWIST IN HADRON - HADRON SCATTERING"}], "author_count": 3, "document_type": ["article"]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C244%2C221&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,do