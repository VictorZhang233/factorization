{"hits": {"hits": [{"updated": "2023-03-28T19:01:52.407502+00:00", "metadata": {"authors": [{"full_name": "Bardeen, William A."}, {"full_name": "Buras, Andrzej J."}], "publication_info": [{"journal_volume": "20", "artid": "166", "year": 1979, "page_start": "166", "journal_title": "Phys.Rev.D"}, {"journal_volume": "21", "artid": "2041", "material": "erratum", "year": 1980, "page_start": "2041", "journal_title": "Phys.Rev.D"}], "texkeys": ["Bardeen:1978hg"], "abstracts": [{"value": "We generalize Witten's calculation of the photon structure function F2\u03b3 to the next-to-the-leading order of asymptotic freedom. Except for the second moment of F2\u03b3, the result is independent of the unknown matrix elements of quark and gluon operators between the photon states. The nonleading corrections turn out to be large."}], "control_number": 132957, "dois": [{"value": "10.1103/PhysRevD.21.2041"}, {"value": "10.1103/PhysRevD.20.166"}], "titles": [{"title": "Higher Order Asymptotic Freedom Corrections to Photon - Photon Scattering"}, {"title": "PHOTON PHOTON"}], "author_count": 2, "document_type": ["article"]}, "created": "1978-11-01T00:00:00+00:00", "id": "132957", "links": {"bibtex": "https://inspirehep.net/api/literature/132957?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/132957?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/132957?format=latex-us", "json": "https://inspirehep.net/api/literature/132957?format=json", "json-expanded": "https://inspirehep.net/api/literature/132957?format=json-expanded", "cv": "https://inspirehep.net/api/literature/132957?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A132957"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C20%2C166&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints