{"hits": {"hits": [{"updated": "2023-03-07T02:27:48.449788+00:00", "metadata": {"authors": [{"full_name": "Sterman, George F."}, {"full_name": "Weinberg, Steven"}], "publication_info": [{"journal_volume": "39", "artid": "1436", "year": 1977, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "page_start": "1436", "journal_title": "Phys.Rev.Lett."}], "texkeys": ["Sterman:1977wj"], "abstracts": [{"value": "The properties of hadronic jets in e+e\u2212 annihilation are examined in quantum chromodynamics, without using the assumptions of the parton model. We find that two-jet events dominate the cross section at high energy, and have the experimentally observed angular distribution. Estimates are given for the jet angular radius and its energy dependence. We argue that the detailed results of perturbation theory for production of arbitrary numbers of quarks and gluons can be reinterpreted in quantum chromodynamics as predictions for the production of jets."}], "control_number": 120612, "dois": [{"value": "10.1103/PhysRevLett.39.1436"}], "titles": [{"title": "Jets from Quantum Chromodynamics"}, {"title": "QCD"}, {"title": "QUANTUM CHROMODYNAMICS"}], "author_count": 2, "document_type": ["article"]}, "created": "1977-07-01T00:00:00+00:00", "id": "120612", "links": {"bibtex": "https://inspirehep.net/api/literature/120612?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/120612?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/120612?format=latex-us", "json": "https://inspirehep.net/api/literature/120612?format=json", "json-expanded": "https://inspirehep.net/api/literature/120612?format=json-expanded", "cv": "https://inspirehep.net/api/literature/120612?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A120612"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.Lett.%2C39%2C1436&size=3&page=1&fields=control_number,titles.title,au