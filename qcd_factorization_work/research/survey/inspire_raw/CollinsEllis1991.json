{"hits": {"hits": [{"links": {"bibtex": "https://inspirehep.net/api/literature/313886?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/313886?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/313886?format=latex-us", "json": "https://inspirehep.net/api/literature/313886?format=json", "json-expanded": "https://inspirehep.net/api/literature/313886?format=json-expanded", "cv": "https://inspirehep.net/api/literature/313886?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A313886"}, "metadata": {"authors": [{"full_name": "Collins, John C."}, {"full_name": "Ellis, R.Keith"}], "publication_info": [{"journal_volume": "360", "page_end": "30", "year": 1991, "page_start": "3", "journal_title": "Nucl.Phys.B"}], "texkeys": ["Collins:1991ty"], "imprints": [{"date": "1991"}], "abstracts": [{"value": "The hadroproduction of heavy quarks is studied in the kinematic regime in which \u221a s is very much greater than the mass of the produced heavy quark. We introduce a modification of the normal Lipatov equation which allows a factorization between the short-distance and long-distance physics. Numerical results are provided using the cross section for b-quark production as an example."}], "control_number": 313886, "dois": [{"value": "10.1016/0550-3213(91)90288-9"}], "titles": [{"title": "Heavy Quark Production in Very High-Energy Hadron Collisions"}], "author_count": 2, "document_type": ["article"]}, "updated": "2026-06-15T13:25:50.186759+00:00", "id": "313886", "created": "1991-02-04T00:00:00+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C360%2C3&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C360%2C3&size=3