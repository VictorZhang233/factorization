{"hits": {"hits": [{"updated": "2023-03-07T02:23:08.783361+00:00", "metadata": {"authors": [{"full_name": "Coleman, S."}, {"full_name": "Norton, R.E."}], "publication_info": [{"journal_volume": "38", "page_end": "442", "year": 1965, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214555"}, "page_start": "438", "journal_title": "Nuovo Cim."}], "texkeys": ["Coleman:1965xm"], "abstracts": [{"value": "It is shown that a Feynman amplitude has singularities on the physical boundary if and only if the relevant Feynman diagram can be interpreted as a picture of an energy- and momentum-conserving process occurring in space-time, with all internal particles real, on the mass shell, and moving forward in time. As a by-product of the proof, the Feynman parameter associated with an internal line is identified (within a proportionality factor) with the time the particle exists between collisions, divided by its mass."}], "control_number": 48874, "dois": [{"value": "10.1007/BF02750472"}], "titles": [{"title": "Singularities in the physical region"}], "author_count": 2, "document_type": ["article"]}, "created": "2003-05-28T00:00:00+00:00", "id": "48874", "links": {"bibtex": "https://inspirehep.net/api/literature/48874?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/48874?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/48874?format=latex-us", "json": "https://inspirehep.net/api/literature/48874?format=json", "json-expanded": "https://inspirehep.net/api/literature/48874?format=json-expanded", "cv": "https://inspirehep.net/api/literature/48874?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A48874"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nuovo%20Cim.%2C38%2C438&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbn