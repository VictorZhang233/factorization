{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Collins, John C."}, {"full_name": "Hautmann, F."}], "publication_info": [{"journal_volume": "472", "page_end": "134", "year": 2000, "page_start": "129", "journal_title": "Phys.Lett.B"}], "texkeys": ["Collins:1999dz"], "abstracts": [{"value": "We propose a method to analyze infrared contributions to non-inclusive processes in QCD. We use the one-loop Sudakov form factor as a working example. Borrowing techniques from renormalization theory, we construct counterterms for the contributions from the soft and collinear regions, and we relate them to eikonal Wilson lines taken along non-lightlike directions."}], "control_number": 506093, "dois": [{"value": "10.1016/S0370-2693(99)01384-2"}], "arxiv_eprints": [{"value": "hep-ph/9908467"}], "titles": [{"title": "Infrared divergences and nonlightlike eikonal lines in Sudakov processes"}, {"title": "Infrared divergences and non-lightlike eikonal lines in Sudakov processes."}], "author_count": 2, "document_type": ["article"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/506093?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/506093?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/506093?format=latex-us", "json": "https://inspirehep.net/api/literature/506093?format=json", "json-expanded": "https://inspirehep.net/api/literature/506093?format=json-expanded", "cv": "https://inspirehep.net/api/literature/506093?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A506093"}, "updated": "2023-03-07T02:53:26.569922+00:00", "created": "1999-08-26T00:00:00+00:00", "id": "506093"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9908467&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "