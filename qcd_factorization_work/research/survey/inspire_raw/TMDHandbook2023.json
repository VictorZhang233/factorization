{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Boussarie, Renaud"}, {"full_name": "Burkardt, Matthias"}, {"full_name": "Constantinou, Martha"}, {"full_name": "Detmold, William"}, {"full_name": "Ebert, Markus"}, {"full_name": "Engelhardt, Michael"}, {"full_name": "Fleming, Sean"}, {"full_name": "Gamberg, Leonard"}, {"full_name": "Ji, Xiangdong"}, {"full_name": "Kang, Zhong-Bo"}, {"full_name": "Lee, Christopher"}, {"full_name": "Liu, Keh-Fei"}, {"full_name": "Liuti, Simonetta"}, {"full_name": "Mehen, Thomas"}, {"full_name": "Metz, Andreas"}, {"full_name": "Negele, John"}, {"full_name": "Pitonyak, Daniel"}, {"full_name": "Prokudin, Alexei"}, {"full_name": "Qiu, Jian-Wei"}, {"full_name": "Rajan, Abha"}, {"full_name": "Schlegel, Marc"}, {"full_name": "Shanahan, Phiala"}, {"full_name": "Schweitzer, Peter"}, {"full_name": "Stewart, Iain W."}, {"full_name": "Tarasov, Andrey"}, {"full_name": "Venugopalan, Raju"}, {"full_name": "Vitev, Ivan"}, {"full_name": "Yuan, Feng"}, {"full_name": "Zhao, Yong"}], "texkeys": ["Boussarie:2023izj"], "abstracts": [{"value": "This handbook provides a comprehensive review of transverse-momentum-dependent parton distribution functions and fragmentation functions, commonly referred to as transverse momentum distributions (TMDs). TMDs describe the distribution of partons inside the proton and other hadrons with respect to both their longitudinal and transverse momenta. They provide unique insight into the internal momentum and spin structure of hadrons, and are a key ingredient in the description of many collider physics cross sections. Understanding TMDs requires a combination of theoretical techniques from quantum field theory, nonperturbative calculations using lattice QCD, and phenomenological analysis of experimental data. The handbook covers a wide range of topics, from theoretical foundations to experimental analyses, as well as recent developments and future directions. It is intended to provide an essential reference for researchers and graduate students interested in understanding the structure of hadrons and the dynamics of partons in high energy collisions."}], "control_number": 2650019, "titles": [{"title": "TMD Handbook"}], "arxiv_eprints": [{"value": "2304.03302"}], "author_count": 29, "document_type": ["article"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/2650019?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/2650019?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/2650019?format=latex-us", "json": "https://inspirehep.net/api/literature/2650019?format=json", "json-expanded": "https://inspirehep.net/api/literature/2650019?format=json-expanded", "cv": "https://inspirehep.net/api/literature/2650019?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2650019"}, "id": "2650019", "created": "2023-04-11T07:32:01.588362+00:00", "updated": "2026-07-29T17:38:41.104602+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%202304.03302&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%202304.03302&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%202304.03302&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%202304.03302&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%202304.03302&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostci