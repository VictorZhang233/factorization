{"hits": {"hits": [{"updated": "2023-03-09T18:05:08.219347+00:00", "metadata": {"publication_info": [{"journal_volume": "53", "page_end": "6179", "year": 1996, "page_start": "6162", "journal_title": "Phys.Rev.D"}], "authors": [{"full_name": "Berera, Arjun"}, {"full_name": "Soper, Davison E."}], "texkeys": ["Berera:1995fj"], "abstracts": [{"value": "Diffractive parton distribution functions give the probability to find a parton in a hadron if the hadron is diffractively scattered. We provide an operator definition of these functions and discuss their relation to diffractive deeply inelastic scattering and to photoproduction of jets at HERA. We perform a calculation in the style of ``constituent counting rules'' for the behavior of these functions when the detected parton carries almost all of the longitudinal momentum transferred from the scattered hadron."}], "control_number": 399093, "dois": [{"value": "10.1103/PhysRevD.53.6162"}], "arxiv_eprints": [{"value": "hep-ph/9509239"}], "titles": [{"title": "Behavior of diffractive parton distribution functions"}, {"title": "Behavior of Diffractive Parton Distribution Functions"}], "author_count": 2, "document_type": ["article"]}, "created": "1995-09-07T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/399093?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/399093?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/399093?format=latex-us", "json": "https://inspirehep.net/api/literature/399093?format=json", "json-expanded": "https://inspirehep.net/api/literature/399093?format=json-expanded", "cv": "https://inspirehep.net/api/literature/399093?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A399093"}, "id": "399093"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Rev.D%2C53%2C6162&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,a