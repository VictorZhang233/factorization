{"hits": {"hits": [{"created": "1996-11-27T00:00:00+00:00", "metadata": {"authors": [{"full_name": "Collins, John C."}, {"full_name": "Frankfurt, Leonid"}, {"full_name": "Strikman, Mark"}], "publication_info": [{"journal_volume": "56", "page_end": "3006", "year": 1997, "page_start": "2982", "journal_title": "Phys.Rev.D"}], "texkeys": ["Collins:1996fb"], "abstracts": [{"value": "We formulate and prove a QCD factorization theorem for hard exclusive electroproduction of mesons in QCD. The proof is valid for the leading power in Q and all logarithms. This generalizes previous work on vector meson production in the diffractive region of small x. The amplitude is expressed in terms of off-diagonal generalizations of the usual parton densities. The full theorem applies to all kinds of meson and not just to vector mesons. The parton densities used include not only the ordinary parton density, but also the helicity density (g_1 or $\\Delta q$) and the transversity density ($h_1$ or $\\delta q$), and these can be probed by measuring the polarization of the produced mesons with unpolarized protons."}], "control_number": 426483, "dois": [{"value": "10.1103/PhysRevD.56.2982"}], "arxiv_eprints": [{"value": "hep-ph/9611433"}], "titles": [{"title": "Factorization for hard exclusive electroproduction of mesons in QCD"}, {"title": "QUANTUM CHROMODYNAMICS"}, {"title": "Factorization for hard exclusive electroproduction of mesons in QCD."}], "author_count": 3, "document_type": ["article"]}, "updated": "2023-03-07T03:12:32.681471+00:00", "id": "426483", "links": {"bibtex": "https://inspirehep.net/api/literature/426483?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/426483?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/426483?format=latex-us", "json": "https://inspirehep.net/api/literature/426483?format=json", "json-expanded": "https://inspirehep.net/api/literature/426483?format=json-expanded", "cv": "https://inspirehep.net/api/literature/426483?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A426483"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9611433&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9611433&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9611433&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9611433&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9611433&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9611433&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9611433&size=3&page=1&format=cv"}}