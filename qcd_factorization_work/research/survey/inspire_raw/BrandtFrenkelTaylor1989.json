{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Brandt, Fernando T."}, {"full_name": "Frenkel, J."}, {"full_name": "Taylor, J.C."}], "publication_info": [{"journal_volume": "312", "page_end": "615", "year": 1989, "page_start": "589", "journal_title": "Nucl.Phys.B"}], "texkeys": ["Brandt:1988xt"], "imprints": [{"date": "1989"}], "abstracts": [{"value": "We verify by explicit calculation, to 2-loop order, the cancellation of soft interactions with spectators in the Drell-Yan process. We employ a model in which a \u201cmeson\u201d consists of a parton and a spectator parton, each moving along parallel eikonal lines. The process occurs in the collision of two such \u201cmesons\u201d at velocities near the speed of light. The calculation is sensitive to gluons with wavelengths of the order of or greater than the meson size."}], "control_number": 23527, "dois": [{"value": "10.1016/0550-3213(89)90573-7"}], "titles": [{"title": "Cancellation of Soft Interactions With Spectators in the {Drell-Yan} Process"}, {"title": "CANCELLATION OF SOFT INTERACTIONS WITH SPECTATORS IN THE DRELL-YAN PROCESS"}], "author_count": 3, "document_type": ["article"]}, "updated": "2023-03-10T08:36:48.092651+00:00", "created": "1988-04-19T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/23527?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/23527?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/23527?format=latex-us", "json": "https://inspirehep.net/api/literature/23527?format=json", "json-expanded": "https://inspirehep.net/api/literature/23527?format=json-expanded", "cv": "https://inspirehep.net/api/literature/23527?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A23527"}, "id": "23527"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C312%2C589&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publ