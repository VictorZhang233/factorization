{"hits": {"hits": [{"created": "1997-11-25T00:00:00+00:00", "metadata": {"publication_info": [{"journal_volume": "58", "artid": "036001", "year": 1998, "journal_title": "Phys.Rev.D"}], "authors": [{"full_name": "Guo, Xiaofeng"}], "texkeys": ["Guo:1997it"], "abstracts": [{"value": "We calculate the nuclear enhancement in Drell-Yan transverse momentum distribution in hadron-nucleus collisions. In terms of multiple scattering picture, we compute the contributions from double scattering. Applying the generalized factorization theorem, we express the nuclear enhancement in terms of twist-4 nuclear parton correlation functions. We demonstrate that these twist-4 nuclear parton correlation functions are universal, and are the same as those used to explain the nuclear dependence in di-jet momentum imbalance and in direct photon production. Using the known information on the twist-4 parton correlation functions, we estimate the nuclear enhancement for Drell-Yan pair in large $q_T$ region. We also discuss the source of nuclear suppression in small $q_T$ region."}], "control_number": 451495, "dois": [{"value": "10.1103/PhysRevD.58.036001"}], "arxiv_eprints": [{"value": "hep-ph/9711453"}], "titles": [{"title": "Nuclear dependence in Drell-Yan transverse momentum distribution"}, {"title": "Nuclear dependence in Drell-Yan transverse momentum distribution."}], "author_count": 1, "document_type": ["article"]}, "id": "451495", "links": {"bibtex": "https://inspirehep.net/api/literature/451495?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/451495?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/451495?format=latex-us", "json": "https://inspirehep.net/api/literature/451495?format=json", "json-expanded": "https://inspirehep.net/api/literature/451495?format=json-expanded", "cv": "https://inspirehep.net/api/literature/451495?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A451495"}, "updated": "2024-05-07T08:52:40.239426+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22Nuclear%20dependence%20in%20Drell-Yan%20transverse%20momentum%20distribution%22&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22Nuclear%20dependence%20in%20Drell-Yan%20transverse%20momentum%20distribution%22&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22Nuclear%20dependence%20in%20Drell-Yan%20transverse%20momentum%20distribution%22&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22Nuclear%20dependence%20in%20Drell-Yan%20transverse%20momentum%20distribution%22&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22Nuclear%20dependence%20in%20Drell-Yan%20transverse%20momentum%20distribution%22&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22Nuclear%20dependence%20in%20Drell-Yan%20transverse%20momentum%20distribution%22&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostrecent&q=t%20%22Nuclear%20dependence%20in%20Drell-Yan%20transverse%20momentum%20distribution%22&size=3&page=1&format=cv"}}