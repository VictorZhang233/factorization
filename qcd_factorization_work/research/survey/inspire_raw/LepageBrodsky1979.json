{"hits": {"hits": [{"created": "1979-06-01T00:00:00+00:00", "updated": "2023-03-09T12:35:25.904528+00:00", "id": "141215", "metadata": {"publication_info": [{"journal_volume": "87", "page_end": "365", "year": 1979, "page_start": "359", "journal_title": "Phys.Lett.B"}], "authors": [{"full_name": "Lepage, G.Peter"}, {"full_name": "Brodsky, Stanley J."}], "texkeys": ["Lepage:1979zb"], "imprints": [{"date": "1979"}], "abstracts": [{"value": "The predictions of quantum chromodynamics for meson form factors at large momentum transfer are given. Evolution equations are derived which determine the structure of hadronic wavefunctions at short distances from their form at large distances. The eigenvalues of the evolution equations appear as exponents in anomalous logarithm corrections to the nominal power law of form factors determined by dimensional counting. The results lead to detailed tests of the spin and scaling structure of QCD at short distances. The predictions for the charged pion, kaon and rho form factors and the \u03b3 \u2192 \u03c0 0 transition form factor of the photon are absolutely normalized at asymptotic momentum transfer."}], "control_number": 141215, "dois": [{"value": "10.1016/0370-2693(79)90554-9"}], "titles": [{"title": "Exclusive Processes in Quantum Chromodynamics: Evolution Equations for Hadronic Wave Functions and the Form-Factors of Mesons"}, {"title": "QCD"}, {"title": "QUANTUM CHROMODYNAMICS"}], "author_count": 2, "document_type": ["article"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/141215?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/141215?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/141215?format=latex-us", "json": "https://inspirehep.net/api/literature/141215?format=json", "json-expanded": "https://inspirehep.net/api/literature/141215?format=json-expanded", "cv": "https://inspirehep.net/api/literature/141215?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A141215"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Lett.B%2C87%2C359&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Lett.B%2C87%2C359&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Lett.B%2C87%2C359&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Lett.B%2C87%2C359&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Lett.B%2C87%2C359&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Lett.B%2C87%2C359&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Phys.Lett.B%2C87%2C359&size=3&page=1&format=cv"}}