{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Becher, Thomas"}, {"full_name": "Neubert, Matthias"}], "publication_info": [{"journal_volume": "102", "artid": "162001", "year": 2009, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "journal_title": "Phys.Rev.Lett."}, {"journal_volume": "111", "artid": "199905", "material": "erratum", "year": 2013, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "journal_issue": "19", "journal_title": "Phys.Rev.Lett."}], "texkeys": ["Becher:2009cu"], "abstracts": [{"value": "An exact formula is derived for the infrared singularities of dimensionally regularized scattering amplitudes in massless QCD with an arbitrary number of legs, valid at any number of loops. It is based on the conjecture that the anomalous-dimension matrix of n-jet operators in soft-collinear effective theory contains only a single non-trivial color structure, whose coefficient is the cusp anomalous dimension of Wilson loops with light-like segments. Its color-diagonal part is characterized by two anomalous dimensions, which are extracted to three-loop order from known perturbative results for the quark and gluon form factors. This allows us to predict the three-loop coefficients of all 1/epsilon^k poles for an arbitrary n-parton scattering amplitudes, generalizing existing two-loop results."}], "titles": [{"title": "Infrared singularities of scattering amplitudes in perturbative QCD"}, {"title": "Infrared singularities of scattering amplitudes in perturbative QCD"}], "author_count": 2, "imprints": [{"date": "2009-04-23"}], "control_number": 810415, "dois": [{"value": "10.1103/PhysRevLett.102.162001"}, {"value": "10.1103/PhysRevLett.111.199905"}], "arxiv_eprints": [{"value": "0901.0722"}], "document_type": ["article"]}, "id": "810415", "created": "2009-01-07T00:00:00+00:00", "updated": "2023-03-10T02:58:34.515755+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/810415?format=bibtex"