{"hits": {"hits": [{"links": {"bibtex": "https://inspirehep.net/api/literature/499707?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/499707?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/499707?format=latex-us", "json": "https://inspirehep.net/api/literature/499707?format=json", "json-expanded": "https://inspirehep.net/api/literature/499707?format=json-expanded", "cv": "https://inspirehep.net/api/literature/499707?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A499707"}, "id": "499707", "updated": "2023-03-10T12:16:28.510126+00:00", "metadata": {"publication_info": [{"journal_volume": "83", "page_end": "1917", "year": 1999, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "page_start": "1914", "journal_title": "Phys.Rev.Lett."}], "authors": [{"full_name": "Beneke, M."}, {"full_name": "Buchalla, G."}, {"full_name": "Neubert, M."}, {"full_name": "Sachrajda, Christopher T."}], "texkeys": ["Beneke:1999br"], "abstracts": [{"value": "We show that, in the heavy quark limit, the hadronic matrix elements that enter $B$ meson decays into two light mesons can be computed from first principles, including `non-factorizable' strong interaction corrections, and expressed in terms of form factors and meson light-cone distribution amplitudes. The conventional factorization result follows in the limit when both power corrections in $1/m_b$ and radiative corrections in $\\alpha_s$ are neglected. We compute the order-$\\alpha_s$ corrections to the decays $B_d\\to\\pi^+\\pi^-$, $B_d\\to\\pi^0\\pi^0$ and $B^+\\to\\pi^+\\pi^0$ in the heavy quark limit and briefly discuss the phenomenological implications for the branching ratios, strong phases and CP violation."}], "control_number": 499707, "dois": [{"value": "10.1103/PhysRevLett.83.1914"}], "arxiv_eprints": [{"value": "hep-ph/9905312"}], "titles": [{"title": "QCD factorization for B ---> pi pi decays: Strong phases and CP violation in the heavy quark limit"}, {"title": "QUANTUM CHROMODYNAMICS"}, {"title": "CHARGE PARITY"}, {"title": "{QCD} factorization for B --> pi pi decays: Strong phases and CP violation in the heavy quark limit"}], "author_count": 4, "document_type": ["article"]}, "created": "1999-05-12T00:00:00+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9905312&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9905312&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9905312&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9905312&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9905312&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9905312&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=eprint%20hep-ph%2F9905312&size=3&page=1&format=cv"}}