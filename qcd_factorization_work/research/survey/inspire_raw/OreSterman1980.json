{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Ore, F.R., Jr."}, {"full_name": "Sterman, George F."}], "publication_info": [{"journal_volume": "165", "page_end": "118", "year": 1980, "page_start": "93", "journal_title": "Nucl.Phys.B"}], "texkeys": ["Ore:1979ry"], "imprints": [{"date": "1980"}], "abstracts": [{"value": "A formalism is developed for expressing annihilation cross sections directly in terms of the vacuum expectation values of certain time-ordered products. This necessitates the introduction of a class of operators defined as spatial of multilocal products of fields. The formalism is used to study qualitatively the effects of a dilute gas of instantons on weighted cross sections, and also to rederive results on the cancellation of mass divergences."}], "control_number": 8448, "dois": [{"value": "10.1016/0550-3213(80)90308-9"}], "titles": [{"title": "AN OPERATOR APPROACH TO WEIGHTED CROSS-SECTIONS"}], "author_count": 2, "document_type": ["article"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/8448?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/8448?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/8448?format=latex-us", "json": "https://inspirehep.net/api/literature/8448?format=json", "json-expanded": "https://inspirehep.net/api/literature/8448?format=json-expanded", "cv": "https://inspirehep.net/api/literature/8448?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A8448"}, "id": "8448", "created": "1979-10-01T00:00:00+00:00", "updated": "2023-03-10T00:11:05.704866+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C165%2C93&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=