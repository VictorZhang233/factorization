{"hits": {"hits": [{"links": {"bibtex": "https://inspirehep.net/api/literature/214452?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/214452?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/214452?format=latex-us", "json": "https://inspirehep.net/api/literature/214452?format=json", "json-expanded": "https://inspirehep.net/api/literature/214452?format=json-expanded", "cv": "https://inspirehep.net/api/literature/214452?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A214452"}, "created": "1985-06-01T00:00:00+00:00", "updated": "2023-03-07T02:48:51.299265+00:00", "metadata": {"authors": [{"full_name": "Collins, John C."}, {"full_name": "Soper, Davison E."}, {"full_name": "Sterman, George F."}], "publication_info": [{"journal_volume": "263", "artid": "37", "year": 1986, "page_start": "37", "journal_title": "Nucl.Phys.B"}, {"conference_record": {"$ref": "https://inspirehep.net/api/conferences/965792"}, "cnum": "C85-03-18.1"}], "texkeys": ["Collins:1985gm"], "imprints": [{"date": "1986"}], "abstracts": [{"value": "We consider the problem of how to compute the cross section for producing heavy strongly interacting particles (quarks, gluinos, squarks \u2026) in high-energy hadron collisions, supposing that the heavy particle masses are large compared to 1 GeV. We use heavy quark production as an example. We consider several low-order graphs in the kinematic region expected to produce the bulk of the total production cross section. Based on the structure of the low-order graphs, we argue that the cross section can be reliably computed in QCD by using the same factorization formula that is used for jet production and W and Z production, but inserting the appropriate parton level cross sections for the heavy particle production. We emphasize that an analysis at all orders of perturbation theory is needed to reliably establish this conjecture."}], "control_number": 214452, "dois": [{"value": "10.1016/0550-3213(86)90026-X"}], "titles": [{"title": "Heavy Particle Production in High-Energy Hadron Collisions"}], "author_count": 3, "document_type": ["conference paper"]}, "id": "214452"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C263%2C37&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C263%2C37&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C263%2C37&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C263%2C37&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C263%2C37&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C263%2C37&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C263%2C37&size=3&page=1&format=cv"}}