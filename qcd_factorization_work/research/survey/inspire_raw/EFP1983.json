{"hits": {"hits": [{"metadata": {"authors": [{"full_name": "Ellis, R.Keith"}, {"full_name": "Furmanski, W."}, {"full_name": "Petronzio, R."}], "publication_info": [{"journal_volume": "212", "artid": "29", "year": 1983, "page_start": "29", "journal_title": "Nucl.Phys.B"}, {"pubinfo_freetext": "Nucl. Phys. B212 (1983) 29-98 AND CERN GENEVA - TH. 3301 (82,REC.JUL.) 103 P"}], "texkeys": ["Ellis:1982cd"], "imprints": [{"date": "1983"}], "abstracts": [{"value": "We present a novel method of deriving the first power corrections (1/ Q 2 ) to the leptoproduction structure functions. The method is based directly on the manipulation of Feynman diagrams. Correspondence with the operator product expansion approach is established. We find that the transverse components of momenta and the gluon field control both the kinematic and dynamical power corrections. The full QCD result is similar in structure to the na\u00efve parton model with intrinsic transverse momentum. We explain how the concept of parton transverse momentum is generalized in the presence of interaction. In the operator language our method defines a new basis in which all but the transverse components of covariant derivatives are eliminated by the equations of motion. We derive constraints on signs of the 1/ Q 2 terms."}], "control_number": 178625, "dois": [{"value": "10.1016/0550-3213(83)90597-7"}], "titles": [{"title": "Unraveling Higher Twists"}], "author_count": 3, "document_type": ["article"]}, "id": "178625", "created": "1982-05-01T00:00:00+00:00", "updated": "2023-11-08T09:02:08.561194+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/178625?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/178625?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/178625?format=latex-us", "json": "https://inspirehep.net/api/literature/178625?format=json", "json-expanded": "https://inspirehep.net/api/literature/178625?format=json-expanded", "cv": "https://inspirehep.net/api/literature/178625?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A178625"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C212%2C29&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C212%2C29&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C212%2C29&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C212%2C29&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C212%2C29&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C212%2C29&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C212%2C29&size=3&page=1&format=cv"}}