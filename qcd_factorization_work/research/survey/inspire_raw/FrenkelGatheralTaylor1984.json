{"hits": {"hits": [{"updated": "2023-03-06T18:00:24.280319+00:00", "metadata": {"publication_info": [{"journal_volume": "233", "page_end": "335", "year": 1984, "page_start": "307", "journal_title": "Nucl.Phys.B"}], "authors": [{"full_name": "Frenkel, J."}, {"full_name": "Gatheral, J.G.M."}, {"full_name": "Taylor, J.C."}], "texkeys": ["Frenkel:1983di"], "imprints": [{"date": "1984"}], "abstracts": [{"value": "In perturbative QCD, the Bloch-Nordsieck cross section for quark-antiquark annihilation is known, to order g 4 , to be infrared finite, except for terms which are power-suppressed at high energies. We give a fairly simple explanation of this fact, using analyticity, unitarity and an analysis of mass singularities is both Feynman and axial gauges. The arguments applies fairly easily to order g 6 . Assuming a generalized unitarity principle, the argument can be extended to all orders."}], "control_number": 190229, "dois": [{"value": "10.1016/0550-3213(84)90418-8"}], "titles": [{"title": "IS QUARK - ANTI-QUARK ANNIHILATION INFRARED SAFE AT HIGH-ENERGY?"}], "author_count": 3, "document_type": ["article"]}, "created": "1983-05-01T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/190229?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/190229?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/190229?format=latex-us", "json": "https://inspirehep.net/api/literature/190229?format=json", "json-expanded": "https://inspirehep.net/api/literature/190229?format=json-expanded", "cv": "https://inspirehep.net/api/literature/190229?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A190229"}, "id": "190229"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C233%2C307&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,