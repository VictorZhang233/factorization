{"hits": {"hits": [{"updated": "2023-03-06T17:12:01.203372+00:00", "metadata": {"authors": [{"full_name": "Labastida, J.M.F."}, {"full_name": "Sterman, George F."}], "publication_info": [{"journal_volume": "254", "page_end": "440", "year": 1985, "page_start": "425", "journal_title": "Nucl.Phys.B"}], "texkeys": ["Labastida:1984gy"], "imprints": [{"date": "1985"}], "abstracts": [{"value": "We analyze the structure of high-energy inclusive hadron-hadron scattering in the Feynman gauge. We show that final-state interactions cancel on a graph-by-graph basis after a sum over final states. We go on to show that the leading high-energy behavior of disconnected parton scatterings in the Feynman gauge is the same as in physical gauges, after a sum over gauge-invariant sets of graphs. We point out that this result is in general not true for individual diagrams in the Feynman gauge, where gluon longitudinal degrees of freedom may lead to power infrared divergences. Our results justify the use of the Feynman gauge in arguments for factorization of leading-twist cross sections, and also in the analysis of disconnected multiparton scattering."}], "control_number": 15811, "dois": [{"value": "10.1016/0550-3213(85)90226-3"}], "titles": [{"title": "Inclusive Hadron - Hadron Scattering in the Feynman Gauge"}, {"title": "INCLUSIVE HADRON - HADRON SCATTERING IN THE FEYNMAN GAUGE"}], "author_count": 2, "document_type": ["article"]}, "created": "1984-11-01T00:00:00+00:00", "id": "15811", "links": {"bibtex": "https://inspirehep.net/api/literature/15811?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/15811?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/15811?format=latex-us", "json": "https://inspirehep.net/api/literature/15811?format=json", "json-expanded": "https://inspirehep.net/api/literature/15811?format=json-expanded", "cv": "https://inspirehep.net/api/literature/15811?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A15811"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C254%2C425&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value", "bibtex": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C254%2C425&size=3&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C254%2C425&size=3&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C254%2C425&size=3&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C254%2C425&size=3&page=1&fields=control_number,titles.title,authors.full_name,author_count,publication_info,arxiv_eprints.value,dois.value,texkeys,abstracts.value,document_type,imprints,isbns,collaborations.value&format=json", "json-expanded": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C254%2C425&size=3&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?sort=mostcited&q=j%20Nucl.Phys.B%2C254%2C425&size=3&page=1&format=cv"}}