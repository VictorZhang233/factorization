\@writefile{lof}{\contentsline {figure}{\numberline {15.2}{\ignorespaces 推力（双喷注）分布在 $\tau =1-T\ll 1$ 时的因子化 $H\times J_n\otimes J_{\bar  n}\otimes S$ 的图示（每个因子都画成割图，红色虚线为末态切割）。 硬函数 $H=|C|^2$ 来自把 QCD 流匹配到 SCET 流的 Wilson 系数 $C(Q^2,\mu )$；喷注函数 $J_n$、$J_{\bar  n}$（对夸克与反夸克是同一个函数）描述虚度 $s_{n,\bar  n}\sim \tau Q^2$ 的共线辐射； 软函数 $S(k,\mu )$ 是沿 $n$、$\bar  n$ 方向的出射（未来指向）Wilson 线 $Y_n$、$Y_{\bar  n}$（后者取反基础表示）的真空矩阵元， 左、右两个顶点分别属于振幅与共轭振幅，软辐射对 $\tau $ 的贡献按半球测量：$k=n\cdot p_{s}^{(n)}+\bar  n\cdot p_{s}^{(\bar  n)}$（上标表示软粒子所在的半球）。 式中省略了相对 $\mathcal  {O}\!\left (\tau \right )$ 的幂次修正。\relax }}{207}{figure.caption.144}\protected@file@percent }
\newlabel{fig:dijet-factorization}{{15.2}{207}{推力（双喷注）分布在 $\tau =1-T\ll 1$ 时的因子化 $H\times J_n\otimes J_{\bar n}\otimes S$ 的图示（每个因子都画成割图，红色虚线为末态切割）。 硬函数 $H=|C|^2$ 来自把 QCD 流匹配到 SCET 流的 Wilson 系数 $C(Q^2,\mu )$；喷注函数 $J_n$、$J_{\bar n}$（对夸克与反夸克是同一个函数）描述虚度 $s_{n,\bar n}\sim \tau Q^2$ 的共线辐射； 软函数 $S(k,\mu )$ 是沿 $n$、$\bar n$ 方向的出射（未来指向）Wilson 线 $Y_n$、$Y_{\bar n}$（后者取反基础表示）的真空矩阵元， 左、右两个顶点分别属于振幅与共轭振幅，软辐射对 $\tau $ 的贡献按半球测量：$k=n\cdot p_{s}^{(n)}+\bar n\cdot p_{s}^{(\bar n)}$（上标表示软粒子所在的半球）。 式中省略了相对 $\order {\tau }$ 的幂次修正。\relax }{figure.caption.144}{}}
\newlabel{fig:dijet-factorization@cref}{{[figure][2][15]15.2}{[1][207][]207}}
