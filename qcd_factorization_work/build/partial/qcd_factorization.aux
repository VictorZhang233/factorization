\newlabel{sec:ir-pinch}{{4.3}{28}{无质量 QCD 中的钳夹面与约化图}{section.4.3}{}}
\newlabel{sec:ir-pinch@cref}{{[section][3][4]4.3}{[1][28][]28}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces $e^+e^-\to $ 两喷注的约化割图（领头钳夹面）。$H$（振幅）与 $H^\dagger $（共轭振幅）是全部离壳线收缩成的硬点；$J_1$、$J_2$ 是分别沿类光方向 $p_1$、$p_2$ 运动的共线子图（喷注），各以一条物理极化的夸克线与 $H$、$H^\dagger $ 相连，并穿过末态切割（红色虚线）； 软子图 $S$ 只通过胶子与两个喷注相连，不与硬部分相连，其末态粒子同样穿过切割。在 Feynman 规范下喷注与硬部分之间还可以有任意多条标量（纵向）极化的共线胶子， 图中未画出（参见\cref {fig:reduced-dis}）。\relax }}{28}{figure.caption.15}\protected@file@percent }
\newlabel{fig:reduced-ee}{{4.4}{28}{$e^+e^-\to $ 两喷注的约化割图（领头钳夹面）。$H$（振幅）与 $H^\dagger $（共轭振幅）是全部离壳线收缩成的硬点；$J_1$、$J_2$ 是分别沿类光方向 $p_1$、$p_2$ 运动的共线子图（喷注），各以一条物理极化的夸克线与 $H$、$H^\dagger $ 相连，并穿过末态切割（红色虚线）； 软子图 $S$ 只通过胶子与两个喷注相连，不与硬部分相连，其末态粒子同样穿过切割。在 Feynman 规范下喷注与硬部分之间还可以有任意多条标量（纵向）极化的共线胶子， 图中未画出（参见\cref {fig:reduced-dis}）。\relax }{figure.caption.15}{}}
\newlabel{fig:reduced-ee@cref}{{[figure][4][4]4.4}{[1][28][]28}}
