\newlabel{prop:yzliu-pinch-ultrasoft}{{23.2}{318}{捏点奇点、超软模式与 $L\to \infty $ 极限 \tagA }{theorem.23.2}{}}
\newlabel{prop:yzliu-pinch-ultrasoft@cref}{{[proposition][2][23]23.2}{[1][318][]318}}
\@writefile{lof}{\contentsline {figure}{\numberline {23.1}{\ignorespaces 离光锥 TMD 软函数作为快速色源对的形状因子（$v=\gamma (1,\beta ,\mathbf  0_\perp )$、$v'=\gamma '(1,-\beta ',\mathbf  0_\perp )$，$\beta =\qopname  \relax o{tanh}Y$、$\beta '=\qopname  \relax o{tanh}Y'$，坐标 $(t,z,\vec  b_\perp )$，$\vec  b_\perp $ 方向按透视画出）。 (a)\nobreakspace  {}两个订书钉形 Wilson 回路（$t<0$ 沿 $v$，$t>0$ 沿 $v'$，在 $-t$ 与 $t'$ 处由横向连接闭合）的时序真空期望，除以 $\sqrt  {ZZ}$（$Z$ 为矩形回路）后取 $t,t'\to \infty $；箭头为路径方向：$0$ 处沿世界线指向未来（色源 $Q$），$\vec  b_\perp $ 处指向过去（$\bar  Q$）。 (b)\nobreakspace  {}等价的 HQET 图像：间隔 $b_\perp $ 的色单态静态 $Q\bar  Q$ 对以速度 $v$ 运动，在 $t=0$ 被等时的流 $J$ 踢到 $v'$，软函数是 ${}_{v'}\langle Q\bar  Q,\vec  b_\perp |J|Q\bar  Q,\vec  b_\perp \rangle _v$，因而有欧氏表示（\cref {thm:yzliu-soft-hqet}，全阶论证 [A]；非微扰的形状因子形式另需\cref {asm:yzliu-heavy-pair}）。 大快度下 $\qopname  \relax o{ln}S=(Y+Y')\tilde  K+\mathcal  D+\mathcal  {O}\!\left (\mathrm  {e}^{-(Y+Y')}\right )$，本征软函数 $S_I=\mathrm  {e}^{-\mathcal  D}$（VF-YZL-2）。\relax }}{319}{figure.caption.240}\protected@file@percent }
\newlabel{fig:yzliu-soft-hqet}{{23.1}{319}{离光锥 TMD 软函数作为快速色源对的形状因子（$v=\gamma (1,\beta ,\mathbf 0_\perp )$、$v'=\gamma '(1,-\beta ',\mathbf 0_\perp )$，$\beta =\tanh Y$、$\beta '=\tanh Y'$，坐标 $(t,z,\vec b_\perp )$，$\vec b_\perp $ 方向按透视画出）。 (a)~两个订书钉形 Wilson 回路（$t<0$ 沿 $v$，$t>0$ 沿 $v'$，在 $-t$ 与 $t'$ 处由横向连接闭合）的时序真空期望，除以 $\sqrt {ZZ}$（$Z$ 为矩形回路）后取 $t,t'\to \infty $；箭头为路径方向：$0$ 处沿世界线指向未来（色源 $Q$），$\vec b_\perp $ 处指向过去（$\bar Q$）。 (b)~等价的 HQET 图像：间隔 $b_\perp $ 的色单态静态 $Q\bar Q$ 对以速度 $v$ 运动，在 $t=0$ 被等时的流 $J$ 踢到 $v'$，软函数是 ${}_{v'}\langle Q\bar Q,\vec b_\perp |J|Q\bar Q,\vec b_\perp \rangle _v$，因而有欧氏表示（\cref {thm:yzliu-soft-hqet}，全阶论证 [A]；非微扰的形状因子形式另需\cref {asm:yzliu-heavy-pair}）。 大快度下 $\ln S=(Y+Y')\tilde K+\mathcal D+\order {\ee ^{-(Y+Y')}}$，本征软函数 $S_I=\ee ^{-\mathcal D}$（VF-YZL-2）。\relax }{figure.caption.240}{}}
\newlabel{fig:yzliu-soft-hqet@cref}{{[figure][1][23]23.1}{[1][318][]319}}
