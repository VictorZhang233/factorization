\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces 半无限 Wilson 线的动量空间规则（$k$ 流入 Wilson 线；颜色矩阵按路径排序，靠近终点者在左）：(a) 过去指向，(b) 未来指向；双线上的箭头为路径取向，空心圆为有限端点 $0$。 统一规则（VF-WL-1）：每个顶点 $\mathrm  {i}g\,t^{a_j}n^{\mu _j}$（图中只标出第一个）；有限端点与顶点之间、相邻顶点之间的每一段给一个程函传播子 $\mathrm  {i}/(n\cdot \ell +\mathrm  {i}0)$， $\ell $ 为沿路径取向流动的动量，伸向无穷远的一段 $\ell =0$、不给传播子。于是 (a) 中第 $j$ 个顶点之后的一段 $\ell =k_1+\dots  +k_j$； (b) 中第 $j$ 个顶点之前的一段 $\ell =-(k_j+\dots  +k_3)$，传播子即 $-\mathrm  {i}/(n\cdot (k_j+\dots  +k_3)-\mathrm  {i}0)$。\relax }}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:prelim-wilson-rules}{{3.2}{7}{半无限 Wilson 线的动量空间规则（$k$ 流入 Wilson 线；颜色矩阵按路径排序，靠近终点者在左）：(a) 过去指向，(b) 未来指向；双线上的箭头为路径取向，空心圆为有限端点 $0$。 统一规则（VF-WL-1）：每个顶点 $\ii g\,t^{a_j}n^{\mu _j}$（图中只标出第一个）；有限端点与顶点之间、相邻顶点之间的每一段给一个程函传播子 $\ii /(n\cdot \ell +\ii 0)$， $\ell $ 为沿路径取向流动的动量，伸向无穷远的一段 $\ell =0$、不给传播子。于是 (a) 中第 $j$ 个顶点之后的一段 $\ell =k_1+\dots +k_j$； (b) 中第 $j$ 个顶点之前的一段 $\ell =-(k_j+\dots +k_3)$，传播子即 $-\ii /(n\cdot (k_j+\dots +k_3)-\ii 0)$。\relax }{figure.caption.3}{}}
\newlabel{fig:prelim-wilson-rules@cref}{{[figure][2][3]3.2}{[1][6][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces 软胶子的程函（eikonal）近似。软胶子（绿色，动量 $k$ 流入夸克线，色指标 $a$、Lorentz 指标 $\mu $）附着在高能无质量夸克线（动量 $p$）上。 当 $k$ 的各分量都远小于 $p$ 的大分量、且不在 Glauber 区时，分子 $\bar  u(p)\gamma ^\mu ({\mathchoice {{\setbox \z@ \hbox {$\mathsurround \z@ \displaystyle p$}\setbox \tw@ \hbox {$\mathsurround \z@ \displaystyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ -0\ht \tw@ \advance \dimen@ -0\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \textstyle p$}\setbox \tw@ \hbox {$\mathsurround \z@ \textstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ -0\ht \tw@ \advance \dimen@ -0\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \scriptstyle p$}\setbox \tw@ \hbox {$\mathsurround \z@ \scriptstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ -0\ht \tw@ \advance \dimen@ -0\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \scriptscriptstyle p$}\setbox \tw@ \hbox {$\mathsurround \z@ \scriptscriptstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ -0\ht \tw@ \advance \dimen@ -0\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}}-{\mathchoice {{\setbox \z@ \hbox {$\mathsurround \z@ \displaystyle k$}\setbox \tw@ \hbox {$\mathsurround \z@ \displaystyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ --.05\ht \tw@ \advance \dimen@ --.05\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \textstyle k$}\setbox \tw@ \hbox {$\mathsurround \z@ \textstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ --.05\ht \tw@ \advance \dimen@ --.05\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \scriptstyle k$}\setbox \tw@ \hbox {$\mathsurround \z@ \scriptstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ --.05\ht \tw@ \advance \dimen@ --.05\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \scriptscriptstyle k$}\setbox \tw@ \hbox {$\mathsurround \z@ \scriptscriptstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ --.05\ht \tw@ \advance \dimen@ --.05\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}})\to 2p^\mu \bar  u(p)$、分母 $(p-k)^2+\mathrm  {i}0\to -2p\cdot k+\mathrm  {i}0$， 结果只依赖于 $p$ 的方向 $n$（对 $n$ 的标度不变），正是沿 $n$ 方向的 Wilson 线的单胶子 Feynman 规则： (a)\nobreakspace  {}出射夸克对应未来指向的 $W_n[\infty ,0]$，传播子为 $-\mathrm  {i}/(n\cdot k-\mathrm  {i}0)$；(b)\nobreakspace  {}入射夸克对应过去指向的 $W_n[0,-\infty ]$，传播子为 $\mathrm  {i}/(n\cdot k+\mathrm  {i}0)$ （顶点因子均为 $\mathrm  {i}g\,t^a n^\mu $）。Wilson 线上的箭头与被替代的夸克线的费米子数流向一致。\relax }}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:soft-eikonal}{{3.3}{8}{软胶子的程函（eikonal）近似。软胶子（绿色，动量 $k$ 流入夸克线，色指标 $a$、Lorentz 指标 $\mu $）附着在高能无质量夸克线（动量 $p$）上。 当 $k$ 的各分量都远小于 $p$ 的大分量、且不在 Glauber 区时，分子 $\bar u(p)\gamma ^\mu (\sla p-\sla k)\to 2p^\mu \bar u(p)$、分母 $(p-k)^2+\ii 0\to -2p\cdot k+\ii 0$， 结果只依赖于 $p$ 的方向 $n$（对 $n$ 的标度不变），正是沿 $n$ 方向的 Wilson 线的单胶子 Feynman 规则： (a)~出射夸克对应未来指向的 $W_n[\infty ,0]$，传播子为 $-\ii /(n\cdot k-\ii 0)$；(b)~入射夸克对应过去指向的 $W_n[0,-\infty ]$，传播子为 $\ii /(n\cdot k+\ii 0)$ （顶点因子均为 $\ii g\,t^a n^\mu $）。Wilson 线上的箭头与被替代的夸克线的费米子数流向一致。\relax }{figure.caption.4}{}}
