\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces Qiu--Sterman 软胶子极点机制（以 $A^{\uparrow }+B\to \gamma +X$ 中的 Compton 子过程 $qg\to \gamma q$ 为例；竖直虚线为末态割线）。 横向极化强子 $A^{\uparrow }$ 的扭度 3 关联函数 $T_F(x_1,x_2)$ 提供割线两侧的夸克线（$x_1P_A$、$x_2P_A$）与一条胶子线（$x_gP_A$，$x_g\equiv x_2-x_1$），后者与末态夸克 $c$ 相连。 夹在硬部分与该胶子之间的传播子（红色）携带 $p_c-(x_2-x_1)P_A$，其分母 $\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left (\vcenter to\@ne \big@size {}\right .$}\box \z@ }p_c-(x_2-x_1)P_A\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left )\vcenter to\@ne \big@size {}\right .$}\box \z@ }^2+\mathrm  {i}0=-2p_c\cdot P_A\,(x_2-x_1-\mathrm  {i}0)$ 在 $x_2\to x_1$ 时为零： $\frac  {1}{x_2-x_1-\mathrm  {i}0}$ 的 $\mathrm  {i}\pi \delta (x_2-x_1)$ 部分提供单自旋不对称所需的相位，使结果正比于 $T_F(x,x)$（“软胶子极点”）。 若胶子与初态部分子相连，$\mathrm  {i}0$ 的符号相反，色因子也不同——这与 Sivers 函数的过程依赖性相对应（参见\cref {fig:sidis-dy-links}）。\relax }}{5}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:twist3-ssa}{{1.1}{5}{Qiu--Sterman 软胶子极点机制（以 $A^{\uparrow }+B\to \gamma +X$ 中的 Compton 子过程 $qg\to \gamma q$ 为例；竖直虚线为末态割线）。 横向极化强子 $A^{\uparrow }$ 的扭度 3 关联函数 $T_F(x_1,x_2)$ 提供割线两侧的夸克线（$x_1P_A$、$x_2P_A$）与一条胶子线（$x_gP_A$，$x_g\equiv x_2-x_1$），后者与末态夸克 $c$ 相连。 夹在硬部分与该胶子之间的传播子（红色）携带 $p_c-(x_2-x_1)P_A$，其分母 $\big (p_c-(x_2-x_1)P_A\big )^2+\ii 0=-2p_c\cdot P_A\,(x_2-x_1-\ii 0)$ 在 $x_2\to x_1$ 时为零： $\frac {1}{x_2-x_1-\ii 0}$ 的 $\ii \pi \delta (x_2-x_1)$ 部分提供单自旋不对称所需的相位，使结果正比于 $T_F(x,x)$（“软胶子极点”）。 若胶子与初态部分子相连，$\ii 0$ 的符号相反，色因子也不同——这与 Sivers 函数的过程依赖性相对应（参见\cref {fig:sidis-dy-links}）。\relax }{figure.caption.4}{}}
\newlabel{fig:twist3-ssa@cref}{{[figure][1][1]1.1}{[1][5][]5}}
