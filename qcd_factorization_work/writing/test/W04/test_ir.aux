\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces Coleman--Norton 定理的时空图像（$e^+e^-$ 湮灭，$\gamma ^*$ 静止系，$z$ 轴取为喷注轴，$x^\pm =(t\pm z)/\sqrt  2$）。钳夹面上每条在壳内线 $i$ 对应一段经典自由传播 $\Delta x_i^\mu =\alpha _i l_i^\mu $（$\alpha _i\ge 0$，与该线的 Feynman 参数成正比）；由 Landau 方程，各顶点的时空位置彼此相容。离壳（硬）线的 $\alpha _i=0$，全部收缩为原点处的硬顶点 $H$； 有限动量的无质量共线粒子沿光锥 $x^-=0$（$q$ 喷注）或 $x^+=0$（$\bar  q$ 喷注）以光速运动，并可在同一光线上任意处分裂或重新结合（图中共线胶子与夸克线的夹角是为了看清而夸大的）。 动量为零的软线（绿色长波长线）不受此约束：它在 Landau 方程中的贡献 $\alpha _i l_i^\mu $ 恒为零，与 $\alpha _i$ 无关；物理上它是波长无限长、不能局域化的量子，可以在两个喷注的任意位置被发射或吸收。 绿线只是示意：它连接的两点一般是类空间隔的。\relax }}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:coleman-norton}{{1.2}{7}{Coleman--Norton 定理的时空图像（$e^+e^-$ 湮灭，$\gamma ^*$ 静止系，$z$ 轴取为喷注轴，$x^\pm =(t\pm z)/\sqrt 2$）。钳夹面上每条在壳内线 $i$ 对应一段经典自由传播 $\Delta x_i^\mu =\alpha _i l_i^\mu $（$\alpha _i\ge 0$，与该线的 Feynman 参数成正比）；由 Landau 方程，各顶点的时空位置彼此相容。离壳（硬）线的 $\alpha _i=0$，全部收缩为原点处的硬顶点 $H$； 有限动量的无质量共线粒子沿光锥 $x^-=0$（$q$ 喷注）或 $x^+=0$（$\bar q$ 喷注）以光速运动，并可在同一光线上任意处分裂或重新结合（图中共线胶子与夸克线的夹角是为了看清而夸大的）。 动量为零的软线（绿色长波长线）不受此约束：它在 Landau 方程中的贡献 $\alpha _i l_i^\mu $ 恒为零，与 $\alpha _i$ 无关；物理上它是波长无限长、不能局域化的量子，可以在两个喷注的任意位置被发射或吸收。 绿线只是示意：它连接的两点一般是类空间隔的。\relax }{figure.caption.5}{}}
\newlabel{fig:coleman-norton@cref}{{[figure][2][1]1.2}{[1][6][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces 单圈无质量顶点 $\gamma ^*(q)\to q(p_1)\,\bar  q(p_2)$ 的三个钳夹面（领头区域）。胶子动量 $k$ 由反夸克线流向夸克线， 内夸克线携带 $p_1-k$，内反夸克线携带 $p_2+k$。 (a)\nobreakspace  {}软区 $k\to 0$：两条内费米子线在壳并分别平行于 $p_1$、$p_2$（蓝、橙色区域为两个喷注），零动量胶子（绿色）构成软子图 $S$，硬部分只剩光子顶点； (b)\nobreakspace  {}$k=\alpha p_1$（$0<\alpha <1$）：胶子与内夸克线都在壳且平行于 $p_1$，同属喷注 $J_1$，而内反夸克线的虚度 $(p_2+\alpha p_1)^2=\alpha q^2$ 不小，收缩进硬部分 $H$； (c)\nobreakspace  {}$k=-\beta p_2$（$0<\beta <1$）：与 (b) 镜像对称，胶子携带物理动量 $-k=\beta p_2$ 沿 $p_2$ 方向运动并属于 $J_2$，内夸克线的虚度 $(p_1+\beta p_2)^2=\beta q^2$ 不小。 费米子线上的箭头表示费米子数流向，动量箭头单独画出。\relax }}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:vertex-regions}{{1.3}{7}{单圈无质量顶点 $\gamma ^*(q)\to q(p_1)\,\bar q(p_2)$ 的三个钳夹面（领头区域）。胶子动量 $k$ 由反夸克线流向夸克线， 内夸克线携带 $p_1-k$，内反夸克线携带 $p_2+k$。 (a)~软区 $k\to 0$：两条内费米子线在壳并分别平行于 $p_1$、$p_2$（蓝、橙色区域为两个喷注），零动量胶子（绿色）构成软子图 $S$，硬部分只剩光子顶点； (b)~$k=\alpha p_1$（$0<\alpha <1$）：胶子与内夸克线都在壳且平行于 $p_1$，同属喷注 $J_1$，而内反夸克线的虚度 $(p_2+\alpha p_1)^2=\alpha q^2$ 不小，收缩进硬部分 $H$； (c)~$k=-\beta p_2$（$0<\beta <1$）：与 (b) 镜像对称，胶子携带物理动量 $-k=\beta p_2$ 沿 $p_2$ 方向运动并属于 $J_2$，内夸克线的虚度 $(p_1+\beta p_2)^2=\beta q^2$ 不小。 费米子线上的箭头表示费米子数流向，动量箭头单独画出。\relax }{figure.caption.6}{}}
\newlabel{fig:vertex-regions@cref}{{[figure][3][1]1.3}{[1][6][]7}}
\@writefile{toc}{\contentsline {section}{\numberline {1.3}无质量 QCD 中的钳夹面与约化图}{8}{section.1.3}\protected@file@percent }
\newlabel{sec:ir-pinch}{{1.3}{8}{无质量 QCD 中的钳夹面与约化图}{section.1.3}{}}
\newlabel{sec:ir-pinch@cref}{{[section][3][1]1.3}{[1][8][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces $e^+e^-\to $ 两喷注的约化割图（领头钳夹面）。$H$（振幅）与 $H^\dagger $（共轭振幅）是全部离壳线收缩成的硬点；$J_1$、$J_2$ 是分别沿类光方向 $p_1$、$p_2$ 运动的共线子图（喷注），各以一条物理极化的夸克线与 $H$、$H^\dagger $ 相连，并穿过末态切割（红色虚线）； 软子图 $S$ 只通过胶子与两个喷注相连，不与硬部分相连，其末态粒子同样穿过切割。在 Feynman 规范下喷注与硬部分之间还可以有任意多条标量（纵向）极化的共线胶子， 图中未画出（参见\cref {fig:reduced-dis}）。\relax }}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:reduced-ee}{{1.4}{8}{$e^+e^-\to $ 两喷注的约化割图（领头钳夹面）。$H$（振幅）与 $H^\dagger $（共轭振幅）是全部离壳线收缩成的硬点；$J_1$、$J_2$ 是分别沿类光方向 $p_1$、$p_2$ 运动的共线子图（喷注），各以一条物理极化的夸克线与 $H$、$H^\dagger $ 相连，并穿过末态切割（红色虚线）； 软子图 $S$ 只通过胶子与两个喷注相连，不与硬部分相连，其末态粒子同样穿过切割。在 Feynman 规范下喷注与硬部分之间还可以有任意多条标量（纵向）极化的共线胶子， 图中未画出（参见\cref {fig:reduced-dis}）。\relax }{figure.caption.7}{}}
\newlabel{fig:reduced-ee@cref}{{[figure][4][1]1.4}{[1][8][]8}}
\newlabel{prop:ir-pinch-classification}{{1.10}{8}{钳夹面与约化图 \tagA }{theorem.1.10}{}}
\newlabel{prop:ir-pinch-classification@cref}{{[proposition][10][1]1.10}{[1][8][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces 深度非弹散射（DIS）的约化割图。靶强子 $P$ 的共线子图 $A$（蓝色）跨越末态切割，其中的旁观者（靶残余）穿过切割； $H$、$H^\dagger $ 分别是振幅与共轭振幅中的硬子图，与虚光子 $q$ 相连；被击出的夸克形成末态喷注 $J$（沿 $n_B$ 方向）并穿过切割； 软子图 $S$ 以胶子与 $A$、$J$ 相连。$A$ 与 $H$（以及 $H^\dagger $）之间除一条物理极化的夸克线外，还可以有任意多条标量（纵向）极化、 即 $\epsilon ^\mu \propto k^\mu $ 的共线胶子（蓝色，以圆点标记），它们在幂次计数中不受压低，经 Ward 恒等式后成为 PDF 定义中的 Wilson 线（\cref {fig:ward-identity}）。\relax }}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:reduced-dis}{{1.5}{9}{深度非弹散射（DIS）的约化割图。靶强子 $P$ 的共线子图 $A$（蓝色）跨越末态切割，其中的旁观者（靶残余）穿过切割； $H$、$H^\dagger $ 分别是振幅与共轭振幅中的硬子图，与虚光子 $q$ 相连；被击出的夸克形成末态喷注 $J$（沿 $n_B$ 方向）并穿过切割； 软子图 $S$ 以胶子与 $A$、$J$ 相连。$A$ 与 $H$（以及 $H^\dagger $）之间除一条物理极化的夸克线外，还可以有任意多条标量（纵向）极化、 即 $\epsilon ^\mu \propto k^\mu $ 的共线胶子（蓝色，以圆点标记），它们在幂次计数中不受压低，经 Ward 恒等式后成为 PDF 定义中的 Wilson 线（\cref {fig:ward-identity}）。\relax }{figure.caption.8}{}}
\newlabel{fig:reduced-dis@cref}{{[figure][5][1]1.5}{[1][8][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.6}{\ignorespaces Drell--Yan 过程 $A+B\to \gamma ^*+X$ 的约化割图（强子张量）。为使两个强子分列左右，切割（红色虚线）画成水平的：下半部为振幅，上半部为共轭振幅。 强子 $A$、$B$ 的共线子图（蓝、橙色）各分为振幅与共轭振幅两部分，二者之间的旁观者（强子残余）线穿过切割；硬子图 $H$、$H^\dagger $ 各由一条来自 $A$ 的夸克线与一条来自 $B$ 的反夸克线相连， 并通过电流插入与 $\gamma ^*$ 相连；软子图 $S$ 以胶子与 $A$、$B$ 相连，在切割两侧均可附着。共线子图与 $H$ 之间的纵向极化胶子未画出（参见\cref {fig:reduced-dis}）； 旁观者之间的 Glauber 交换见\cref {fig:glauber-exchange}。\relax }}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:reduced-dy}{{1.6}{9}{Drell--Yan 过程 $A+B\to \gamma ^*+X$ 的约化割图（强子张量）。为使两个强子分列左右，切割（红色虚线）画成水平的：下半部为振幅，上半部为共轭振幅。 强子 $A$、$B$ 的共线子图（蓝、橙色）各分为振幅与共轭振幅两部分，二者之间的旁观者（强子残余）线穿过切割；硬子图 $H$、$H^\dagger $ 各由一条来自 $A$ 的夸克线与一条来自 $B$ 的反夸克线相连， 并通过电流插入与 $\gamma ^*$ 相连；软子图 $S$ 以胶子与 $A$、$B$ 相连，在切割两侧均可附着。共线子图与 $H$ 之间的纵向极化胶子未画出（参见\cref {fig:reduced-dis}）； 旁观者之间的 Glauber 交换见\cref {fig:glauber-exchange}。\relax }{figure.caption.9}{}}
\newlabel{fig:reduced-dy@cref}{{[figure][6][1]1.6}{[1][8][]9}}
