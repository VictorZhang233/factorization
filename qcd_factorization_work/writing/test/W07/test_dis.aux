\@writefile{toc}{\contentsline {section}{\numberline {1.3}扭度、规范不变算符与欧氏算符乘积展开}{9}{section.1.3}\protected@file@percent }
\newlabel{sec:dis-ope}{{1.3}{9}{扭度、规范不变算符与欧氏算符乘积展开}{section.1.3}{}}
\newlabel{sec:dis-ope@cref}{{[section][3][1]1.3}{[1][9][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces 光锥算符乘积展开的图示。左：$\langle P|T\,J(x)J(0)|P\rangle $ 在 $x^2\to 0$（而 $x$ 本身不趋于零）时由两流之间夸克传播子的光锥奇异性主导 （在动量空间中，即 $Q^2\to \infty $ 时该传播子远离壳层），虚线框内为硬部分。右：硬部分收缩为 Wilson 系数 $C_n$，长程部分化为定域算符 $O_n^{\mu _1\cdots  \mu _n}(0)$（$\otimes $）的强子矩阵元； $C_n(x^2,\mu ^2)$ 在 $x^2\to 0$ 时的行为为 $(x^2)^{(\tau _n-6)/2}$ 乘以对数修正（$\tau _n$ 为 $O_n$ 的扭度），故扭度越高奇异性越弱，$\cdots  $ 即表示这些高扭度项。领头项为扭度 $2$ 的算符 $O_q^{\mu _1\cdots  \mu _n}=\bar  \psi \gamma ^{\{\mu _1}\mathrm  {i}D^{\mu _2}\cdots  \mathrm  {i}D^{\mu _n\}}\psi -(\text  {迹})$ 及其胶子对应物；由于协变导数，$\otimes $ 处还可连接任意多条胶子线。 与短距离展开不同，光锥展开的每一扭度都含有对所有 $n$ 的无穷求和。\relax }}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:ope-schematic}{{1.4}{9}{光锥算符乘积展开的图示。左：$\langle P|T\,J(x)J(0)|P\rangle $ 在 $x^2\to 0$（而 $x$ 本身不趋于零）时由两流之间夸克传播子的光锥奇异性主导 （在动量空间中，即 $Q^2\to \infty $ 时该传播子远离壳层），虚线框内为硬部分。右：硬部分收缩为 Wilson 系数 $C_n$，长程部分化为定域算符 $O_n^{\mu _1\cdots \mu _n}(0)$（$\otimes $）的强子矩阵元； $C_n(x^2,\mu ^2)$ 在 $x^2\to 0$ 时的行为为 $(x^2)^{(\tau _n-6)/2}$ 乘以对数修正（$\tau _n$ 为 $O_n$ 的扭度），故扭度越高奇异性越弱，$\cdots $ 即表示这些高扭度项。领头项为扭度 $2$ 的算符 $O_q^{\mu _1\cdots \mu _n}=\bar \psi \gamma ^{\{\mu _1}\ii D^{\mu _2}\cdots \ii D^{\mu _n\}}\psi -(\text {迹})$ 及其胶子对应物；由于协变导数，$\otimes $ 处还可连接任意多条胶子线。 与短距离展开不同，光锥展开的每一扭度都含有对所有 $n$ 的无穷求和。\relax }{figure.caption.7}{}}
\newlabel{fig:ope-schematic@cref}{{[figure][4][1]1.4}{[1][9][]9}}
