\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces Sterman--Weinberg 两喷注定义（$e^+e^-$质心系，示意；线段为各粒子的飞行方向）：若存在一对方向相反、半张角为$\delta $的锥（锥轴可任意选取），使两锥之外的总能量小于$\epsilon \sqrt  s$，则事例计为两喷注事例。 $\epsilon $是总能量$\sqrt  s$的份额；在$\epsilon <\delta \ll 1$时$\mathcal  {O}\!\left (\alpha _s\right )$的结果含$4\qopname  \relax o{ln}\delta \qopname  \relax o{ln}2\epsilon $（若$\epsilon '$取为束流能量的份额，则为$4\qopname  \relax o{ln}\delta \qopname  \relax o{ln}\epsilon '$；\cref {prop:jets-sw}，VF-EE-12）。\relax }}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:jets-sw-cone}{{1.1}{2}{Sterman--Weinberg 两喷注定义（$e^+e^-$质心系，示意；线段为各粒子的飞行方向）：若存在一对方向相反、半张角为$\delta $的锥（锥轴可任意选取），使两锥之外的总能量小于$\epsilon \sqrt s$，则事例计为两喷注事例。 $\epsilon $是总能量$\sqrt s$的份额；在$\epsilon <\delta \ll 1$时$\order {\alpha _s}$的结果含$4\ln \delta \ln 2\epsilon $（若$\epsilon '$取为束流能量的份额，则为$4\ln \delta \ln \epsilon '$；\cref {prop:jets-sw}，VF-EE-12）。\relax }{figure.caption.2}{}}
