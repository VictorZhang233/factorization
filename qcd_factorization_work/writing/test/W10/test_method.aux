\@writefile{lof}{\contentsline {figure}{\numberline {1.9}{\ignorespaces 软胶子动量 $k$（固定 $k^+$、$k_T$，$k_T\sim \lambda Q$）在复 $k^-$ 平面上的 Glauber 区分析。阴影带为 Glauber 区 $|k^-|\lesssim k_T^2/Q$； 图中极点来自 $k$ 流经的 $A$ 共线传播子，位于 $|k^-|\sim k_T^2/Q$。约定 $k$ 在附着顶点从 $A$ 子图流出，并取末态旁观者动量 $p_X$ 固定： Glauber 顶点之前的旁观者线 $l_s=p_X+k$ 中 $k$ 与大分量 $l_s^+$ 同向，极点在下半平面；进入 $H$ 的活动部分子线 $l_a=P_A-p_X-k$ 中 $k$ 与 $l_a^+$ 反向，极点在上半平面（$k$ 流入时上下互换）。 $B$ 共线线与胶子传播子本身给出的 $k^-$ 极点位于 $|k^-|\sim Q$，在图外。 (a)\nobreakspace  {}所有 $A$ 共线极点在同一侧：围道可向另一侧变形到 $|k^-|\sim |k_T|$，在那里软近似成立； (b)\nobreakspace  {}旁观者线与活动部分子线的极点分居两侧：围道被钳在 Glauber 区内（Glauber 钳夹）。 仅有 $k^-$ 钳夹并不致命：若胶子另一端的线（如 DIS 中出射的被击出夸克）给出的 $k^+$ 极点都在同一侧，仍可把 $k^+$ 围道变形到 $|k^+|\sim |k_T|$，使该端的程函近似成立； Drell--Yan 中 $B$ 一侧的 $k^+$ 围道同样被钳住，这一钳夹只有在对末态切割求和之后才被消除（\cref {fig:glauber-exchange}）。\relax }}{29}{figure.caption.20}\protected@file@percent }
\newlabel{fig:glauber-contour}{{1.9}{29}{软胶子动量 $k$（固定 $k^+$、$k_T$，$k_T\sim \lambda Q$）在复 $k^-$ 平面上的 Glauber 区分析。阴影带为 Glauber 区 $|k^-|\lesssim k_T^2/Q$； 图中极点来自 $k$ 流经的 $A$ 共线传播子，位于 $|k^-|\sim k_T^2/Q$。约定 $k$ 在附着顶点从 $A$ 子图流出，并取末态旁观者动量 $p_X$ 固定： Glauber 顶点之前的旁观者线 $l_s=p_X+k$ 中 $k$ 与大分量 $l_s^+$ 同向，极点在下半平面；进入 $H$ 的活动部分子线 $l_a=P_A-p_X-k$ 中 $k$ 与 $l_a^+$ 反向，极点在上半平面（$k$ 流入时上下互换）。 $B$ 共线线与胶子传播子本身给出的 $k^-$ 极点位于 $|k^-|\sim Q$，在图外。 (a)~所有 $A$ 共线极点在同一侧：围道可向另一侧变形到 $|k^-|\sim |k_T|$，在那里软近似成立； (b)~旁观者线与活动部分子线的极点分居两侧：围道被钳在 Glauber 区内（Glauber 钳夹）。 仅有 $k^-$ 钳夹并不致命：若胶子另一端的线（如 DIS 中出射的被击出夸克）给出的 $k^+$ 极点都在同一侧，仍可把 $k^+$ 围道变形到 $|k^+|\sim |k_T|$，使该端的程函近似成立； Drell--Yan 中 $B$ 一侧的 $k^+$ 围道同样被钳住，这一钳夹只有在对末态切割求和之后才被消除（\cref {fig:glauber-exchange}）。\relax }{figure.caption.20}{}}
\newlabel{fig:glauber-contour@cref}{{[figure][9][1]1.9}{[1][28][]29}}
