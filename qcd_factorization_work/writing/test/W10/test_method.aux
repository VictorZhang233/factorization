\@writefile{toc}{\contentsline {section}{\numberline {1.3}Grammer--Yennie 分解}{12}{section.1.3}\protected@file@percent }
\newlabel{sec:method-gy}{{1.3}{12}{Grammer--Yennie 分解}{section.1.3}{}}
\newlabel{sec:method-gy@cref}{{[section][3][1]1.3}{[1][11][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces 共线胶子的 Grammer--Yennie 分解（Feynman 规范；$k$ 由 $A$ 共线子图流入硬部分，$\mu $ 为硬端、$\nu $ 为共线端的指标）。 $g_{\mu \nu }=K_{\mu \nu }+G_{\mu \nu }$：K 部分（蓝色，圆点标出带标量极化 $k_\mu $ 的硬端）的共线端只取 $A^+=n_B\cdot A$ 分量；对 $H$ 内一切附着求和后，由 Ward 恒等式，K 胶子改为附着在沿 $n_B$ 的 Wilson 线上，乘以不含该胶子的硬部分 $H_0$（左下；$-\mathrm  {i}0$ 对应末态附着，即 DIS 中未来指向的线，初态附着取 $+\mathrm  {i}0$）； G 部分满足 $G_{\mu \nu }k^\nu =0$，每多一条 G 胶子至少压低 $\lambda $。例外（右下）：作为活动部分子的单个横向胶子（此处为 $\gamma ^*g\to q\bar  q$），由 Ward 恒等式 $k_\mu H^\mu =0$，其 G 项是领头的，与 $k^+A^j-k^jA^+$ 组成场强 $G^{+j}$。\relax }}{12}{figure.caption.10}\protected@file@percent }
