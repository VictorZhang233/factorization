\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces 光生过程 $\gamma p\to \text  {jets}+X$（振幅示意）。(a)\nobreakspace  {}直接光子：光子直接参与硬散射 $H$，只有质子一侧有部分子分布 $f_{i/p}$ 与旁观者 $X_p$，与 DIS 同为单强子过程，因子化为全阶论证 [A]（\cref {thm:coll-direct-photo}）； (b)\nobreakspace  {}分辨光子：光子先“强子化”为由光子部分子分布 $f_{j/\gamma }$ 描述的部分子云，提供进入硬散射的部分子（动量份额 $x_\gamma $），光子一侧也有旁观者 $X_\gamma $， 等效于末态有色的强子—强子过程，旁观者之间可交换 Glauber 胶子（暗红色），因子化为猜想 [C]（\cref {conj:coll-resolved-photo}）。\relax }}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:coll-photoproduction}{{1.1}{1}{光生过程 $\gamma p\to \text {jets}+X$（振幅示意）。(a)~直接光子：光子直接参与硬散射 $H$，只有质子一侧有部分子分布 $f_{i/p}$ 与旁观者 $X_p$，与 DIS 同为单强子过程，因子化为全阶论证 [A]（\cref {thm:coll-direct-photo}）； (b)~分辨光子：光子先“强子化”为由光子部分子分布 $f_{j/\gamma }$ 描述的部分子云，提供进入硬散射的部分子（动量份额 $x_\gamma $），光子一侧也有旁观者 $X_\gamma $， 等效于末态有色的强子—强子过程，旁观者之间可交换 Glauber 胶子（暗红色），因子化为猜想 [C]（\cref {conj:coll-resolved-photo}）。\relax }{figure.caption.1}{}}
\newlabel{fig:coll-photoproduction@cref}{{[figure][1][1]1.1}{[1][1][]1}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces $e^+e^-\to \gamma ^*\to hX$ 的领头区域（约化割图；竖直虚线为末态割线，左侧为振幅、右侧为共轭振幅）。 硬子图 $H$、$H^\dagger $ 产生两个喷注：被观测强子 $h$（动量 $p_h$，$z=2p_h\cdot q/q^2$，粗线穿过割线）所在的喷注 $J_1$ 给出碎裂函数 $d_{h/q}(z/y)$，$y$ 为碎裂部分子（动量 $k$）的相应份额； 未观测的喷注 $J_2$ 与软子图 $S$ 也穿过割线，它们在对末态的割线求和中由幺正性相消（\cref {lem:coll-unobserved-jet}），软因子为 $1$；全部共线线都是出射的，Glauber 区没有钳夹（\cref {lem:coll-final-poles}）。\relax }}{2}{figure.caption.2}\protected@file@percent }
\newlabel{fig:coll-sia}{{1.2}{2}{$e^+e^-\to \gamma ^*\to hX$ 的领头区域（约化割图；竖直虚线为末态割线，左侧为振幅、右侧为共轭振幅）。 硬子图 $H$、$H^\dagger $ 产生两个喷注：被观测强子 $h$（动量 $p_h$，$z=2p_h\cdot q/q^2$，粗线穿过割线）所在的喷注 $J_1$ 给出碎裂函数 $d_{h/q}(z/y)$，$y$ 为碎裂部分子（动量 $k$）的相应份额； 未观测的喷注 $J_2$ 与软子图 $S$ 也穿过割线，它们在对末态的割线求和中由幺正性相消（\cref {lem:coll-unobserved-jet}），软因子为 $1$；全部共线线都是出射的，Glauber 区没有钳夹（\cref {lem:coll-final-poles}）。\relax }{figure.caption.2}{}}
\newlabel{fig:coll-sia@cref}{{[figure][2][1]1.2}{[1][1][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces 半单举 DIS $\ell A\to \ell ' hX$ 的共线因子化（割图示意；竖直虚线为末态割线，左侧为振幅）。 靶 $A$ 的共线子图给出部分子分布 $f_{i/A}(\xi )$（蓝色，沿 $+z$），流出硬部分的部分子 $j$ 碎裂为被观测强子 $h$（粗线穿过割线），给出碎裂函数 $d_{h/j}(\zeta )$（橙色）； $P_{hT}\sim Q$ 时 $h$ 的横动量来自硬辐射 $X_H$，截面为 $f\otimes \mathrm  {d}\hat  \sigma \otimes d$ 的共线因子化形式；$P_{hT}\ll Q$ 时需要 TMD 因子化，二者在中间区域由 $W+Y$ 衔接（\cref {ch:tmd}）。\relax }}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:coll-sidis}{{1.3}{2}{半单举 DIS $\ell A\to \ell ' hX$ 的共线因子化（割图示意；竖直虚线为末态割线，左侧为振幅）。 靶 $A$ 的共线子图给出部分子分布 $f_{i/A}(\xi )$（蓝色，沿 $+z$），流出硬部分的部分子 $j$ 碎裂为被观测强子 $h$（粗线穿过割线），给出碎裂函数 $d_{h/j}(\zeta )$（橙色）； $P_{hT}\sim Q$ 时 $h$ 的横动量来自硬辐射 $X_H$，截面为 $f\otimes \dd \hat \sigma \otimes d$ 的共线因子化形式；$P_{hT}\ll Q$ 时需要 TMD 因子化，二者在中间区域由 $W+Y$ 衔接（\cref {ch:tmd}）。\relax }{figure.caption.3}{}}
\newlabel{fig:coll-sidis@cref}{{[figure][3][1]1.3}{[1][1][]2}}
