\@writefile{lof}{\contentsline {figure}{\numberline {1.49}{\ignorespaces 屏蔽与反屏蔽的直观图像（示意）。(a) QED：真空中的虚电子—正电子对屏蔽电荷，有效耦合在远处变小； (b) QCD：夸克对同样屏蔽（$-\frac  43T_Fn_f$），而带色的胶子把色荷“涂抹”到更大的区域，在短距离处看到的色荷变小（反屏蔽，$+\frac  {11}3C_A$）； (c) 两种理论的有效耦合随距离的变化趋势。二者之和 $\beta _0>0$（SU(3) 中 $n_f\le 16$）。 这只是启发式图像：规范无关的推导见\cref {prop:prelim-beta}，把反屏蔽解释为胶子自旋的顺磁效应见\cite  {Nielsen:1980sx}。\relax }}{50}{figure.caption.49}\protected@file@percent }
\newlabel{fig:qcd-antiscreening}{{1.49}{50}{屏蔽与反屏蔽的直观图像（示意）。(a) QED：真空中的虚电子—正电子对屏蔽电荷，有效耦合在远处变小； (b) QCD：夸克对同样屏蔽（$-\frac 43T_Fn_f$），而带色的胶子把色荷“涂抹”到更大的区域，在短距离处看到的色荷变小（反屏蔽，$+\frac {11}3C_A$）； (c) 两种理论的有效耦合随距离的变化趋势。二者之和 $\beta _0>0$（SU(3) 中 $n_f\le 16$）。 这只是启发式图像：规范无关的推导见\cref {prop:prelim-beta}，把反屏蔽解释为胶子自旋的顺磁效应见\cite {Nielsen:1980sx}。\relax }{figure.caption.49}{}}
\newlabel{fig:qcd-antiscreening@cref}{{[figure][49][1]1.49}{[1][50][]50}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.50}{\ignorespaces 红外发散与红外安全（示意）。(a) 无质量夸克发射胶子：传播子在软（$E_k\to 0$）与共线（$\theta \to 0$）极限下发散； (b) 对足够单举的量，实发射与虚修正的发散相消（$e^+e^-$ 总截面，VF-EE-6；$N_\varepsilon $ 为两者共同的归一化因子，以 Born 截面 $\sigma _0$ 为单位，见\cref {prop:ee-oneloop}）； (c) 红外安全可观测量在软发射与共线劈裂下取值不变，因而可以逐阶微扰计算（精确定义见\cref {def:ir-safe}）。\relax }}{51}{figure.caption.50}\protected@file@percent }
\newlabel{fig:qcd-ir-safety}{{1.50}{51}{红外发散与红外安全（示意）。(a) 无质量夸克发射胶子：传播子在软（$E_k\to 0$）与共线（$\theta \to 0$）极限下发散； (b) 对足够单举的量，实发射与虚修正的发散相消（$e^+e^-$ 总截面，VF-EE-6；$N_\varepsilon $ 为两者共同的归一化因子，以 Born 截面 $\sigma _0$ 为单位，见\cref {prop:ee-oneloop}）； (c) 红外安全可观测量在软发射与共线劈裂下取值不变，因而可以逐阶微扰计算（精确定义见\cref {def:ir-safe}）。\relax }{figure.caption.50}{}}
\newlabel{fig:qcd-ir-safety@cref}{{[figure][50][1]1.50}{[1][51][]51}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.51}{\ignorespaces 规范固定与 Faddeev--Popov 行列式（示意）：规范固定曲面与每条规范轨道相交一次，交点处的 Jacobian 给出鬼场。 在远离 $A=0$ 的大场强区域，规范固定曲面可能与同一条轨道相交多次（Gribov 复本，红点）；它们在微扰论的任何一阶中都不出现。\relax }}{52}{figure.caption.51}\protected@file@percent }
\newlabel{fig:qcd-gauge-orbit}{{1.51}{52}{规范固定与 Faddeev--Popov 行列式（示意）：规范固定曲面与每条规范轨道相交一次，交点处的 Jacobian 给出鬼场。 在远离 $A=0$ 的大场强区域，规范固定曲面可能与同一条轨道相交多次（Gribov 复本，红点）；它们在微扰论的任何一阶中都不出现。\relax }{figure.caption.51}{}}
