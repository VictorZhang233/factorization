\@writefile{lof}{\contentsline {figure}{\numberline {1.116}{\ignorespaces 手提包图（前向 Compton 振幅，未切割）的两种读法：(a)\nobreakspace  {}作为正规乘积展开中的 AB 部分——含两个流顶点的子图 $\gamma $（$q$ 冻结在其中）给出系数 $C^{(n)}(q)$，把 $\gamma $ 收缩为一点后其余部分给出局域算符 $O^{(n)}$ 的矩阵元（$\propto A^{(n)}$）； (b)\nobreakspace  {}作为区域分析中的约化图——硬顶点 $H$ 与靶（沿 $+z$ 运动）的共线子图 $J_A$ 由平行于 $n_A$ 的共线线相连。 在有质量模型中两种读法的重叠由超减除分开；无质量 QCD 中还需要红外抵消项（\cref {sec:appM-massless}）。\relax }}{117}{figure.caption.116}\protected@file@percent }
\newlabel{fig:appM-handbag-ab}{{1.116}{117}{手提包图（前向 Compton 振幅，未切割）的两种读法：(a)~作为正规乘积展开中的 AB 部分——含两个流顶点的子图 $\gamma $（$q$ 冻结在其中）给出系数 $C^{(n)}(q)$，把 $\gamma $ 收缩为一点后其余部分给出局域算符 $O^{(n)}$ 的矩阵元（$\propto A^{(n)}$）； (b)~作为区域分析中的约化图——硬顶点 $H$ 与靶（沿 $+z$ 运动）的共线子图 $J_A$ 由平行于 $n_A$ 的共线线相连。 在有质量模型中两种读法的重叠由超减除分开；无质量 QCD 中还需要红外抵消项（\cref {sec:appM-massless}）。\relax }{figure.caption.116}{}}
