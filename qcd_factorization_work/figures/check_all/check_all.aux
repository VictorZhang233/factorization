\@writefile{lof}{\contentsline {figure}{\numberline {1.12}{\ignorespaces 强子—强子碰撞 $A+B\to Y+X$ 中共线因子化的图示（$Y$ 为被观测的硬末态，例如 Drell--Yan 过程中的 $\gamma ^*\to \ell ^+\ell ^-$）。 左：完整的割图，$X$ 为未观测末态。右：领头幂次下，割图分解为强子 $A$、$B$ 的部分子分布 $f_{i/A}(\xi _a;\mu )$、$f_{j/B}(\xi _b;\mu )$ （割图形式见\cref {fig:pdf-operator}，剩余部分包含在其中）与可微扰计算的硬部分 $H_{ij}$（由振幅 $H$ 与共轭振幅 $H^*$ 组成，$Y$ 穿过割线）， 二者通过部分子动量分数 $\xi _a$、$\xi _b$ 的卷积相连：$\sigma =\DOTSB \sum@ \slimits@ _{i,j}H_{ij}\otimes f_{i/A}\otimes f_{j/B}+\mathcal  {O}\!\left ((\Lambda /Q)^p\right )$。 软胶子与 Glauber 胶子的交换在单举截面中相消（对 Drell--Yan 过程这一步只有全阶论证），因此右图中没有软因子。\relax }}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:factorization-schematic}{{1.12}{13}{强子—强子碰撞 $A+B\to Y+X$ 中共线因子化的图示（$Y$ 为被观测的硬末态，例如 Drell--Yan 过程中的 $\gamma ^*\to \ell ^+\ell ^-$）。 左：完整的割图，$X$ 为未观测末态。右：领头幂次下，割图分解为强子 $A$、$B$ 的部分子分布 $f_{i/A}(\xi _a;\mu )$、$f_{j/B}(\xi _b;\mu )$ （割图形式见\cref {fig:pdf-operator}，剩余部分包含在其中）与可微扰计算的硬部分 $H_{ij}$（由振幅 $H$ 与共轭振幅 $H^*$ 组成，$Y$ 穿过割线）， 二者通过部分子动量分数 $\xi _a$、$\xi _b$ 的卷积相连：$\sigma =\sum _{i,j}H_{ij}\otimes f_{i/A}\otimes f_{j/B}+\order {(\Lambda /Q)^p}$。 软胶子与 Glauber 胶子的交换在单举截面中相消（对 Drell--Yan 过程这一步只有全阶论证），因此右图中没有软因子。\relax }{figure.caption.12}{}}
\newlabel{fig:factorization-schematic@cref}{{[figure][12][1]1.12}{[1][13][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.13}{\ignorespaces 复 $k^-$ 平面中积分围道（蓝色）的形变与 Landau 奇异性。灰色虚箭头表示外部参数趋近奇异点（或 $\mathrm  {i}0\to 0$）时极点的移动方向。 (a)\nobreakspace  {}两个极点位于实轴同侧（此处都在下半平面）：即使它们趋近实轴，围道也可以向另一侧（上半平面）形变而远离极点，积分保持解析； (b)\nobreakspace  {}两个极点从实轴两侧相向趋近同一点：围道被夹在两者之间，无论向哪一侧形变都要越过一个极点，这就是 Landau 方程所刻画的钳夹（pinch）奇异性； (c)\nobreakspace  {}极点趋近积分区间的端点 $a$：端点不能移动，围道在端点附近无法避开极点，产生端点奇异性。 只有 (b)、(c) 两种情形可能使积分作为外部参数的函数出现奇异性。多维积分中，奇异性要求积分围道（超曲面）在所有方向上都无法形变避开奇点，由此导出 Landau 方程。\relax }}{14}{figure.caption.13}\protected@file@percent }
\newlabel{fig:landau-pinch}{{1.13}{14}{复 $k^-$ 平面中积分围道（蓝色）的形变与 Landau 奇异性。灰色虚箭头表示外部参数趋近奇异点（或 $\ii 0\to 0$）时极点的移动方向。 (a)~两个极点位于实轴同侧（此处都在下半平面）：即使它们趋近实轴，围道也可以向另一侧（上半平面）形变而远离极点，积分保持解析； (b)~两个极点从实轴两侧相向趋近同一点：围道被夹在两者之间，无论向哪一侧形变都要越过一个极点，这就是 Landau 方程所刻画的钳夹（pinch）奇异性； (c)~极点趋近积分区间的端点 $a$：端点不能移动，围道在端点附近无法避开极点，产生端点奇异性。 只有 (b)、(c) 两种情形可能使积分作为外部参数的函数出现奇异性。多维积分中，奇异性要求积分围道（超曲面）在所有方向上都无法形变避开奇点，由此导出 Landau 方程。\relax }{figure.caption.13}{}}
\newlabel{fig:landau-pinch@cref}{{[figure][13][1]1.13}{[1][14][]14}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.14}{\ignorespaces 单圈无质量顶点 $\gamma ^*(q)\to q(p_1)\,\bar  q(p_2)$ 的三个钳夹面（领头区域）。胶子动量 $k$ 由反夸克线流向夸克线， 内夸克线携带 $p_1-k$，内反夸克线携带 $p_2+k$。 (a)\nobreakspace  {}软区 $k\to 0$：两条内费米子线在壳并分别平行于 $p_1$、$p_2$（蓝、橙色区域为两个喷注），零动量胶子（绿色）构成软子图 $S$，硬部分只剩光子顶点； (b)\nobreakspace  {}$k=\alpha p_1$（$0<\alpha <1$）：胶子与内夸克线都在壳且平行于 $p_1$，同属喷注 $J_1$，而内反夸克线的虚度 $(p_2+\alpha p_1)^2=\alpha q^2$ 不小，收缩进硬部分 $H$； (c)\nobreakspace  {}$k=-\beta p_2$（$0<\beta <1$）：与 (b) 镜像对称，胶子携带物理动量 $-k=\beta p_2$ 沿 $p_2$ 方向运动并属于 $J_2$，内夸克线的虚度 $(p_1+\beta p_2)^2=\beta q^2$ 不小。 费米子线上的箭头表示费米子数流向，动量箭头单独画出。\relax }}{15}{figure.caption.14}\protected@file@percent }
\newlabel{fig:vertex-regions}{{1.14}{15}{单圈无质量顶点 $\gamma ^*(q)\to q(p_1)\,\bar q(p_2)$ 的三个钳夹面（领头区域）。胶子动量 $k$ 由反夸克线流向夸克线， 内夸克线携带 $p_1-k$，内反夸克线携带 $p_2+k$。 (a)~软区 $k\to 0$：两条内费米子线在壳并分别平行于 $p_1$、$p_2$（蓝、橙色区域为两个喷注），零动量胶子（绿色）构成软子图 $S$，硬部分只剩光子顶点； (b)~$k=\alpha p_1$（$0<\alpha <1$）：胶子与内夸克线都在壳且平行于 $p_1$，同属喷注 $J_1$，而内反夸克线的虚度 $(p_2+\alpha p_1)^2=\alpha q^2$ 不小，收缩进硬部分 $H$； (c)~$k=-\beta p_2$（$0<\beta <1$）：与 (b) 镜像对称，胶子携带物理动量 $-k=\beta p_2$ 沿 $p_2$ 方向运动并属于 $J_2$，内夸克线的虚度 $(p_1+\beta p_2)^2=\beta q^2$ 不小。 费米子线上的箭头表示费米子数流向，动量箭头单独画出。\relax }{figure.caption.14}{}}
\newlabel{fig:vertex-regions@cref}{{[figure][14][1]1.14}{[1][15][]15}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.15}{\ignorespaces Coleman--Norton 定理的时空图像（$e^+e^-$ 湮灭，$\gamma ^*$ 静止系，$z$ 轴取为喷注轴，$x^\pm =(t\pm z)/\sqrt  2$）。钳夹面上每条在壳内线 $i$ 对应一段经典自由传播 $\Delta x_i^\mu =\alpha _i l_i^\mu $（$\alpha _i\ge 0$，与该线的 Feynman 参数成正比）；由 Landau 方程，各顶点的时空位置彼此相容。离壳（硬）线的 $\alpha _i=0$，全部收缩为原点处的硬顶点 $H$； 有限动量的无质量共线粒子沿光锥 $x^-=0$（$q$ 喷注）或 $x^+=0$（$\bar  q$ 喷注）以光速运动，并可在同一光线上任意处分裂或重新结合（图中共线胶子与夸克线的夹角是为了看清而夸大的）。 动量为零的软线（绿色长波长线）不受此约束：它在 Landau 方程中的贡献 $\alpha _i l_i^\mu $ 恒为零，与 $\alpha _i$ 无关；物理上它是波长无限长、不能局域化的量子，可以在两个喷注的任意位置被发射或吸收。 绿线只是示意：它连接的两点一般是类空间隔的。\relax }}{16}{figure.caption.15}\protected@file@percent }
\newlabel{fig:coleman-norton}{{1.15}{16}{Coleman--Norton 定理的时空图像（$e^+e^-$ 湮灭，$\gamma ^*$ 静止系，$z$ 轴取为喷注轴，$x^\pm =(t\pm z)/\sqrt 2$）。钳夹面上每条在壳内线 $i$ 对应一段经典自由传播 $\Delta x_i^\mu =\alpha _i l_i^\mu $（$\alpha _i\ge 0$，与该线的 Feynman 参数成正比）；由 Landau 方程，各顶点的时空位置彼此相容。离壳（硬）线的 $\alpha _i=0$，全部收缩为原点处的硬顶点 $H$； 有限动量的无质量共线粒子沿光锥 $x^-=0$（$q$ 喷注）或 $x^+=0$（$\bar q$ 喷注）以光速运动，并可在同一光线上任意处分裂或重新结合（图中共线胶子与夸克线的夹角是为了看清而夸大的）。 动量为零的软线（绿色长波长线）不受此约束：它在 Landau 方程中的贡献 $\alpha _i l_i^\mu $ 恒为零，与 $\alpha _i$ 无关；物理上它是波长无限长、不能局域化的量子，可以在两个喷注的任意位置被发射或吸收。 绿线只是示意：它连接的两点一般是类空间隔的。\relax }{figure.caption.15}{}}
\newlabel{fig:coleman-norton@cref}{{[figure][15][1]1.15}{[1][16][]16}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.16}{\ignorespaces $e^+e^-\to $ 两喷注的约化割图（领头钳夹面）。$H$（振幅）与 $H^\dagger $（共轭振幅）是全部离壳线收缩成的硬点；$J_1$、$J_2$ 是分别沿类光方向 $p_1$、$p_2$ 运动的共线子图（喷注），各以一条物理极化的夸克线与 $H$、$H^\dagger $ 相连，并穿过末态切割（红色虚线）； 软子图 $S$ 只通过胶子与两个喷注相连，不与硬部分相连，其末态粒子同样穿过切割。在 Feynman 规范下喷注与硬部分之间还可以有任意多条标量（纵向）极化的共线胶子， 图中未画出（参见\cref {fig:reduced-dis}）。\relax }}{17}{figure.caption.16}\protected@file@percent }
\newlabel{fig:reduced-ee}{{1.16}{17}{$e^+e^-\to $ 两喷注的约化割图（领头钳夹面）。$H$（振幅）与 $H^\dagger $（共轭振幅）是全部离壳线收缩成的硬点；$J_1$、$J_2$ 是分别沿类光方向 $p_1$、$p_2$ 运动的共线子图（喷注），各以一条物理极化的夸克线与 $H$、$H^\dagger $ 相连，并穿过末态切割（红色虚线）； 软子图 $S$ 只通过胶子与两个喷注相连，不与硬部分相连，其末态粒子同样穿过切割。在 Feynman 规范下喷注与硬部分之间还可以有任意多条标量（纵向）极化的共线胶子， 图中未画出（参见\cref {fig:reduced-dis}）。\relax }{figure.caption.16}{}}
\newlabel{fig:reduced-ee@cref}{{[figure][16][1]1.16}{[1][17][]17}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.17}{\ignorespaces 深度非弹散射（DIS）的约化割图。靶强子 $P$ 的共线子图 $A$（蓝色）跨越末态切割，其中的旁观者（靶残余）穿过切割； $H$、$H^\dagger $ 分别是振幅与共轭振幅中的硬子图，与虚光子 $q$ 相连；被击出的夸克形成末态喷注 $J$（沿 $n_B$ 方向）并穿过切割； 软子图 $S$ 以胶子与 $A$、$J$ 相连。$A$ 与 $H$（以及 $H^\dagger $）之间除一条物理极化的夸克线外，还可以有任意多条标量（纵向）极化、 即 $\epsilon ^\mu \propto k^\mu $ 的共线胶子（蓝色，以圆点标记），它们在幂次计数中不受压低，经 Ward 恒等式后成为 PDF 定义中的 Wilson 线（\cref {fig:ward-identity}）。\relax }}{18}{figure.caption.17}\protected@file@percent }
\newlabel{fig:reduced-dis}{{1.17}{18}{深度非弹散射（DIS）的约化割图。靶强子 $P$ 的共线子图 $A$（蓝色）跨越末态切割，其中的旁观者（靶残余）穿过切割； $H$、$H^\dagger $ 分别是振幅与共轭振幅中的硬子图，与虚光子 $q$ 相连；被击出的夸克形成末态喷注 $J$（沿 $n_B$ 方向）并穿过切割； 软子图 $S$ 以胶子与 $A$、$J$ 相连。$A$ 与 $H$（以及 $H^\dagger $）之间除一条物理极化的夸克线外，还可以有任意多条标量（纵向）极化、 即 $\epsilon ^\mu \propto k^\mu $ 的共线胶子（蓝色，以圆点标记），它们在幂次计数中不受压低，经 Ward 恒等式后成为 PDF 定义中的 Wilson 线（\cref {fig:ward-identity}）。\relax }{figure.caption.17}{}}
\newlabel{fig:reduced-dis@cref}{{[figure][17][1]1.17}{[1][18][]18}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.18}{\ignorespaces Drell--Yan 过程 $A+B\to \gamma ^*+X$ 的约化割图（强子张量）。为使两个强子分列左右，切割（红色虚线）画成水平的：下半部为振幅，上半部为共轭振幅。 强子 $A$、$B$ 的共线子图（蓝、橙色）各分为振幅与共轭振幅两部分，二者之间的旁观者（强子残余）线穿过切割；硬子图 $H$、$H^\dagger $ 各由一条来自 $A$ 的夸克线与一条来自 $B$ 的反夸克线相连， 并通过电流插入与 $\gamma ^*$ 相连；软子图 $S$ 以胶子与 $A$、$B$ 相连，在切割两侧均可附着。共线子图与 $H$ 之间的纵向极化胶子未画出（参见\cref {fig:reduced-dis}）； 旁观者之间的 Glauber 交换见\cref {fig:glauber-exchange}。\relax }}{19}{figure.caption.18}\protected@file@percent }
\newlabel{fig:reduced-dy}{{1.18}{19}{Drell--Yan 过程 $A+B\to \gamma ^*+X$ 的约化割图（强子张量）。为使两个强子分列左右，切割（红色虚线）画成水平的：下半部为振幅，上半部为共轭振幅。 强子 $A$、$B$ 的共线子图（蓝、橙色）各分为振幅与共轭振幅两部分，二者之间的旁观者（强子残余）线穿过切割；硬子图 $H$、$H^\dagger $ 各由一条来自 $A$ 的夸克线与一条来自 $B$ 的反夸克线相连， 并通过电流插入与 $\gamma ^*$ 相连；软子图 $S$ 以胶子与 $A$、$B$ 相连，在切割两侧均可附着。共线子图与 $H$ 之间的纵向极化胶子未画出（参见\cref {fig:reduced-dis}）； 旁观者之间的 Glauber 交换见\cref {fig:glauber-exchange}。\relax }{figure.caption.18}{}}
\newlabel{fig:reduced-dy@cref}{{[figure][18][1]1.18}{[1][19][]19}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.19}{\ignorespaces $(\qopname  \relax o{ln}k^+,\qopname  \relax o{ln}k^-)$ 平面上的动量区域（括号内为 $(k^+,k^-,k_T)/Q$ 的标度，$\lambda \ll 1$；坐标轴以 $\qopname  \relax o{ln}(1/\lambda )$ 为单位）。$A$（$n$）共线区的大分量为 $k^+$，$B$（$\bar  n$）共线区的大分量为 $k^-$。 等虚度双曲线 $k^+k^-=$ 常数在对数坐标中是斜率为 $-1$ 的直线：共线区与软区位于同一条双曲线 $k^+k^-\sim \lambda ^2Q^2$ 上，彼此只差快度 $y=\frac  12\qopname  \relax o{ln}(k^+/k^-)$； 超软区位于 $k^+k^-\sim \lambda ^4Q^2$。Glauber 区由 $|k^+k^-|\ll k_T^2$ 定义：阴影为 $k_T\sim \lambda Q$ 时满足此条件的区域（通常所说的 Glauber 区是其中 $k^\pm \ll Q$ 的软部分）， 其典型标度 $(\lambda ^2,\lambda ^2,\lambda )$ 在本图中的投影与超软区重合（红框），二者只在 $k_T$ 上不同：Glauber 动量以横动量为主，$k^2\approx -k_T^2$。\relax }}{20}{figure.caption.19}\protected@file@percent }
\newlabel{fig:momentum-regions}{{1.19}{20}{$(\ln k^+,\ln k^-)$ 平面上的动量区域（括号内为 $(k^+,k^-,k_T)/Q$ 的标度，$\lambda \ll 1$；坐标轴以 $\ln (1/\lambda )$ 为单位）。$A$（$n$）共线区的大分量为 $k^+$，$B$（$\bar n$）共线区的大分量为 $k^-$。 等虚度双曲线 $k^+k^-=$ 常数在对数坐标中是斜率为 $-1$ 的直线：共线区与软区位于同一条双曲线 $k^+k^-\sim \lambda ^2Q^2$ 上，彼此只差快度 $y=\frac 12\ln (k^+/k^-)$； 超软区位于 $k^+k^-\sim \lambda ^4Q^2$。Glauber 区由 $|k^+k^-|\ll k_T^2$ 定义：阴影为 $k_T\sim \lambda Q$ 时满足此条件的区域（通常所说的 Glauber 区是其中 $k^\pm \ll Q$ 的软部分）， 其典型标度 $(\lambda ^2,\lambda ^2,\lambda )$ 在本图中的投影与超软区重合（红框），二者只在 $k_T$ 上不同：Glauber 动量以横动量为主，$k^2\approx -k_T^2$。\relax }{figure.caption.19}{}}
\newlabel{fig:momentum-regions@cref}{{[figure][19][1]1.19}{[1][20][]20}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.20}{\ignorespaces 图示 Ward 恒等式。蓝色螺旋线是标量（纵向）极化的共线胶子（K 胶子，极化 $\propto k^\mu $，以圆点标记），来自 $A$ 共线子图（未画出）； $H$ 的其余外线（入射夸克、出射夸克、光子）都取为在壳的物理粒子（共线近似之后）。 (a)\nobreakspace  {}对 K 胶子在 $H$ 内一切可能附着位置（包括非阿贝尔情形中 $H$ 内的胶子线与鬼场线）求和，等于把它附着到一条沿 $n_B$ 方向的 Wilson 线（双线）上、 再乘以不含该胶子的硬部分 $H_0$（其入射动量为 $p+k$）；Wilson 线是未来指向还是过去指向，取决于 K 胶子附着在 $H$ 的末态线还是初态线上。 阿贝尔理论中这一等式对任意多个 K 光子成立；非阿贝尔理论中对单个 K 胶子成立（BRST 对称性）。 (b)\nobreakspace  {}非阿贝尔理论中有两个及以上 K 胶子时，求和给出按路径次序附着在 Wilson 线上的各项（色矩阵 $t^{a_1}$、$t^{a_2}$ 的次序由附着次序决定，两种次序都出现）， 一般还伴随含鬼场线（带箭头的点线）的附加项；此处只示意其存在，其精确形式与处理见附录 F。\relax }}{21}{figure.caption.20}\protected@file@percent }
\newlabel{fig:ward-identity}{{1.20}{21}{图示 Ward 恒等式。蓝色螺旋线是标量（纵向）极化的共线胶子（K 胶子，极化 $\propto k^\mu $，以圆点标记），来自 $A$ 共线子图（未画出）； $H$ 的其余外线（入射夸克、出射夸克、光子）都取为在壳的物理粒子（共线近似之后）。 (a)~对 K 胶子在 $H$ 内一切可能附着位置（包括非阿贝尔情形中 $H$ 内的胶子线与鬼场线）求和，等于把它附着到一条沿 $n_B$ 方向的 Wilson 线（双线）上、 再乘以不含该胶子的硬部分 $H_0$（其入射动量为 $p+k$）；Wilson 线是未来指向还是过去指向，取决于 K 胶子附着在 $H$ 的末态线还是初态线上。 阿贝尔理论中这一等式对任意多个 K 光子成立；非阿贝尔理论中对单个 K 胶子成立（BRST 对称性）。 (b)~非阿贝尔理论中有两个及以上 K 胶子时，求和给出按路径次序附着在 Wilson 线上的各项（色矩阵 $t^{a_1}$、$t^{a_2}$ 的次序由附着次序决定，两种次序都出现）， 一般还伴随含鬼场线（带箭头的点线）的附加项；此处只示意其存在，其精确形式与处理见附录 F。\relax }{figure.caption.20}{}}
\newlabel{fig:ward-identity@cref}{{[figure][20][1]1.20}{[1][21][]21}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.21}{\ignorespaces 软胶子的程函（eikonal）近似。软胶子（绿色，动量 $k$ 流入夸克线，色指标 $a$、Lorentz 指标 $\mu $）附着在高能无质量夸克线（动量 $p$）上。 当 $k$ 的各分量都远小于 $p$ 的大分量、且不在 Glauber 区时，分子 $\bar  u(p)\gamma ^\mu ({\mathchoice {{\setbox \z@ \hbox {$\mathsurround \z@ \displaystyle p$}\setbox \tw@ \hbox {$\mathsurround \z@ \displaystyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ -0\ht \tw@ \advance \dimen@ -0\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \textstyle p$}\setbox \tw@ \hbox {$\mathsurround \z@ \textstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ -0\ht \tw@ \advance \dimen@ -0\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \scriptstyle p$}\setbox \tw@ \hbox {$\mathsurround \z@ \scriptstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ -0\ht \tw@ \advance \dimen@ -0\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \scriptscriptstyle p$}\setbox \tw@ \hbox {$\mathsurround \z@ \scriptscriptstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ -0\ht \tw@ \advance \dimen@ -0\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}}-{\mathchoice {{\setbox \z@ \hbox {$\mathsurround \z@ \displaystyle k$}\setbox \tw@ \hbox {$\mathsurround \z@ \displaystyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ --.05\ht \tw@ \advance \dimen@ --.05\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \textstyle k$}\setbox \tw@ \hbox {$\mathsurround \z@ \textstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ --.05\ht \tw@ \advance \dimen@ --.05\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \scriptstyle k$}\setbox \tw@ \hbox {$\mathsurround \z@ \scriptstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ --.05\ht \tw@ \advance \dimen@ --.05\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}{{\setbox \z@ \hbox {$\mathsurround \z@ \scriptscriptstyle k$}\setbox \tw@ \hbox {$\mathsurround \z@ \scriptscriptstyle /$}\dimen 4\wd \z@ \dimen@ \ht \tw@ \advance \dimen@ -\dp \tw@ \advance \dimen@ -\ht \z@ \advance \dimen@ \dp \z@ \divide \dimen@ \tw@ \advance \dimen@ --.05\ht \tw@ \advance \dimen@ --.05\dp \tw@ \dimen@ii 0\wd \z@ \raise -\dimen@ \hbox to\dimen 4{\hss \kern \dimen@ii \box \tw@ \kern -\dimen@ii \hss }\llap  {\hbox to\dimen 4{\hss \box \z@ \hss }}}}})\to 2p^\mu \bar  u(p)$、分母 $(p-k)^2+\mathrm  {i}0\to -2p\cdot k+\mathrm  {i}0$， 结果只依赖于 $p$ 的方向 $n$（对 $n$ 的标度不变），正是沿 $n$ 方向的 Wilson 线的单胶子 Feynman 规则： (a)\nobreakspace  {}出射夸克对应未来指向的 $W_n[\infty ,0]$，传播子为 $-\mathrm  {i}/(n\cdot k-\mathrm  {i}0)$；(b)\nobreakspace  {}入射夸克对应过去指向的 $W_n[0,-\infty ]$，传播子为 $\mathrm  {i}/(n\cdot k+\mathrm  {i}0)$ （顶点因子均为 $\mathrm  {i}g\,t^a n^\mu $）。Wilson 线上的箭头与被替代的夸克线的费米子数流向一致。\relax }}{22}{figure.caption.21}\protected@file@percent }
\newlabel{fig:soft-eikonal}{{1.21}{22}{软胶子的程函（eikonal）近似。软胶子（绿色，动量 $k$ 流入夸克线，色指标 $a$、Lorentz 指标 $\mu $）附着在高能无质量夸克线（动量 $p$）上。 当 $k$ 的各分量都远小于 $p$ 的大分量、且不在 Glauber 区时，分子 $\bar u(p)\gamma ^\mu (\sla p-\sla k)\to 2p^\mu \bar u(p)$、分母 $(p-k)^2+\ii 0\to -2p\cdot k+\ii 0$， 结果只依赖于 $p$ 的方向 $n$（对 $n$ 的标度不变），正是沿 $n$ 方向的 Wilson 线的单胶子 Feynman 规则： (a)~出射夸克对应未来指向的 $W_n[\infty ,0]$，传播子为 $-\ii /(n\cdot k-\ii 0)$；(b)~入射夸克对应过去指向的 $W_n[0,-\infty ]$，传播子为 $\ii /(n\cdot k+\ii 0)$ （顶点因子均为 $\ii g\,t^a n^\mu $）。Wilson 线上的箭头与被替代的夸克线的费米子数流向一致。\relax }{figure.caption.21}{}}
\newlabel{fig:soft-eikonal@cref}{{[figure][21][1]1.21}{[1][22][]22}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.22}{\ignorespaces $e^+e^-\to $ 强子总截面的 $\mathcal  {O}\!\left (\alpha _s\right )$ 修正。上排：振幅层次的图——(a)\nobreakspace  {}单圈顶点修正 $\mathcal  M_V$，(b)、(c)\nobreakspace  {}夸克或反夸克辐射一个实胶子 $\mathcal  M_q$、$\mathcal  M_{\bar  q}$ （无质量外线的自能修正在维数正规化中是无标度积分，为零，故未画出）。下排：电磁流关联函数 $\Pi $ 的三个两圈图及其全部切割（虚线上方的数字为被切粒子数）。 (d)\nobreakspace  {}两粒子切割给出 $2\Real  (\mathcal  M_0^*\mathcal  M_V)$（$\mathcal  M_0$ 为 Born 振幅），三粒子切割给出干涉项 $2\Real  (\mathcal  M_q\mathcal  M_{\bar  q}^*)$； (e)、(f)\nobreakspace  {}三粒子切割给出 $|\mathcal  M_q|^2$、$|\mathcal  M_{\bar  q}|^2$，两粒子切割（浅色）对应在壳无质量外线上的自能，在维数正规化中为零。 由切割规则，所有切割之和等于 $2\Imag  \Pi $ 在 $\mathcal  {O}\!\left (\alpha _s\right )$ 的贡献：虚、实两部分各含 $1/\varepsilon ^2$ 极点，其和有限，给出 $R=R_0\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left (\vcenter to\@ne \big@size {}\right .$}\box \z@ }1+\genfrac  {}{}{}134C_F\,\alpha _s/\pi \leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left )\vcenter to\@ne \big@size {}\right .$}\box \z@ }$。\relax }}{23}{figure.caption.22}\protected@file@percent }
\newlabel{fig:ee-oneloop}{{1.22}{23}{$e^+e^-\to $ 强子总截面的 $\order {\as }$ 修正。上排：振幅层次的图——(a)~单圈顶点修正 $\mathcal M_V$，(b)、(c)~夸克或反夸克辐射一个实胶子 $\mathcal M_q$、$\mathcal M_{\bar q}$ （无质量外线的自能修正在维数正规化中是无标度积分，为零，故未画出）。下排：电磁流关联函数 $\Pi $ 的三个两圈图及其全部切割（虚线上方的数字为被切粒子数）。 (d)~两粒子切割给出 $2\Real (\mathcal M_0^*\mathcal M_V)$（$\mathcal M_0$ 为 Born 振幅），三粒子切割给出干涉项 $2\Real (\mathcal M_q\mathcal M_{\bar q}^*)$； (e)、(f)~三粒子切割给出 $|\mathcal M_q|^2$、$|\mathcal M_{\bar q}|^2$，两粒子切割（浅色）对应在壳无质量外线上的自能，在维数正规化中为零。 由切割规则，所有切割之和等于 $2\Imag \Pi $ 在 $\order {\as }$ 的贡献：虚、实两部分各含 $1/\varepsilon ^2$ 极点，其和有限，给出 $R=R_0\big (1+\tfrac 34C_F\,\as /\pi \big )$。\relax }{figure.caption.22}{}}
\newlabel{fig:ee-oneloop@cref}{{[figure][22][1]1.22}{[1][23][]23}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.23}{\ignorespaces Drell--Yan 过程 $\mathcal  {O}\!\left (\alpha _s\right )$ 修正的部分子图（振幅层次，时间自左向右）。上排为 $q\bar  q$ 道：(a)、(b)\nobreakspace  {}$q(p_1)\,\bar  q(p_2)\to \gamma ^*(q)\,g(k)$ 的两个实辐射图， (c)\nobreakspace  {}单圈顶点修正（与 Born 振幅干涉；无质量外线自能在维数正规化中为零）。下排为 $qg$ 道 $q(p_1)\,g(p_2)\to \gamma ^*(q)\,q(k)$ 的两个图：(d)\nobreakspace  {}$s$ 道（内夸克线动量 $p_1+p_2$），(e)\nobreakspace  {}$t$ 道（内夸克线动量 $p_1-q$） （$\bar  q g$ 道的图由电荷共轭得到）。入射反夸克线上的费米子数箭头背离顶点，动量箭头另行标出。\relax }}{24}{figure.caption.23}\protected@file@percent }
\newlabel{fig:dy-oneloop}{{1.23}{24}{Drell--Yan 过程 $\order {\as }$ 修正的部分子图（振幅层次，时间自左向右）。上排为 $q\bar q$ 道：(a)、(b)~$q(p_1)\,\bar q(p_2)\to \gamma ^*(q)\,g(k)$ 的两个实辐射图， (c)~单圈顶点修正（与 Born 振幅干涉；无质量外线自能在维数正规化中为零）。下排为 $qg$ 道 $q(p_1)\,g(p_2)\to \gamma ^*(q)\,q(k)$ 的两个图：(d)~$s$ 道（内夸克线动量 $p_1+p_2$），(e)~$t$ 道（内夸克线动量 $p_1-q$） （$\bar q g$ 道的图由电荷共轭得到）。入射反夸克线上的费米子数箭头背离顶点，动量箭头另行标出。\relax }{figure.caption.23}{}}
\newlabel{fig:dy-oneloop@cref}{{[figure][23][1]1.23}{[1][24][]24}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.24}{\ignorespaces Glauber 胶子交换（暗红色）。时间自左向右，硬碰撞 $H$ 之前的交换为初态相互作用，之后为末态相互作用。 (a)\nobreakspace  {}Drell--Yan：强子 $A$、$B$ 的旁观者（强子残余，进入末态 $X_A$、$X_B$）在硬碰撞之前交换 Glauber 胶子（$|k^+k^-|\ll k_T^2$）；来自 $B$ 的入射反夸克线与 $A$ 的旁观者线的交叉不是顶点。 在单个割图中，$A$ 一侧（旁观者线与活动部分子线）的 $k^-$ 极点与 $B$ 一侧的 $k^+$ 极点都分居实轴两侧，围道被钳在 Glauber 区（\cref {fig:glauber-contour}），只有对旁观者的末态切割求和（幺正性）之后才能把围道变形出 Glauber 区； (b)\nobreakspace  {}DIS：被击出的夸克与靶残余在硬碰撞之后交换 Glauber 胶子；对单举 DIS 它们由幺正性相消，而在 SIDIS 的 TMD 中它们组合成未来指向的 Wilson 线， 与 Drell--Yan 中由初态相互作用产生的过去指向 Wilson 线相对照（Sivers 函数因而在两过程间变号）。\relax }}{25}{figure.caption.24}\protected@file@percent }
\newlabel{fig:glauber-exchange}{{1.24}{25}{Glauber 胶子交换（暗红色）。时间自左向右，硬碰撞 $H$ 之前的交换为初态相互作用，之后为末态相互作用。 (a)~Drell--Yan：强子 $A$、$B$ 的旁观者（强子残余，进入末态 $X_A$、$X_B$）在硬碰撞之前交换 Glauber 胶子（$|k^+k^-|\ll k_T^2$）；来自 $B$ 的入射反夸克线与 $A$ 的旁观者线的交叉不是顶点。 在单个割图中，$A$ 一侧（旁观者线与活动部分子线）的 $k^-$ 极点与 $B$ 一侧的 $k^+$ 极点都分居实轴两侧，围道被钳在 Glauber 区（\cref {fig:glauber-contour}），只有对旁观者的末态切割求和（幺正性）之后才能把围道变形出 Glauber 区； (b)~DIS：被击出的夸克与靶残余在硬碰撞之后交换 Glauber 胶子；对单举 DIS 它们由幺正性相消，而在 SIDIS 的 TMD 中它们组合成未来指向的 Wilson 线， 与 Drell--Yan 中由初态相互作用产生的过去指向 Wilson 线相对照（Sivers 函数因而在两过程间变号）。\relax }{figure.caption.24}{}}
\newlabel{fig:glauber-exchange@cref}{{[figure][24][1]1.24}{[1][25][]25}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.25}{\ignorespaces 软胶子动量 $k$（固定 $k^+$、$k_T$，$k_T\sim \lambda Q$）在复 $k^-$ 平面上的 Glauber 区分析。阴影带为 Glauber 区 $|k^-|\lesssim k_T^2/Q$； 图中极点来自 $k$ 流经的 $A$ 共线传播子，位于 $|k^-|\sim k_T^2/Q$。约定 $k$ 在附着顶点从 $A$ 子图流出，并取末态旁观者动量 $p_X$ 固定： Glauber 顶点之前的旁观者线 $l_s=p_X+k$ 中 $k$ 与大分量 $l_s^+$ 同向，极点在下半平面；进入 $H$ 的活动部分子线 $l_a=P_A-p_X-k$ 中 $k$ 与 $l_a^+$ 反向，极点在上半平面（$k$ 流入时上下互换）。 $B$ 共线线与胶子传播子本身给出的 $k^-$ 极点位于 $|k^-|\sim Q$，在图外。 (a)\nobreakspace  {}所有 $A$ 共线极点在同一侧：围道可向另一侧变形到 $|k^-|\sim |k_T|$，在那里软近似成立； (b)\nobreakspace  {}旁观者线与活动部分子线的极点分居两侧：围道被钳在 Glauber 区内（Glauber 钳夹）。 仅有 $k^-$ 钳夹并不致命：若胶子另一端的线（如 DIS 中出射的被击出夸克）给出的 $k^+$ 极点都在同一侧，仍可把 $k^+$ 围道变形到 $|k^+|\sim |k_T|$，使该端的程函近似成立； Drell--Yan 中 $B$ 一侧的 $k^+$ 围道同样被钳住，这一钳夹只有在对末态切割求和之后才被消除（\cref {fig:glauber-exchange}）。\relax }}{26}{figure.caption.25}\protected@file@percent }
\newlabel{fig:glauber-contour}{{1.25}{26}{软胶子动量 $k$（固定 $k^+$、$k_T$，$k_T\sim \lambda Q$）在复 $k^-$ 平面上的 Glauber 区分析。阴影带为 Glauber 区 $|k^-|\lesssim k_T^2/Q$； 图中极点来自 $k$ 流经的 $A$ 共线传播子，位于 $|k^-|\sim k_T^2/Q$。约定 $k$ 在附着顶点从 $A$ 子图流出，并取末态旁观者动量 $p_X$ 固定： Glauber 顶点之前的旁观者线 $l_s=p_X+k$ 中 $k$ 与大分量 $l_s^+$ 同向，极点在下半平面；进入 $H$ 的活动部分子线 $l_a=P_A-p_X-k$ 中 $k$ 与 $l_a^+$ 反向，极点在上半平面（$k$ 流入时上下互换）。 $B$ 共线线与胶子传播子本身给出的 $k^-$ 极点位于 $|k^-|\sim Q$，在图外。 (a)~所有 $A$ 共线极点在同一侧：围道可向另一侧变形到 $|k^-|\sim |k_T|$，在那里软近似成立； (b)~旁观者线与活动部分子线的极点分居两侧：围道被钳在 Glauber 区内（Glauber 钳夹）。 仅有 $k^-$ 钳夹并不致命：若胶子另一端的线（如 DIS 中出射的被击出夸克）给出的 $k^+$ 极点都在同一侧，仍可把 $k^+$ 围道变形到 $|k^+|\sim |k_T|$，使该端的程函近似成立； Drell--Yan 中 $B$ 一侧的 $k^+$ 围道同样被钳住，这一钳夹只有在对末态切割求和之后才被消除（\cref {fig:glauber-exchange}）。\relax }{figure.caption.25}{}}
\newlabel{fig:glauber-contour@cref}{{[figure][25][1]1.25}{[1][26][]26}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.26}{\ignorespaces 单圈离壳 Sudakov 形状因子的按区域展开（此处画成类时情形 $\gamma ^*(q)\to q(p_1)\,\bar  q(p_2)$；$p_1$ 沿 $n$（$+$ 方向），$p_2$ 沿 $\bar  n$）。 左：动量走向，外线离壳 $p_1\sim Q(1,\lambda ^2,\lambda )$、$p_2\sim Q(\lambda ^2,1,\lambda )$，标度均按 $(k^+,k^-,k_T)$ 书写。 右：圈动量 $k$ 的四个贡献区域，内线旁标出其虚度的量级：硬区（三条内线均离壳 $\sim Q^2$，整个圈收缩为一点，灰色）、 $1$ 共线区（$k$ 与 $p_1-k$ 构成沿 $p_1$ 的喷注，蓝色；$p_2+k$ 为硬线）、$2$ 共线区（橙色，镜像）、超软区（胶子虚度 $\sim \lambda ^4Q^2$，绿色；两条夸克线虚度 $\sim \lambda ^2Q^2$）。 软区 $k\sim Q(\lambda ,\lambda ,\lambda )$ 给出无标度积分，在维数正规化中为零。各区域单独含有 $1/\varepsilon ^2$、$1/\varepsilon $ 极点：对标量三角形积分，这些极点在求和中完全相消，给出有限的原积分； 对完整的 QCD 顶点，求和后只剩原积分本身的紫外发散，由重整化消去。\relax }}{27}{figure.caption.26}\protected@file@percent }
\newlabel{fig:sudakov-ff}{{1.26}{27}{单圈离壳 Sudakov 形状因子的按区域展开（此处画成类时情形 $\gamma ^*(q)\to q(p_1)\,\bar q(p_2)$；$p_1$ 沿 $n$（$+$ 方向），$p_2$ 沿 $\bar n$）。 左：动量走向，外线离壳 $p_1\sim Q(1,\lambda ^2,\lambda )$、$p_2\sim Q(\lambda ^2,1,\lambda )$，标度均按 $(k^+,k^-,k_T)$ 书写。 右：圈动量 $k$ 的四个贡献区域，内线旁标出其虚度的量级：硬区（三条内线均离壳 $\sim Q^2$，整个圈收缩为一点，灰色）、 $1$ 共线区（$k$ 与 $p_1-k$ 构成沿 $p_1$ 的喷注，蓝色；$p_2+k$ 为硬线）、$2$ 共线区（橙色，镜像）、超软区（胶子虚度 $\sim \lambda ^4Q^2$，绿色；两条夸克线虚度 $\sim \lambda ^2Q^2$）。 软区 $k\sim Q(\lambda ,\lambda ,\lambda )$ 给出无标度积分，在维数正规化中为零。各区域单独含有 $1/\varepsilon ^2$、$1/\varepsilon $ 极点：对标量三角形积分，这些极点在求和中完全相消，给出有限的原积分； 对完整的 QCD 顶点，求和后只剩原积分本身的紫外发散，由重整化消去。\relax }{figure.caption.26}{}}
\newlabel{fig:sudakov-ff@cref}{{[figure][26][1]1.26}{[1][27][]27}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.27}{\ignorespaces SCET 中的两类 Wilson 线。(a)\nobreakspace  {}$n$ 共线胶子（蓝色，领头分量 $\bar  n\cdot A_n\sim \lambda ^0$）附着在 $\bar  n$ 共线（或硬）线上时，使该线离壳 $p^2\sim Q^2$； 把这些离壳模式积掉后，它们附着到从流顶点 $\otimes $ 出发、沿 $\bar  n$ 方向（与 $\bar  n$ 共线反夸克平行）的共线 Wilson 线 $W_n$（由 $\bar  n\cdot A_n$ 构成）上， 流算符因而只通过规范不变组合 $\chi _n=W_n^\dagger \xi _n$ 出现（树图层次的匹配）。 (b)\nobreakspace  {}领头阶共线拉氏量中超软胶子（绿色）只通过 $n\cdot A_{us}$ 与 $n$ 共线夸克耦合；场重定义 $\xi _n=Y_n\xi _n^{(0)}$、$A_n=Y_nA_n^{(0)}Y_n^\dagger $ （$n\cdot D_{us}Y_n=0$）使新场 $\xi _n^{(0)}$、$A_n^{(0)}$ 与超软胶子退耦，超软胶子全部附着在沿 $n$ 方向（与 $n$ 共线夸克平行）的 Wilson 线 $Y_n$ 上。 $Y_n$ 的端点（$-\infty $ 或 $+\infty $）与 $\mathrm  {i}0$ 规定应依粒子是入射还是出射选取（此处为出射夸克）。Wilson 线上的箭头与被替代的费米子线的费米子数流向一致。\relax }}{28}{figure.caption.27}\protected@file@percent }
\newlabel{fig:scet-wilson}{{1.27}{28}{SCET 中的两类 Wilson 线。(a)~$n$ 共线胶子（蓝色，领头分量 $\bar n\cdot A_n\sim \lambda ^0$）附着在 $\bar n$ 共线（或硬）线上时，使该线离壳 $p^2\sim Q^2$； 把这些离壳模式积掉后，它们附着到从流顶点 $\otimes $ 出发、沿 $\bar n$ 方向（与 $\bar n$ 共线反夸克平行）的共线 Wilson 线 $W_n$（由 $\bar n\cdot A_n$ 构成）上， 流算符因而只通过规范不变组合 $\chi _n=W_n^\dagger \xi _n$ 出现（树图层次的匹配）。 (b)~领头阶共线拉氏量中超软胶子（绿色）只通过 $n\cdot A_{us}$ 与 $n$ 共线夸克耦合；场重定义 $\xi _n=Y_n\xi _n^{(0)}$、$A_n=Y_nA_n^{(0)}Y_n^\dagger $ （$n\cdot D_{us}Y_n=0$）使新场 $\xi _n^{(0)}$、$A_n^{(0)}$ 与超软胶子退耦，超软胶子全部附着在沿 $n$ 方向（与 $n$ 共线夸克平行）的 Wilson 线 $Y_n$ 上。 $Y_n$ 的端点（$-\infty $ 或 $+\infty $）与 $\ii 0$ 规定应依粒子是入射还是出射选取（此处为出射夸克）。Wilson 线上的箭头与被替代的费米子线的费米子数流向一致。\relax }{figure.caption.27}{}}
\newlabel{fig:scet-wilson@cref}{{[figure][27][1]1.27}{[1][28][]28}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.28}{\ignorespaces 推力（双喷注）分布在 $\tau =1-T\ll 1$ 时的因子化 $H\times J_n\otimes J_{\bar  n}\otimes S$ 的图示（每个因子都画成割图，红色虚线为末态切割）。 硬函数 $H=|C|^2$ 来自把 QCD 流匹配到 SCET 流的 Wilson 系数 $C(Q^2,\mu )$；喷注函数 $J_n$、$J_{\bar  n}$（对夸克与反夸克是同一个函数）描述虚度 $s_{n,\bar  n}\sim \tau Q^2$ 的共线辐射； 软函数 $S(k,\mu )$ 是沿 $n$、$\bar  n$ 方向的出射（未来指向）Wilson 线 $Y_n$、$Y_{\bar  n}$（后者取反基础表示）的真空矩阵元， 左、右两个顶点分别属于振幅与共轭振幅，软辐射对 $\tau $ 的贡献按半球测量：$k=n\cdot p_{s}^{(n)}+\bar  n\cdot p_{s}^{(\bar  n)}$（上标表示软粒子所在的半球）。 式中省略了相对 $\mathcal  {O}\!\left (\tau \right )$ 的幂次修正。\relax }}{29}{figure.caption.28}\protected@file@percent }
\newlabel{fig:dijet-factorization}{{1.28}{29}{推力（双喷注）分布在 $\tau =1-T\ll 1$ 时的因子化 $H\times J_n\otimes J_{\bar n}\otimes S$ 的图示（每个因子都画成割图，红色虚线为末态切割）。 硬函数 $H=|C|^2$ 来自把 QCD 流匹配到 SCET 流的 Wilson 系数 $C(Q^2,\mu )$；喷注函数 $J_n$、$J_{\bar n}$（对夸克与反夸克是同一个函数）描述虚度 $s_{n,\bar n}\sim \tau Q^2$ 的共线辐射； 软函数 $S(k,\mu )$ 是沿 $n$、$\bar n$ 方向的出射（未来指向）Wilson 线 $Y_n$、$Y_{\bar n}$（后者取反基础表示）的真空矩阵元， 左、右两个顶点分别属于振幅与共轭振幅，软辐射对 $\tau $ 的贡献按半球测量：$k=n\cdot p_{s}^{(n)}+\bar n\cdot p_{s}^{(\bar n)}$（上标表示软粒子所在的半球）。 式中省略了相对 $\order {\tau }$ 的幂次修正。\relax }{figure.caption.28}{}}
\newlabel{fig:dijet-factorization@cref}{{[figure][28][1]1.28}{[1][29][]29}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.29}{\ignorespaces TMD 夸克分布算符中的“订书钉”形 Wilson 线，画在 $(w^-,w_{\mathrm  T})$ 平面内（$w^+=0$）。未减除的 TMD 关联函数为 $\tilde  f^{\,\mathrm  {unsub}}_{q/H}(x,b_{\mathrm  T})=\DOTSI \intop \ilimits@ \frac  {\mathrm  {d}w^-}{4\pi }\,\mathrm  {e}^{-\mathrm  {i}xP^+w^-}\langle P|\,\bar  \psi (w)\gamma ^+\,W_{\sqsupset }[w,0]\,\psi (0)\,|P\rangle $， $w=(0^+,w^-,b_{\mathrm  T})$（颜色求和、自旋平均），$n$ 为满足 $n\cdot v=v^+$ 的光型矢量。 (a)\nobreakspace  {}SIDIS：$W_{\sqsupset }[w,0]=W[w,w+\infty n]\,W_{\mathrm  T}\,W[\infty n,0]$，路径由 $0$ 沿 $n$ 走到 $w^-=+\infty $， 经该处的横向连接 $W_{\mathrm  T}=W[w+\infty n,\infty n]$，再沿 $-n$ 回到 $w$；它来自被击出夸克与靶残余之间的末态相互作用。 (b)\nobreakspace  {}Drell--Yan：路径改经 $w^-=-\infty $，$W_{\sqsupset }[w,0]=W[w,w-\infty n]\,W_{\mathrm  T}\,W[-\infty n,0]$；它来自强子 $B$ 的入射反夸克与强子 $A$ 残余之间的初态相互作用（见\cref {fig:sidis-dy-links}）。 双线为 Wilson 线，箭头为路径方向（$W[b,a]$ 由 $a$ 指向 $b$），与被本征化部分子的费米子数（色）流向一致：(a) 中为出射夸克，(b) 中为入射反夸克（其费米子数箭头逆着动量，指向过去）。 在共变规范中无穷远处的横向连接可以略去，在光锥规范中则不可缺少。$b_{\mathrm  T}=0$ 时两种路径都化为共线 PDF 中的直线 $W[w,0]$（往返部分相消）；对光型的 $n$，算符含快度发散（见正文）。\relax }}{30}{figure.caption.29}\protected@file@percent }
\newlabel{fig:tmd-staple}{{1.29}{30}{TMD 夸克分布算符中的“订书钉”形 Wilson 线，画在 $(w^-,w_{\mathrm T})$ 平面内（$w^+=0$）。未减除的 TMD 关联函数为 $\tilde f^{\,\mathrm {unsub}}_{q/H}(x,b_{\mathrm T})=\int \frac {\dd w^-}{4\pi }\,\ee ^{-\ii xP^+w^-}\langle P|\,\bar \psi (w)\gamma ^+\,W_{\sqsupset }[w,0]\,\psi (0)\,|P\rangle $， $w=(0^+,w^-,b_{\mathrm T})$（颜色求和、自旋平均），$n$ 为满足 $n\cdot v=v^+$ 的光型矢量。 (a)~SIDIS：$W_{\sqsupset }[w,0]=W[w,w+\infty n]\,W_{\mathrm T}\,W[\infty n,0]$，路径由 $0$ 沿 $n$ 走到 $w^-=+\infty $， 经该处的横向连接 $W_{\mathrm T}=W[w+\infty n,\infty n]$，再沿 $-n$ 回到 $w$；它来自被击出夸克与靶残余之间的末态相互作用。 (b)~Drell--Yan：路径改经 $w^-=-\infty $，$W_{\sqsupset }[w,0]=W[w,w-\infty n]\,W_{\mathrm T}\,W[-\infty n,0]$；它来自强子 $B$ 的入射反夸克与强子 $A$ 残余之间的初态相互作用（见\cref {fig:sidis-dy-links}）。 双线为 Wilson 线，箭头为路径方向（$W[b,a]$ 由 $a$ 指向 $b$），与被本征化部分子的费米子数（色）流向一致：(a) 中为出射夸克，(b) 中为入射反夸克（其费米子数箭头逆着动量，指向过去）。 在共变规范中无穷远处的横向连接可以略去，在光锥规范中则不可缺少。$b_{\mathrm T}=0$ 时两种路径都化为共线 PDF 中的直线 $W[w,0]$（往返部分相消）；对光型的 $n$，算符含快度发散（见正文）。\relax }{figure.caption.29}{}}
\newlabel{fig:tmd-staple@cref}{{[figure][29][1]1.29}{[1][30][]30}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.30}{\ignorespaces TMD 软因子 $\tilde  S(b_{\mathrm  T})$ 的割图表示。两条 Wilson 线（双线）分别沿 $n_A$、$n_B$ 方向，代替两个沿相反方向运动的硬部分子： 在振幅中自同一点 $0$ 出发，在共轭振幅中自横向位置 $b_{\mathrm  T}$ 出发；两侧的 Wilson 线在割线处（无穷远）相接，构成闭合的色迹 $\frac  1{N_c}\mathrm  {Tr}_{\mathrm  c}$。 软胶子可在割线同一侧交换（虚修正，如图中左侧的胶子），也可穿过割线（实发射）；横向动量为 $\ell _{\mathrm  T}$ 的实胶子给出相因子 $\mathrm  {e}^{\mathrm  {i}\ell _{\mathrm  T}\cdot b_{\mathrm  T}}$。 箭头为路径方向，即色（费米子数）流向。图中两条线都按未来指向画出，对应两个出射部分子（$e^+e^-\to h_1h_2X$）；对 Drell--Yan 两条线都是过去指向（两个入射部分子）， 对 SIDIS 则各有一条——胶子的连接方式与图示相同。对光型的 $n_A$、$n_B$，固定 $\ell _{\mathrm  T}$ 时胶子快度的积分发散（快度发散），需要快度正规化（见正文）。\relax }}{31}{figure.caption.30}\protected@file@percent }
\newlabel{fig:tmd-soft-factor}{{1.30}{31}{TMD 软因子 $\tilde S(b_{\mathrm T})$ 的割图表示。两条 Wilson 线（双线）分别沿 $n_A$、$n_B$ 方向，代替两个沿相反方向运动的硬部分子： 在振幅中自同一点 $0$ 出发，在共轭振幅中自横向位置 $b_{\mathrm T}$ 出发；两侧的 Wilson 线在割线处（无穷远）相接，构成闭合的色迹 $\frac 1{N_c}\mathrm {Tr}_{\mathrm c}$。 软胶子可在割线同一侧交换（虚修正，如图中左侧的胶子），也可穿过割线（实发射）；横向动量为 $\ell _{\mathrm T}$ 的实胶子给出相因子 $\ee ^{\ii \ell _{\mathrm T}\cdot b_{\mathrm T}}$。 箭头为路径方向，即色（费米子数）流向。图中两条线都按未来指向画出，对应两个出射部分子（$e^+e^-\to h_1h_2X$）；对 Drell--Yan 两条线都是过去指向（两个入射部分子）， 对 SIDIS 则各有一条——胶子的连接方式与图示相同。对光型的 $n_A$、$n_B$，固定 $\ell _{\mathrm T}$ 时胶子快度的积分发散（快度发散），需要快度正规化（见正文）。\relax }{figure.caption.30}{}}
\newlabel{fig:tmd-soft-factor@cref}{{[figure][30][1]1.30}{[1][31][]31}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.31}{\ignorespaces 小 $q_{\mathrm  T}$（$q_{\mathrm  T}\ll Q$，可低至 $\Lambda $ 量级）Drell--Yan 过程的约化割图与 TMD 因子化的结构。竖直虚线为末态割线，两个强子都自左（振幅）入射、向右（共轭振幅）出射。 $A$、$B$ 为分别与两强子共线的子图（各含穿过割线的强子残余），动量按 $(k^+,k^-,\bm  {k}_{\mathrm  T})$ 的标度如图所示；软子图 $S$ 的所有分量都是 $q_{\mathrm  T}$ 量级（软区，而非超软区）， 以胶子与 $A$、$B$ 相连；$H$、$H^\dagger $ 为虚度 $\sim Q^2$ 的硬子图，经电流插入与 $\gamma ^*$ 相连。来自 $B$ 的反夸克的费米子数箭头由 $H$ 指向 $B$，其动量 $k_B$ 则流入 $H$。 对各区域作近似、用 Ward 恒等式把纵向极化胶子收入 Wilson 线并扣除共线区与软区的重叠之后，横向动量守恒 $\bm  {q}_{\mathrm  T}=\bm  {k}_{A\mathrm  T}+\bm  {k}_{B\mathrm  T}+\bm  {k}_{S\mathrm  T}$ 使三个因子在动量空间中作卷积、在 $b_{\mathrm  T}$ 空间中相乘；把软因子 $\tilde  S(b_{\mathrm  T})$ 按定义分配进两个 TMD（见正文）后，得 $\frac  {\mathrm  {d}\sigma }{\mathrm  {d}Q^2\,\mathrm  {d}y\,\mathrm  {d}^2\bm  {q}_{\mathrm  T}}=\sigma _0\DOTSB \sum@ \slimits@ _q e_q^2\,H(Q;\mu )\DOTSI \intop \ilimits@ \frac  {\mathrm  {d}^2\bm  {b}_{\mathrm  T}}{(2\pi )^2}\,\mathrm  {e}^{\mathrm  {i}\bm  {q}_{\mathrm  T}\cdot \bm  {b}_{\mathrm  T}}\, \tilde  f_{q/A}(x_A,b_{\mathrm  T};\mu ,\zeta _A)\,\tilde  f_{\bar  q/B}(x_B,b_{\mathrm  T};\mu ,\zeta _B)+(q\leftrightarrow \bar  q)+Y$，$\zeta _A\zeta _B=Q^4$，$Y$ 为与 $q_{\mathrm  T}\sim Q$ 的固定阶结果相衔接的修正项。 Glauber 区的贡献对此单举观测量相消，未画出。\relax }}{32}{figure.caption.31}\protected@file@percent }
\newlabel{fig:tmd-dy}{{1.31}{32}{小 $q_{\mathrm T}$（$q_{\mathrm T}\ll Q$，可低至 $\Lambda $ 量级）Drell--Yan 过程的约化割图与 TMD 因子化的结构。竖直虚线为末态割线，两个强子都自左（振幅）入射、向右（共轭振幅）出射。 $A$、$B$ 为分别与两强子共线的子图（各含穿过割线的强子残余），动量按 $(k^+,k^-,\boldsymbol k_{\mathrm T})$ 的标度如图所示；软子图 $S$ 的所有分量都是 $q_{\mathrm T}$ 量级（软区，而非超软区）， 以胶子与 $A$、$B$ 相连；$H$、$H^\dagger $ 为虚度 $\sim Q^2$ 的硬子图，经电流插入与 $\gamma ^*$ 相连。来自 $B$ 的反夸克的费米子数箭头由 $H$ 指向 $B$，其动量 $k_B$ 则流入 $H$。 对各区域作近似、用 Ward 恒等式把纵向极化胶子收入 Wilson 线并扣除共线区与软区的重叠之后，横向动量守恒 $\boldsymbol q_{\mathrm T}=\boldsymbol k_{A\mathrm T}+\boldsymbol k_{B\mathrm T}+\boldsymbol k_{S\mathrm T}$ 使三个因子在动量空间中作卷积、在 $b_{\mathrm T}$ 空间中相乘；把软因子 $\tilde S(b_{\mathrm T})$ 按定义分配进两个 TMD（见正文）后，得 $\frac {\dd \sigma }{\dd Q^2\,\dd y\,\dd ^2\boldsymbol q_{\mathrm T}}=\sigma _0\sum _q e_q^2\,H(Q;\mu )\int \frac {\dd ^2\boldsymbol b_{\mathrm T}}{(2\pi )^2}\,\ee ^{\ii \boldsymbol q_{\mathrm T}\cdot \boldsymbol b_{\mathrm T}}\, \tilde f_{q/A}(x_A,b_{\mathrm T};\mu ,\zeta _A)\,\tilde f_{\bar q/B}(x_B,b_{\mathrm T};\mu ,\zeta _B)+(q\leftrightarrow \bar q)+Y$，$\zeta _A\zeta _B=Q^4$，$Y$ 为与 $q_{\mathrm T}\sim Q$ 的固定阶结果相衔接的修正项。 Glauber 区的贡献对此单举观测量相消，未画出。\relax }{figure.caption.31}{}}
\newlabel{fig:tmd-dy@cref}{{[figure][31][1]1.31}{[1][32][]32}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.32}{\ignorespaces 单胶子交换如何决定 TMD 中 Wilson 线的方向。$n$ 为满足 $n\cdot v=v^+$ 的光型矢量，$\ell $ 为由强子 $A$ 的残余流入本征（eikonal）线的胶子动量，$n\cdot \ell =\ell ^+$。 (a)\nobreakspace  {}SIDIS：被击出的夸克（末态，$p\parallel n$）与靶残余 $X$ 交换胶子（末态相互作用）；在本征近似下夸克传播子化为 $-1/[2p^-(\ell ^+-\mathrm  {i}0)]$， 与未来指向的 $W[\infty n,0]$ 的单胶子 Feynman 规则 $g\,t^a n^\mu /(n\cdot \ell -\mathrm  {i}0)$ 一致。 (b)\nobreakspace  {}Drell--Yan：强子 $B$ 的入射反夸克（$p\parallel n$）在湮灭之前与 $A$ 的残余 $X_A$ 交换胶子（初态相互作用）；传播子化为 $1/[2p^-(\ell ^++\mathrm  {i}0)]$， 对应过去指向的 $W[-\infty n,0]$，其单胶子规则为 $g\,t^a n^\mu /(n\cdot \ell +\mathrm  {i}0)$。两图拓扑相同，夸克线上的箭头均为费米子数流向：(b) 中反夸克的费米子数由湮灭顶点指向 $B$，其动量则流入顶点。 两种本征因子之差 $\frac  {1}{\ell ^+-\mathrm  {i}0}-\frac  {1}{\ell ^++\mathrm  {i}0}=2\pi \mathrm  {i}\,\delta (\ell ^+)$ 为 Glauber（Coulomb）相位项：它在对 $\bm  {k}_{\mathrm  T}$ 积分的共线 PDF 中相消， 在 TMD 中则保留下来，使 Sivers 函数在两过程中反号，$f_{1T}^{\perp q}\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left |\vcenter to\@ne \big@size {}\right .$}\box \z@ }_{\mathrm  {SIDIS}}=-f_{1T}^{\perp q}\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left |\vcenter to\@ne \big@size {}\right .$}\box \z@ }_{\mathrm  {DY}}$（参见\cref {fig:tmd-staple}）。\relax }}{33}{figure.caption.32}\protected@file@percent }
\newlabel{fig:sidis-dy-links}{{1.32}{33}{单胶子交换如何决定 TMD 中 Wilson 线的方向。$n$ 为满足 $n\cdot v=v^+$ 的光型矢量，$\ell $ 为由强子 $A$ 的残余流入本征（eikonal）线的胶子动量，$n\cdot \ell =\ell ^+$。 (a)~SIDIS：被击出的夸克（末态，$p\parallel n$）与靶残余 $X$ 交换胶子（末态相互作用）；在本征近似下夸克传播子化为 $-1/[2p^-(\ell ^+-\ii 0)]$， 与未来指向的 $W[\infty n,0]$ 的单胶子 Feynman 规则 $g\,t^a n^\mu /(n\cdot \ell -\ii 0)$ 一致。 (b)~Drell--Yan：强子 $B$ 的入射反夸克（$p\parallel n$）在湮灭之前与 $A$ 的残余 $X_A$ 交换胶子（初态相互作用）；传播子化为 $1/[2p^-(\ell ^++\ii 0)]$， 对应过去指向的 $W[-\infty n,0]$，其单胶子规则为 $g\,t^a n^\mu /(n\cdot \ell +\ii 0)$。两图拓扑相同，夸克线上的箭头均为费米子数流向：(b) 中反夸克的费米子数由湮灭顶点指向 $B$，其动量则流入顶点。 两种本征因子之差 $\frac {1}{\ell ^+-\ii 0}-\frac {1}{\ell ^++\ii 0}=2\pi \ii \,\delta (\ell ^+)$ 为 Glauber（Coulomb）相位项：它在对 $\boldsymbol k_{\mathrm T}$ 积分的共线 PDF 中相消， 在 TMD 中则保留下来，使 Sivers 函数在两过程中反号，$f_{1T}^{\perp q}\big |_{\mathrm {SIDIS}}=-f_{1T}^{\perp q}\big |_{\mathrm {DY}}$（参见\cref {fig:tmd-staple}）。\relax }{figure.caption.32}{}}
\newlabel{fig:sidis-dy-links@cref}{{[figure][32][1]1.32}{[1][33][]33}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.33}{\ignorespaces TMD 因子化破坏的 Collins--Qiu 机制：$h_1+h_2\to H_1+H_2+X$，$H_1$、$H_2$ 在横向近乎背对背，测量其横动量失衡 $\bm  {q}_{\mathrm  T}=\bm  {p}_{H_1\mathrm  T}+\bm  {p}_{H_2\mathrm  T}$。 (a)\nobreakspace  {}在硬散射 $H$ 之外，$h_1$ 的旁观者 $X_1$ 与碎裂为 $H_2$ 的出射部分子交换一个 Glauber 胶子（暗红色，动量 $\ell $）。若 TMD 因子化成立，$h_1$ 的旁观者的这类相互作用必须能被吸收进 $h_1$ 的 TMD 的 Wilson 线； 但这个胶子的色矩阵作用在出射部分子上，即作用在 $H_2$ 的碎裂因子的色空间中。Collins 与 Qiu（2007）对横向极化 $h_1$ 的 Sivers 型单自旋不对称明确算出： 这类末态交换，连同与 $h_2$ 入射部分子的初态交换和与碎裂为 $H_1$ 的部分子的末态交换，所给出的 Glauber 相位项既不同于 SIDIS 型（未来指向）也不同于 Drell--Yan 型（过去指向）Wilson 线所给出的，即标准 TMD 因子化不成立； Rogers 与 Mulders（2010）在非极化截面的双胶子交换中证明，允许过程依赖 Wilson 线的“推广 TMD 因子化”同样不成立（严格性标签 [V]）。 (b)\nobreakspace  {}同一图在大 $N_c$ 下的色流（双线记号，以色单态硬交换为例；强子为夸克加反三重态旁观者的色单态；箭头为色流方向）：胶子交换把两条色线重新连接， 使 $h_1$ 的残余与 $H_2$ 的碎裂部分子落在同一条色线上（红），而 $H_1$ 经 $h_1$、硬散射与 $h_2$ 的残余相连（蓝）——色结构不再分解为各因子各自的色迹之积。\relax }}{34}{figure.caption.33}\protected@file@percent }
\newlabel{fig:violation-cq}{{1.33}{34}{TMD 因子化破坏的 Collins--Qiu 机制：$h_1+h_2\to H_1+H_2+X$，$H_1$、$H_2$ 在横向近乎背对背，测量其横动量失衡 $\boldsymbol q_{\mathrm T}=\boldsymbol p_{H_1\mathrm T}+\boldsymbol p_{H_2\mathrm T}$。 (a)~在硬散射 $H$ 之外，$h_1$ 的旁观者 $X_1$ 与碎裂为 $H_2$ 的出射部分子交换一个 Glauber 胶子（暗红色，动量 $\ell $）。若 TMD 因子化成立，$h_1$ 的旁观者的这类相互作用必须能被吸收进 $h_1$ 的 TMD 的 Wilson 线； 但这个胶子的色矩阵作用在出射部分子上，即作用在 $H_2$ 的碎裂因子的色空间中。Collins 与 Qiu（2007）对横向极化 $h_1$ 的 Sivers 型单自旋不对称明确算出： 这类末态交换，连同与 $h_2$ 入射部分子的初态交换和与碎裂为 $H_1$ 的部分子的末态交换，所给出的 Glauber 相位项既不同于 SIDIS 型（未来指向）也不同于 Drell--Yan 型（过去指向）Wilson 线所给出的，即标准 TMD 因子化不成立； Rogers 与 Mulders（2010）在非极化截面的双胶子交换中证明，允许过程依赖 Wilson 线的“推广 TMD 因子化”同样不成立（严格性标签 [V]）。 (b)~同一图在大 $N_c$ 下的色流（双线记号，以色单态硬交换为例；强子为夸克加反三重态旁观者的色单态；箭头为色流方向）：胶子交换把两条色线重新连接， 使 $h_1$ 的残余与 $H_2$ 的碎裂部分子落在同一条色线上（红），而 $H_1$ 经 $h_1$、硬散射与 $h_2$ 的残余相连（蓝）——色结构不再分解为各因子各自的色迹之积。\relax }{figure.caption.33}{}}
\newlabel{fig:violation-cq@cref}{{[figure][33][1]1.33}{[1][34][]34}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.34}{\ignorespaces 衍射过程中的因子化。(a)\nobreakspace  {}衍射 DIS（$e p\to e\,X\,p'$）：靶质子保持完整（$p'$ 被探测到），与强子末态 $X$ 之间有一个没有粒子的快度间隙：质子与 $X$ 之间交换的是一个色单态体系（黄色阴影：进入硬散射的活动部分子及其色伴随者），二者之间没有色流。 运动学变量 $x_{\mathbb  {P}}=\frac  {(P-P')\cdot q}{P\cdot q}$、$\beta =\frac  {x}{x_{\mathbb  {P}}}$、$t=(P-P')^2$（下标 $\mathbb  {P}$ 只是传统记号，不涉及任何 Pomeron 模型）。 截面因子化为硬部分与衍射 PDF $f^{D}_{i/p}(\beta ,x_{\mathbb  {P}},t;\mu )$ 的卷积，后者是末态中含被探测质子 $p'$ 的 PDF 算符矩阵元；入射强子只有一个，证明与 DIS 相同（Collins 1998，全阶论证 [A]）。 (b)\nobreakspace  {}强子--强子硬衍射（如 $p\bar  p\to \bar  p'+\text  {两喷注}+X$）：两个入射强子的旁观者之间的软/Glauber 相互作用（暗红色）可以打碎 $\bar  p'$ 或在间隙中产生粒子（红色）， 于是用 (a) 中提取的衍射 PDF 所作的因子化预言不成立（间隙存活问题）；CDF 在 Tevatron 测得的衍射双喷注截面比这种预言低约一个数量级（[V]）。下方为末态粒子在快度 $\eta $ 上分布的示意。\relax }}{35}{figure.caption.34}\protected@file@percent }
\newlabel{fig:diffraction}{{1.34}{35}{衍射过程中的因子化。(a)~衍射 DIS（$e p\to e\,X\,p'$）：靶质子保持完整（$p'$ 被探测到），与强子末态 $X$ 之间有一个没有粒子的快度间隙：质子与 $X$ 之间交换的是一个色单态体系（黄色阴影：进入硬散射的活动部分子及其色伴随者），二者之间没有色流。 运动学变量 $x_{\mathbb P}=\frac {(P-P')\cdot q}{P\cdot q}$、$\beta =\frac {x}{x_{\mathbb P}}$、$t=(P-P')^2$（下标 $\mathbb P$ 只是传统记号，不涉及任何 Pomeron 模型）。 截面因子化为硬部分与衍射 PDF $f^{D}_{i/p}(\beta ,x_{\mathbb P},t;\mu )$ 的卷积，后者是末态中含被探测质子 $p'$ 的 PDF 算符矩阵元；入射强子只有一个，证明与 DIS 相同（Collins 1998，全阶论证 [A]）。 (b)~强子--强子硬衍射（如 $p\bar p\to \bar p'+\text {两喷注}+X$）：两个入射强子的旁观者之间的软/Glauber 相互作用（暗红色）可以打碎 $\bar p'$ 或在间隙中产生粒子（红色）， 于是用 (a) 中提取的衍射 PDF 所作的因子化预言不成立（间隙存活问题）；CDF 在 Tevatron 测得的衍射双喷注截面比这种预言低约一个数量级（[V]）。下方为末态粒子在快度 $\eta $ 上分布的示意。\relax }{figure.caption.34}{}}
\newlabel{fig:diffraction@cref}{{[figure][34][1]1.34}{[1][35][]35}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.35}{\ignorespaces $\pi $ 介子电磁形状因子的领头阶硬散射图（$F_\pi (Q^2)$ 由 $\langle \pi (P')|j^\mu |\pi (P)\rangle =(P+P')^\mu F_\pi (Q^2)$ 定义，$Q^2=-q^2$）。 入射 $\pi $ 介子以分布振幅 $\phi (x)$ 分裂为共线的夸克（$xP$）与反夸克（$(1-x)P$），出射 $\pi $ 介子由 $yP'$ 与 $(1-y)P'$ 组成（$\phi ^*(y)$）； 蓝、橙两色分别表示与 $P$、$P'$ 共线的子图。为使反夸克转向 $P'$ 方向，必须交换一个硬胶子：(a)\nobreakspace  {}光子先于胶子作用于夸克，内夸克线 $(xP+q)^2=-(1-x)Q^2$； (b)\nobreakspace  {}胶子先于光子，内夸克线 $(yP'-q)^2=-(1-y)Q^2$；两图中胶子虚度均为 $-(1-x)(1-y)Q^2$（$m_\pi \to 0$，$2P\cdot P'=Q^2$）。 领头阶共有 4 个图，另两个是光子作用于反夸克的对应图。反夸克线上的箭头（费米子数）与其动量方向相反。 结果为 $F_\pi (Q^2)=\DOTSI \intop \ilimits@ _0^1\!\mathrm  {d}x\,\mathrm  {d}y\,\phi ^*(y)\,T_H(x,y,Q^2)\,\phi (x)$；当不与光子相连的反夸克的动量分数 $1-x$ 或 $1-y\to 0$ 时，内线虚度趋于零，这就是端点区域。\relax }}{36}{figure.caption.35}\protected@file@percent }
\newlabel{fig:pion-ff}{{1.35}{36}{$\pi $ 介子电磁形状因子的领头阶硬散射图（$F_\pi (Q^2)$ 由 $\langle \pi (P')|j^\mu |\pi (P)\rangle =(P+P')^\mu F_\pi (Q^2)$ 定义，$Q^2=-q^2$）。 入射 $\pi $ 介子以分布振幅 $\phi (x)$ 分裂为共线的夸克（$xP$）与反夸克（$(1-x)P$），出射 $\pi $ 介子由 $yP'$ 与 $(1-y)P'$ 组成（$\phi ^*(y)$）； 蓝、橙两色分别表示与 $P$、$P'$ 共线的子图。为使反夸克转向 $P'$ 方向，必须交换一个硬胶子：(a)~光子先于胶子作用于夸克，内夸克线 $(xP+q)^2=-(1-x)Q^2$； (b)~胶子先于光子，内夸克线 $(yP'-q)^2=-(1-y)Q^2$；两图中胶子虚度均为 $-(1-x)(1-y)Q^2$（$m_\pi \to 0$，$2P\cdot P'=Q^2$）。 领头阶共有 4 个图，另两个是光子作用于反夸克的对应图。反夸克线上的箭头（费米子数）与其动量方向相反。 结果为 $F_\pi (Q^2)=\int _0^1\!\dd x\,\dd y\,\phi ^*(y)\,T_H(x,y,Q^2)\,\phi (x)$；当不与光子相连的反夸克的动量分数 $1-x$ 或 $1-y\to 0$ 时，内线虚度趋于零，这就是端点区域。\relax }{figure.caption.35}{}}
\newlabel{fig:pion-ff@cref}{{[figure][35][1]1.35}{[1][36][]36}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.36}{\ignorespaces 深度虚康普顿散射（DVCS）$\gamma ^*(q)+p(P)\to \gamma (q')+p(P')$ 的领头阶图：(a)\nobreakspace  {}手提包图；(b)\nobreakspace  {}交叉图（两光子交叉，交叉处无顶点）。 灰色团为广义部分子分布（GPD）的关联函数；$\bar  P=\frac  12(P+P')$，$\xi =\frac  {P^+-P'^+}{P^++P'^+}$，$t=(P'-P)^2$。 离开团的部分子带正光锥动量 $(x+\xi )\bar  P^+$，回到团的部分子带 $(x-\xi )\bar  P^+$，二者之差 $2\xi \bar  P^+=P^+-P'^+$ 交给硬散射。 在 Bjorken 极限下，(a) 中硬夸克传播子的分母为 $\frac  {Q^2}{2\xi }(x-\xi +\mathrm  {i}0)$，(b) 中为 $-\frac  {Q^2}{2\xi }(x+\xi -\mathrm  {i}0)$， 故系数函数含 $\frac  1{x-\xi +\mathrm  {i}0}$ 与 $\frac  1{x+\xi -\mathrm  {i}0}$，其虚部取 GPD 在 $x=\pm \xi $ 处的值。 图中按 DGLAP 区 $x>\xi $ 标注动量；当 $-\xi <x<\xi $（ERBL 区）时，右侧部分子的正光锥动量为负，应理解为由靶发射的夸克--反夸克对。\relax }}{37}{figure.caption.36}\protected@file@percent }
\newlabel{fig:dvcs-handbag}{{1.36}{37}{深度虚康普顿散射（DVCS）$\gamma ^*(q)+p(P)\to \gamma (q')+p(P')$ 的领头阶图：(a)~手提包图；(b)~交叉图（两光子交叉，交叉处无顶点）。 灰色团为广义部分子分布（GPD）的关联函数；$\bar P=\frac 12(P+P')$，$\xi =\frac {P^+-P'^+}{P^++P'^+}$，$t=(P'-P)^2$。 离开团的部分子带正光锥动量 $(x+\xi )\bar P^+$，回到团的部分子带 $(x-\xi )\bar P^+$，二者之差 $2\xi \bar P^+=P^+-P'^+$ 交给硬散射。 在 Bjorken 极限下，(a) 中硬夸克传播子的分母为 $\frac {Q^2}{2\xi }(x-\xi +\ii 0)$，(b) 中为 $-\frac {Q^2}{2\xi }(x+\xi -\ii 0)$， 故系数函数含 $\frac 1{x-\xi +\ii 0}$ 与 $\frac 1{x+\xi -\ii 0}$，其虚部取 GPD 在 $x=\pm \xi $ 处的值。 图中按 DGLAP 区 $x>\xi $ 标注动量；当 $-\xi <x<\xi $（ERBL 区）时，右侧部分子的正光锥动量为负，应理解为由靶发射的夸克--反夸克对。\relax }{figure.caption.36}{}}
\newlabel{fig:dvcs-handbag@cref}{{[figure][36][1]1.36}{[1][37][]37}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.37}{\ignorespaces 硬遍举介子产生 $\gamma ^*_L(q)+p(P)\to M(q')+p(P')$ 的一个领头阶图（夸克 GPD 的贡献；记号同\cref {fig:dvcs-handbag}）。 下方灰色团为 GPD 关联函数 $F^q(x,\xi ,t)$，按介子的量子数取 $H^q,E^q$ 或 $\tilde  H^q,\tilde  E^q$；上方橙色团为介子的光锥分布振幅 $\phi _M(z)$，其中夸克带动量 $zq'$，反夸克带 $(1-z)q'$； 虚线框内为硬散射核 $T_H$，领头阶含一个硬胶子交换。振幅的因子化形式为 $\mathcal  M=\DOTSB \sum@ \slimits@ _q\DOTSI \intop \ilimits@ _{-1}^{1}\mathrm  {d}x\DOTSI \intop \ilimits@ _0^1\mathrm  {d}z\,F^q(x,\xi ,t)\,T^q_H(x,\xi ,z;Q,\mu )\,\phi _M(z;\mu )+\text  {幂次修正}$（Collins--Frankfurt--Strikman 1997）， 只对纵向极化的 $\gamma ^*$ 成立（全阶论证 [A]）。对横向极化光子，相应的扭度 3 卷积在端点 $z\to 0,1$ 处发散，标准的共线因子化不成立。 对矢量介子，胶子 GPD 在同一阶也有贡献（图略）。\relax }}{38}{figure.caption.37}\protected@file@percent }
\newlabel{fig:meson-production}{{1.37}{38}{硬遍举介子产生 $\gamma ^*_L(q)+p(P)\to M(q')+p(P')$ 的一个领头阶图（夸克 GPD 的贡献；记号同\cref {fig:dvcs-handbag}）。 下方灰色团为 GPD 关联函数 $F^q(x,\xi ,t)$，按介子的量子数取 $H^q,E^q$ 或 $\tilde H^q,\tilde E^q$；上方橙色团为介子的光锥分布振幅 $\phi _M(z)$，其中夸克带动量 $zq'$，反夸克带 $(1-z)q'$； 虚线框内为硬散射核 $T_H$，领头阶含一个硬胶子交换。振幅的因子化形式为 $\mathcal M=\sum _q\int _{-1}^{1}\dd x\int _0^1\dd z\,F^q(x,\xi ,t)\,T^q_H(x,\xi ,z;Q,\mu )\,\phi _M(z;\mu )+\text {幂次修正}$（Collins--Frankfurt--Strikman 1997）， 只对纵向极化的 $\gamma ^*$ 成立（全阶论证 [A]）。对横向极化光子，相应的扭度 3 卷积在端点 $z\to 0,1$ 处发散，标准的共线因子化不成立。 对矢量介子，胶子 GPD 在同一阶也有贡献（图略）。\relax }{figure.caption.37}{}}
\newlabel{fig:meson-production@cref}{{[figure][37][1]1.37}{[1][38][]38}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.38}{\ignorespaces 重夸克偶素产生的 NRQCD 因子化图像。灰色团为短距离过程：在距离 $\sim 1/m_Q$ 上产生处于确定色、自旋与轨道角动量态 $n={}^{2S+1}L_J^{[1,8]}$ 的 $Q\bar  Q$ 对（粗线；箭头为费米子数）， 其截面 $\mathrm  {d}\hat  \sigma (ij\to Q\bar  Q[n]+X)$ 可按 $\alpha _s(m_Q)$ 微扰计算；绿色团为长距离矩阵元 $\langle \mathcal  O^{H}(n)\rangle $，描述 $Q\bar  Q[n]$（相对速度 $v$，尺度 $\sim 1/(m_Qv)$）演化为强子 $H$ 的概率，按 $v$ 的幂次计数（$c\bar  c$：$v^2\approx 0.3$；$b\bar  b$：$v^2\approx 0.1$）。 (a)\nobreakspace  {}色单态：例如 $gg\to Q\bar  Q[{}^3S_1^{[1]}]+g$，在 $v$ 的领头阶 $Q\bar  Q$ 直接成为 $J/\psi $；为满足色与 $C$ 宇称守恒，短距离过程必须多放出一个硬胶子。 (b)\nobreakspace  {}色八重态（如 ${}^1S_0^{[8]}$、${}^3S_1^{[8]}$、${}^3P_J^{[8]}$）：$Q\bar  Q$ 对须放出能量 $\sim m_Qv^2$ 的软胶子才能成为色单态强子，相应矩阵元相对于 (a) 有额外的 $v$ 压低。 产生截面的因子化形式 $\mathrm  {d}\sigma (H)=\DOTSB \sum@ \slimits@ _n\mathrm  {d}\hat  \sigma (Q\bar  Q[n])\,\langle \mathcal  O^H(n)\rangle $ 是猜想（[C]），对衰变的类似公式有全阶论证（[A]）；八重态算符须以 Wilson 线补全规范不变性（见正文）。\relax }}{39}{figure.caption.38}\protected@file@percent }
\newlabel{fig:nrqcd}{{1.38}{39}{重夸克偶素产生的 NRQCD 因子化图像。灰色团为短距离过程：在距离 $\sim 1/m_Q$ 上产生处于确定色、自旋与轨道角动量态 $n={}^{2S+1}L_J^{[1,8]}$ 的 $Q\bar Q$ 对（粗线；箭头为费米子数）， 其截面 $\dd \hat \sigma (ij\to Q\bar Q[n]+X)$ 可按 $\alpha _s(m_Q)$ 微扰计算；绿色团为长距离矩阵元 $\langle \mathcal O^{H}(n)\rangle $，描述 $Q\bar Q[n]$（相对速度 $v$，尺度 $\sim 1/(m_Qv)$）演化为强子 $H$ 的概率，按 $v$ 的幂次计数（$c\bar c$：$v^2\approx 0.3$；$b\bar b$：$v^2\approx 0.1$）。 (a)~色单态：例如 $gg\to Q\bar Q[{}^3S_1^{[1]}]+g$，在 $v$ 的领头阶 $Q\bar Q$ 直接成为 $J/\psi $；为满足色与 $C$ 宇称守恒，短距离过程必须多放出一个硬胶子。 (b)~色八重态（如 ${}^1S_0^{[8]}$、${}^3S_1^{[8]}$、${}^3P_J^{[8]}$）：$Q\bar Q$ 对须放出能量 $\sim m_Qv^2$ 的软胶子才能成为色单态强子，相应矩阵元相对于 (a) 有额外的 $v$ 压低。 产生截面的因子化形式 $\dd \sigma (H)=\sum _n\dd \hat \sigma (Q\bar Q[n])\,\langle \mathcal O^H(n)\rangle $ 是猜想（[C]），对衰变的类似公式有全阶论证（[A]）；八重态算符须以 Wilson 线补全规范不变性（见正文）。\relax }{figure.caption.38}{}}
\newlabel{fig:nrqcd@cref}{{[figure][38][1]1.38}{[1][39][]39}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.39}{\ignorespaces 小 $x$ 物理。(a)\nobreakspace  {}割开的胶子梯形图：$t$ 道胶子 $k_1,\dots  ,k_n$ 自质子 $p$ 向硬过程 $H$ 依次传递，横档（实胶子）穿过割线。在领头对数 $\qopname  \relax o{ln}(1/x)$ 近似（BFKL）中， 各级动量分数强有序，$x_1\gg x_2\gg \cdots  \gg x_n$，而横动量 $\bm  {k}_{i\mathrm  T}$ 不必有序，图的求和给出 $\DOTSB \sum@ \slimits@ _n c_n\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left (\vcenter to\@ne \big@size {}\right .$}\box \z@ }\alpha _s\qopname  \relax o{ln}\frac  1x\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left )\vcenter to\@ne \big@size {}\right .$}\box \z@ }^n$； 与之对照，DGLAP 的领头对数 $\qopname  \relax o{ln}Q^2$ 来自横动量强有序 $k_{1\mathrm  T}\ll k_{2\mathrm  T}\ll \cdots  \ll Q$ 的区域。 (b)\nobreakspace  {}$k_{\mathrm  T}$（高能）因子化：最上一级胶子 $k=xP+k_{\mathrm  T}$ 离壳（$k^2\simeq -\bm  {k}_{\mathrm  T}^2$），与离壳硬部分（此处为 $\gamma ^*g^*\to Q\bar  Q$，粗线为重夸克）相连， 下方蓝色团为非积分胶子分布 $\mathcal  F(x,\bm  {k}_{\mathrm  T})$（包含 (a) 中的梯形求和）；截面形如 $\sigma \simeq \DOTSI \intop \ilimits@ \frac  {\mathrm  {d}\xi }{\xi }\DOTSI \intop \ilimits@ \mathrm  {d}^2\bm  {k}_{\mathrm  T}\,\hat  \sigma \leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left (\vcenter to\@ne \big@size {}\right .$}\box \z@ }\genfrac  {}{}{}1{x}{\xi },\bm  {k}_{\mathrm  T};Q\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left )\vcenter to\@ne \big@size {}\right .$}\box \z@ }\,\mathcal  F(\xi ,\bm  {k}_{\mathrm  T})$（示意；归一化约定见正文）。 $k_{\mathrm  T}$ 因子化只在 $\qopname  \relax o{ln}(1/x)$ 的领头对数精度、对特定过程（如重夸克产生）被确立（[P]）；BFKL 方程本身是微扰论高能极限下的（次）领头对数结果；饱和区的非线性演化属 [C]/[P]。\relax }}{40}{figure.caption.39}\protected@file@percent }
\newlabel{fig:bfkl-ladder}{{1.39}{40}{小 $x$ 物理。(a)~割开的胶子梯形图：$t$ 道胶子 $k_1,\dots ,k_n$ 自质子 $p$ 向硬过程 $H$ 依次传递，横档（实胶子）穿过割线。在领头对数 $\ln (1/x)$ 近似（BFKL）中， 各级动量分数强有序，$x_1\gg x_2\gg \cdots \gg x_n$，而横动量 $\boldsymbol k_{i\mathrm T}$ 不必有序，图的求和给出 $\sum _n c_n\big (\alpha _s\ln \frac 1x\big )^n$； 与之对照，DGLAP 的领头对数 $\ln Q^2$ 来自横动量强有序 $k_{1\mathrm T}\ll k_{2\mathrm T}\ll \cdots \ll Q$ 的区域。 (b)~$k_{\mathrm T}$（高能）因子化：最上一级胶子 $k=xP+k_{\mathrm T}$ 离壳（$k^2\simeq -\boldsymbol k_{\mathrm T}^2$），与离壳硬部分（此处为 $\gamma ^*g^*\to Q\bar Q$，粗线为重夸克）相连， 下方蓝色团为非积分胶子分布 $\mathcal F(x,\boldsymbol k_{\mathrm T})$（包含 (a) 中的梯形求和）；截面形如 $\sigma \simeq \int \frac {\dd \xi }{\xi }\int \dd ^2\boldsymbol k_{\mathrm T}\,\hat \sigma \big (\tfrac {x}{\xi },\boldsymbol k_{\mathrm T};Q\big )\,\mathcal F(\xi ,\boldsymbol k_{\mathrm T})$（示意；归一化约定见正文）。 $k_{\mathrm T}$ 因子化只在 $\ln (1/x)$ 的领头对数精度、对特定过程（如重夸克产生）被确立（[P]）；BFKL 方程本身是微扰论高能极限下的（次）领头对数结果；饱和区的非线性演化属 [C]/[P]。\relax }{figure.caption.39}{}}
\newlabel{fig:bfkl-ladder@cref}{{[figure][39][1]1.39}{[1][40][]40}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.40}{\ignorespaces 重整化子链图（大 $\beta _0$ 近似）。胶子传播子插入 $n$ 个费米子泡：(a)\nobreakspace  {}夸克--光子顶点的单圈修正；(b)\nobreakspace  {}Adler 函数（流--流关联函数）中的相应图（另有两个自能型图，未画出）。 在 $\overline  {\mathrm  {MS}}$ 方案中每个泡给出因子 $\frac  {\alpha _sT_Fn_f}{3\pi }\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left [\vcenter to\@ne \big@size {}\right .$}\box \z@ }\qopname  \relax o{ln}\frac  {-k^2}{\mu ^2}-\frac  53\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left ]\vcenter to\@ne \big@size {}\right .$}\box \z@ }$（相对于裸胶子传播子）； 保留 $n_f$ 的最高次幂后作替换 $\frac  43T_Fn_f\to -\beta _0$（“朴素非阿贝尔化”）并对 $n$ 求和，相当于把胶子两端的耦合换成以 $-k^2\mathrm  {e}^{-5/3}$ 为标度的单圈跑动耦合 $\alpha _s(\mu )\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left /\vcenter to\@ne \big@size {}\right .$}\box \z@ }\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left [\vcenter to\@ne \big@size {}\right .$}\box \z@ }1+\frac  {\beta _0\alpha _s(\mu )}{4\pi }\qopname  \relax o{ln}\frac  {-k^2\mathrm  {e}^{-5/3}}{\mu ^2}\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left ]\vcenter to\@ne \big@size {}\right .$}\box \z@ }$。 固定 $n$ 时，圈积分中 $|k^2|\ll Q^2$ 的区域给出随 $n$ 阶乘增长的系数 $\sim n!\,\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left (\vcenter to\@ne \big@size {}\right .$}\box \z@ }\frac  {\beta _0}{4\pi p}\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left )\vcenter to\@ne \big@size {}\right .$}\box \z@ }^n\alpha _s^{n+1}$（红外重整化子，$p=1,2,\dots  $），相应 Borel 积分的不确定性 $\propto (\Lambda ^2/Q^2)^p$，与高扭度贡献的量级相同； $|k^2|\gg Q^2$ 的区域给出符号交错的紫外重整化子（见正文）。\relax }}{41}{figure.caption.40}\protected@file@percent }
\newlabel{fig:renormalon-chain}{{1.40}{41}{重整化子链图（大 $\beta _0$ 近似）。胶子传播子插入 $n$ 个费米子泡：(a)~夸克--光子顶点的单圈修正；(b)~Adler 函数（流--流关联函数）中的相应图（另有两个自能型图，未画出）。 在 $\MSbar $ 方案中每个泡给出因子 $\frac {\alpha _sT_Fn_f}{3\pi }\big [\ln \frac {-k^2}{\mu ^2}-\frac 53\big ]$（相对于裸胶子传播子）； 保留 $n_f$ 的最高次幂后作替换 $\frac 43T_Fn_f\to -\beta _0$（“朴素非阿贝尔化”）并对 $n$ 求和，相当于把胶子两端的耦合换成以 $-k^2\ee ^{-5/3}$ 为标度的单圈跑动耦合 $\alpha _s(\mu )\big /\big [1+\frac {\beta _0\alpha _s(\mu )}{4\pi }\ln \frac {-k^2\ee ^{-5/3}}{\mu ^2}\big ]$。 固定 $n$ 时，圈积分中 $|k^2|\ll Q^2$ 的区域给出随 $n$ 阶乘增长的系数 $\sim n!\,\big (\frac {\beta _0}{4\pi p}\big )^n\alpha _s^{n+1}$（红外重整化子，$p=1,2,\dots $），相应 Borel 积分的不确定性 $\propto (\Lambda ^2/Q^2)^p$，与高扭度贡献的量级相同； $|k^2|\gg Q^2$ 的区域给出符号交错的紫外重整化子（见正文）。\relax }{figure.caption.40}{}}
\newlabel{fig:renormalon-chain@cref}{{[figure][40][1]1.40}{[1][41][]41}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.41}{\ignorespaces DIS 强子张量的扭度展开（割图；竖直虚线为末态割线）。(a)\nobreakspace  {}扭度 2 的手提包图：强子经割线两侧各一条夸克线与硬部分相连。 (b)\nobreakspace  {}强子另外经一条横向极化的胶子（光锥规范 $A^+=0$ 中的 $A_{\mathrm  T}$）与硬部分相连，即夸克--胶子--夸克关联（算符 $\bar  \psi \gamma ^+G^{+\alpha }\psi $ 为扭度 3）； 按幂次计数，每多一条与硬部分相连的横向极化部分子，贡献就多一个 $1/Q$ 压低。在非极化 DIS 中，$1/Q$ 项因前向矩阵元中没有可用的横向矢量而为零； (b) 类图对部分子横动量展开到一阶的项，与 (a) 展开到二阶的项以及 (c) 类图合并为规范不变的扭度 4 矩阵元（如 $\bar  \psi \gamma ^+D_{\mathrm  T}D_{\mathrm  T}\psi $）， 给出结构函数的 $1/Q^2$ 修正（Ellis--Furmanski--Petronzio 的共线展开）。(c)\nobreakspace  {}割线两侧各多一条胶子的四部分子关联直接属于扭度 4；四夸克关联亦属此列（图略）。\relax }}{42}{figure.caption.41}\protected@file@percent }
\newlabel{fig:higher-twist}{{1.41}{42}{DIS 强子张量的扭度展开（割图；竖直虚线为末态割线）。(a)~扭度 2 的手提包图：强子经割线两侧各一条夸克线与硬部分相连。 (b)~强子另外经一条横向极化的胶子（光锥规范 $A^+=0$ 中的 $A_{\mathrm T}$）与硬部分相连，即夸克--胶子--夸克关联（算符 $\bar \psi \gamma ^+G^{+\alpha }\psi $ 为扭度 3）； 按幂次计数，每多一条与硬部分相连的横向极化部分子，贡献就多一个 $1/Q$ 压低。在非极化 DIS 中，$1/Q$ 项因前向矩阵元中没有可用的横向矢量而为零； (b) 类图对部分子横动量展开到一阶的项，与 (a) 展开到二阶的项以及 (c) 类图合并为规范不变的扭度 4 矩阵元（如 $\bar \psi \gamma ^+D_{\mathrm T}D_{\mathrm T}\psi $）， 给出结构函数的 $1/Q^2$ 修正（Ellis--Furmanski--Petronzio 的共线展开）。(c)~割线两侧各多一条胶子的四部分子关联直接属于扭度 4；四夸克关联亦属此列（图略）。\relax }{figure.caption.41}{}}
\newlabel{fig:higher-twist@cref}{{[figure][41][1]1.41}{[1][42][]42}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.42}{\ignorespaces Qiu--Sterman 软胶子极点机制（以 $A^{\uparrow }+B\to \gamma +X$ 中的 Compton 子过程 $qg\to \gamma q$ 为例；竖直虚线为末态割线）。 横向极化强子 $A^{\uparrow }$ 的扭度 3 关联函数 $T_F(x_1,x_2)$ 提供割线两侧的夸克线（$x_1P_A$、$x_2P_A$）与一条胶子线（$x_gP_A$，$x_g\equiv x_2-x_1$），后者与末态夸克 $c$ 相连。 夹在硬部分与该胶子之间的传播子（红色）携带 $p_c-(x_2-x_1)P_A$，其分母 $\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left (\vcenter to\@ne \big@size {}\right .$}\box \z@ }p_c-(x_2-x_1)P_A\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left )\vcenter to\@ne \big@size {}\right .$}\box \z@ }^2+\mathrm  {i}0=-2p_c\cdot P_A\,(x_2-x_1-\mathrm  {i}0)$ 在 $x_2\to x_1$ 时为零： $\frac  {1}{x_2-x_1-\mathrm  {i}0}$ 的 $\mathrm  {i}\pi \delta (x_2-x_1)$ 部分提供单自旋不对称所需的相位，使结果正比于 $T_F(x,x)$（“软胶子极点”）。 若胶子与初态部分子相连，$\mathrm  {i}0$ 的符号相反，色因子也不同——这与 Sivers 函数的过程依赖性相对应（参见\cref {fig:sidis-dy-links}）。\relax }}{43}{figure.caption.42}\protected@file@percent }
\newlabel{fig:twist3-ssa}{{1.42}{43}{Qiu--Sterman 软胶子极点机制（以 $A^{\uparrow }+B\to \gamma +X$ 中的 Compton 子过程 $qg\to \gamma q$ 为例；竖直虚线为末态割线）。 横向极化强子 $A^{\uparrow }$ 的扭度 3 关联函数 $T_F(x_1,x_2)$ 提供割线两侧的夸克线（$x_1P_A$、$x_2P_A$）与一条胶子线（$x_gP_A$，$x_g\equiv x_2-x_1$），后者与末态夸克 $c$ 相连。 夹在硬部分与该胶子之间的传播子（红色）携带 $p_c-(x_2-x_1)P_A$，其分母 $\big (p_c-(x_2-x_1)P_A\big )^2+\ii 0=-2p_c\cdot P_A\,(x_2-x_1-\ii 0)$ 在 $x_2\to x_1$ 时为零： $\frac {1}{x_2-x_1-\ii 0}$ 的 $\ii \pi \delta (x_2-x_1)$ 部分提供单自旋不对称所需的相位，使结果正比于 $T_F(x,x)$（“软胶子极点”）。 若胶子与初态部分子相连，$\ii 0$ 的符号相反，色因子也不同——这与 Sivers 函数的过程依赖性相对应（参见\cref {fig:sidis-dy-links}）。\relax }{figure.caption.42}{}}
\newlabel{fig:twist3-ssa@cref}{{[figure][42][1]1.42}{[1][43][]43}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.43}{\ignorespaces 双部分子散射（DPS）的示意（振幅层次，以双 Drell--Yan 过程为例）。每个强子各提供两个部分子，参与两个硬散射 $H_1$、$H_2$，二者在横向平面上相距 $\bm  {y}$； 来自 $B$ 的反夸克的费米子数箭头由硬散射指向 $B$。截面的因子化形式为 $\mathrm  {d}\sigma _{\mathrm  {DPS}}=\frac  1C\DOTSB \sum@ \slimits@ \DOTSI \intop \ilimits@ \mathrm  {d}^2\bm  {y}\,F_{a_1a_2/A}\,F_{b_1b_2/B}\,\mathrm  {d}\hat  \sigma _{a_1b_1}\,\mathrm  {d}\hat  \sigma _{a_2b_2}$ （对部分子种类求和，$F$ 的自变量如图），其中 $F$ 为双部分子分布，依赖于两部分子的动量分数及其横向间距 $\bm  {y}$；$C$ 为对称因子（两个硬过程相同时 $C=2$，否则 $C=1$）。 对双 Drell--Yan，旁观者之间 Glauber 交换的相消已有全阶论证（[A]）；而色关联、$1\to 2$ 微扰劈裂（小 $\bm  {y}$ 处 $F\propto 1/\bm  {y}^2$）以及与单部分子散射之间的重复计数等问题，使完整框架仍只具 [P] 地位。\relax }}{44}{figure.caption.43}\protected@file@percent }
\newlabel{fig:dps}{{1.43}{44}{双部分子散射（DPS）的示意（振幅层次，以双 Drell--Yan 过程为例）。每个强子各提供两个部分子，参与两个硬散射 $H_1$、$H_2$，二者在横向平面上相距 $\boldsymbol y$； 来自 $B$ 的反夸克的费米子数箭头由硬散射指向 $B$。截面的因子化形式为 $\dd \sigma _{\mathrm {DPS}}=\frac 1C\sum \int \dd ^2\boldsymbol y\,F_{a_1a_2/A}\,F_{b_1b_2/B}\,\dd \hat \sigma _{a_1b_1}\,\dd \hat \sigma _{a_2b_2}$ （对部分子种类求和，$F$ 的自变量如图），其中 $F$ 为双部分子分布，依赖于两部分子的动量分数及其横向间距 $\boldsymbol y$；$C$ 为对称因子（两个硬过程相同时 $C=2$，否则 $C=1$）。 对双 Drell--Yan，旁观者之间 Glauber 交换的相消已有全阶论证（[A]）；而色关联、$1\to 2$ 微扰劈裂（小 $\boldsymbol y$ 处 $F\propto 1/\boldsymbol y^2$）以及与单部分子散射之间的重复计数等问题，使完整框架仍只具 [P] 地位。\relax }{figure.caption.43}{}}
\newlabel{fig:dps@cref}{{[figure][43][1]1.43}{[1][44][]44}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.44}{\ignorespaces 准 PDF 与光锥 PDF 算符的时空图（$z$ 为纵向坐标；阴影带为强子的世界带）。(a) 中黑色双线为光锥 PDF 算符的 Wilson 线 $W[w,0]$， $w=(0^+,w^-,0_{\mathrm  T})$ 位于光锥 $w^+=0$（即 $t=-z$）上，$f_{q/H}(\xi )=\DOTSI \intop \ilimits@ \frac  {\mathrm  {d}w^-}{4\pi }\mathrm  {e}^{-\mathrm  {i}\xi P^+w^-}\langle P|\bar  \psi (w)\gamma ^+W[w,0]\psi (0)|P\rangle $； 蓝色双线为准 PDF 算符的 Wilson 线 $W[z,0]$，沿 $z$ 轴、在等时面 $t=0$ 上，$\tilde  q(x,P^z)=\DOTSI \intop \ilimits@ \frac  {\mathrm  {d}z}{4\pi }\mathrm  {e}^{\mathrm  {i}xP^zz}\langle P|\bar  \psi (z)\Gamma W[z,0]\psi (0)|P\rangle $（$\Gamma =\gamma ^z$ 或 $\gamma ^t$，归一化见正文）。 (a)\nobreakspace  {}强子以速度 $v$ 沿 $+z$ 运动；(b)\nobreakspace  {}经快度为 $y$（$\qopname  \relax o{tanh}y=v$）的 Lorentz 变换转到强子静止系后，等时间隔 $(t,z)=(0,z)$ 变为 $(-z\qopname  \relax o{sinh}y,\,z\qopname  \relax o{cosh}y)$： 其端点由 $t=0$ 处（灰点）沿不变双曲线 $z^2-t^2=\text  {常数}$（点线）移动，随 $P^z$ 增大而趋向光锥 $w^+=0$，即光锥 PDF 算符的方向；光锥方向本身在变换下不变（只被伸缩）。 因此大 $P^z$ 下的准 PDF 趋近光锥 PDF，二者之差由微扰匹配系数描述（大动量有效理论，见正文）；此图取 $v=0.8$。\relax }}{45}{figure.caption.44}\protected@file@percent }
\newlabel{fig:quasi-pdf}{{1.44}{45}{准 PDF 与光锥 PDF 算符的时空图（$z$ 为纵向坐标；阴影带为强子的世界带）。(a) 中黑色双线为光锥 PDF 算符的 Wilson 线 $W[w,0]$， $w=(0^+,w^-,0_{\mathrm T})$ 位于光锥 $w^+=0$（即 $t=-z$）上，$f_{q/H}(\xi )=\int \frac {\dd w^-}{4\pi }\ee ^{-\ii \xi P^+w^-}\langle P|\bar \psi (w)\gamma ^+W[w,0]\psi (0)|P\rangle $； 蓝色双线为准 PDF 算符的 Wilson 线 $W[z,0]$，沿 $z$ 轴、在等时面 $t=0$ 上，$\tilde q(x,P^z)=\int \frac {\dd z}{4\pi }\ee ^{\ii xP^zz}\langle P|\bar \psi (z)\Gamma W[z,0]\psi (0)|P\rangle $（$\Gamma =\gamma ^z$ 或 $\gamma ^t$，归一化见正文）。 (a)~强子以速度 $v$ 沿 $+z$ 运动；(b)~经快度为 $y$（$\tanh y=v$）的 Lorentz 变换转到强子静止系后，等时间隔 $(t,z)=(0,z)$ 变为 $(-z\sinh y,\,z\cosh y)$： 其端点由 $t=0$ 处（灰点）沿不变双曲线 $z^2-t^2=\text {常数}$（点线）移动，随 $P^z$ 增大而趋向光锥 $w^+=0$，即光锥 PDF 算符的方向；光锥方向本身在变换下不变（只被伸缩）。 因此大 $P^z$ 下的准 PDF 趋近光锥 PDF，二者之差由微扰匹配系数描述（大动量有效理论，见正文）；此图取 $v=0.8$。\relax }{figure.caption.44}{}}
\newlabel{fig:quasi-pdf@cref}{{[figure][44][1]1.44}{[1][45][]45}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.45}{\ignorespaces 本书主要结论的逻辑依赖。框的颜色表示严格性标签（绿 R、蓝 A、橙 P、紫 C、红 V），虚线框为 $R_{\rm  cond}$ 条件定理；灰色箭头是各条目依赖记录在所示结论之间的传递约化，引用编号后的圈码表示用到左列的哪几项工具（ST 为 Slavnov--Taylor 恒等式）。下方橙色虚线框为编号假设，其中“Glauber 区”框代表 Glauber--软混合、围道形变与改写形式的 Collins 条件三条假设；橙色虚线箭头指向以之为前提的条件定理，粗红线标出决定各全阶论证地位的瓶颈假设。完整的依赖图见附录\nobreakspace  {}P。\relax }}{46}{figure.caption.45}\protected@file@percent }
\newlabel{fig:intro-dependency}{{1.45}{46}{本书主要结论的逻辑依赖。框的颜色表示严格性标签（绿 R、蓝 A、橙 P、紫 C、红 V），虚线框为 $R_{\rm cond}$ 条件定理；灰色箭头是各条目依赖记录在所示结论之间的传递约化，引用编号后的圈码表示用到左列的哪几项工具（ST 为 Slavnov--Taylor 恒等式）。下方橙色虚线框为编号假设，其中“Glauber 区”框代表 Glauber--软混合、围道形变与改写形式的 Collins 条件三条假设；橙色虚线箭头指向以之为前提的条件定理，粗红线标出决定各全阶论证地位的瓶颈假设。完整的依赖图见附录~P。\relax }{figure.caption.45}{}}
