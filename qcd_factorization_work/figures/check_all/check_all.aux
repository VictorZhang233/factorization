\@writefile{lof}{\contentsline {figure}{\numberline {1.47}{\ignorespaces 胶子传播子的单圈修正（Feynman 规范，外线动量 $k$ 自左向右流动）：(a) 夸克圈（对 $n_f$ 味求和），(b) 胶子圈，(c) 鬼场圈， (d) 四胶子顶点的蝌蚪图（无标度积分，维数正规化中为零）。(b)(c) 单独都不满足横向性，三者之和正比于 $k^2g^{\mu \nu }-k^\mu k^\nu $； 紫外极点给出 $\delta Z_3$，与夸克场和顶点的重整化常数合成规范无关的 $\delta Z_g$ 与 $\beta _0=\frac  {11}3C_A-\frac  43T_Fn_f$（VF-PDF-14，VF-QCD-4）。\relax }}{48}{figure.caption.47}\protected@file@percent }
\newlabel{fig:qcd-vacuum-polarization}{{1.47}{48}{胶子传播子的单圈修正（Feynman 规范，外线动量 $k$ 自左向右流动）：(a) 夸克圈（对 $n_f$ 味求和），(b) 胶子圈，(c) 鬼场圈， (d) 四胶子顶点的蝌蚪图（无标度积分，维数正规化中为零）。(b)(c) 单独都不满足横向性，三者之和正比于 $k^2g^{\mu \nu }-k^\mu k^\nu $； 紫外极点给出 $\delta Z_3$，与夸克场和顶点的重整化常数合成规范无关的 $\delta Z_g$ 与 $\beta _0=\frac {11}3C_A-\frac 43T_Fn_f$（VF-PDF-14，VF-QCD-4）。\relax }{figure.caption.47}{}}
