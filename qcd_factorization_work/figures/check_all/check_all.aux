\@writefile{lof}{\contentsline {figure}{\numberline {1.82}{\ignorespaces Mellin 反演与 Landau 极点（示意）。反演积分$\DOTSI \intop \ilimits@ _C\frac  {\mathrm  {d}N}{2\pi \mathrm  {i}}\,\tau ^{-N}f_{A,N}f_{B,N}\Delta _N$（截面的归一化见正文）的围道$C$自下而上。在固定对数精度下，阈值指数按$\alpha _s\qopname  \relax o{ln}\bar  N$组织；当有效标度$Q^2/\bar  N^2$降到跑动耦合$\alpha _s(q^2)$的 Landau 极点时，$\qopname  \relax o{ln}\Delta _N$在正实轴远处的$N_L$出现支点（及向右的割线）； 最小处方\cite  {CataniEtAl1996}的围道$C_{\rm  MP}$与实轴交于$c$，$c$位于部分子分布矩的奇点与$N_L$之间（其余奇点都在围道左侧，$N_L$及其割线在右侧），在$|\Imag  N|$大处向左弯折以改善收敛。处方是定义，不是定理（\cref {rem:thr-prescriptions}）。\relax }}{83}{figure.caption.82}\protected@file@percent }
\newlabel{fig:thr-mellin}{{1.82}{83}{Mellin 反演与 Landau 极点（示意）。反演积分$\int _C\frac {\dd N}{2\pi \ii }\,\tau ^{-N}f_{A,N}f_{B,N}\Delta _N$（截面的归一化见正文）的围道$C$自下而上。在固定对数精度下，阈值指数按$\alpha _s\ln \bar N$组织；当有效标度$Q^2/\bar N^2$降到跑动耦合$\alpha _s(q^2)$的 Landau 极点时，$\ln \Delta _N$在正实轴远处的$N_L$出现支点（及向右的割线）； 最小处方\cite {CataniEtAl1996}的围道$C_{\rm MP}$与实轴交于$c$，$c$位于部分子分布矩的奇点与$N_L$之间（其余奇点都在围道左侧，$N_L$及其割线在右侧），在$|\Imag N|$大处向左弯折以改善收敛。处方是定义，不是定理（\cref {rem:thr-prescriptions}）。\relax }{figure.caption.82}{}}
\newlabel{fig:thr-mellin@cref}{{[figure][82][1]1.82}{[1][83][]83}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.83}{\ignorespaces Sterman--Weinberg 两喷注定义（$e^+e^-$质心系，示意；线段为各粒子的飞行方向）：若存在一对方向相反、半张角为$\delta $的锥（锥轴可任意选取），使两锥之外的总能量小于$\epsilon \sqrt  s$，则事例计为两喷注事例。 $\epsilon $是总能量$\sqrt  s$的份额；在$\epsilon <\delta \ll 1$时$\mathcal  {O}\!\left (\alpha _s\right )$的结果含$4\qopname  \relax o{ln}\delta \qopname  \relax o{ln}2\epsilon $（若$\epsilon '$取为束流能量的份额，则为$4\qopname  \relax o{ln}\delta \qopname  \relax o{ln}\epsilon '$；\cref {prop:jets-sw}，VF-EE-12）。\relax }}{84}{figure.caption.83}\protected@file@percent }
\newlabel{fig:jets-sw-cone}{{1.83}{84}{Sterman--Weinberg 两喷注定义（$e^+e^-$质心系，示意；线段为各粒子的飞行方向）：若存在一对方向相反、半张角为$\delta $的锥（锥轴可任意选取），使两锥之外的总能量小于$\epsilon \sqrt s$，则事例计为两喷注事例。 $\epsilon $是总能量$\sqrt s$的份额；在$\epsilon <\delta \ll 1$时$\order {\alpha _s}$的结果含$4\ln \delta \ln 2\epsilon $（若$\epsilon '$取为束流能量的份额，则为$4\ln \delta \ln \epsilon '$；\cref {prop:jets-sw}，VF-EE-12）。\relax }{figure.caption.83}{}}
\newlabel{fig:jets-sw-cone@cref}{{[figure][83][1]1.83}{[1][84][]84}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.84}{\ignorespaces 非全局对数的来源（$e^+e^-$质心系，示意）。垂直于推力轴的平面把事例分为半球 L 与 R，只对 R 中的总能量施加否决$E_R<E_{\rm  cut}$（阴影）；$q$、$\bar  q$沿推力轴。 未被测量的 L 中的较硬胶子$k_1$（能量$\omega _1$）向被否决的 R 辐射较软的胶子$k_2$（$\omega _2\ll \omega _1$）：$k_2$由$k_1$参与的相干发射给出，其实辐射被否决而虚修正不受限制，二者不再相消，产生非全局对数； 首项出现在$\mathcal  {O}\!\left (\alpha _s^2\right )$，色因子为$C_FC_A$（\cref {prop:jets-ngl}）。\relax }}{85}{figure.caption.84}\protected@file@percent }
\newlabel{fig:jets-ngl}{{1.84}{85}{非全局对数的来源（$e^+e^-$质心系，示意）。垂直于推力轴的平面把事例分为半球 L 与 R，只对 R 中的总能量施加否决$E_R<E_{\rm cut}$（阴影）；$q$、$\bar q$沿推力轴。 未被测量的 L 中的较硬胶子$k_1$（能量$\omega _1$）向被否决的 R 辐射较软的胶子$k_2$（$\omega _2\ll \omega _1$）：$k_2$由$k_1$参与的相干发射给出，其实辐射被否决而虚修正不受限制，二者不再相消，产生非全局对数； 首项出现在$\order {\alpha _s^2}$，色因子为$C_FC_A$（\cref {prop:jets-ngl}）。\relax }{figure.caption.84}{}}
\newlabel{fig:jets-ngl@cref}{{[figure][84][1]1.84}{[1][85][]85}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.85}{\ignorespaces 强子对撞中的“喷注间隙”可观测量（示意）。(a)\nobreakspace  {}两个硬喷注位于快度$y_1$、$y_2$，其间宽为$Y$的快度区间（阴影）内辐射的横能量被否决，$E_T<Q_0\ll Q$；束流沿$y\to \pm \infty $。 (b)\nobreakspace  {}初态两个有色部分子之间的 Coulomb/Glauber 交换（暗红色，虚部$\mathrm  {i}\pi $）与软辐射（绿色，例如间隙外的软胶子）不对易，实—虚相消失效，产生超领头对数：首项为相对 Born 的$\alpha _s^4\qopname  \relax o{ln}^5(Q/Q_0)$（VF-GLA-13）。 其地位分三层：振幅层次严格共线因子化的破坏 [V]；超领头对数的固定阶与重求和结果 [P]；间隙截面的 PDF 因子化仍是猜想 [C]，并有恢复的证据（\cref {prop:jets-sll}）。\relax }}{86}{figure.caption.85}\protected@file@percent }
\newlabel{fig:jets-gap}{{1.85}{86}{强子对撞中的“喷注间隙”可观测量（示意）。(a)~两个硬喷注位于快度$y_1$、$y_2$，其间宽为$Y$的快度区间（阴影）内辐射的横能量被否决，$E_T<Q_0\ll Q$；束流沿$y\to \pm \infty $。 (b)~初态两个有色部分子之间的 Coulomb/Glauber 交换（暗红色，虚部$\ii \pi $）与软辐射（绿色，例如间隙外的软胶子）不对易，实—虚相消失效，产生超领头对数：首项为相对 Born 的$\alpha _s^4\ln ^5(Q/Q_0)$（VF-GLA-13）。 其地位分三层：振幅层次严格共线因子化的破坏 [V]；超领头对数的固定阶与重求和结果 [P]；间隙截面的 PDF 因子化仍是猜想 [C]，并有恢复的证据（\cref {prop:jets-sll}）。\relax }{figure.caption.85}{}}
\newlabel{fig:jets-gap@cref}{{[figure][85][1]1.85}{[1][86][]86}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.86}{\ignorespaces 偶极子图像与 BK 演化（示意；靶强子沿$+z$运动，Lorentz 收缩为位于$x^-=0$的冲击波，偶极子沿$-z$运动，以$x^-$为光锥时间；(a)、(b) 中竖直方向示意横向位置）。 (a)\nobreakspace  {}虚光子分裂为横向尺寸$r=|\bm  {x}_0-\bm  {x}_1|$的$q\bar  q$偶极子（箭头为费米子数流向），夸克与反夸克穿过冲击波时分别获得 Wilson 线$V_{\bm  {x}_0}$、$V^\dagger _{\bm  {x}_1}$（$V_{\bm  {x}}=\mathrm  P\qopname  \relax o{exp}[\mathrm  {i}g\DOTSI \intop \ilimits@ \mathrm  {d}x^-A^+(x^-,\bm  {x})]$），偶极子的$S$矩阵为$S_{01}$。 (b)\nobreakspace  {}偶极子发射的软胶子（绿色）在横向位置$\bm  {x}_2$穿过冲击波（伴随表示的$U_{\bm  {x}_2}$；图中只画出一种附着方式）；(c)\nobreakspace  {}在大$N_c$下它把偶极子$(\bm  {x}_0,\bm  {x}_1)$（虚线）分裂为$(\bm  {x}_0,\bm  {x}_2)$与$(\bm  {x}_2,\bm  {x}_1)$，权重为偶极子核；两个子偶极子同时散射给出 BK 方程的非线性项$-N_{02}N_{12}$（VF-MISC-4，\cref {thm:smallx-bk}）。 这是 Regge（程函）展开中固定对数精度下的结果，不是 QCD 的领头幂次定理。\relax }}{87}{figure.caption.86}\protected@file@percent }
\newlabel{fig:smallx-dipole}{{1.86}{87}{偶极子图像与 BK 演化（示意；靶强子沿$+z$运动，Lorentz 收缩为位于$x^-=0$的冲击波，偶极子沿$-z$运动，以$x^-$为光锥时间；(a)、(b) 中竖直方向示意横向位置）。 (a)~虚光子分裂为横向尺寸$r=|\boldsymbol x_0-\boldsymbol x_1|$的$q\bar q$偶极子（箭头为费米子数流向），夸克与反夸克穿过冲击波时分别获得 Wilson 线$V_{\boldsymbol x_0}$、$V^\dagger _{\boldsymbol x_1}$（$V_{\boldsymbol x}=\mathrm P\exp [\ii g\int \dd x^-A^+(x^-,\boldsymbol x)]$），偶极子的$S$矩阵为$S_{01}$。 (b)~偶极子发射的软胶子（绿色）在横向位置$\boldsymbol x_2$穿过冲击波（伴随表示的$U_{\boldsymbol x_2}$；图中只画出一种附着方式）；(c)~在大$N_c$下它把偶极子$(\boldsymbol x_0,\boldsymbol x_1)$（虚线）分裂为$(\boldsymbol x_0,\boldsymbol x_2)$与$(\boldsymbol x_2,\boldsymbol x_1)$，权重为偶极子核；两个子偶极子同时散射给出 BK 方程的非线性项$-N_{02}N_{12}$（VF-MISC-4，\cref {thm:smallx-bk}）。 这是 Regge（程函）展开中固定对数精度下的结果，不是 QCD 的领头幂次定理。\relax }{figure.caption.86}{}}
\newlabel{fig:smallx-dipole@cref}{{[figure][86][1]1.86}{[1][87][]87}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.87}{\ignorespaces 小$x$物理的“地图”（示意）。DGLAP 沿$\qopname  \relax o{ln}Q^2$演化（严格 [R]，微扰论中由算符重整化得到）；BFKL 沿$\qopname  \relax o{ln}(1/x)$重求和$(\alpha _s\qopname  \relax o{ln}\frac  1x)^n$（全阶论证 [A]，LL/NLL）；$k_T$因子化只对特定过程在$\qopname  \relax o{ln}(1/x)$的领头对数精度下确立（部分 [P]）； BK/JIMWLK（全阶论证 [A]，偶极子框架中的 LL，\cref {thm:smallx-bk}）描述向饱和线$\qopname  \relax o{ln}Q_s^2(x)$的演化，其下方的饱和区是猜想 [C]（\cref {conj:smallx-saturation}）；两种领头对数在双对数（DLA）区重叠。小$x$结果是 Regge 展开中固定对数精度下的陈述，不是 QCD 的领头幂次定理。\relax }}{88}{figure.caption.87}\protected@file@percent }
\newlabel{fig:smallx-map}{{1.87}{88}{小$x$物理的“地图”（示意）。DGLAP 沿$\ln Q^2$演化（严格 [R]，微扰论中由算符重整化得到）；BFKL 沿$\ln (1/x)$重求和$(\alpha _s\ln \frac 1x)^n$（全阶论证 [A]，LL/NLL）；$k_T$因子化只对特定过程在$\ln (1/x)$的领头对数精度下确立（部分 [P]）； BK/JIMWLK（全阶论证 [A]，偶极子框架中的 LL，\cref {thm:smallx-bk}）描述向饱和线$\ln Q_s^2(x)$的演化，其下方的饱和区是猜想 [C]（\cref {conj:smallx-saturation}）；两种领头对数在双对数（DLA）区重叠。小$x$结果是 Regge 展开中固定对数精度下的陈述，不是 QCD 的领头幂次定理。\relax }{figure.caption.87}{}}
\newlabel{fig:smallx-map@cref}{{[figure][87][1]1.87}{[1][88][]88}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.88}{\ignorespaces $\bar  B^0\to D^+\pi ^-$ 的因子化（\cref {thm:heavy-bdpi}，全阶论证 [A]）。黑方块为弱作用四夸克算符 $O_{\mathbf  0}=[\bar  c\gamma ^\mu P_Lb][\bar  d\gamma _\mu P_Lu]$ 的顶点，粗线为重夸克 $b$、$c$，双线为介子；细线上的箭头为费米子数流向（反夸克 $\bar  d$、$\bar  u$ 的箭头逆着动量）。 旁观者 $\bar  d$ 自 $\bar  B^0$ 进入 $D^+$，这一软的跃迁由形状因子 $F^{B\to D}(0)$ 描述；发射的 $\pi ^-$ 由弱顶点直接产生的共线 $d\bar  u$ 对构成（蓝色团，分布振幅 $\phi _\pi (x)$，$x$ 为 $d$ 夸克的动量分数），它是快速运动的色单态小偶极子： 软胶子与 $d$、$\bar  u$ 的程函耦合在领头幂次相消（打叉的绿色胶子，色透明性），硬胶子交换归入短程系数 $T(x,\mu )$。 $N=\frac  {\mathrm  {i}}{2}m_BE_\pi f_\pi $；修正被 $\Lambda /m_b$、$\Lambda /m_c$、$\Lambda /E_\pi $ 压低（VF-BQ-6）；$B^-\to D^0\pi ^-$ 同理。证明还用到分布振幅端点压低的假设（见正文）。\relax }}{89}{figure.caption.88}\protected@file@percent }
\newlabel{fig:heavy-bdpi}{{1.88}{89}{$\bar B^0\to D^+\pi ^-$ 的因子化（\cref {thm:heavy-bdpi}，全阶论证 [A]）。黑方块为弱作用四夸克算符 $O_{\mathbf 0}=[\bar c\gamma ^\mu P_Lb][\bar d\gamma _\mu P_Lu]$ 的顶点，粗线为重夸克 $b$、$c$，双线为介子；细线上的箭头为费米子数流向（反夸克 $\bar d$、$\bar u$ 的箭头逆着动量）。 旁观者 $\bar d$ 自 $\bar B^0$ 进入 $D^+$，这一软的跃迁由形状因子 $F^{B\to D}(0)$ 描述；发射的 $\pi ^-$ 由弱顶点直接产生的共线 $d\bar u$ 对构成（蓝色团，分布振幅 $\phi _\pi (x)$，$x$ 为 $d$ 夸克的动量分数），它是快速运动的色单态小偶极子： 软胶子与 $d$、$\bar u$ 的程函耦合在领头幂次相消（打叉的绿色胶子，色透明性），硬胶子交换归入短程系数 $T(x,\mu )$。 $N=\frac {\ii }{2}m_BE_\pi f_\pi $；修正被 $\Lambda /m_b$、$\Lambda /m_c$、$\Lambda /E_\pi $ 压低（VF-BQ-6）；$B^-\to D^0\pi ^-$ 同理。证明还用到分布振幅端点压低的假设（见正文）。\relax }{figure.caption.88}{}}
\newlabel{fig:heavy-bdpi@cref}{{[figure][88][1]1.88}{[1][89][]89}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.89}{\ignorespaces 无粲两体衰变 $\bar  B\to M_1M_2$ 的 QCD 因子化（BBNS；\cref {prop:heavy-qcdf-lp}，部分 [P]），各只画一个代表图。黑方块为弱作用四夸克算符的顶点，粗线为 $b$ 夸克，箭头为费米子数流向； $M_2$（蓝）为由弱顶点发射的介子，$M_1$（橙）为接收旁观反夸克 $\bar  q_s$ 的介子。(a)\nobreakspace  {}形状因子项：硬胶子连接发射对与 $b\to q$ 线（顶点修正），软的跃迁由 $F^{B\to M_1}(0)$ 描述。 (b)\nobreakspace  {}硬旁观者散射：旁观者（动量 $\xi p_B$，$\xi \sim \Lambda /m_b$）放出一个硬共线胶子（虚度 $\sim m_b\Lambda $），以动量分数 $\bar  y=1-y$ 进入 $M_1$。 红色标出端点区 $\bar  y\to 0$（旁观反夸克以趋于零的动量分数进入 $M_1$）：扭度 3 的硬旁观者项在此对数发散，$X_H=\DOTSI \intop \ilimits@ _0^1\frac  {\mathrm  {d}y}{1-y}\Phi _p(y)$；弱湮灭项（未画出）有同类端点发散 $X_A=\DOTSI \intop \ilimits@ _0^1\frac  {\mathrm  {d}y}{y}$（VF-BQ-3）。 这些幂次修正的标准共线因子化不成立（\cref {prop:heavy-qcdf-endpoint}，[V]），$X_{A,H}$ 的参数化只是模型。\relax }}{90}{figure.caption.89}\protected@file@percent }
\newlabel{fig:heavy-qcdf}{{1.89}{90}{无粲两体衰变 $\bar B\to M_1M_2$ 的 QCD 因子化（BBNS；\cref {prop:heavy-qcdf-lp}，部分 [P]），各只画一个代表图。黑方块为弱作用四夸克算符的顶点，粗线为 $b$ 夸克，箭头为费米子数流向； $M_2$（蓝）为由弱顶点发射的介子，$M_1$（橙）为接收旁观反夸克 $\bar q_s$ 的介子。(a)~形状因子项：硬胶子连接发射对与 $b\to q$ 线（顶点修正），软的跃迁由 $F^{B\to M_1}(0)$ 描述。 (b)~硬旁观者散射：旁观者（动量 $\xi p_B$，$\xi \sim \Lambda /m_b$）放出一个硬共线胶子（虚度 $\sim m_b\Lambda $），以动量分数 $\bar y=1-y$ 进入 $M_1$。 红色标出端点区 $\bar y\to 0$（旁观反夸克以趋于零的动量分数进入 $M_1$）：扭度 3 的硬旁观者项在此对数发散，$X_H=\int _0^1\frac {\dd y}{1-y}\Phi _p(y)$；弱湮灭项（未画出）有同类端点发散 $X_A=\int _0^1\frac {\dd y}{y}$（VF-BQ-3）。 这些幂次修正的标准共线因子化不成立（\cref {prop:heavy-qcdf-endpoint}，[V]），$X_{A,H}$ 的参数化只是模型。\relax }{figure.caption.89}{}}
\newlabel{fig:heavy-qcdf@cref}{{[figure][89][1]1.89}{[1][90][]90}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.90}{\ignorespaces 大 $\beta _0$（泡链）近似下 Adler 函数 $D(Q^2)$ 的 Borel 平面（\cref {prop:power-adler-large-beta0}，部分 [P]；Borel 变换按\cref {def:power-borel}：$R=\DOTSB \sum@ \slimits@ _nr_n\alpha _s^{n+1}$，$B[R](t)=\DOTSB \sum@ \slimits@ _nr_nt^n/n!$，$u=\beta _0t/(4\pi )$，单圈跑动下 $\mathrm  {e}^{-t/\alpha _s(Q)}=(\Lambda ^2/Q^2)^u$）。 红外重整化子极点位于正实轴 $u=2,3,\dots  $（红叉），使沿正实轴的 Borel 积分不确定：绕到极点上方（$C_+$）或下方（$C_-$）的两种积分之差在 $u=u_0$ 处正比于 $(\Lambda ^2/Q^2)^{u_0}$。 $u=1$ 处没有极点（空心圆），这与不存在量纲为 2 的规范不变算符相一致；$u=2$ 的极点与 OPE 中的胶子凝聚项 $\langle \frac  {\alpha _s}{\pi }G^2\rangle /Q^4$ 相对应。紫外重整化子位于 $u=-1,-2,\dots  $（灰叉）。 只有大 $\beta _0$ 极限中的这一结构是确立的；红外重整化子与高扭度之间的一般对应是猜想（\cref {conj:power-renormalon-ht}，[C]）。\relax }}{91}{figure.caption.90}\protected@file@percent }
\newlabel{fig:power-borel-plane}{{1.90}{91}{大 $\beta _0$（泡链）近似下 Adler 函数 $D(Q^2)$ 的 Borel 平面（\cref {prop:power-adler-large-beta0}，部分 [P]；Borel 变换按\cref {def:power-borel}：$R=\sum _nr_n\alpha _s^{n+1}$，$B[R](t)=\sum _nr_nt^n/n!$，$u=\beta _0t/(4\pi )$，单圈跑动下 $\ee ^{-t/\alpha _s(Q)}=(\Lambda ^2/Q^2)^u$）。 红外重整化子极点位于正实轴 $u=2,3,\dots $（红叉），使沿正实轴的 Borel 积分不确定：绕到极点上方（$C_+$）或下方（$C_-$）的两种积分之差在 $u=u_0$ 处正比于 $(\Lambda ^2/Q^2)^{u_0}$。 $u=1$ 处没有极点（空心圆），这与不存在量纲为 2 的规范不变算符相一致；$u=2$ 的极点与 OPE 中的胶子凝聚项 $\langle \frac {\alpha _s}{\pi }G^2\rangle /Q^4$ 相对应。紫外重整化子位于 $u=-1,-2,\dots $（灰叉）。 只有大 $\beta _0$ 极限中的这一结构是确立的；红外重整化子与高扭度之间的一般对应是猜想（\cref {conj:power-renormalon-ht}，[C]）。\relax }{figure.caption.90}{}}
