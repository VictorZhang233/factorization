\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces $e^+e^-\to \gamma ^*\to hX$ 的领头区域（约化割图；竖直虚线为末态割线，左侧为振幅、右侧为共轭振幅）。 硬子图 $H$、$H^\dagger $ 产生两个喷注：被观测强子 $h$（动量 $p_h$，$z=2p_h\cdot q/q^2$，粗线穿过割线）所在的喷注 $J_1$ 给出碎裂函数 $d_{h/q}(z/y)$，$y$ 为碎裂部分子（动量 $k$）的相应份额； 未观测的喷注 $J_2$ 与软子图 $S$ 也穿过割线，它们在对末态的割线求和中由幺正性相消（\cref {lem:coll-unobserved-jet}），软因子为 $1$；全部共线线都是出射的，Glauber 区没有钳夹（\cref {lem:coll-final-poles}）。\relax }}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:coll-sia}{{1.1}{1}{$e^+e^-\to \gamma ^*\to hX$ 的领头区域（约化割图；竖直虚线为末态割线，左侧为振幅、右侧为共轭振幅）。 硬子图 $H$、$H^\dagger $ 产生两个喷注：被观测强子 $h$（动量 $p_h$，$z=2p_h\cdot q/q^2$，粗线穿过割线）所在的喷注 $J_1$ 给出碎裂函数 $d_{h/q}(z/y)$，$y$ 为碎裂部分子（动量 $k$）的相应份额； 未观测的喷注 $J_2$ 与软子图 $S$ 也穿过割线，它们在对末态的割线求和中由幺正性相消（\cref {lem:coll-unobserved-jet}），软因子为 $1$；全部共线线都是出射的，Glauber 区没有钳夹（\cref {lem:coll-final-poles}）。\relax }{figure.caption.1}{}}
