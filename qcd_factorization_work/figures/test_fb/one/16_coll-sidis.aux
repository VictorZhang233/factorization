\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces 半单举 DIS $\ell A\to \ell ' hX$ 的共线因子化（割图示意；竖直虚线为末态割线，左侧为振幅）。 靶 $A$ 的共线子图给出部分子分布 $f_{i/A}(\xi )$（蓝色，沿 $+z$），流出硬部分的部分子 $j$ 碎裂为被观测强子 $h$（粗线穿过割线），给出碎裂函数 $d_{h/j}(\zeta )$（橙色）； $P_{hT}\sim Q$ 时 $h$ 的横动量来自硬辐射 $X_H$，截面为 $f\otimes \mathrm  {d}\hat  \sigma \otimes d$ 的共线因子化形式；$P_{hT}\ll Q$ 时需要 TMD 因子化，二者在中间区域由 $W+Y$ 衔接（\cref {ch:tmd}）。\relax }}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:coll-sidis}{{1.1}{1}{半单举 DIS $\ell A\to \ell ' hX$ 的共线因子化（割图示意；竖直虚线为末态割线，左侧为振幅）。 靶 $A$ 的共线子图给出部分子分布 $f_{i/A}(\xi )$（蓝色，沿 $+z$），流出硬部分的部分子 $j$ 碎裂为被观测强子 $h$（粗线穿过割线），给出碎裂函数 $d_{h/j}(\zeta )$（橙色）； $P_{hT}\sim Q$ 时 $h$ 的横动量来自硬辐射 $X_H$，截面为 $f\otimes \dd \hat \sigma \otimes d$ 的共线因子化形式；$P_{hT}\ll Q$ 时需要 TMD 因子化，二者在中间区域由 $W+Y$ 衔接（\cref {ch:tmd}）。\relax }{figure.caption.1}{}}
