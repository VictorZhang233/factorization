\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces 前向 Compton 振幅 $T_2$ 在复 $\omega =1/x$ 平面上的欧氏点。靶静止系中，欧氏动量 $q=(\mathrm  {i}q^4,\mathbf  q)$（$|\mathbf  q|\ge Q/2$）给出 $\omega =2\mathrm  {i}Mq^4/Q^2$， 恰好取遍虚轴上的短线段 $\mathcal  I_Q=\{\mathrm  {i}y:\,|y|\le \sqrt  3M/Q\}$（蓝色粗线；右上为原点附近的放大），$Q\to \infty $ 时它缩向原点（VF-REF-1）。 $T_2$ 在单位圆盘 $|\omega |<1$ 内解析，割线 $(-\infty ,-1]$ 与 $[1,\infty )$ 分别为 $u$ 道与 $s$ 道（物理区）的割线。 欧氏 OPE 只在长度为 $\mathcal  {O}\!\left (M/Q\right )$ 的线段 $\mathcal  I_Q$ 上提供信息；由此得到固定 $n$ 的矩还需要 $F_2\ge 0$ 与有限减除的色散关系（\cref {thm:dis-fixed-n}）， 而 $n<n_0$ 的低阶矩还需要增长条件（\cref {prop:dis-low-moments}）。\relax }}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:dis-euclid-segment}{{1.1}{1}{前向 Compton 振幅 $T_2$ 在复 $\omega =1/x$ 平面上的欧氏点。靶静止系中，欧氏动量 $q=(\ii q^4,\mathbf q)$（$|\mathbf q|\ge Q/2$）给出 $\omega =2\ii Mq^4/Q^2$， 恰好取遍虚轴上的短线段 $\mathcal I_Q=\{\ii y:\,|y|\le \sqrt 3M/Q\}$（蓝色粗线；右上为原点附近的放大），$Q\to \infty $ 时它缩向原点（VF-REF-1）。 $T_2$ 在单位圆盘 $|\omega |<1$ 内解析，割线 $(-\infty ,-1]$ 与 $[1,\infty )$ 分别为 $u$ 道与 $s$ 道（物理区）的割线。 欧氏 OPE 只在长度为 $\order {M/Q}$ 的线段 $\mathcal I_Q$ 上提供信息；由此得到固定 $n$ 的矩还需要 $F_2\ge 0$ 与有限减除的色散关系（\cref {thm:dis-fixed-n}）， 而 $n<n_0$ 的低阶矩还需要增长条件（\cref {prop:dis-low-moments}）。\relax }{figure.caption.1}{}}
\newlabel{fig:dis-euclid-segment@cref}{{[figure][1][1]1.1}{[1][1][]1}}
