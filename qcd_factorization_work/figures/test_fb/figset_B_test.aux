\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces 动量模式在指数空间 $(a,b,c)$ 中的位置，$(k^+,k^-,k_T)\sim (\lambda ^a,\lambda ^b,\lambda ^c)\,Q$，$\lambda \ll 1$（指数越大，相应分量越小）。 硬、$A$ 共线、$B$ 共线、软与超软模式都在在壳平面 $c=\frac  12(a+b)$（半透明灰色平行四边形）上，即 $k_T^2$、$k^+k^-$ 与虚度 $|k^2|$ 同阶； 硬、两种共线与超软模式恰为平行四边形的四个顶点，软模式 $(1,1,1)$（TMD 因子化所用的标度）为其中心。 Glauber 模式 $(2,2,1)$（红色空心圆，透过平面看到）与超软模式有相同的 $k^\pm $，只是横动量大 $\lambda ^{-1}$ 倍（红色虚线），因而位于平面之下： $|k^+k^-|\ll k_T^2$，$k^2\approx -k_T^2$，以横动量为主且离壳；在 $(\qopname  \relax o{ln}k^+,\qopname  \relax o{ln}k^-)$ 平面（\cref {fig:momentum-regions}）上它与超软模式重合，只有加上第三个方向 $\qopname  \relax o{ln}k_T$ 才能区分。 本书的“超软”即 Libby--Sterman 的“软”。\relax }}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:ir-mode-exponents}{{4.1}{1}{动量模式在指数空间 $(a,b,c)$ 中的位置，$(k^+,k^-,k_T)\sim (\lambda ^a,\lambda ^b,\lambda ^c)\,Q$，$\lambda \ll 1$（指数越大，相应分量越小）。 硬、$A$ 共线、$B$ 共线、软与超软模式都在在壳平面 $c=\frac 12(a+b)$（半透明灰色平行四边形）上，即 $k_T^2$、$k^+k^-$ 与虚度 $|k^2|$ 同阶； 硬、两种共线与超软模式恰为平行四边形的四个顶点，软模式 $(1,1,1)$（TMD 因子化所用的标度）为其中心。 Glauber 模式 $(2,2,1)$（红色空心圆，透过平面看到）与超软模式有相同的 $k^\pm $，只是横动量大 $\lambda ^{-1}$ 倍（红色虚线），因而位于平面之下： $|k^+k^-|\ll k_T^2$，$k^2\approx -k_T^2$，以横动量为主且离壳；在 $(\ln k^+,\ln k^-)$ 平面（\cref {fig:momentum-regions}）上它与超软模式重合，只有加上第三个方向 $\ln k_T$ 才能区分。 本书的“超软”即 Libby--Sterman 的“软”。\relax }{figure.caption.1}{}}
\newlabel{fig:ir-mode-exponents@cref}{{[figure][1][4]4.1}{[1][1][]1}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces 单圈顶点的 Feynman 参数单形 $\{\alpha _0+\alpha _1+\alpha _2=1,\ \alpha _j\ge 0\}$ 上的 Landau 集（示意；左为线与参数的记号）。 (a)\nobreakspace  {}在壳无质量外线（$p_i^2=0$，$Q^2=2p_1\cdot p_2>0$）：$\mathcal  F=-Q^2\alpha _1\alpha _2$，Landau 集为两条闭棱 $\alpha _2=0$（$k=xp_1$，共线于 $p_1$，红）与 $\alpha _1=0$（$k=-yp_2$，蓝），二者交于软角 $S$（$k=0$）； 另两个角是零动量夸克线（共线面的幂次压低端点）；棱 $\alpha _0=0$（虚线）只在 $Q^2=0$ 时是解；内部即硬区 $H$，没有钳夹（VF-REG-4）。 (b)\nobreakspace  {}两条外线离壳（$p_i^2=-m^2$，欧氏非例外运动学）：$\mathcal  F$ 只在单形的三个角上为零（零动量的无质量线，VF-REF-17）；欧氏区的红外有限性来自幂次计数，而不是因为没有 Landau 解（\cref {rem:ir-euclid-corners}）。\relax }}{2}{figure.caption.2}\protected@file@percent }
\newlabel{fig:ir-landau-simplex}{{4.2}{2}{单圈顶点的 Feynman 参数单形 $\{\alpha _0+\alpha _1+\alpha _2=1,\ \alpha _j\ge 0\}$ 上的 Landau 集（示意；左为线与参数的记号）。 (a)~在壳无质量外线（$p_i^2=0$，$Q^2=2p_1\cdot p_2>0$）：$\mathcal F=-Q^2\alpha _1\alpha _2$，Landau 集为两条闭棱 $\alpha _2=0$（$k=xp_1$，共线于 $p_1$，红）与 $\alpha _1=0$（$k=-yp_2$，蓝），二者交于软角 $S$（$k=0$）； 另两个角是零动量夸克线（共线面的幂次压低端点）；棱 $\alpha _0=0$（虚线）只在 $Q^2=0$ 时是解；内部即硬区 $H$，没有钳夹（VF-REG-4）。 (b)~两条外线离壳（$p_i^2=-m^2$，欧氏非例外运动学）：$\mathcal F$ 只在单形的三个角上为零（零动量的无质量线，VF-REF-17）；欧氏区的红外有限性来自幂次计数，而不是因为没有 Landau 解（\cref {rem:ir-euclid-corners}）。\relax }{figure.caption.2}{}}
\newlabel{fig:ir-landau-simplex@cref}{{[figure][2][4]4.2}{[1][2][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces 割线求和与前向函数的不连续性（$e^+e^-$ 总截面；红色虚线为末态割线，左侧为振幅，右侧为共轭振幅）。 (a)\nobreakspace  {}$\mathcal  {O}\!\left (\alpha _s^2\right )$ 的一个三圈流关联函数图（夸克圈上两条胶子横档）的三类割线：两粒子 $q\bar  q$、三粒子 $q\bar  qg$ 与四粒子 $q\bar  qgg$（每类只画一例，其余割线位置与镜像未画出）。 每类割图单独含有直到 $1/\varepsilon ^4$ 的软、共线极点，只有对全部割线求和（连同 $\overline  {\mathrm  {MS}}$ 抵消项）才有限（\cref {cor:ee-cuts}）； 两个夸克圈各连一个光子的单态项 $\propto (\DOTSB \sum@ \slimits@ _qe_q)^2$ 由 Furry 定理自 $\mathcal  {O}\!\left (\alpha _s^3\right )$ 起才出现。 (b)\nobreakspace  {}在钳夹面附近，割线只能穿过末态喷注 $J_1$、$J_2$ 与软子图 $S$，不能穿过 $H$、$H^\dagger $；对固定的 $H$、$H^\dagger $，由幺正性，对这些割线求和等于不加割线的前向（编时）组合 $F$（虚线框）的不连续性 $F(s+\mathrm  {i}0)-F(s-\mathrm  {i}0)$。 $F$ 是 $s$ 的解析函数，钳夹（Landau 奇点）只出现在实轴的割线上；由 Cauchy 定理，不连续性等于沿圆周 $|z|=s$ 的积分，圆周除两端外离实轴 $\mathcal  {O}\!\left (s\right )$，那里没有钳夹，只剩欧氏区可计算的部分（围道公式，\cref {prop:ee-contour}）。\relax }}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:ee-cutsum-disc}{{4.3}{3}{割线求和与前向函数的不连续性（$e^+e^-$ 总截面；红色虚线为末态割线，左侧为振幅，右侧为共轭振幅）。 (a)~$\order {\as ^2}$ 的一个三圈流关联函数图（夸克圈上两条胶子横档）的三类割线：两粒子 $q\bar q$、三粒子 $q\bar qg$ 与四粒子 $q\bar qgg$（每类只画一例，其余割线位置与镜像未画出）。 每类割图单独含有直到 $1/\varepsilon ^4$ 的软、共线极点，只有对全部割线求和（连同 $\MSbar $ 抵消项）才有限（\cref {cor:ee-cuts}）； 两个夸克圈各连一个光子的单态项 $\propto (\sum _qe_q)^2$ 由 Furry 定理自 $\order {\as ^3}$ 起才出现。 (b)~在钳夹面附近，割线只能穿过末态喷注 $J_1$、$J_2$ 与软子图 $S$，不能穿过 $H$、$H^\dagger $；对固定的 $H$、$H^\dagger $，由幺正性，对这些割线求和等于不加割线的前向（编时）组合 $F$（虚线框）的不连续性 $F(s+\ii 0)-F(s-\ii 0)$。 $F$ 是 $s$ 的解析函数，钳夹（Landau 奇点）只出现在实轴的割线上；由 Cauchy 定理，不连续性等于沿圆周 $|z|=s$ 的积分，圆周除两端外离实轴 $\order {s}$，那里没有钳夹，只剩欧氏区可计算的部分（围道公式，\cref {prop:ee-contour}）。\relax }{figure.caption.3}{}}
\newlabel{fig:ee-cutsum-disc@cref}{{[figure][3][4]4.3}{[1][3][]3}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces 前向 Compton 振幅 $T_2$ 在复 $\omega =1/x$ 平面上的欧氏点。靶静止系中，欧氏动量 $q=(\mathrm  {i}q^4,\mathbf  q)$（$|\mathbf  q|\ge Q/2$）给出 $\omega =2\mathrm  {i}Mq^4/Q^2$， 恰好取遍虚轴上的短线段 $\mathcal  I_Q=\{\mathrm  {i}y:\,|y|\le \sqrt  3M/Q\}$（蓝色粗线；右上为原点附近的放大），$Q\to \infty $ 时它缩向原点（VF-REF-1）。 $T_2$ 在单位圆盘 $|\omega |<1$ 内解析，割线 $(-\infty ,-1]$ 与 $[1,\infty )$ 分别为 $u$ 道与 $s$ 道（物理区）的割线。 欧氏 OPE 只在长度为 $\mathcal  {O}\!\left (M/Q\right )$ 的线段 $\mathcal  I_Q$ 上提供信息；由此得到固定 $n$ 的矩还需要 $F_2\ge 0$ 与有限减除的色散关系（\cref {thm:dis-fixed-n}）， 而 $n<n_0$ 的低阶矩还需要增长条件（\cref {prop:dis-low-moments}）。\relax }}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:dis-euclid-segment}{{4.4}{4}{前向 Compton 振幅 $T_2$ 在复 $\omega =1/x$ 平面上的欧氏点。靶静止系中，欧氏动量 $q=(\ii q^4,\mathbf q)$（$|\mathbf q|\ge Q/2$）给出 $\omega =2\ii Mq^4/Q^2$， 恰好取遍虚轴上的短线段 $\mathcal I_Q=\{\ii y:\,|y|\le \sqrt 3M/Q\}$（蓝色粗线；右上为原点附近的放大），$Q\to \infty $ 时它缩向原点（VF-REF-1）。 $T_2$ 在单位圆盘 $|\omega |<1$ 内解析，割线 $(-\infty ,-1]$ 与 $[1,\infty )$ 分别为 $u$ 道与 $s$ 道（物理区）的割线。 欧氏 OPE 只在长度为 $\order {M/Q}$ 的线段 $\mathcal I_Q$ 上提供信息；由此得到固定 $n$ 的矩还需要 $F_2\ge 0$ 与有限减除的色散关系（\cref {thm:dis-fixed-n}）， 而 $n<n_0$ 的低阶矩还需要增长条件（\cref {prop:dis-low-moments}）。\relax }{figure.caption.4}{}}
\newlabel{fig:dis-euclid-segment@cref}{{[figure][4][4]4.4}{[1][4][]4}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces 扭度与额外部分子（DIS 强子张量的割图示意，$\lambda \sim \Lambda /Q$）：与硬部分 $H$ 相连的每一条额外的物理极化部分子都带来一个压低因子——每多一条横向胶子压低 $\lambda $，每多一对夸克压低 $\lambda ^2$； 纵向极化（K）胶子不受压低，经 Ward 恒等式归入 Wilson 线。非极化单举 DIS 中奇扭度项在无质量微扰论中因手征而消失（\cref {prop:dis-chiral-suppression}），领头的幂次修正来自扭度 4（\cref {prop:dis-twist4}，参见\cref {fig:higher-twist}）。\relax }}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:dis-twist-graphical}{{4.5}{5}{扭度与额外部分子（DIS 强子张量的割图示意，$\lambda \sim \Lambda /Q$）：与硬部分 $H$ 相连的每一条额外的物理极化部分子都带来一个压低因子——每多一条横向胶子压低 $\lambda $，每多一对夸克压低 $\lambda ^2$； 纵向极化（K）胶子不受压低，经 Ward 恒等式归入 Wilson 线。非极化单举 DIS 中奇扭度项在无质量微扰论中因手征而消失（\cref {prop:dis-chiral-suppression}），领头的幂次修正来自扭度 4（\cref {prop:dis-twist4}，参见\cref {fig:higher-twist}）。\relax }{figure.caption.5}{}}
\newlabel{fig:dis-twist-graphical@cref}{{[figure][5][4]4.5}{[1][5][]5}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces 全阶因子化证明的六个步骤（左），它们与\cref {thm:method-template}（模板定理）的假设 \mbox  {(H1)--(H5)} 的对应，以及精确形式中的编号假设（右；\cref {app:appN}与\cref {app:appO}，对应关系即\cref {tab:method-hypotheses}）。 每个步骤中，绿色框为在所用层次上已严格证明的陈述（[R] 或数学引理），蓝色框为全阶论证 [A]，绿色虚线框为条件定理 $R_{\rm  cond}$，即\cref {app:appN}中的减除演绎（\cref {thm:appN-subtraction}）与\cref {app:appO}中单举色单态 Drell--Yan 过程的 Glauber 相消（\cref {thm:appO-main}）。 步骤 4 中，$A$ 共线的 K 胶子化为沿 $n_B$ 的 Wilson 线（$B$ 共线的则沿 $n_A$），软胶子化为沿各喷注方向的 Wilson 线；离开 Glauber 区须沿 $e_G=n_B-n_A$ 同时形变两个光锥分量（\cref {fig:method-glauber-direction}），软因子的幺正性只在处理完 Glauber 区之后使用。\relax }}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:method-flowchart}{{4.6}{6}{全阶因子化证明的六个步骤（左），它们与\cref {thm:method-template}（模板定理）的假设 \mbox {(H1)--(H5)} 的对应，以及精确形式中的编号假设（右；\cref {app:appN}与\cref {app:appO}，对应关系即\cref {tab:method-hypotheses}）。 每个步骤中，绿色框为在所用层次上已严格证明的陈述（[R] 或数学引理），蓝色框为全阶论证 [A]，绿色虚线框为条件定理 $R_{\rm cond}$，即\cref {app:appN}中的减除演绎（\cref {thm:appN-subtraction}）与\cref {app:appO}中单举色单态 Drell--Yan 过程的 Glauber 相消（\cref {thm:appO-main}）。 步骤 4 中，$A$ 共线的 K 胶子化为沿 $n_B$ 的 Wilson 线（$B$ 共线的则沿 $n_A$），软胶子化为沿各喷注方向的 Wilson 线；离开 Glauber 区须沿 $e_G=n_B-n_A$ 同时形变两个光锥分量（\cref {fig:method-glauber-direction}），软因子的幺正性只在处理完 Glauber 区之后使用。\relax }{figure.caption.6}{}}
\newlabel{fig:method-flowchart@cref}{{[figure][6][4]4.6}{[1][6][]6}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces 两圈平面顶点九个领头区域的 Hasse 图。左：内胶子 $k_1$、外胶子 $k_2$ 的动量走向（胶子动量由反夸克线流向夸克线），线的颜色给出区域 $(C_1,S)$ 的逐线模式： $J_1=\{k_1,\,p_1-k_2,\,p_1-k_1-k_2\}$、$J_2=\{p_2+k_2\}$、$S=\{k_2\}$，硬线 $p_2+k_1+k_2$ 与光子顶点组成 $H$。 右：16 种模式组合中恰有 9 个领头钳夹，按逐线偏序（$S<C_i<\mathrm  H$，$C_1\wedge C_2=S$）排成 Hasse 图（12 条覆盖关系，自下而上钳夹集增大），其中 $(C_1,C_1)<(\mathrm  H,C_1)$（红线）不易一眼看出； 这一集合对逐线交运算封闭，例如 $(C_1,C_1)\wedge (\mathrm  H,S)=(C_1,S)$、$(\mathrm  H,C_1)\wedge (\mathrm  H,C_2)=(\mathrm  H,S)$、$(C_1,C_1)\wedge (C_2,C_2)=(S,S)$。 右列为各层的邻域指数 $\beta _R=3^{h(R)-h_*}$（$h_*=4$；最大区域的邻域为整个积分域 $\Omega $，\cref {def:method-neighbourhoods}）。\relax }}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:method-hasse}{{4.7}{7}{两圈平面顶点九个领头区域的 Hasse 图。左：内胶子 $k_1$、外胶子 $k_2$ 的动量走向（胶子动量由反夸克线流向夸克线），线的颜色给出区域 $(C_1,S)$ 的逐线模式： $J_1=\{k_1,\,p_1-k_2,\,p_1-k_1-k_2\}$、$J_2=\{p_2+k_2\}$、$S=\{k_2\}$，硬线 $p_2+k_1+k_2$ 与光子顶点组成 $H$。 右：16 种模式组合中恰有 9 个领头钳夹，按逐线偏序（$S<C_i<\mathrm H$，$C_1\wedge C_2=S$）排成 Hasse 图（12 条覆盖关系，自下而上钳夹集增大），其中 $(C_1,C_1)<(\mathrm H,C_1)$（红线）不易一眼看出； 这一集合对逐线交运算封闭，例如 $(C_1,C_1)\wedge (\mathrm H,S)=(C_1,S)$、$(\mathrm H,C_1)\wedge (\mathrm H,C_2)=(\mathrm H,S)$、$(C_1,C_1)\wedge (C_2,C_2)=(S,S)$。 右列为各层的邻域指数 $\beta _R=3^{h(R)-h_*}$（$h_*=4$；最大区域的邻域为整个积分域 $\Omega $，\cref {def:method-neighbourhoods}）。\relax }{figure.caption.7}{}}
\newlabel{fig:method-hasse@cref}{{[figure][7][4]4.7}{[1][7][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces 区域的偏序与减除（示意；钳夹集画成区域）。单圈顶点的钳夹集彼此嵌套：软钳夹集 $\pi _S$（绿色）同时含于两个共线钳夹集 $\pi _A$（蓝）与 $\pi _B$（橙），并且恰为二者之交 $\pi _S=\pi _A\cap \pi _B$，即逐线交 $A\wedge B=S$；所有钳夹集都含于硬区 $\pi _H=\Omega $。 减除自最小区域（软）开始，依次为 \textcircled {\scriptsize  1}\nobreakspace  {}$T_S$、\textcircled {\scriptsize  2}\nobreakspace  {}$T_A,T_B$、\textcircled {\scriptsize  3}\nobreakspace  {}$T_H$：较大区域的近似子作用于减去较小区域贡献之后的被积函数，$C_R\Gamma \equiv T_R\leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left (\vcenter to\@ne \big@size {}\right .$}\box \z@ }\Gamma -\DOTSB \sum@ \slimits@ _{R'<R}C_{R'}\Gamma \leavevmode@ifvmode {\setbox \z@ \hbox {\mathsurround \z@ $\nulldelimiterspace \z@ \left )\vcenter to\@ne \big@size {}\right .$}\box \z@ }$（\cref {def:method-subtraction}）。 单个链项一般不可积，只有分组表达式满足 \mbox  {(CS1)--(CS3)}。\relax }}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:method-nesting}{{4.8}{8}{区域的偏序与减除（示意；钳夹集画成区域）。单圈顶点的钳夹集彼此嵌套：软钳夹集 $\pi _S$（绿色）同时含于两个共线钳夹集 $\pi _A$（蓝）与 $\pi _B$（橙），并且恰为二者之交 $\pi _S=\pi _A\cap \pi _B$，即逐线交 $A\wedge B=S$；所有钳夹集都含于硬区 $\pi _H=\Omega $。 减除自最小区域（软）开始，依次为 \textcircled {\scriptsize 1}~$T_S$、\textcircled {\scriptsize 2}~$T_A,T_B$、\textcircled {\scriptsize 3}~$T_H$：较大区域的近似子作用于减去较小区域贡献之后的被积函数，$C_R\Gamma \equiv T_R\big (\Gamma -\sum _{R'<R}C_{R'}\Gamma \big )$（\cref {def:method-subtraction}）。 单个链项一般不可积，只有分组表达式满足 \mbox {(CS1)--(CS3)}。\relax }{figure.caption.8}{}}
\newlabel{fig:method-nesting@cref}{{[figure][8][4]4.8}{[1][8][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces 依赖于 $\lambda $ 的邻域 $N_R=\{\sigma _{R(j)}(l_j)\le \lambda ^{\beta _R}\}$ 与支配集 $U_R=N_R\setminus \DOTSB \bigcup@ \slimits@ _{R'<R}N_{R'}$（\cref {def:method-neighbourhoods}；示意：单圈离壳三角图的胶子动量 $k$ 在 $\mathbf  k_T=0$ 处的 $(k^+,k^-)$ 截面，以 $Q$ 为单位）。 共线钳夹集 $\pi _{C_1}$、$\pi _{C_2}$ 相交于软钳夹点 $\pi _S$（$k=0$）；$N_{C_i}$ 是半宽 $\lambda ^{\beta _C}$ 的管道，$N_S$ 是半径 $\lambda ^{\beta _S}$ 的球， 由于 $\beta _S<\beta _C$ 而比管道“胖”。绿、蓝、橙、灰色区域分别为 $U_S$、$U_{C_1}$、$U_{C_2}$、$U_{\mathrm  H}$，它们覆盖整个积分域（\cref {lem:method-covering}）。\relax }}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:method-neighbourhoods}{{4.9}{9}{依赖于 $\lambda $ 的邻域 $N_R=\{\sigma _{R(j)}(l_j)\le \lambda ^{\beta _R}\}$ 与支配集 $U_R=N_R\setminus \bigcup _{R'<R}N_{R'}$（\cref {def:method-neighbourhoods}；示意：单圈离壳三角图的胶子动量 $k$ 在 $\mathbf k_T=0$ 处的 $(k^+,k^-)$ 截面，以 $Q$ 为单位）。 共线钳夹集 $\pi _{C_1}$、$\pi _{C_2}$ 相交于软钳夹点 $\pi _S$（$k=0$）；$N_{C_i}$ 是半宽 $\lambda ^{\beta _C}$ 的管道，$N_S$ 是半径 $\lambda ^{\beta _S}$ 的球， 由于 $\beta _S<\beta _C$ 而比管道“胖”。绿、蓝、橙、灰色区域分别为 $U_S$、$U_{C_1}$、$U_{C_2}$、$U_{\mathrm H}$，它们覆盖整个积分域（\cref {lem:method-covering}）。\relax }{figure.caption.9}{}}
\newlabel{fig:method-neighbourhoods@cref}{{[figure][9][4]4.9}{[1][9][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.10}{\ignorespaces 共线胶子的 Grammer--Yennie 分解（Feynman 规范；$k$ 由 $A$ 共线子图流入硬部分，$\mu $ 为硬端、$\nu $ 为共线端的指标）。 $g_{\mu \nu }=K_{\mu \nu }+G_{\mu \nu }$：K 部分（蓝色，圆点标出带标量极化 $k_\mu $ 的硬端）的共线端只取 $A^+=n_B\cdot A$ 分量；对 $H$ 内一切附着求和后，由 Ward 恒等式，K 胶子改为附着在沿 $n_B$ 的 Wilson 线上，乘以不含该胶子的硬部分 $H_0$（左下；$-\mathrm  {i}0$ 对应末态附着，即 DIS 中未来指向的线，初态附着取 $+\mathrm  {i}0$）； G 部分满足 $G_{\mu \nu }k^\nu =0$，每多一条 G 胶子至少压低 $\lambda $。例外（右下）：作为活动部分子的单个横向胶子（此处为 $\gamma ^*g\to q\bar  q$），由 Ward 恒等式 $k_\mu H^\mu =0$，其 G 项是领头的，与 $k^+A^j-k^jA^+$ 组成场强 $G^{+j}$。\relax }}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:method-kg}{{4.10}{10}{共线胶子的 Grammer--Yennie 分解（Feynman 规范；$k$ 由 $A$ 共线子图流入硬部分，$\mu $ 为硬端、$\nu $ 为共线端的指标）。 $g_{\mu \nu }=K_{\mu \nu }+G_{\mu \nu }$：K 部分（蓝色，圆点标出带标量极化 $k_\mu $ 的硬端）的共线端只取 $A^+=n_B\cdot A$ 分量；对 $H$ 内一切附着求和后，由 Ward 恒等式，K 胶子改为附着在沿 $n_B$ 的 Wilson 线上，乘以不含该胶子的硬部分 $H_0$（左下；$-\ii 0$ 对应末态附着，即 DIS 中未来指向的线，初态附着取 $+\ii 0$）； G 部分满足 $G_{\mu \nu }k^\nu =0$，每多一条 G 胶子至少压低 $\lambda $。例外（右下）：作为活动部分子的单个横向胶子（此处为 $\gamma ^*g\to q\bar q$），由 Ward 恒等式 $k_\mu H^\mu =0$，其 G 项是领头的，与 $k^+A^j-k^jA^+$ 组成场强 $G^{+j}$。\relax }{figure.caption.10}{}}
\newlabel{fig:method-kg@cref}{{[figure][10][4]4.10}{[1][10][]10}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.11}{\ignorespaces 单圈离壳三角图（$p_i^2=-m^2$，$\lambda =m/Q$）的区域与 Collins 减除中的软—共线重叠（\cref {ex:method-sudakov-subtraction}）。 (a)\nobreakspace  {}$(\qopname  \relax o{ln}|k^+|,\qopname  \relax o{ln}|k^-|)$ 平面（以 $\qopname  \relax o{ln}(1/\lambda )$ 为单位，$k_T$ 取 $k_T^2\sim |k^+k^-|$ 的典型值）：区域 $\mathrm  H$、$C_1$、$C_2$、$S$ 位于正方形的四角，其中软区 $S\sim Q(\lambda ^2,\lambda ^2,\lambda ^2)$ 是\cref {def:ir-scalings}的超软标度（$k\sim m^2/Q$）； 粗斜线 $k^+k^-\sim m^2$ 是 $k_T\sim \lambda Q$ 的在壳线 $k_T^2=2k^+k^-$，经过 $C_1$、$C_2$ 与“软中心”$(\lambda ,\lambda ,\lambda )$；绿色阴影带为软—共线重叠，减除项在重叠区相消的方式由分组表达式决定。 (b)\nobreakspace  {}对 $k=(z,\lambda ^2/z,\lambda )$（$\lambda ^2\ll z\ll 1$，红色虚线），胶子线 $D_g$ 与夸克线 $D_1$ 的 $k^-$ 极点分居实轴两侧、相距 $\sim \lambda ^2Q/z$，围道只能在两极点之间穿过实轴； 软近似只在 $\Real  k^-\sim k_T^2/(4k^+)$ 附近穿过实轴的围道上成立，在 $k^-\approx 0$ 附近（红色区域）失效（\cref {lem:method-i0-compat}）。\relax }}{11}{figure.caption.11}\protected@file@percent }
\newlabel{fig:method-sudakov-plane}{{4.11}{11}{单圈离壳三角图（$p_i^2=-m^2$，$\lambda =m/Q$）的区域与 Collins 减除中的软—共线重叠（\cref {ex:method-sudakov-subtraction}）。 (a)~$(\ln |k^+|,\ln |k^-|)$ 平面（以 $\ln (1/\lambda )$ 为单位，$k_T$ 取 $k_T^2\sim |k^+k^-|$ 的典型值）：区域 $\mathrm H$、$C_1$、$C_2$、$S$ 位于正方形的四角，其中软区 $S\sim Q(\lambda ^2,\lambda ^2,\lambda ^2)$ 是\cref {def:ir-scalings}的超软标度（$k\sim m^2/Q$）； 粗斜线 $k^+k^-\sim m^2$ 是 $k_T\sim \lambda Q$ 的在壳线 $k_T^2=2k^+k^-$，经过 $C_1$、$C_2$ 与“软中心”$(\lambda ,\lambda ,\lambda )$；绿色阴影带为软—共线重叠，减除项在重叠区相消的方式由分组表达式决定。 (b)~对 $k=(z,\lambda ^2/z,\lambda )$（$\lambda ^2\ll z\ll 1$，红色虚线），胶子线 $D_g$ 与夸克线 $D_1$ 的 $k^-$ 极点分居实轴两侧、相距 $\sim \lambda ^2Q/z$，围道只能在两极点之间穿过实轴； 软近似只在 $\Real k^-\sim k_T^2/(4k^+)$ 附近穿过实轴的围道上成立，在 $k^-\approx 0$ 附近（红色区域）失效（\cref {lem:method-i0-compat}）。\relax }{figure.caption.11}{}}
\newlabel{fig:method-sudakov-plane@cref}{{[figure][11][4]4.11}{[1][11][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.12}{\ignorespaces 单圈 DIS 系数函数 = 割图减去其共线近似（$\gamma ^*q$ 道，Feynman 规范；竖直红色虚线为末态割线，左侧为振幅）。 上行为 $\mathcal  {O}\!\left (\alpha _s\right )$ 割图 $\Gamma ^{(1)}$，下行为其靶共线近似 $T_A\Gamma ^{(1)}=f^{(1)}_{q/q}\otimes {\rm  Born}$：PDF 算符的割图（$\otimes $ 为算符顶点，双线为沿 $n_B$ 的 Wilson 线）乘以领头阶硬部分；同色框中的图一一对应。 初态辐射的平方对应 PDF 算符的梯形图，ISR--FSR 干涉对应胶子连到割线另一侧 Wilson 线的实图，顶点虚修正对应同侧的 Wilson 线虚图（外线自能无标度，未画出）；末态辐射没有靶共线区，不需减除。 各列之差的和即硬区减除项 $C_H\Gamma ^{(1)}$，在 $\mu =Q$ 时为 $\frac  {\alpha _s}{2\pi }C_2^q$；纯维数正规化中下行各图无标度，只留下 $\overline  {\mathrm  {MS}}$ 抵消项，$C_A\Gamma ^{(1)}=-\frac  {\alpha _s}{2\pi }\frac  1\varepsilon P_{qq}$（VF-DIS-6，VF-PDF-3）。\relax }}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:method-coeff-minus-coll}{{4.12}{12}{单圈 DIS 系数函数 = 割图减去其共线近似（$\gamma ^*q$ 道，Feynman 规范；竖直红色虚线为末态割线，左侧为振幅）。 上行为 $\order {\as }$ 割图 $\Gamma ^{(1)}$，下行为其靶共线近似 $T_A\Gamma ^{(1)}=f^{(1)}_{q/q}\otimes {\rm Born}$：PDF 算符的割图（$\otimes $ 为算符顶点，双线为沿 $n_B$ 的 Wilson 线）乘以领头阶硬部分；同色框中的图一一对应。 初态辐射的平方对应 PDF 算符的梯形图，ISR--FSR 干涉对应胶子连到割线另一侧 Wilson 线的实图，顶点虚修正对应同侧的 Wilson 线虚图（外线自能无标度，未画出）；末态辐射没有靶共线区，不需减除。 各列之差的和即硬区减除项 $C_H\Gamma ^{(1)}$，在 $\mu =Q$ 时为 $\frac {\as }{2\pi }C_2^q$；纯维数正规化中下行各图无标度，只留下 $\MSbar $ 抵消项，$C_A\Gamma ^{(1)}=-\frac {\as }{2\pi }\frac 1\varepsilon P_{qq}$（VF-DIS-6，VF-PDF-3）。\relax }{figure.caption.12}{}}
\newlabel{fig:method-coeff-minus-coll@cref}{{[figure][12][4]4.12}{[1][12][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.13}{\ignorespaces 离开 Glauber 区需要沿 $e_G=n_B-n_A$ 同时形变两个光锥分量（示意；(a)、(c) 以 $|\mathbf  k_T|$ 为单位，红色阴影为 Glauber 楔 $G_\delta =\{|k^+k^-|\le \delta k_T^2\}$，复形变量画在同一平面中）。 (a)\nobreakspace  {}对 Glauber 动量 $k^\pm \sim \lambda ^2$、$k_T\sim \lambda $ 只形变 $k^-$，即使形变到 $|\mathbf  k_T|$ 量级，仍有 $|k^+k^-|\sim \lambda ^3\ll k_T^2$，动量留在 $G_\delta $ 中； (b)\nobreakspace  {}$k^+<0$ 时软线自身的极点位于上半平面，与 $J_A$ 线的极点分居实轴两侧，把只形变 $k^-$ 的幅度限制在 $\kappa \sim k_T^2/|k^+|$（\cref {lem:method-i0-compat}）； (c)\nobreakspace  {}振幅一侧（$\sigma =+1$）流入 $J_A$ 的软动量沿 $e_G$ 形变（$\Imag  k^->0$、$\Imag  k^+<0$），幅度 $\sim |\mathbf  k_T|$，离开 $G_\delta $，且使所有分母更类时（VF-REF-7；\cref {prop:method-glauber-deformation}）。\relax }}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:method-glauber-direction}{{4.13}{13}{离开 Glauber 区需要沿 $e_G=n_B-n_A$ 同时形变两个光锥分量（示意；(a)、(c) 以 $|\mathbf k_T|$ 为单位，红色阴影为 Glauber 楔 $G_\delta =\{|k^+k^-|\le \delta k_T^2\}$，复形变量画在同一平面中）。 (a)~对 Glauber 动量 $k^\pm \sim \lambda ^2$、$k_T\sim \lambda $ 只形变 $k^-$，即使形变到 $|\mathbf k_T|$ 量级，仍有 $|k^+k^-|\sim \lambda ^3\ll k_T^2$，动量留在 $G_\delta $ 中； (b)~$k^+<0$ 时软线自身的极点位于上半平面，与 $J_A$ 线的极点分居实轴两侧，把只形变 $k^-$ 的幅度限制在 $\kappa \sim k_T^2/|k^+|$（\cref {lem:method-i0-compat}）； (c)~振幅一侧（$\sigma =+1$）流入 $J_A$ 的软动量沿 $e_G$ 形变（$\Imag k^->0$、$\Imag k^+<0$），幅度 $\sim |\mathbf k_T|$，离开 $G_\delta $，且使所有分母更类时（VF-REF-7；\cref {prop:method-glauber-deformation}）。\relax }{figure.caption.13}{}}
\newlabel{fig:method-glauber-direction@cref}{{[figure][13][4]4.13}{[1][13][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.14}{\ignorespaces DIS 中 PDF Wilson 线的种子（VF-WL-8，\cref {prop:method-ward-tree}）：一个来自靶共线子图 $A$ 的 K 胶子（蓝色，流入硬部分的动量为 $k$，圆点标出带标量极化 $k_\mu $ 的硬端）对硬部分 $H$ 的所有附着之和（领头阶即附着在末态被击夸克 $p'$ 上）， 经 Ward 恒等式 $k_\mu H^\mu _a=g\,t^aH_0$ 化为去掉该胶子、入射动量为 $l+k$ 的硬部分 $H_0$，乘以夸克场 $\psi (0)$ 处出发、沿 $n_B$ 的未来指向 Wilson 线 $W^{(1)}[\infty n_B,0]$ 的单胶子项（双线箭头为路径方向 $0\to \infty n_B$）。 程函传播子中的 $-\mathrm  {i}0$ 继承自被替代的被击夸克传播子：$(p'-k)^2+\mathrm  {i}0\simeq -2p'^-k^++\mathrm  {i}0$ 的极点位于 $k^+$ 上半平面；Drell--Yan 中同样的附着落在入射反夸克上，给出 $+\mathrm  {i}0$。\relax }}{14}{figure.caption.14}\protected@file@percent }
\newlabel{fig:disall-seed}{{4.14}{14}{DIS 中 PDF Wilson 线的种子（VF-WL-8，\cref {prop:method-ward-tree}）：一个来自靶共线子图 $A$ 的 K 胶子（蓝色，流入硬部分的动量为 $k$，圆点标出带标量极化 $k_\mu $ 的硬端）对硬部分 $H$ 的所有附着之和（领头阶即附着在末态被击夸克 $p'$ 上）， 经 Ward 恒等式 $k_\mu H^\mu _a=g\,t^aH_0$ 化为去掉该胶子、入射动量为 $l+k$ 的硬部分 $H_0$，乘以夸克场 $\psi (0)$ 处出发、沿 $n_B$ 的未来指向 Wilson 线 $W^{(1)}[\infty n_B,0]$ 的单胶子项（双线箭头为路径方向 $0\to \infty n_B$）。 程函传播子中的 $-\ii 0$ 继承自被替代的被击夸克传播子：$(p'-k)^2+\ii 0\simeq -2p'^-k^++\ii 0$ 的极点位于 $k^+$ 上半平面；Drell--Yan 中同样的附着落在入射反夸克上，给出 $+\ii 0$。\relax }{figure.caption.14}{}}
\newlabel{fig:disall-seed@cref}{{[figure][14][4]4.14}{[1][14][]14}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.15}{\ignorespaces DIS 两级梯形图（外夸克离壳 $p^2=-m^2$，内线无质量；竖直红色虚线为末态割线，左侧为振幅）的三个区域 $R_2<R_1<R_H$ 与分组余项。 $\Gamma =\mathsf  H_0(k_2)\,K_2(k_2,k_1)\,K_1(k_1,p)$，$\mathsf  H_0$ 为含两个光子顶点的顶端夸克线，$K_2$、$K_1$ 为上、下两级横档；虚线框依次为 $R_2$、$R_1$、$R_H$ 的硬子图。 分组余项 $r=\Delta \mathsf  H_0\Delta K_2\Delta K_1$（$\Delta $ 表示相应因子减去其共线近似）；包含全硬区域 $R_H$ 才能得到两圈系数函数（\cref {ex:disall-ladder}）。\relax }}{15}{figure.caption.15}\protected@file@percent }
\newlabel{fig:disall-ladder-regions}{{4.15}{15}{DIS 两级梯形图（外夸克离壳 $p^2=-m^2$，内线无质量；竖直红色虚线为末态割线，左侧为振幅）的三个区域 $R_2<R_1<R_H$ 与分组余项。 $\Gamma =\mathsf H_0(k_2)\,K_2(k_2,k_1)\,K_1(k_1,p)$，$\mathsf H_0$ 为含两个光子顶点的顶端夸克线，$K_2$、$K_1$ 为上、下两级横档；虚线框依次为 $R_2$、$R_1$、$R_H$ 的硬子图。 分组余项 $r=\Delta \mathsf H_0\Delta K_2\Delta K_1$（$\Delta $ 表示相应因子减去其共线近似）；包含全硬区域 $R_H$ 才能得到两圈系数函数（\cref {ex:disall-ladder}）。\relax }{figure.caption.15}{}}
\newlabel{fig:disall-ladder-regions@cref}{{[figure][15][4]4.15}{[1][15][]15}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.16}{\ignorespaces 含重夸克质量的 DIS（粗线为质量 $m$ 的重夸克 $Q$）。(a)\nobreakspace  {}领头阶的光子—胶子融合，保留完整的质量依赖，两图之和的平方给出领头阶的胶子道系数； (b)\nobreakspace  {}变味（ACOT/CWZ）方案中的减除项 ${f_{Q/g}\otimes \hat  \sigma (\gamma ^*Q\to Q)}$：胶子先在重夸克分布 $f_{Q/g}$（蓝色，靶共线）中分裂为 $Q\bar  Q$，其中的 $Q$ 再发生领头阶散射 $\gamma ^*Q\to Q$。 二者之差在 $m\to 0$ 时抵消 (a) 中的共线对数 $\qopname  \relax o{ln}(Q^2/m^2)P_{qg}$，给出对 $m/Q$ 一致有效的系数函数（\cref {thm:disall-heavy}，\cref {ex:disall-heavy-lo}）。\relax }}{16}{figure.caption.16}\protected@file@percent }
\newlabel{fig:disall-heavy}{{4.16}{16}{含重夸克质量的 DIS（粗线为质量 $m$ 的重夸克 $Q$）。(a)~领头阶的光子—胶子融合，保留完整的质量依赖，两图之和的平方给出领头阶的胶子道系数； (b)~变味（ACOT/CWZ）方案中的减除项 ${f_{Q/g}\otimes \hat \sigma (\gamma ^*Q\to Q)}$：胶子先在重夸克分布 $f_{Q/g}$（蓝色，靶共线）中分裂为 $Q\bar Q$，其中的 $Q$ 再发生领头阶散射 $\gamma ^*Q\to Q$。 二者之差在 $m\to 0$ 时抵消 (a) 中的共线对数 $\ln (Q^2/m^2)P_{qg}$，给出对 $m/Q$ 一致有效的系数函数（\cref {thm:disall-heavy}，\cref {ex:disall-heavy-lo}）。\relax }{figure.caption.16}{}}
\newlabel{fig:disall-heavy@cref}{{[figure][16][4]4.16}{[1][16][]16}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.17}{\ignorespaces $e^+e^-\to \gamma ^*\to hX$ 的领头区域（约化割图；竖直虚线为末态割线，左侧为振幅、右侧为共轭振幅）。 硬子图 $H$、$H^\dagger $ 产生两个喷注：被观测强子 $h$（动量 $p_h$，$z=2p_h\cdot q/q^2$，粗线穿过割线）所在的喷注 $J_1$ 给出碎裂函数 $d_{h/q}(z/y)$，$y$ 为碎裂部分子（动量 $k$）的相应份额； 未观测的喷注 $J_2$ 与软子图 $S$ 也穿过割线，它们在对末态的割线求和中由幺正性相消（\cref {lem:coll-unobserved-jet}），软因子为 $1$；全部共线线都是出射的，Glauber 区没有钳夹（\cref {lem:coll-final-poles}）。\relax }}{17}{figure.caption.17}\protected@file@percent }
\newlabel{fig:coll-sia}{{4.17}{17}{$e^+e^-\to \gamma ^*\to hX$ 的领头区域（约化割图；竖直虚线为末态割线，左侧为振幅、右侧为共轭振幅）。 硬子图 $H$、$H^\dagger $ 产生两个喷注：被观测强子 $h$（动量 $p_h$，$z=2p_h\cdot q/q^2$，粗线穿过割线）所在的喷注 $J_1$ 给出碎裂函数 $d_{h/q}(z/y)$，$y$ 为碎裂部分子（动量 $k$）的相应份额； 未观测的喷注 $J_2$ 与软子图 $S$ 也穿过割线，它们在对末态的割线求和中由幺正性相消（\cref {lem:coll-unobserved-jet}），软因子为 $1$；全部共线线都是出射的，Glauber 区没有钳夹（\cref {lem:coll-final-poles}）。\relax }{figure.caption.17}{}}
\newlabel{fig:coll-sia@cref}{{[figure][17][4]4.17}{[1][17][]17}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.18}{\ignorespaces 半单举 DIS $\ell A\to \ell ' hX$ 的共线因子化（割图示意；竖直虚线为末态割线，左侧为振幅）。 靶 $A$ 的共线子图给出部分子分布 $f_{i/A}(\xi )$（蓝色，沿 $+z$），流出硬部分的部分子 $j$ 碎裂为被观测强子 $h$（粗线穿过割线），给出碎裂函数 $d_{h/j}(\zeta )$（橙色）； $P_{hT}\sim Q$ 时 $h$ 的横动量来自硬辐射 $X_H$，截面为 $f\otimes \mathrm  {d}\hat  \sigma \otimes d$ 的共线因子化形式；$P_{hT}\ll Q$ 时需要 TMD 因子化，二者在中间区域由 $W+Y$ 衔接（\cref {ch:tmd}）。\relax }}{18}{figure.caption.18}\protected@file@percent }
\newlabel{fig:coll-sidis}{{4.18}{18}{半单举 DIS $\ell A\to \ell ' hX$ 的共线因子化（割图示意；竖直虚线为末态割线，左侧为振幅）。 靶 $A$ 的共线子图给出部分子分布 $f_{i/A}(\xi )$（蓝色，沿 $+z$），流出硬部分的部分子 $j$ 碎裂为被观测强子 $h$（粗线穿过割线），给出碎裂函数 $d_{h/j}(\zeta )$（橙色）； $P_{hT}\sim Q$ 时 $h$ 的横动量来自硬辐射 $X_H$，截面为 $f\otimes \dd \hat \sigma \otimes d$ 的共线因子化形式；$P_{hT}\ll Q$ 时需要 TMD 因子化，二者在中间区域由 $W+Y$ 衔接（\cref {ch:tmd}）。\relax }{figure.caption.18}{}}
\newlabel{fig:coll-sidis@cref}{{[figure][18][4]4.18}{[1][18][]18}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.19}{\ignorespaces 光生过程 $\gamma p\to \text  {jets}+X$（振幅示意）。(a)\nobreakspace  {}直接光子：光子直接参与硬散射 $H$，只有质子一侧有部分子分布 $f_{i/p}$ 与旁观者 $X_p$，与 DIS 同为单强子过程，因子化为全阶论证 [A]（\cref {thm:coll-direct-photo}）； (b)\nobreakspace  {}分辨光子：光子先“强子化”为由光子部分子分布 $f_{j/\gamma }$ 描述的部分子云，提供进入硬散射的部分子（动量份额 $x_\gamma $），光子一侧也有旁观者 $X_\gamma $， 等效于末态有色的强子—强子过程，旁观者之间可交换 Glauber 胶子（暗红色），因子化为猜想 [C]（\cref {conj:coll-resolved-photo}）。\relax }}{19}{figure.caption.19}\protected@file@percent }
\newlabel{fig:coll-photoproduction}{{4.19}{19}{光生过程 $\gamma p\to \text {jets}+X$（振幅示意）。(a)~直接光子：光子直接参与硬散射 $H$，只有质子一侧有部分子分布 $f_{i/p}$ 与旁观者 $X_p$，与 DIS 同为单强子过程，因子化为全阶论证 [A]（\cref {thm:coll-direct-photo}）； (b)~分辨光子：光子先“强子化”为由光子部分子分布 $f_{j/\gamma }$ 描述的部分子云，提供进入硬散射的部分子（动量份额 $x_\gamma $），光子一侧也有旁观者 $X_\gamma $， 等效于末态有色的强子—强子过程，旁观者之间可交换 Glauber 胶子（暗红色），因子化为猜想 [C]（\cref {conj:coll-resolved-photo}）。\relax }{figure.caption.19}{}}
\newlabel{fig:coll-photoproduction@cref}{{[figure][19][4]4.19}{[1][19][]19}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.20}{\ignorespaces 横度分布 $h_1$ 的手征结构（割图示意；深红色边框标出手征奇的分布或碎裂函数）。光子顶点 $\gamma ^\mu $ 保持（无质量）夸克的手征，手征奇的因子只能成对出现。 (a)\nobreakspace  {}单举 DIS 只有一条经过硬部分的费米子线，$h_1$ 在领头扭度不出现（翻转手征需要夸克质量，被幂次压低）； (b)\nobreakspace  {}横向极化 Drell--Yan 中两个手征奇的分布相乘，$h_1\otimes \bar  h_1$；(c)\nobreakspace  {}SIDIS 中 $h_1$ 与手征奇的 Collins 碎裂函数 $H_1^\perp $ 相乘（TMD 观测量，见\cref {ch:tmd}）。横度分布的定义见\cref {def:coll-transversity}。\relax }}{20}{figure.caption.20}\protected@file@percent }
\newlabel{fig:coll-transversity}{{4.20}{20}{横度分布 $h_1$ 的手征结构（割图示意；深红色边框标出手征奇的分布或碎裂函数）。光子顶点 $\gamma ^\mu $ 保持（无质量）夸克的手征，手征奇的因子只能成对出现。 (a)~单举 DIS 只有一条经过硬部分的费米子线，$h_1$ 在领头扭度不出现（翻转手征需要夸克质量，被幂次压低）； (b)~横向极化 Drell--Yan 中两个手征奇的分布相乘，$h_1\otimes \bar h_1$；(c)~SIDIS 中 $h_1$ 与手征奇的 Collins 碎裂函数 $H_1^\perp $ 相乘（TMD 观测量，见\cref {ch:tmd}）。横度分布的定义见\cref {def:coll-transversity}。\relax }{figure.caption.20}{}}
\newlabel{fig:coll-transversity@cref}{{[figure][20][4]4.20}{[1][20][]20}}
