\@writefile{lof}{\contentsline {figure}{\numberline {1.14}{\ignorespaces 流关联函数 $\Pi (q^2)$ 的解析结构：割线 $[0,\infty )$、欧氏点 $-Q^2$、围道公式 $R(s)=\frac  1{2\pi }\DOTSI \intop \ilimits@ _{-\pi }^{\pi }\mathrm  {d}\theta \,D(s\mathrm  {e}^{\mathrm  {i}\theta })$ 的积分路径 $|q^2|=s$ （$D$ 的宗量 $Q^2=-q^2$ 走遍该圆周，在 $q^2$ 平面中即自 $s+\mathrm  {i}0$ 逆时针到 $s-\mathrm  {i}0$）以及抹平所用的点 $s\pm \mathrm  {i}\Delta $。在复 $q^2$ 处使用 OPE 是额外的假设（\cref {rem:ee-complex-ope}）。\relax }}{15}{figure.caption.14}\protected@file@percent }
\newlabel{fig:ee-pi-plane}{{1.14}{15}{流关联函数 $\Pi (q^2)$ 的解析结构：割线 $[0,\infty )$、欧氏点 $-Q^2$、围道公式 $R(s)=\frac 1{2\pi }\int _{-\pi }^{\pi }\dd \theta \,D(s\ee ^{\ii \theta })$ 的积分路径 $|q^2|=s$ （$D$ 的宗量 $Q^2=-q^2$ 走遍该圆周，在 $q^2$ 平面中即自 $s+\ii 0$ 逆时针到 $s-\ii 0$）以及抹平所用的点 $s\pm \ii \Delta $。在复 $q^2$ 处使用 OPE 是额外的假设（\cref {rem:ee-complex-ope}）。\relax }{figure.caption.14}{}}
