\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces 本书主要结论的逻辑依赖。框的颜色表示严格性标签（绿 R、蓝 A、橙 P、紫 C、红 V），虚线框为 $R_{\rm  cond}$ 条件定理；灰色箭头是各条目依赖记录在所示结论之间的传递约化，引用编号后的圈码表示用到左列的哪几项工具（ST 为 Slavnov--Taylor 恒等式）。下方橙色虚线框为编号假设，其中“Glauber 区”框代表 Glauber--软混合、围道形变与改写形式的 Collins 条件三条假设；橙色虚线箭头指向以之为前提的条件定理，粗红线标出决定各全阶论证地位的瓶颈假设。完整的依赖图见附录\nobreakspace  {}P。\relax }}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:intro-dependency}{{1.1}{2}{本书主要结论的逻辑依赖。框的颜色表示严格性标签（绿 R、蓝 A、橙 P、紫 C、红 V），虚线框为 $R_{\rm cond}$ 条件定理；灰色箭头是各条目依赖记录在所示结论之间的传递约化，引用编号后的圈码表示用到左列的哪几项工具（ST 为 Slavnov--Taylor 恒等式）。下方橙色虚线框为编号假设，其中“Glauber 区”框代表 Glauber--软混合、围道形变与改写形式的 Collins 条件三条假设；橙色虚线箭头指向以之为前提的条件定理，粗红线标出决定各全阶论证地位的瓶颈假设。完整的依赖图见附录~P。\relax }{figure.caption.1}{}}
\newlabel{fig:intro-dependency@cref}{{[figure][1][1]1.1}{[1][2][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces 本书使用的 Feynman 规则（协变规范，$D_\mu =\partial _\mu -\mathrm  {i}gA^a_\mu t^a$，与 Peskin--Schroeder 第 16 章一致；图中胶子传播子取 Feynman 规范 $\xi _g=1$，一般 $\xi _g$ 的形式见正文）。 夸克与鬼场传播子中的动量沿线上的箭头；夸克—胶子顶点 $(t^a)_{ij}$ 中的 $i$ 属于沿箭头离开顶点的夸克线；三胶子顶点的动量 $k,p,q$ 均流入顶点； 鬼场—胶子顶点中 $a$ 为出射鬼场（动量 $p$ 流出顶点），$c$ 为入射鬼场，$b$ 为胶子的色指标。每个闭合夸克圈与闭合鬼场圈各带因子 $-1$。\relax }}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:prelim-feynman-rules}{{1.2}{3}{本书使用的 Feynman 规则（协变规范，$D_\mu =\partial _\mu -\ii gA^a_\mu t^a$，与 Peskin--Schroeder 第 16 章一致；图中胶子传播子取 Feynman 规范 $\xi _g=1$，一般 $\xi _g$ 的形式见正文）。 夸克与鬼场传播子中的动量沿线上的箭头；夸克—胶子顶点 $(t^a)_{ij}$ 中的 $i$ 属于沿箭头离开顶点的夸克线；三胶子顶点的动量 $k,p,q$ 均流入顶点； 鬼场—胶子顶点中 $a$ 为出射鬼场（动量 $p$ 流出顶点），$c$ 为入射鬼场，$b$ 为胶子的色指标。每个闭合夸克圈与闭合鬼场圈各带因子 $-1$。\relax }{figure.caption.2}{}}
\newlabel{fig:prelim-feynman-rules@cref}{{[figure][2][1]1.2}{[1][3][]3}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces 胶子传播子的单圈修正（Feynman 规范，外线动量 $k$ 自左向右流动）：(a) 夸克圈（对 $n_f$ 味求和），(b) 胶子圈，(c) 鬼场圈， (d) 四胶子顶点的蝌蚪图（无标度积分，维数正规化中为零）。(b)(c) 单独都不满足横向性，三者之和正比于 $k^2g^{\mu \nu }-k^\mu k^\nu $； 紫外极点给出 $\delta Z_3$，与夸克场和顶点的重整化常数合成规范无关的 $\delta Z_g$ 与 $\beta _0=\frac  {11}3C_A-\frac  43T_Fn_f$（VF-PDF-14，VF-QCD-4）。\relax }}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:qcd-vacuum-polarization}{{1.3}{4}{胶子传播子的单圈修正（Feynman 规范，外线动量 $k$ 自左向右流动）：(a) 夸克圈（对 $n_f$ 味求和），(b) 胶子圈，(c) 鬼场圈， (d) 四胶子顶点的蝌蚪图（无标度积分，维数正规化中为零）。(b)(c) 单独都不满足横向性，三者之和正比于 $k^2g^{\mu \nu }-k^\mu k^\nu $； 紫外极点给出 $\delta Z_3$，与夸克场和顶点的重整化常数合成规范无关的 $\delta Z_g$ 与 $\beta _0=\frac {11}3C_A-\frac 43T_Fn_f$（VF-PDF-14，VF-QCD-4）。\relax }{figure.caption.3}{}}
\newlabel{fig:qcd-vacuum-polarization@cref}{{[figure][3][1]1.3}{[1][4][]4}}
\citation{ParticleDataGroup:2024cfk}
\citation{ParticleDataGroup:2024cfk}
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces 跑动耦合 $\alpha _s(Q)$（$n_f=5$，输入 PDG 2024 世界平均 $\alpha _s(M_Z)=0.1180\pm 0.0009$\cite  [式\nobreakspace  {}(9.25)]{ParticleDataGroup:2024cfk}）。 (a) 单圈与两圈（截断式，$\Lambda ^{(5)}_{\overline  {\mathrm  {MS}}}=0.226\,\mathrm  {GeV}$，在 $5\le Q\le 1000\,\mathrm  {GeV}$ 内与精确两圈跑动相差不到 $0.6\%$，VF-QCD-7）跑动； (b) 单圈下 $1/\alpha _s$ 对 $\qopname  \relax o{ln}Q$ 为直线，斜率 $\beta _0/(2\pi )>0$：$Q$ 越大耦合越弱，这就是渐近自由。 图中全程取 $n_f=5$；$Q<m_b$ 与 $Q>m_t$ 处应分别改用 $n_f=4$ 与 $n_f=6$（阈值匹配），图中未画出。\relax }}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:qcd-running-coupling}{{1.4}{5}{跑动耦合 $\alpha _s(Q)$（$n_f=5$，输入 PDG 2024 世界平均 $\alpha _s(M_Z)=0.1180\pm 0.0009$\cite [式~(9.25)]{ParticleDataGroup:2024cfk}）。 (a) 单圈与两圈（截断式，$\Lambda ^{(5)}_{\MSbar }=0.226\,\mathrm {GeV}$，在 $5\le Q\le 1000\,\mathrm {GeV}$ 内与精确两圈跑动相差不到 $0.6\%$，VF-QCD-7）跑动； (b) 单圈下 $1/\alpha _s$ 对 $\ln Q$ 为直线，斜率 $\beta _0/(2\pi )>0$：$Q$ 越大耦合越弱，这就是渐近自由。 图中全程取 $n_f=5$；$Q<m_b$ 与 $Q>m_t$ 处应分别改用 $n_f=4$ 与 $n_f=6$（阈值匹配），图中未画出。\relax }{figure.caption.4}{}}
\newlabel{fig:qcd-running-coupling@cref}{{[figure][4][1]1.4}{[1][5][]5}}
\citation{Nielsen:1980sx}
\citation{Nielsen:1980sx}
\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces 屏蔽与反屏蔽的直观图像（示意）。(a) QED：真空中的虚电子—正电子对屏蔽电荷，有效耦合在远处变小； (b) QCD：夸克对同样屏蔽（$-\frac  43T_Fn_f$），而带色的胶子把色荷“涂抹”到更大的区域，在短距离处看到的色荷变小（反屏蔽，$+\frac  {11}3C_A$）； (c) 两种理论的有效耦合随距离的变化趋势。二者之和 $\beta _0>0$（SU(3) 中 $n_f\le 16$）。 这只是启发式图像：规范无关的推导见\cref {prop:prelim-beta}，把反屏蔽解释为胶子自旋的顺磁效应见\cite  {Nielsen:1980sx}。\relax }}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:qcd-antiscreening}{{1.5}{6}{屏蔽与反屏蔽的直观图像（示意）。(a) QED：真空中的虚电子—正电子对屏蔽电荷，有效耦合在远处变小； (b) QCD：夸克对同样屏蔽（$-\frac 43T_Fn_f$），而带色的胶子把色荷“涂抹”到更大的区域，在短距离处看到的色荷变小（反屏蔽，$+\frac {11}3C_A$）； (c) 两种理论的有效耦合随距离的变化趋势。二者之和 $\beta _0>0$（SU(3) 中 $n_f\le 16$）。 这只是启发式图像：规范无关的推导见\cref {prop:prelim-beta}，把反屏蔽解释为胶子自旋的顺磁效应见\cite {Nielsen:1980sx}。\relax }{figure.caption.5}{}}
\newlabel{fig:qcd-antiscreening@cref}{{[figure][5][1]1.5}{[1][6][]6}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.6}{\ignorespaces 红外发散与红外安全（示意）。(a) 无质量夸克发射胶子：传播子在软（$E_k\to 0$）与共线（$\theta \to 0$）极限下发散； (b) 对足够单举的量，实发射与虚修正的发散相消（$e^+e^-$ 总截面，VF-EE-6；$N_\varepsilon $ 为两者共同的归一化因子，以 Born 截面 $\sigma _0$ 为单位，见\cref {prop:ee-oneloop}）； (c) 红外安全可观测量在软发射与共线劈裂下取值不变，因而可以逐阶微扰计算（精确定义见\cref {def:ir-safe}）。\relax }}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:qcd-ir-safety}{{1.6}{7}{红外发散与红外安全（示意）。(a) 无质量夸克发射胶子：传播子在软（$E_k\to 0$）与共线（$\theta \to 0$）极限下发散； (b) 对足够单举的量，实发射与虚修正的发散相消（$e^+e^-$ 总截面，VF-EE-6；$N_\varepsilon $ 为两者共同的归一化因子，以 Born 截面 $\sigma _0$ 为单位，见\cref {prop:ee-oneloop}）； (c) 红外安全可观测量在软发射与共线劈裂下取值不变，因而可以逐阶微扰计算（精确定义见\cref {def:ir-safe}）。\relax }{figure.caption.6}{}}
\newlabel{fig:qcd-ir-safety@cref}{{[figure][6][1]1.6}{[1][7][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.7}{\ignorespaces 规范固定与 Faddeev--Popov 行列式（示意）：规范固定曲面与每条规范轨道相交一次，交点处的 Jacobian 给出鬼场。 在远离 $A=0$ 的大场强区域，规范固定曲面可能与同一条轨道相交多次（Gribov 复本，红点）；它们在微扰论的任何一阶中都不出现。\relax }}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:qcd-gauge-orbit}{{1.7}{8}{规范固定与 Faddeev--Popov 行列式（示意）：规范固定曲面与每条规范轨道相交一次，交点处的 Jacobian 给出鬼场。 在远离 $A=0$ 的大场强区域，规范固定曲面可能与同一条轨道相交多次（Gribov 复本，红点）；它们在微扰论的任何一阶中都不出现。\relax }{figure.caption.7}{}}
\newlabel{fig:qcd-gauge-orbit@cref}{{[figure][7][1]1.7}{[1][8][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.8}{\ignorespaces 色流（双线）记号与 Fierz 恒等式；$C_F=\frac  {N^2-1}{2N}$ 与 $C_A=N$ 的图示（VF-QCD-1）。单线箭头表示色指标的流向（夸克线即其费米子数流向）， 闭合色线圈给出因子 $\delta _{ii}=N$；(c) 的第一行即用 (b) 把夸克自能的色因子 $t^at^a$ 化为 $C_F$。\relax }}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:qcd-colour-flow}{{1.8}{9}{色流（双线）记号与 Fierz 恒等式；$C_F=\frac {N^2-1}{2N}$ 与 $C_A=N$ 的图示（VF-QCD-1）。单线箭头表示色指标的流向（夸克线即其费米子数流向）， 闭合色线圈给出因子 $\delta _{ii}=N$；(c) 的第一行即用 (b) 把夸克自能的色因子 $t^at^a$ 化为 $C_F$。\relax }{figure.caption.8}{}}
\newlabel{fig:qcd-colour-flow@cref}{{[figure][8][1]1.8}{[1][9][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.9}{\ignorespaces 半无限 Wilson 线的动量空间规则（$k$ 流入 Wilson 线；颜色矩阵按路径排序，靠近终点者在左）：(a) 过去指向，(b) 未来指向；双线上的箭头为路径取向，空心圆为有限端点 $0$。 统一规则（VF-WL-1）：每个顶点 $\mathrm  {i}g\,t^{a_j}n^{\mu _j}$（图中只标出第一个）；有限端点与顶点之间、相邻顶点之间的每一段给一个程函传播子 $\mathrm  {i}/(n\cdot \ell +\mathrm  {i}0)$， $\ell $ 为沿路径取向流动的动量，伸向无穷远的一段 $\ell =0$、不给传播子。于是 (a) 中第 $j$ 个顶点之后的一段 $\ell =k_1+\dots  +k_j$； (b) 中第 $j$ 个顶点之前的一段 $\ell =-(k_j+\dots  +k_3)$，传播子即 $-\mathrm  {i}/(n\cdot (k_j+\dots  +k_3)-\mathrm  {i}0)$。\relax }}{10}{figure.caption.9}\protected@file@percent }
\newlabel{fig:prelim-wilson-rules}{{1.9}{10}{半无限 Wilson 线的动量空间规则（$k$ 流入 Wilson 线；颜色矩阵按路径排序，靠近终点者在左）：(a) 过去指向，(b) 未来指向；双线上的箭头为路径取向，空心圆为有限端点 $0$。 统一规则（VF-WL-1）：每个顶点 $\ii g\,t^{a_j}n^{\mu _j}$（图中只标出第一个）；有限端点与顶点之间、相邻顶点之间的每一段给一个程函传播子 $\ii /(n\cdot \ell +\ii 0)$， $\ell $ 为沿路径取向流动的动量，伸向无穷远的一段 $\ell =0$、不给传播子。于是 (a) 中第 $j$ 个顶点之后的一段 $\ell =k_1+\dots +k_j$； (b) 中第 $j$ 个顶点之前的一段 $\ell =-(k_j+\dots +k_3)$，传播子即 $-\ii /(n\cdot (k_j+\dots +k_3)-\ii 0)$。\relax }{figure.caption.9}{}}
\newlabel{fig:prelim-wilson-rules@cref}{{[figure][9][1]1.9}{[1][10][]10}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.10}{\ignorespaces 光锥坐标与 Lorentz 推动。(a) $(z,t)$ 平面中的光锥轴 $x^\pm =(t\pm z)/\sqrt  2$ 与沿 $+z$ 快速运动的强子世界带；推动沿不变双曲线移动点。 (b) 对数光锥平面中，快度为 $\eta $ 的推动 $v^\pm \to \mathrm  {e}^{\pm \eta }v^\pm $ 是沿反对角线的平移（$\qopname  \relax o{ln}v^+$ 增加 $\eta $，$\qopname  \relax o{ln}v^-$ 减少 $\eta $），等 $v^+v^-$ 线为反对角线（虚线），等快度线为对角线（点线）。\relax }}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:prelim-lightcone}{{1.10}{11}{光锥坐标与 Lorentz 推动。(a) $(z,t)$ 平面中的光锥轴 $x^\pm =(t\pm z)/\sqrt 2$ 与沿 $+z$ 快速运动的强子世界带；推动沿不变双曲线移动点。 (b) 对数光锥平面中，快度为 $\eta $ 的推动 $v^\pm \to \ee ^{\pm \eta }v^\pm $ 是沿反对角线的平移（$\ln v^+$ 增加 $\eta $，$\ln v^-$ 减少 $\eta $），等 $v^+v^-$ 线为反对角线（虚线），等快度线为对角线（点线）。\relax }{figure.caption.10}{}}
\newlabel{fig:prelim-lightcone@cref}{{[figure][10][1]1.10}{[1][11][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.11}{\ignorespaces Sudakov 形状因子的领头区域与因子化 $F=H\,J_1J_2/S$（$\gamma ^*\to q(p_1)\,\bar  q(p_2)$，$p_1$ 沿 $n_A$、$p_2$ 沿 $n_B$）。 (a) 硬子图 $H$、两个喷注子图 $J_1$、$J_2$ 与只连接喷注的软子图 $S$（绿色）；Feynman 规范下 $J_i$ 与 $H$ 之间还有任意多条标量（纵向）极化的共线胶子（蓝色，以圆点标记）。 (b) 喷注函数中的 Wilson 线沿另一喷注方向，软函数是两条 Wilson 线的真空期望（$\otimes $ 为算符所在点，双线箭头与被替代的夸克线的费米子数流向一致）。\relax }}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:sudakov-hjjs}{{1.11}{12}{Sudakov 形状因子的领头区域与因子化 $F=H\,J_1J_2/S$（$\gamma ^*\to q(p_1)\,\bar q(p_2)$，$p_1$ 沿 $n_A$、$p_2$ 沿 $n_B$）。 (a) 硬子图 $H$、两个喷注子图 $J_1$、$J_2$ 与只连接喷注的软子图 $S$（绿色）；Feynman 规范下 $J_i$ 与 $H$ 之间还有任意多条标量（纵向）极化的共线胶子（蓝色，以圆点标记）。 (b) 喷注函数中的 Wilson 线沿另一喷注方向，软函数是两条 Wilson 线的真空期望（$\otimes $ 为算符所在点，双线箭头与被替代的夸克线的费米子数流向一致）。\relax }{figure.caption.11}{}}
\newlabel{fig:sudakov-hjjs@cref}{{[figure][11][1]1.11}{[1][12][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.12}{\ignorespaces Wilson 线尖点及其单圈修正。(a) 类时 Wilson 线 $W[\infty v_1,0]\,W[0,-\infty v_2]$（$v_i^2=1$，$v_i^0>0$；双线箭头为路径方向）：沿 $v_2$ 自过去入射，在原点折向 $v_1$； 尖点角 $\beta $ 由 $\qopname  \relax o{cosh}\beta =v_1\cdot v_2$ 定义，$\beta =0$ 即一条不折的直线（图中所画角度为示意）。(b) 类光极限：$v_2$、$v_1$ 分别趋于 $n_A$、$n_B$ 方向，$\beta \to \infty $。 (c) 包含两线自能的单圈尖点反常维度为 $\Gamma (\beta )=\frac  {\alpha _sC_F}\pi (\beta \qopname  \relax o{coth}\beta -1)$，类光极限下线性依赖于 $\beta $，斜率给出单圈 $\Gamma _{\rm  cusp}$（VF-CONV-23）。\relax }}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:sudakov-cusp}{{1.12}{13}{Wilson 线尖点及其单圈修正。(a) 类时 Wilson 线 $W[\infty v_1,0]\,W[0,-\infty v_2]$（$v_i^2=1$，$v_i^0>0$；双线箭头为路径方向）：沿 $v_2$ 自过去入射，在原点折向 $v_1$； 尖点角 $\beta $ 由 $\cosh \beta =v_1\cdot v_2$ 定义，$\beta =0$ 即一条不折的直线（图中所画角度为示意）。(b) 类光极限：$v_2$、$v_1$ 分别趋于 $n_A$、$n_B$ 方向，$\beta \to \infty $。 (c) 包含两线自能的单圈尖点反常维度为 $\Gamma (\beta )=\frac {\alpha _sC_F}\pi (\beta \coth \beta -1)$，类光极限下线性依赖于 $\beta $，斜率给出单圈 $\Gamma _{\rm cusp}$（VF-CONV-23）。\relax }{figure.caption.12}{}}
\newlabel{fig:sudakov-cusp@cref}{{[figure][12][1]1.12}{[1][13][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.13}{\ignorespaces 多腿振幅的红外结构：(a) 两圈以内由偶极子项（色关联 $\mathbf  T_i\cdot \mathbf  T_j$）给出，反常维度如图下公式（VF-SUD-5，$(i,j)$ 取有序对）； (b) 三圈起出现连接三条或四条外线的非偶极子 web（偶极子公式作为全阶公式在三圈失效，[V]）。\relax }}{14}{figure.caption.13}\protected@file@percent }
\newlabel{fig:sudakov-dipole}{{1.13}{14}{多腿振幅的红外结构：(a) 两圈以内由偶极子项（色关联 $\mathbf T_i\cdot \mathbf T_j$）给出，反常维度如图下公式（VF-SUD-5，$(i,j)$ 取有序对）； (b) 三圈起出现连接三条或四条外线的非偶极子 web（偶极子公式作为全阶公式在三圈失效，[V]）。\relax }{figure.caption.13}{}}
