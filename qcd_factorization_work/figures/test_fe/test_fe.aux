\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces $h\to \gamma \gamma $ 的 $b$ 夸克圈贡献的重整化端点因子化定理\cite  {Liu:2019oav,Liu:2020wbn}（$\lambda =m_b/M_h$，一次质量插入，次领头幂次振幅）。 (a)\nobreakspace  {}软夸克（绿）在两个光子共线扇区之间交换，与 Higgs 顶点相连的两条线分别与 $n_1$、$n_2$ 共线（蓝、橙）；箭头为费米子数流向，另一取向的圈图未画出； (b)\nobreakspace  {}因子化公式的第三项 $H_3\,J\otimes J\otimes S$：两个辐射喷注函数 $J$ 分别只依赖软夸克动量的分量 $\ell _+$、$\ell _-$，对 $\ell _\pm $ 的卷积在端点 $\ell _\pm \to 0$ 发散；重因子化条件把端点发散在各项之间重新分配，给出各项分别有限的重整化定理，并再现领头双对数 $\mathcal  M_0\frac  {\hat  L^2}2\,{}_2F_2(1,1;\frac  32,2;-\frac  {C_F\alpha _s}{8\pi }\hat  L^2)$（全阶论证，VF-FRO-9）。\relax }}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:front-endpoint}{{1.5}{5}{$h\to \gamma \gamma $ 的 $b$ 夸克圈贡献的重整化端点因子化定理\cite {Liu:2019oav,Liu:2020wbn}（$\lambda =m_b/M_h$，一次质量插入，次领头幂次振幅）。 (a)~软夸克（绿）在两个光子共线扇区之间交换，与 Higgs 顶点相连的两条线分别与 $n_1$、$n_2$ 共线（蓝、橙）；箭头为费米子数流向，另一取向的圈图未画出； (b)~因子化公式的第三项 $H_3\,J\otimes J\otimes S$：两个辐射喷注函数 $J$ 分别只依赖软夸克动量的分量 $\ell _+$、$\ell _-$，对 $\ell _\pm $ 的卷积在端点 $\ell _\pm \to 0$ 发散；重因子化条件把端点发散在各项之间重新分配，给出各项分别有限的重整化定理，并再现领头双对数 $\mathcal M_0\frac {\hat L^2}2\,{}_2F_2(1,1;\frac 32,2;-\frac {C_F\alpha _s}{8\pi }\hat L^2)$（全阶论证，VF-FRO-9）。\relax }{figure.caption.4}{}}
\newlabel{fig:front-endpoint@cref}{{[figure][5][1]1.5}{[1][5][]5}}
\citation{CollinsRogersSato2022}
\citation{CollinsRogersSato2022}
\@writefile{lof}{\contentsline {figure}{\numberline {1.6}{\ignorespaces Yukawa 模型中单圈 $\overline  {\mathrm  {MS}}$ “夸克在核子中”的分布（$m_q=0.3\,\mathrm  {GeV}$、$m_p=1.0\,\mathrm  {GeV}$、$m_s=1.5\,\mathrm  {GeV}$，纵轴以 $a_\lambda =\lambda ^2/(16\pi ^2)$ 为单位）\cite  {CollinsRogersSato2022}：$\mu =0.8\,\mathrm  {GeV}$ 时 $\xi >0.264$ 处为负，$\mu =1.2\,\mathrm  {GeV}$ 时 $\xi >0.567$ 处为负，$\mu =2.5\,\mathrm  {GeV}$ 时处处为正（曲线由 VF-FRO-10 的单圈公式计算）。 “$\overline  {\mathrm  {MS}}$ 分布在所有标度上非负”因而不成立；足够大标度上的正定性只有部分论证（\cref {prop:front-positivity-large-scale}），一般陈述仍是猜想（\cref {conj:pdf-positivity}）。\relax }}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:front-yukawa-pdf}{{1.6}{6}{Yukawa 模型中单圈 $\MSbar $ “夸克在核子中”的分布（$m_q=0.3\,\mathrm {GeV}$、$m_p=1.0\,\mathrm {GeV}$、$m_s=1.5\,\mathrm {GeV}$，纵轴以 $a_\lambda =\lambda ^2/(16\pi ^2)$ 为单位）\cite {CollinsRogersSato2022}：$\mu =0.8\,\mathrm {GeV}$ 时 $\xi >0.264$ 处为负，$\mu =1.2\,\mathrm {GeV}$ 时 $\xi >0.567$ 处为负，$\mu =2.5\,\mathrm {GeV}$ 时处处为正（曲线由 VF-FRO-10 的单圈公式计算）。 “$\MSbar $ 分布在所有标度上非负”因而不成立；足够大标度上的正定性只有部分论证（\cref {prop:front-positivity-large-scale}），一般陈述仍是猜想（\cref {conj:pdf-positivity}）。\relax }{figure.caption.5}{}}
\newlabel{fig:front-yukawa-pdf@cref}{{[figure][6][1]1.6}{[1][6][]6}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.7}{\ignorespaces 双部分子散射与单部分子散射在小 $y$ 处的重复计数及其减除：$\sigma =\sigma _{\rm  SPS}+\sigma _{\rm  DPS}-\sigma _{\rm  sub}$（VF-FRO-13）。 (a)\nobreakspace  {}两个强子各经微扰 $1\to 2$ 劈裂提供两个部分子（小横向间距 $y$ 处双部分子分布 $F\propto 1/y^2$），图中闭合的夸克圈在 $y\sim 1/Q$ 时正是单部分子散射的单圈图，两种计算重复计入同一区域； (b)\nobreakspace  {}DPS 公式中的截断函数 $\Phi (y\nu )$（$\Phi (u)\to 1$，$u\gg 1$；小 $u$ 处 $\Phi =O(u^\delta )$；曲线为示意）压低小 $y$ 区：小 $y$ 处 $\Phi $ 依赖在 $\sigma _{\rm  DPS}$ 与 $\sigma _{\rm  sub}$ 之间相消，只剩 SPS，大 $y$ 处 $\sigma _{\rm  SPS}\simeq \sigma _{\rm  sub}$，只剩 DPS。\relax }}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:front-dps-double-counting}{{1.7}{7}{双部分子散射与单部分子散射在小 $y$ 处的重复计数及其减除：$\sigma =\sigma _{\rm SPS}+\sigma _{\rm DPS}-\sigma _{\rm sub}$（VF-FRO-13）。 (a)~两个强子各经微扰 $1\to 2$ 劈裂提供两个部分子（小横向间距 $y$ 处双部分子分布 $F\propto 1/y^2$），图中闭合的夸克圈在 $y\sim 1/Q$ 时正是单部分子散射的单圈图，两种计算重复计入同一区域； (b)~DPS 公式中的截断函数 $\Phi (y\nu )$（$\Phi (u)\to 1$，$u\gg 1$；小 $u$ 处 $\Phi =O(u^\delta )$；曲线为示意）压低小 $y$ 区：小 $y$ 处 $\Phi $ 依赖在 $\sigma _{\rm DPS}$ 与 $\sigma _{\rm sub}$ 之间相消，只剩 SPS，大 $y$ 处 $\sigma _{\rm SPS}\simeq \sigma _{\rm sub}$，只剩 DPS。\relax }{figure.caption.6}{}}
\newlabel{fig:front-dps-double-counting@cref}{{[figure][7][1]1.7}{[1][7][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.8}{\ignorespaces DIS 矩定理对编号假设的依赖（据各陈述所列的“依赖”绘制；节点只写标签去掉前缀 \texttt  {prop:dis-}、\texttt  {asm:intro-} 等后的部分）：\cref {thm:dis-moments} 的微扰部分只依赖 OPE 的三个子陈述（蓝框，即 \cref {thm:dis-ope}），它们在编号假设中只用到 App M 的三个技术假设，其中 \cref {asm:appM-brst-ope}、\cref {asm:appM-forward} 是相应 [A] 陈述的瓶颈（粗红线）；非微扰的固定 $n$ 定理（\cref {thm:dis-fixed-n}）依赖 Wightman 公理（W）与非微扰 OPE（O），$n<n_0$ 的矩（\cref {thm:dis-moments-np}）还依赖增长条件（G）。 框色为严格性标签，虚线框为 $R_{\mathrm  {cond}}$ 条件定理，橙色虚线框为编号假设；节点第二行的橙色字母标出该陈述直接使用的全局假设（W、C、O、F、G 对应上排五个全局假设），其余依赖画为由前提指向陈述的箭头。\relax }}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:appM-dependency}{{1.8}{8}{DIS 矩定理对编号假设的依赖（据各陈述所列的“依赖”绘制；节点只写标签去掉前缀 \texttt {prop:dis-}、\texttt {asm:intro-} 等后的部分）：\cref {thm:dis-moments} 的微扰部分只依赖 OPE 的三个子陈述（蓝框，即 \cref {thm:dis-ope}），它们在编号假设中只用到 App M 的三个技术假设，其中 \cref {asm:appM-brst-ope}、\cref {asm:appM-forward} 是相应 [A] 陈述的瓶颈（粗红线）；非微扰的固定 $n$ 定理（\cref {thm:dis-fixed-n}）依赖 Wightman 公理（W）与非微扰 OPE（O），$n<n_0$ 的矩（\cref {thm:dis-moments-np}）还依赖增长条件（G）。 框色为严格性标签，虚线框为 $R_{\mathrm {cond}}$ 条件定理，橙色虚线框为编号假设；节点第二行的橙色字母标出该陈述直接使用的全局假设（W、C、O、F、G 对应上排五个全局假设），其余依赖画为由前提指向陈述的箭头。\relax }{figure.caption.7}{}}
\newlabel{fig:appM-dependency@cref}{{[figure][8][1]1.8}{[1][8][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.9}{\ignorespaces BPHZ 森林公式与正规乘积（示意）：(a)\nobreakspace  {}森林是两两嵌套或不相交的子图（重整化部分；在正规乘积中还包括 AB 部分）的集合，例如紫外发散的顶点修正 $\gamma _1$ 与自能 $\gamma _3$，以及包含 $\gamma _1$ 与两个流顶点 $V_A$、$V_B$ 的 AB 部分 $\gamma _2$（$\gamma _3$ 与 $\gamma _2$ 无公共顶点）；$R_\Gamma $ 中较小的子图先作用（$\curvearrowleft $），大动量 $q$ 自 $V_A$ 流入、自 $V_B$ 流出； (b)\nobreakspace  {}冻结 $q$ 的双局域正规乘积中，含两个流顶点的子图（AB 部分，加上辅助线 $\ell _x$ 后为单粒子不可约）只对外动量 $p$ 作 Taylor 减除，$q$ 不展开。 减除次数必须对顶点可加（$\delta (\gamma )=\omega (\gamma )+\DOTSB \sum@ \slimits@ _{v\in V(\gamma )}c_v$），否则可构造反例（\cref {ex:appM-nonadditive}）。\relax }}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:appM-forest}{{1.9}{9}{BPHZ 森林公式与正规乘积（示意）：(a)~森林是两两嵌套或不相交的子图（重整化部分；在正规乘积中还包括 AB 部分）的集合，例如紫外发散的顶点修正 $\gamma _1$ 与自能 $\gamma _3$，以及包含 $\gamma _1$ 与两个流顶点 $V_A$、$V_B$ 的 AB 部分 $\gamma _2$（$\gamma _3$ 与 $\gamma _2$ 无公共顶点）；$R_\Gamma $ 中较小的子图先作用（$\curvearrowleft $），大动量 $q$ 自 $V_A$ 流入、自 $V_B$ 流出； (b)~冻结 $q$ 的双局域正规乘积中，含两个流顶点的子图（AB 部分，加上辅助线 $\ell _x$ 后为单粒子不可约）只对外动量 $p$ 作 Taylor 减除，$q$ 不展开。 减除次数必须对顶点可加（$\delta (\gamma )=\omega (\gamma )+\sum _{v\in V(\gamma )}c_v$），否则可构造反例（\cref {ex:appM-nonadditive}）。\relax }{figure.caption.8}{}}
