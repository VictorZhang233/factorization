\@writefile{lof}{\contentsline {figure}{\numberline {1.9}{\ignorespaces 混合重整化方案（示意）。(a)\nobreakspace  {}$|z|\le z_S$ 用比值方案，紫外发散（包括 Wilson 线的线性发散）在比值中相消；$|z|>z_S$ 只减去 Wilson 线的线性发散与对数因子（$\delta m$ 的符号约定同 \cref {prop:lattice-renormalizability}：$O^R=Z_j^{-2}\mathrm  {e}^{-\delta m|z|}O^B$）。 (b)\nobreakspace  {}到 $\overline  {\mathrm  {MS}}$ 的换算因子：混合方案中它等于 $z_S$ 处的值，在所有 $|z|$ 上都是微扰的，因此动量空间匹配成立；比值方案与 RI/MOM 方案的换算因子依赖于 $\qopname  \relax o{ln}(z^2\mu ^2)$，在大 $|z|$ 处含 $\alpha _s(1/|z|)$（灰色区），动量空间匹配没有依据（\cref {rem:lamet-ratio-large-z}）。 单圈混合核满足 $\DOTSI \intop \ilimits@ \mathrm  {d}\xi \,C_{\rm  hyb}=1$（\cref {prop:lamet-hybrid-kernel}，VF-LAM-10）。\relax }}{10}{figure.caption.9}\protected@file@percent }
\newlabel{fig:lamet-hybrid}{{1.9}{10}{混合重整化方案（示意）。(a)~$|z|\le z_S$ 用比值方案，紫外发散（包括 Wilson 线的线性发散）在比值中相消；$|z|>z_S$ 只减去 Wilson 线的线性发散与对数因子（$\delta m$ 的符号约定同 \cref {prop:lattice-renormalizability}：$O^R=Z_j^{-2}\ee ^{-\delta m|z|}O^B$）。 (b)~到 $\MSbar $ 的换算因子：混合方案中它等于 $z_S$ 处的值，在所有 $|z|$ 上都是微扰的，因此动量空间匹配成立；比值方案与 RI/MOM 方案的换算因子依赖于 $\ln (z^2\mu ^2)$，在大 $|z|$ 处含 $\alpha _s(1/|z|)$（灰色区），动量空间匹配没有依据（\cref {rem:lamet-ratio-large-z}）。 单圈混合核满足 $\int \dd \xi \,C_{\rm hyb}=1$（\cref {prop:lamet-hybrid-kernel}，VF-LAM-10）。\relax }{figure.caption.9}{}}
\newlabel{fig:lamet-hybrid@cref}{{[figure][9][1]1.9}{[1][10][]10}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.10}{\ignorespaces Fourier 步骤的截断误差与解析带（示意，数值取自 VF-LAM-17）。若准 ITD 沿射线满足 $|\tilde  h(\lambda ,-\lambda ^2/P_z^2)|\le A\,\mathrm  {e}^{-m|\lambda |/P^z}$（指数衰减假设），则准 PDF 在带形 $|\Imag  x|<m/P^z$ 中全纯（内插图，\cref {lem:lamet-strip}），在有限 $P^z$ 下没有端点奇异性； 只用数据窗 $|\lambda |\le \lambda _L=z_LP^z$（蓝色；图中 $m=0.5$ GeV，$P^z=2$ GeV）作 Fourier 变换时，截去的尾部（斜线）引起的误差不超过 $\frac  {AP^z}{\pi m}\mathrm  {e}^{-mz_L}$（\cref {prop:lamet-truncation}）。对 $m=0.5$ GeV、$z_L=1$ fm，$\mathrm  {e}^{-mz_L}=0.079$：对现有的 $z_L$ 这一压低并不是参数上小的。QCD 中这种衰减本身是猜想（\cref {conj:lamet-decay-qcd}）。\relax }}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:lamet-fourier}{{1.10}{11}{Fourier 步骤的截断误差与解析带（示意，数值取自 VF-LAM-17）。若准 ITD 沿射线满足 $|\tilde h(\lambda ,-\lambda ^2/P_z^2)|\le A\,\ee ^{-m|\lambda |/P^z}$（指数衰减假设），则准 PDF 在带形 $|\Imag x|<m/P^z$ 中全纯（内插图，\cref {lem:lamet-strip}），在有限 $P^z$ 下没有端点奇异性； 只用数据窗 $|\lambda |\le \lambda _L=z_LP^z$（蓝色；图中 $m=0.5$ GeV，$P^z=2$ GeV）作 Fourier 变换时，截去的尾部（斜线）引起的误差不超过 $\frac {AP^z}{\pi m}\ee ^{-mz_L}$（\cref {prop:lamet-truncation}）。对 $m=0.5$ GeV、$z_L=1$ fm，$\ee ^{-mz_L}=0.079$：对现有的 $z_L$ 这一压低并不是参数上小的。QCD 中这种衰减本身是猜想（\cref {conj:lamet-decay-qcd}）。\relax }{figure.caption.10}{}}
\newlabel{fig:lamet-fourier@cref}{{[figure][10][1]1.10}{[1][11][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.11}{\ignorespaces LaMET 预言的适用范围（示意，图中取 $\Lambda /P^z=0.1$）。端点区要求硬标度 $2xP^z$ 与旁观者动量 $(1-x)P^z$ 都远大于 $\Lambda $（灰色带不适用）。相对幂次修正在小 $x$ 处按 $\Lambda ^2/(x^2P_z^2)$ 增大；在大 $x$ 处，两种计数规则 $\Lambda ^2/((1-x)^{2-\delta }P_z^2)$（$\delta =0$ 虚线，$\delta =1$ 点线）对应扭度 4 分布 $\rho _4/q\sim (1-x)^\delta $ 的不同端点行为（\cref {cor:lamet-endpoint}，VF-LAM-12），$\delta $ 在 QCD 中未知。 固定阶匹配只在 $[x_0,1-x_0]$ 上一致成立；阈值重求和（\cref {thm:yzliu-threshold}）把大 $x$ 边界推到 $(1-x)P^z\gg \Lambda $（\cref {rem:lamet-domain}）。\relax }}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:lamet-validity}{{1.11}{12}{LaMET 预言的适用范围（示意，图中取 $\Lambda /P^z=0.1$）。端点区要求硬标度 $2xP^z$ 与旁观者动量 $(1-x)P^z$ 都远大于 $\Lambda $（灰色带不适用）。相对幂次修正在小 $x$ 处按 $\Lambda ^2/(x^2P_z^2)$ 增大；在大 $x$ 处，两种计数规则 $\Lambda ^2/((1-x)^{2-\delta }P_z^2)$（$\delta =0$ 虚线，$\delta =1$ 点线）对应扭度 4 分布 $\rho _4/q\sim (1-x)^\delta $ 的不同端点行为（\cref {cor:lamet-endpoint}，VF-LAM-12），$\delta $ 在 QCD 中未知。 固定阶匹配只在 $[x_0,1-x_0]$ 上一致成立；阈值重求和（\cref {thm:yzliu-threshold}）把大 $x$ 边界推到 $(1-x)P^z\gg \Lambda $（\cref {rem:lamet-domain}）。\relax }{figure.caption.11}{}}
\newlabel{fig:lamet-validity@cref}{{[figure][11][1]1.11}{[1][12][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.12}{\ignorespaces 离光锥 TMD 软函数作为快速色源对的形状因子（$v=\gamma (1,\beta ,\mathbf  0_\perp )$、$v'=\gamma '(1,-\beta ',\mathbf  0_\perp )$，$\beta =\qopname  \relax o{tanh}Y$、$\beta '=\qopname  \relax o{tanh}Y'$，坐标 $(t,z,\vec  b_\perp )$，$\vec  b_\perp $ 方向按透视画出）。 (a)\nobreakspace  {}两个订书钉形 Wilson 回路（$t<0$ 沿 $v$，$t>0$ 沿 $v'$，在 $-t$ 与 $t'$ 处由横向连接闭合）的时序真空期望，除以 $\sqrt  {ZZ}$（$Z$ 为矩形回路）后取 $t,t'\to \infty $；箭头为路径方向：$0$ 处沿世界线指向未来（色源 $Q$），$\vec  b_\perp $ 处指向过去（$\bar  Q$）。 (b)\nobreakspace  {}等价的 HQET 图像：间隔 $b_\perp $ 的色单态静态 $Q\bar  Q$ 对以速度 $v$ 运动，在 $t=0$ 被等时的流 $J$ 踢到 $v'$，软函数是 ${}_{v'}\langle Q\bar  Q,\vec  b_\perp |J|Q\bar  Q,\vec  b_\perp \rangle _v$，因而有欧氏表示（\cref {thm:yzliu-soft-hqet}，全阶论证 [A]；非微扰的形状因子形式另需\cref {asm:yzliu-heavy-pair}）。 大快度下 $\qopname  \relax o{ln}S=(Y+Y')\tilde  K+\mathcal  D+\mathcal  {O}\!\left (\mathrm  {e}^{-(Y+Y')}\right )$，本征软函数 $S_I=\mathrm  {e}^{-\mathcal  D}$（VF-YZL-2）。\relax }}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:yzliu-soft-hqet}{{1.12}{13}{离光锥 TMD 软函数作为快速色源对的形状因子（$v=\gamma (1,\beta ,\mathbf 0_\perp )$、$v'=\gamma '(1,-\beta ',\mathbf 0_\perp )$，$\beta =\tanh Y$、$\beta '=\tanh Y'$，坐标 $(t,z,\vec b_\perp )$，$\vec b_\perp $ 方向按透视画出）。 (a)~两个订书钉形 Wilson 回路（$t<0$ 沿 $v$，$t>0$ 沿 $v'$，在 $-t$ 与 $t'$ 处由横向连接闭合）的时序真空期望，除以 $\sqrt {ZZ}$（$Z$ 为矩形回路）后取 $t,t'\to \infty $；箭头为路径方向：$0$ 处沿世界线指向未来（色源 $Q$），$\vec b_\perp $ 处指向过去（$\bar Q$）。 (b)~等价的 HQET 图像：间隔 $b_\perp $ 的色单态静态 $Q\bar Q$ 对以速度 $v$ 运动，在 $t=0$ 被等时的流 $J$ 踢到 $v'$，软函数是 ${}_{v'}\langle Q\bar Q,\vec b_\perp |J|Q\bar Q,\vec b_\perp \rangle _v$，因而有欧氏表示（\cref {thm:yzliu-soft-hqet}，全阶论证 [A]；非微扰的形状因子形式另需\cref {asm:yzliu-heavy-pair}）。 大快度下 $\ln S=(Y+Y')\tilde K+\mathcal D+\order {\ee ^{-(Y+Y')}}$，本征软函数 $S_I=\ee ^{-\mathcal D}$（VF-YZL-2）。\relax }{figure.caption.12}{}}
\newlabel{fig:yzliu-soft-hqet@cref}{{[figure][12][1]1.12}{[1][13][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.13}{\ignorespaces 单线记号与偶极子 2PI 分解（示意；双线为类空 Wilson 线，箭头为路径方向，$\otimes $ 为夸克场端点）。(a)\nobreakspace  {}准 TMD 的订书钉形 Wilson 线的两条腿沿 $\hat  z$ 平行演化，可看作一个色单态“偶极子”，在单线记号中画成一条量纲 $\frac  32$、自旋 $0$ 的线（用于\cref {prop:yzliu-qtmd-powercount}的幂次计数）。 (b)\nobreakspace  {}部分指数化引理（\cref {lem:yzliu-partial-exp}）：关联函数等于规范线真空期望值 $\mathrm  {e}^{\Phi (\mathcal  W_z)}$（其 web 的指数，橙色胶子为一例）乘以算符—规范线两粒子不可约顶点之和（蓝色胶子为一例）；$\mathrm  {e}^{\Phi (\mathcal  W_z)}$ 与 $\sqrt  {Z_E}$ 都按 $\mathrm  {e}^{-LE(b_\perp )}$ 依赖于 $L$，在比值中相消（\cref {prop:yzliu-pinch-ultrasoft}）。\relax }}{14}{figure.caption.13}\protected@file@percent }
\newlabel{fig:yzliu-single-line}{{1.13}{14}{单线记号与偶极子 2PI 分解（示意；双线为类空 Wilson 线，箭头为路径方向，$\otimes $ 为夸克场端点）。(a)~准 TMD 的订书钉形 Wilson 线的两条腿沿 $\hat z$ 平行演化，可看作一个色单态“偶极子”，在单线记号中画成一条量纲 $\frac 32$、自旋 $0$ 的线（用于\cref {prop:yzliu-qtmd-powercount}的幂次计数）。 (b)~部分指数化引理（\cref {lem:yzliu-partial-exp}）：关联函数等于规范线真空期望值 $\ee ^{\Phi (\mathcal W_z)}$（其 web 的指数，橙色胶子为一例）乘以算符—规范线两粒子不可约顶点之和（蓝色胶子为一例）；$\ee ^{\Phi (\mathcal W_z)}$ 与 $\sqrt {Z_E}$ 都按 $\ee ^{-LE(b_\perp )}$ 依赖于 $L$，在比值中相消（\cref {prop:yzliu-pinch-ultrasoft}）。\relax }{figure.caption.13}{}}
\newlabel{fig:yzliu-single-line@cref}{{[figure][13][1]1.13}{[1][14][]14}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.14}{\ignorespaces 离光锥软函数对双曲角的解析性。单一时序的减除软函数只通过双曲角 $\theta (v_1,v_2)$（$\qopname  \relax o{cosh}\theta =v_1\cdot v_2/\sqrt  {v_1^2v_2^2}$，$\pm \mathrm  {i}0$ 处方见正文）依赖于两个方向，是带形 $-\pi \le \Imag  \theta \le \pi $（阴影，$\Real  \theta \ge 0$）上同一函数 $S(\theta )$ 的取值； 在固定的 $\Real  \theta =Y_0$ 上标出两个方向为类空/类时、过去/未来指向的六种组合所对应的 $\theta $（VF-YZL-4），其中 $\theta =Y_0$ 一点同时代表 Collins 的类空 DY 软因子与类时形状因子软函数， 由此在微扰论各阶 $S_{\mathrm  {DY}}=S_{\mathrm  {FF}}$（\cref {thm:yzliu-analyticity}，全阶论证 [A]；前提为维数正规化微扰论中的 Wightman 结构，\cref {asm:yzliu-wightman-pt}）。 光锥极限 $Y\to \infty $ 能否越过整个带形延拓，取决于该极限对 $\Imag  \theta $ 的一致性；它只在 $\Imag  \theta \in \{0,\pm \frac  {\pi }{2},\pm \pi \}$ 处得到微扰验证（\cref {asm:yzliu-lightcone-uniform}，部分 [P]）。\relax }}{15}{figure.caption.14}\protected@file@percent }
\newlabel{fig:yzliu-theta-strip}{{1.14}{15}{离光锥软函数对双曲角的解析性。单一时序的减除软函数只通过双曲角 $\theta (v_1,v_2)$（$\cosh \theta =v_1\cdot v_2/\sqrt {v_1^2v_2^2}$，$\pm \ii 0$ 处方见正文）依赖于两个方向，是带形 $-\pi \le \Imag \theta \le \pi $（阴影，$\Real \theta \ge 0$）上同一函数 $S(\theta )$ 的取值； 在固定的 $\Real \theta =Y_0$ 上标出两个方向为类空/类时、过去/未来指向的六种组合所对应的 $\theta $（VF-YZL-4），其中 $\theta =Y_0$ 一点同时代表 Collins 的类空 DY 软因子与类时形状因子软函数， 由此在微扰论各阶 $S_{\mathrm {DY}}=S_{\mathrm {FF}}$（\cref {thm:yzliu-analyticity}，全阶论证 [A]；前提为维数正规化微扰论中的 Wightman 结构，\cref {asm:yzliu-wightman-pt}）。 光锥极限 $Y\to \infty $ 能否越过整个带形延拓，取决于该极限对 $\Imag \theta $ 的一致性；它只在 $\Imag \theta \in \{0,\pm \frac {\pi }{2},\pm \pi \}$ 处得到微扰验证（\cref {asm:yzliu-lightcone-uniform}，部分 [P]）。\relax }{figure.caption.14}{}}
\newlabel{fig:yzliu-theta-strip@cref}{{[figure][14][1]1.14}{[1][15][]15}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.15}{\ignorespaces 时序无关性的解析延拓图像（$(z,t)$ 平面示意；双线为类光 Wilson 线，箭头为路径方向；$n$、$\bar  n$ 分别沿 $+z$、$-z$，即本书 $n_A$、$n_B$ 的方向；横向间隔 $\vec  b_\perp $ 垂直于纸面）。 左：指数正规子下的 DY 形软因子 $S$——振幅中的 $T[W_{\bar  n}^\dagger W_n](0)$ 与共轭振幅中位于 $\vec  b_\perp -\mathrm  {i}\nu e_t$ 的 $\bar  T[W_n^\dagger W_{\bar  n}]$（紫色，虚时间位移画成竖直错开）； 右：单一时序的类空形状因子 $S_t$——位于 $0$ 与 $\vec  b_\perp -\nu e_z$ 的一对类光色源，沿 $n$ 入射、沿 $\bar  n$ 出射。 二者由复 Lorentz 变换 $\Lambda (t,z)=(\mathrm  {i}z,\mathrm  {i}t)$（快度为 $\mathrm  {i}\pi /2$ 的推动）相联系，所有不变间隔的实部都为负（阈下表示，例如图下的 $x^2_{B,ij}$）。 在维数正规化中胶子 Wightman 函数满足谱条件与局域对易性的假设下（\cref {asm:yzliu-wightman-pt}；复 Lorentz 协变性来自 Bargmann--Hall--Wightman 定理），微扰论各阶 $S=S_t$（\cref {thm:yzliu-time-ordering}，全阶论证 [A]；VF-YZL-12）。\relax }}{16}{figure.caption.15}\protected@file@percent }
\newlabel{fig:yzliu-complex-lorentz}{{1.15}{16}{时序无关性的解析延拓图像（$(z,t)$ 平面示意；双线为类光 Wilson 线，箭头为路径方向；$n$、$\bar n$ 分别沿 $+z$、$-z$，即本书 $n_A$、$n_B$ 的方向；横向间隔 $\vec b_\perp $ 垂直于纸面）。 左：指数正规子下的 DY 形软因子 $S$——振幅中的 $T[W_{\bar n}^\dagger W_n](0)$ 与共轭振幅中位于 $\vec b_\perp -\ii \nu e_t$ 的 $\bar T[W_n^\dagger W_{\bar n}]$（紫色，虚时间位移画成竖直错开）； 右：单一时序的类空形状因子 $S_t$——位于 $0$ 与 $\vec b_\perp -\nu e_z$ 的一对类光色源，沿 $n$ 入射、沿 $\bar n$ 出射。 二者由复 Lorentz 变换 $\Lambda (t,z)=(\ii z,\ii t)$（快度为 $\ii \pi /2$ 的推动）相联系，所有不变间隔的实部都为负（阈下表示，例如图下的 $x^2_{B,ij}$）。 在维数正规化中胶子 Wightman 函数满足谱条件与局域对易性的假设下（\cref {asm:yzliu-wightman-pt}；复 Lorentz 协变性来自 Bargmann--Hall--Wightman 定理），微扰论各阶 $S=S_t$（\cref {thm:yzliu-time-ordering}，全阶论证 [A]；VF-YZL-12）。\relax }{figure.caption.15}{}}
\newlabel{fig:yzliu-complex-lorentz@cref}{{[figure][15][1]1.15}{[1][16][]16}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.16}{\ignorespaces 准 TMD 的领头区域（示意；幂次计数参数为 $1/(b_\perp P^z)$）。 (a)\nobreakspace  {}双线记号：共线子图 $C$（强子动量 $P$ 沿 $+\hat  z$，前向矩阵元）、位于两个夸克—规范线连接点 $0$ 与 $z\hat  e_z+\vec  b_\perp $ 的硬顶点 $H$、类空订书钉（双线，箭头为路径方向：自 $\psi (0)$ 沿 $+\hat  z$ 到 $L\to \infty $，经横向连接回到 $\bar  \psi $；与\cref {fig:tmd-staple}中的类光订书钉不同）与软子图 $S$；细线箭头为费米子数流向；$C$ 与 $H$ 之间可有任意多条纵向共线胶子（带点的蓝色胶子），$S$ 与 $C$ 之间可有任意多条软胶子（绿色）。 (b)\nobreakspace  {}单线记号：一对订书钉线合成一条量纲 $\frac  32$、自旋 $0$ 的偶极线（粗虚线）。 幂次计数 $F(H)=0$、$F(SC)\ge 0$ 表明没有超领头区域，且硬动量不能在 $0$ 与 $\vec  b_\perp $ 之间传递，因而匹配中没有 $x$ 卷积（VF-YZL-8；\cref {prop:yzliu-qtmd-powercount}，全阶论证 [A]）。\relax }}{17}{figure.caption.16}\protected@file@percent }
\newlabel{fig:yzliu-leading-region}{{1.16}{17}{准 TMD 的领头区域（示意；幂次计数参数为 $1/(b_\perp P^z)$）。 (a)~双线记号：共线子图 $C$（强子动量 $P$ 沿 $+\hat z$，前向矩阵元）、位于两个夸克—规范线连接点 $0$ 与 $z\hat e_z+\vec b_\perp $ 的硬顶点 $H$、类空订书钉（双线，箭头为路径方向：自 $\psi (0)$ 沿 $+\hat z$ 到 $L\to \infty $，经横向连接回到 $\bar \psi $；与\cref {fig:tmd-staple}中的类光订书钉不同）与软子图 $S$；细线箭头为费米子数流向；$C$ 与 $H$ 之间可有任意多条纵向共线胶子（带点的蓝色胶子），$S$ 与 $C$ 之间可有任意多条软胶子（绿色）。 (b)~单线记号：一对订书钉线合成一条量纲 $\frac 32$、自旋 $0$ 的偶极线（粗虚线）。 幂次计数 $F(H)=0$、$F(SC)\ge 0$ 表明没有超领头区域，且硬动量不能在 $0$ 与 $\vec b_\perp $ 之间传递，因而匹配中没有 $x$ 卷积（VF-YZL-8；\cref {prop:yzliu-qtmd-powercount}，全阶论证 [A]）。\relax }{figure.caption.16}{}}
\newlabel{fig:yzliu-leading-region@cref}{{[figure][16][1]1.16}{[1][17][]17}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.17}{\ignorespaces 阈值因子化的时空图像（示意）。 (a)\nobreakspace  {}$x\to 1$ 的 DIS：被击出的夸克在硬顶点 $H$ 吸收虚光子后形成窄喷注 $J$，喷注与靶残余之间只有软辐射 $S$。 (b)\nobreakspace  {}$\xi \to 1$ 的准 PDF 匹配核（$\Gamma =\gamma ^0$，$\overline  {\mathrm  {MS}}$，非单态）：共线夸克（动量 $p$，沿类光方向；细线箭头为费米子数流向）在类空 Wilson 线 $W[z\hat  e_z,0]$（双线，箭头为路径方向）的两个连接点处发生硬相互作用（灰色顶点 $H$，标度 $\zeta _z=4p_z^2$），并与静态规范线交换半硬胶子（绿色，标度 $|1-\xi |p^z$）；虚线框内的部分组成类空喷注函数 $\tilde  J$，乘上相位因子后为 $J_f$。 $H$ 与准 TMD 因子化中的硬核相同（\cref {thm:yzliu-threshold}，全阶论证 [A]；VF-LAM-14，VF-YZL-9）。 这一因子化形式在单圈精确成立；精确的两圈核在阈值极限下与它的全部 41 个奇异项相容（其中两个常数由比较定出）。\relax }}{18}{figure.caption.17}\protected@file@percent }
\newlabel{fig:yzliu-threshold}{{1.17}{18}{阈值因子化的时空图像（示意）。 (a)~$x\to 1$ 的 DIS：被击出的夸克在硬顶点 $H$ 吸收虚光子后形成窄喷注 $J$，喷注与靶残余之间只有软辐射 $S$。 (b)~$\xi \to 1$ 的准 PDF 匹配核（$\Gamma =\gamma ^0$，$\MSbar $，非单态）：共线夸克（动量 $p$，沿类光方向；细线箭头为费米子数流向）在类空 Wilson 线 $W[z\hat e_z,0]$（双线，箭头为路径方向）的两个连接点处发生硬相互作用（灰色顶点 $H$，标度 $\zeta _z=4p_z^2$），并与静态规范线交换半硬胶子（绿色，标度 $|1-\xi |p^z$）；虚线框内的部分组成类空喷注函数 $\tilde J$，乘上相位因子后为 $J_f$。 $H$ 与准 TMD 因子化中的硬核相同（\cref {thm:yzliu-threshold}，全阶论证 [A]；VF-LAM-14，VF-YZL-9）。 这一因子化形式在单圈精确成立；精确的两圈核在阈值极限下与它的全部 41 个奇异项相容（其中两个常数由比较定出）。\relax }{figure.caption.17}{}}
\newlabel{fig:yzliu-threshold@cref}{{[figure][17][1]1.17}{[1][18][]18}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.18}{\ignorespaces 大 $\beta _0$（泡链）近似下重—轻 Sudakov 核的 Borel 平面（$u=\beta _0t/(4\pi )$，约定同\cref {def:power-borel}；只画出 $u=\frac  12$ 附近，其余奇点未画出）。 线性红外重整化子位于 $u=\frac  12$，只出现在核的虚部即相位 $A$ 中 (b)，使沿正实轴的 Borel 积分产生正比于 $\Lambda /p^z$ 的不确定性（绕极点上方 $C_+$ 或下方 $C_-$）；核的实部在该处正则 (a)；轻—轻 Sudakov 核没有这一奇点。 它与次领头幂次阈值软算符（及含维数 1 的 Wilson 线尖点算符的软因子）的紫外重整化子相消（VF-YZL-11；\cref {prop:yzliu-linear-renormalon}，部分 [P]）。 归一化 $N_m$ 与极点质量、Wilson 线线性重整化子相同；它在大 $\beta _0$ 之外的普适性是猜想（\cref {conj:yzliu-renormalon-norm}，[C]）。\relax }}{19}{figure.caption.18}\protected@file@percent }
